+      executiveSummary: finalNode.summary,
+      themes: finalNode.themes,
+      actions: finalNode.actions,
+      deadlines: finalNode.deadlines,
+      decisions: finalNode.decisions,
+      risks: finalNode.risks,
+      notableFacts: finalNode.notableFacts,
+      citations: this.#mailboxDigestCitations(finalNode, context.metadata),
+      limitations: this.#mailboxDigestLimitations(context.job),
