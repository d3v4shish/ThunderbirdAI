+add_task(async function test_runtime_logs_schema_redaction_filter_and_export() {
+  await AIStorage.clearGeneratedData();
+  await AILocalModels.clearGeneratedData();
+  AIRuntimeLogging.clear();
+
+  const retrieval = await AIService.retrieveContext({
+    query: "Find mail from user@example.com about invoice 4111111111111111",
+    scopeMode: "all",
+    limit: 4,
+  });
+  Assert.equal(retrieval.status, "empty");
+
+  AIRuntimeLogging.recordTrace({
+    id: "trace-fallback",
+    type: "assistant",
+    status: "fallback",
+    fallbackUsed: true,
+    answerMode: "raw-llm",
+    sourceType: "openai-compatible",
+    model: "llama3.2:1b",
+    decisionReason:
+      "Endpoint failed after Thunderbird built the prompt and selected local fallback.",
+    request: JSON.stringify({
+      messages: [
+        {
+          role: "user",
+          content: "Prompt with user@example.com and Bearer secret-token.",
+        },
+      ],
+      retrievalSummary: {
+        retrievedRecordCount: 2,
+        contextBudget: {
+          includedCount: 2,
+          excludedCount: 1,
+          redacted: true,
+          finalPromptTokens: 128,
+          finalPromptBytes: 512,
+        },
+      },
+    }),
+    attempts: [
+      {
+        requestURL: "http://127.0.0.1:11434/v1/chat/completions",
+        httpStatus: 503,
+        errorMessage: "sk-secret-token",
+      },
+    ],
+    citations: [{ messageId: "message-1" }],
+  });
+
+  const logs = await AIService.getAIRuntimeLogs();
+  Assert.ok(
+    logs.some(
+      log => log.action == "retrieve-context" && log.category == "retrieval"
+    )
+  );
+  Assert.ok(
+    logs.some(
+      log =>
+        log.action == "backend-fallback" && log.requestId == "trace-fallback"
+    )
+  );
+
+  const retrievalLog = logs.find(log => log.action == "retrieve-context");
+  Assert.ok(
+    retrievalLog,
+    "Retrieval planning should emit a structured runtime log"
+  );
+  Assert.ok(retrievalLog.createdAt, "Runtime logs should capture timestamps");
+  Assert.ok(retrievalLog.requestId, "Runtime logs should capture request ids");
+  Assert.equal(retrievalLog.fields.query, "<redacted>");
+  Assert.ok(
+    !JSON.stringify(retrievalLog).includes("user@example.com"),
+    "Retrieval runtime logs should redact mailbox content"
+  );
+
+  const fallbackLog = logs.find(log => log.action == "backend-fallback");
+  Assert.ok(
+    fallbackLog,
+    "Fallback decisions should emit structured runtime logs"
+  );
+  Assert.equal(fallbackLog.backend, "openai-compatible");
+  Assert.equal(fallbackLog.fields.lastAttempt.errorMessage, "<redacted>");
+  Assert.ok(
+    !JSON.stringify(fallbackLog).includes("Prompt with"),
+    "Fallback runtime logs should not expose prompt content"
+  );
+
+  const filtered = await AIService.getAIRuntimeLogs({
+    action: "backend-fallback",
+    filter: "trace-fallback",
+  });
+  Assert.equal(filtered.length, 1);
+  Assert.equal(filtered[0].requestId, "trace-fallback");
+
+  const bundle = await AIService.exportDiagnosticBundle();
+  Assert.ok(
+    Array.isArray(bundle.runtimeLogs),
+    "Diagnostic bundle should include runtime logs"
+  );
+  Assert.ok(bundle.runtimeLogs.some(log => log.action == "backend-fallback"));
+  Assert.ok(
+    !JSON.stringify(bundle.runtimeLogs).includes("user@example.com"),
+    "Diagnostic bundle runtime logs should stay redacted"
+  );
+  Assert.ok(
+    !("assistantInspector" in bundle.runtime),
+    "Diagnostic exports should omit content-bearing Assistant inspector data"
+  );
+  Assert.ok(
+    !("runtimeInspectorTabs" in bundle.runtime),
+    "Diagnostic exports should omit content-bearing runtime inspector payloads"
+  );
+
+  const reset = await AIService.resetAssistantRuntime({
+    clearModelFiles: false,
+  });
+  Assert.equal(reset.status, "complete");
+  const resetLogs = await AIService.getAIRuntimeLogs();
+  Assert.ok(
+    resetLogs.some(log => log.action == "reset" && log.state == "complete")
+  );
+  Assert.ok(
+    !resetLogs.some(log => log.action == "backend-fallback"),
+    "Runtime reset should clear prior runtime logs before recording the reset event"
+  );
+});
