+  async clearDebugTraces(filter = {}) {
+    await AIStorage.init();
+    const normalizedType = normalizedConversationTraceType(filter.type || "");
+    if (normalizedType == "assistant") {
+      AIStorage.data.traces = AIStorage.data.traces.filter(trace => {
+        if (!isConversationTraceType(trace.type)) {
+          return true;
+        }
+        if (filter.accountKey && trace.accountKey != filter.accountKey) {
+          return true;
