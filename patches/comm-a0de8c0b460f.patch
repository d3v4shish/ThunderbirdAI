+function aiDebugJSON(value) {
+  if (!value || typeof value != "string") {
+    return null;
+  }
+  try {
+    return JSON.parse(value);
+  } catch {
+    return null;
+  }
+}
+
+function redactAIDebugString(value) {
+  return String(value)
+    .replace(/\bBearer\s+[A-Za-z0-9._~+/=-]+/gi, "Bearer <redacted>")
+    .replace(/\bsk-[A-Za-z0-9_-]{12,}\b/g, "<redacted-api-key>");
+}
+
+function redactAIDebugPayload(value, key = "") {
+  if (value == null) {
+    return value;
+  }
+  if (/authorization|api[_-]?key|token|secret|password/i.test(key)) {
+    return "<redacted>";
+  }
+  if (typeof value == "string") {
+    const parsed = aiDebugJSON(value);
+    return parsed
+      ? redactAIDebugPayload(parsed, key)
+      : redactAIDebugString(value);
+  }
+  if (Array.isArray(value)) {
+    return value.map(item => redactAIDebugPayload(item));
+  }
+  if (typeof value == "object") {
+    const redacted = {};
+    for (const [entryKey, entryValue] of Object.entries(value)) {
+      redacted[entryKey] = redactAIDebugPayload(entryValue, entryKey);
+    }
+    return redacted;
+  }
+  return value;
+}
+
+function aiDebugBytesLabel(bytes = 0) {
