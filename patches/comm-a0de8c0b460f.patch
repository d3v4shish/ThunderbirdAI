+      runtimeStatus?.attachmentScanRuntime?.enabled &&
+      !runtimeStatus.attachmentScanRuntime.autoUpdateEnabled;
+    for (const button of this.panel?.querySelectorAll(
+      "button[data-runtime-action]"
+    ) || []) {
+      const action = button.dataset.runtimeAction;
+      const doesNotNeedSelection = [
+        "open-debug",
+        "self-test",
+        "cancel-analysis-queue",
+        "fix-attachment-security",
+      ].includes(action);
+      if (action == "cancel-reanalysis") {
+        button.disabled = this._runtimeActionBusy || !activeJob;
+      } else if (action == "cancel-analysis-queue") {
+        button.disabled = this._runtimeActionBusy || !hasQueuedAnalysis;
+        button.hidden = !hasQueuedAnalysis;
+      } else if (action == "fix-attachment-security") {
+        button.disabled = this._runtimeActionBusy || !attachmentUpdatesDisabled;
+        button.hidden = !attachmentUpdatesDisabled;
+      } else if (doesNotNeedSelection) {
+        button.disabled = this._runtimeActionBusy;
+      } else {
+        button.disabled =
+          this._runtimeActionBusy ||
+          activeJob ||
+          (selectionRequired && !doesNotNeedSelection);
+      }
+    }
+    if (this.analysisArtifactSelect) {
+      this.analysisArtifactSelect.disabled =
+        this._runtimeActionBusy || activeJob || selectionRequired;
+    }
+    if (this.endpointGraphEnrichment) {
+      this.endpointGraphEnrichment.disabled =
+        this._runtimeActionBusy || activeJob || selectionRequired;
+    }
+    const visibleOnly =
+      this.ollamaUpgradeConfig({ persist: false }).visibleMode == "only";
+    const canUpgradeVisibleMessages =
+      visibleOnly && !!visibleAIMailMessageIds().length;
+    for (const button of this.panel?.querySelectorAll(
+      "button[data-runtime-action]"
+    ) || []) {
+      if (button.dataset.runtimeAction != "upgrade-with-ollama") {
