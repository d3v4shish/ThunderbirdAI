+    // sparse mailbox exposes only one entity. This is better than inventing a
+    // second endpoint-selected entity.
+    const fallback = selected[0]?.label || "mail evidence";
+    return {
+      from: fallback,
+      to: "unresolved related entity",
+      maxHops: 4,
+      source: "focused-evidence-fallback",
+    };
+  }
+  return {
+    from: selected[0].label,
+    to: selected[1].label,
+    maxHops: 4,
+    source: selected.map(item => item.source).join(","),
+  };
+}
