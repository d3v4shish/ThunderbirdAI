+      progressCalls,
+      0,
+      "The thread-pane header should not compute deep progress during a hot refresh"
+    );
+  } finally {
+    AIService.getRuntimeSnapshot = originalSnapshot;
+    AIService.getAnalysisProgress = originalProgress;
+  }
+});
