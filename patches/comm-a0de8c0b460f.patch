+      const runtimeBudget = lane.runtimeBudget || {};
+      const timeline = Array.isArray(lane.timeline) ? lane.timeline : [];
+      const repairReport = lane.repairReport || {};
+      const actions = Array.isArray(lane.actions)
+        ? lane.actions.map(action => action.label).join(" | ")
+        : "";
+      const queueDepth = queue.partitioned
+        ? queue.depth || 0
+        : queue.sharedDepth || 0;
+      const lines = [
+        `${lane.label} [${lane.health?.state || "unknown"}]`,
+        `  Queue depth: ${queueDepth}`,
+        `  Active operation: ${liveActivity.label || activeWork.label || "Idle"}`,
+        `  Active request: ${activeWork.requestId || "none"}`,
+        `  Last failure: ${lastFailure.message || "none"}`,
+        `  Backend: ${backend.summary || "unknown"}`,
+        `  Warm policy: ${runtimeBudget.warmSummary || "unknown"}`,
+        `  Budget: ${
+          runtimeBudget.memorySummary || "0 MB local"
+        } | ${runtimeBudget.concurrencySummary || "no dedicated cap"}`,
+      ];
+      if (timeline.length) {
+        lines.push("  Recent events:");
+        for (const event of timeline) {
+          lines.push(
+            `    ${event.at || "-"} [${event.severity || "info"}] ${
+              event.action || "event"
+            } | request ${event.requestId || "none"} | backend ${
+              event.backend || "unknown"
+            } | model ${event.modelId || "none"} | hint ${
+              event.repairHint || "none"
+            }`
+          );
+        }
+      } else {
+        lines.push("  Recent events: none recorded");
+      }
+      lines.push(
+        `  Repair report: ${
+          repairReport.summary || "copy-ready report unavailable"
+        }`
+      );
+      lines.push(`  Actions: ${actions || "none"}`);
