+      const msgHdr = gDBView.getMsgHdrAt(index);
+      if (msgHdr?.folder) {
+        ids.push(`${msgHdr.folder.URI}#${msgHdr.messageKey}`);
+      }
+    } catch {}
+  }
+  return [...new Set(ids)];
