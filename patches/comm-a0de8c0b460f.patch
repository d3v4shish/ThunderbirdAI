+    restartedScopes.push({
+      accountKey: scope?.accountKey || null,
+      folderURI: scope?.folderURI || null,
+      messageIds: Array.isArray(scope?.messageIds) ? [...scope.messageIds] : [],
+      force: !!options.force,
+    });
+  };
+
+  try {
+    about3Pane.restoreState({ folderURI: analysisFolder.URI });
+    await BrowserTestUtils.waitForCondition(
+      () => about3Pane.gFolder?.URI == analysisFolder.URI,
+      "The reanalysis folder should be visible"
+    );
+
+    const selectedResult = await AIService.reanalyzeMailScope({
+      messageIds: [targetId],
+    });
+    Assert.equal(selectedResult.queuedCount, 1);
+    Assert.equal(selectedResult.restarted, false);
+    Assert.deepEqual(requestedIds, [targetId]);
+    Assert.ok(
+      AIStorage.getMessage(targetId),
+      "Selected-message reanalysis should keep the stored record"
+    );
+
+    const folderResult = await AIService.reanalyzeMailScope({
+      accountKey: account.incomingServer.key,
+      folderURI: analysisFolder.URI,
+    });
+    Assert.equal(folderResult.restarted, true);
+    Assert.ok(
+      AIStorage.getMessage(targetId),
+      "Folder reanalysis should keep the stored record"
+    );
+    Assert.deepEqual(restartedScopes[0], {
+      accountKey: account.incomingServer.key,
+      folderURI: analysisFolder.URI,
+      messageIds: [],
+      force: true,
+    });
+
+    const accountResult = await AIService.reanalyzeMailScope({
+      accountKey: account.incomingServer.key,
+    });
+    Assert.equal(accountResult.restarted, true);
+    Assert.ok(
+      AIStorage.getMessage(targetId),
+      "Account reanalysis should keep the stored record"
+    );
+    Assert.deepEqual(restartedScopes[1], {
+      accountKey: account.incomingServer.key,
+      folderURI: null,
+      messageIds: [],
+      force: true,
+    });
+
+    const globalResult = await AIService.reanalyzeMailScope();
+    Assert.equal(globalResult.restarted, true);
+    Assert.ok(
+      AIStorage.getMessage(targetId),
+      "Global reanalysis should keep the stored record"
+    );
+    Assert.deepEqual(restartedScopes[2], {
+      accountKey: null,
+      folderURI: null,
+      messageIds: [],
+      force: true,
+    });
+  } finally {
+    AIService.requestAnalysis = originalRequestAnalysis;
+    AIService.startBackfill = originalStartBackfill;
+    await AIStorage.clearGeneratedData();
+  }
+});
