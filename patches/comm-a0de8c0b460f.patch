+function cancelDeferredAICardRendering(owner) {
+  if (!owner) {
+    return;
+  }
+  if (owner._deferredRenderTimer) {
+    clearTimeout(owner._deferredRenderTimer);
+    owner._deferredRenderTimer = null;
+  }
+  owner._deferredRenderToken = (owner._deferredRenderToken || 0) + 1;
+}
+
+function renderDeferredAICardSections(
+  owner,
+  sections = [],
+  { initialCount = 2, batchSize = 2, onProgress = null, onComplete = null } = {}
+) {
+  cancelDeferredAICardRendering(owner);
+  const token = owner._deferredRenderToken || 0;
+  let rendered = 0;
+  const renderBatch = limit => {
+    if ((owner._deferredRenderToken || 0) != token) {
+      return;
+    }
+    const target = Math.min(sections.length, rendered + limit);
+    while (rendered < target) {
+      sections[rendered++]();
+    }
+    if (rendered < sections.length) {
+      onProgress?.(rendered, sections.length);
+      owner._deferredRenderTimer = setTimeout(() => renderBatch(batchSize), 0);
+      return;
+    }
+    owner._deferredRenderTimer = null;
+    onComplete?.(rendered, sections.length);
+  };
+  renderBatch(Math.max(1, initialCount));
+}
