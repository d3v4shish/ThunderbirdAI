+async function yieldForAIPaneFirstPaint() {
+  await new Promise(resolve => {
+    let resolved = false;
+    const finish = () => {
+      if (resolved) {
+        return;
+      }
+      resolved = true;
+      clearTimeout(fallbackTimer);
+      resolve();
+    };
+    // requestAnimationFrame can be indefinitely throttled after a secondary
+    // window takes focus or while the main window is occluded. Pane loading
+    // must continue even when the compositor does not schedule a frame.
+    const fallbackTimer = setTimeout(finish, 50);
+    requestAnimationFrame(() => {
+      setTimeout(finish, 0);
+    });
+  });
+}
