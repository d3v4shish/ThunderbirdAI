+
+function runtimeLanePlacementState(roleRows = []) {
+  const states = roleRows
+    .map(row => String(row.state || "").trim())
+    .filter(Boolean);
+  if (!states.length) {
+    return "unknown";
+  }
+  if (states.every(state => state == "disabled")) {
+    return "disabled";
+  }
+  if (states.some(state => state == "failed")) {
+    return "failed";
+  }
+  if (states.some(state => state == "degraded")) {
+    return "degraded";
+  }
+  if (states.every(state => ["missing", "disabled"].includes(state))) {
+    return "missing";
+  }
+  if (states.some(state => state == "ready")) {
+    return "ready";
+  }
+  return states[0];
+}
