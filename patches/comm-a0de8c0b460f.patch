+    );
+    Services.prefs.setBoolPref("mail.ai.private_ml.gliner.enabled", true);
+    Services.prefs.setBoolPref(
+      "mail.ai.private_ml.modernbert_intent.enabled",
+      true
+    );
+
+    const requests = [];
+    AIPrivateModelExperiment.setTestFetch(async (url, options) => {
+      const request = JSON.parse(options.body);
+      requests.push({ url, request });
+      const text = request.input.text;
+      if (request.role == "gliner-entities") {
+        const entityText = "GLINER-ATLAS";
+        const start = text.indexOf(entityText);
+        return new Response(
+          JSON.stringify({
+            entities: [
+              {
+                text: entityText,
+                label: "project",
+                start,
+                end: start + entityText.length,
+                confidence: 0.92,
+              },
+            ],
+          }),
+          { status: 200 }
+        );
+      }
+      if (request.role == "modernbert-intent") {
+        return new Response(
+          JSON.stringify({
+            intent: { label: "job-hunt", confidence: 0.88 },
+          }),
+          { status: 200 }
+        );
+      }
+      return new Response("unexpected role", { status: 400 });
+    });
+
+    const { injection, folder, msgHdr } = await createTimelineTestMessage({
+      from: "Engineering Updates <updates@example.test>",
+      subject: "Weekly engineering notes",
+      body: [
+        "GLINER-ATLAS is in the internal delivery notes.",
+        "Contact finance-contact@private.test for the unreleased details.",
+      ].join("\r\n"),
+    });
+    folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    msgHdr.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    const messageId = `${folder.URI}#${msgHdr.messageKey}`;
+
+    try {
+      AIService.requestAnalysis(msgHdr, { force: true });
+      await TestUtils.waitForCondition(() => {
+        const record = AIStorage.getMessage(messageId);
+        return (
+          record?.privateEntityHints?.[0]?.text == "GLINER-ATLAS" &&
+          record?.privateIntentHint?.label == "job-hunt"
+        );
+      }, "waiting for private GLiNER and ModernBERT retrieval hints");
+
+      const record = AIStorage.getMessage(messageId);
+      Assert.equal(record.privateEntityHints[0].provenance, "private-gliner");
+      Assert.equal(record.privateIntentHint.provenance, "private-modernbert");
+      Assert.ok(record.retrievalEntityHints.includes("GLINER-ATLAS"));
+      Assert.ok(
+        !Object.values(record.extractedEntities || {})
+          .flat()
+          .includes("GLINER-ATLAS"),
+        "private entity hints must not become deterministic entity facts"
+      );
+      Assert.ok(
+        record.timelineStages.some(
+          stage =>
+            stage.id == "private-model-hints" &&
+            stage.engine == "private-loopback" &&
+            stage.status == "complete"
+        ),
+        "the private-model stage is visible in the analysis timeline"
+      );
+      Assert.equal(
+        record.category,
+        "job-hunt",
+        "a high-confidence ModernBERT hint routes novel mail without becoming evidence"
+      );
+      Assert.equal(requests.length, 2);
+      Assert.ok(
+        requests.every(
+          ({ request }) =>
+            !request.input.text.includes("finance-contact@private.test")
+        ),
+        "private model input must use the post-PII-safe text"
+      );
+
+      await TestUtils.waitForCondition(async () => {
+        const matches = await AIRAGIndex.search({
+          // SQLite's tokenizer splits the closed-vocabulary `job-hunt` label;
+          // `hunt` is absent from the fixture mail and proves the private hint
+          // reached the RAG search text.
+          query: "hunt",
+          scope: {
+            scopeMode: "folder",
+            accountKey: folder.server.key,
+            folderURI: folder.URI,
+          },
+        });
+        return matches.records.some(
+          candidate =>
+            candidate.messageKey == msgHdr.messageKey &&
+            candidate.retrievalMatch?.derivedHint === true &&
+            candidate.retrievalMatch?.text == ""
+        );
+      }, "waiting for the ModernBERT retrieval hint to reach the local RAG index");
+    } finally {
+      injection.teardownMessageInjection();
+      AIPrivateModelExperiment.setTestFetch(null);
+      Services.prefs.clearUserPref("mail.ai.private_ml.enabled");
+      Services.prefs.clearUserPref("mail.ai.private_ml.manifest_path");
+      Services.prefs.clearUserPref("mail.ai.private_ml.gliner.enabled");
+      Services.prefs.clearUserPref(
+        "mail.ai.private_ml.modernbert_intent.enabled"
+      );
+      await IOUtils.remove(PRIVATE_MODEL_ARTIFACT, { ignoreAbsent: true });
+      await IOUtils.remove(PRIVATE_MODEL_MANIFEST, { ignoreAbsent: true });
+      await AIStorage.clearGeneratedData();
+    }
+  }
