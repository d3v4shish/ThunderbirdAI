+            ? `Latency ${firstAttempt.durationMs} ms.`
+            : "",
+          endpointProbe.answer ? `Reply: ${endpointProbe.answer}` : ""
+        ).join(" ")
+      );
+      result.summary = `${sourceLabel} answered the Assistant probe.`;
+      result.runtimeStatus =
