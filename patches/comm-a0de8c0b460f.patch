+    const metadataById = new Map(
+      messageMetadata.map(metadata => [metadata.messageId, metadata])
+    );
+    const threads = new Map();
+    for (const [messageId, node] of messageNodes) {
+      const threadId = metadataById.get(messageId)?.threadId || messageId;
+      const nodes = threads.get(threadId) || [];
+      nodes.push(node);
+      threads.set(threadId, nodes);
+    }
