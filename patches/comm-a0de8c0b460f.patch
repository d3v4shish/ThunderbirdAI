--- /dev/null
+++ b/mail/components/ai/modules/AIModelDownloads.sys.mjs
@@ -0,0 +1,833 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AILocalModels } from "moz-src:///comm/mail/components/ai/modules/AILocalModels.sys.mjs";
+import { AIRuntimePaths } from "moz-src:///comm/mail/components/ai/modules/AIRuntimePaths.sys.mjs";
+import {
+  getModelCatalogEntry,
+  validateModelCatalogEntry,
+} from "moz-src:///comm/mail/components/ai/modules/AIModelCatalog.sys.mjs";
+
+const DEFAULT_DISK_SAFETY_MARGIN_BYTES = 250 * 1024 * 1024;
+const LOCAL_MODEL_RESOURCE_ROOT = "resource://thunderbird-ai-models/";
+const activeDownloads = new Map();
+let availableBytesProvider = null;
+
+function limitedString(value, maxChars = 400) {
+  return String(value ?? "")
+    .trim()
+    .slice(0, maxChars);
+}
+
+function safePathPart(value = "") {
+  return limitedString(value, 120).replace(/[^a-z0-9._-]/gi, "_") || "model";
+}
+
+function artifactSourcePath(artifact = {}) {
+  return limitedString(artifact.sourcePath || artifact.fileName, 1000);
+}
+
+function artifactPathSegments(artifact = {}) {
+  const parts = artifactSourcePath(artifact)
+    .split(/[\\/]+/)
+    .map(safePathPart)
+    .filter(Boolean);
+  return parts.length ? parts : [safePathPart(artifact.fileName)];
+}
+
+function artifactList(entry = {}) {
+  return Array.isArray(entry.artifacts) ? entry.artifacts : [];
+}
+
+function requiredBytesForEntry(entry = {}) {
+  const artifactBytes = artifactList(entry).reduce(
+    (sum, artifact) => sum + (Number(artifact.sizeBytes) || 0),
+    0
+  );
+  return artifactBytes || (Number(entry.sizeMB) || 0) * 1024 * 1024;
+}
+
+function artifactDownloadURL(entry = {}, artifact = {}) {
+  if (artifact.downloadURL) {
+    return artifact.downloadURL;
+  }
+  if (!artifact.sourcePath) {
+    return entry.downloadURL;
+  }
+  const baseURL = new URL(entry.downloadURL);
+  const marker = `/resolve/${entry.revision}/`;
+  const markerIndex = baseURL.pathname.indexOf(marker);
+  if (markerIndex < 0) {
+    return entry.downloadURL;
+  }
+  baseURL.pathname = `${baseURL.pathname.slice(
+    0,
+    markerIndex + marker.length
+  )}${artifact.sourcePath}`;
+  return baseURL.toString();
+}
+
+function binaryHashToHex(binary = "") {
+  return Array.from(binary, char =>
+    char.charCodeAt(0).toString(16).padStart(2, "0")
+  ).join("");
+}
+
+export function sha256HexForByteArray(bytes = []) {
+  const hash = Cc["@mozilla.org/security/hash;1"].createInstance(
+    Ci.nsICryptoHash
+  );
+  hash.init(hash.SHA256);
+  const byteArray = Uint8Array.from(bytes);
+  hash.update(byteArray, byteArray.length);
+  return binaryHashToHex(hash.finish(false));
+}
+
+function sha256HexForStream(stream) {
+  const hash = Cc["@mozilla.org/security/hash;1"].createInstance(
+    Ci.nsICryptoHash
+  );
+  hash.init(hash.SHA256);
+  hash.updateFromStream(stream, 0xffffffff);
+  return binaryHashToHex(hash.finish(false));
+}
+
+function fileInputStreamForPath(path = "") {
+  const file = Cc["@mozilla.org/file/local;1"].createInstance(Ci.nsIFile);
+  file.initWithPath(path);
+  const stream = Cc["@mozilla.org/network/file-input-stream;1"].createInstance(
+    Ci.nsIFileInputStream
+  );
+  stream.init(file, -1, 0, 0);
+  return stream;
+}
+
+function sha256HexForPath(path = "") {
+  const stream = fileInputStreamForPath(path);
+  try {
+    return sha256HexForStream(stream);
+  } finally {
+    stream.close();
+  }
+}
+
+function abortDownloadError() {
+  return new DOMException("Download aborted", "AbortError");
+}
+
+async function readStreamChunk(reader, signal = null) {
+  if (!signal) {
+    return reader.read();
+  }
+  if (signal.aborted) {
+    throw abortDownloadError();
+  }
+  let abort = null;
+  try {
+    return await Promise.race([
+      reader.read(),
+      new Promise((_resolve, reject) => {
+        abort = () => reject(abortDownloadError());
+        signal.addEventListener("abort", abort, { once: true });
+      }),
+    ]);
+  } finally {
+    if (abort) {
+      signal.removeEventListener("abort", abort);
+    }
+  }
+}
+
+function modelDirectory(modelId = "") {
+  return PathUtils.join(
+    AIRuntimePaths.modelCacheRootDir(),
+    safePathPart(modelId)
+  );
+}
+
+function runtimeModelPathSegments(sourceRepository = "") {
+  return limitedString(sourceRepository, 400)
+    .split(/[\\/]+/)
+    .map(safePathPart)
+    .filter(Boolean);
+}
+
+function legacyArtifactPath(modelId = "", artifact = {}) {
+  return PathUtils.join(
+    modelDirectory(modelId),
+    safePathPart(artifact.fileName)
+  );
+}
+
+function artifactPath(modelId = "", artifact = {}, sourceRepository = "") {
+  return PathUtils.join(
+    modelDirectory(modelId),
+    ...runtimeModelPathSegments(
+      sourceRepository || artifact.modelSourceRepository
+    ),
+    "resolve",
+    "main",
+    ...artifactPathSegments(artifact)
+  );
+}
+
+async function fileSize(path = "") {
+  try {
+    return (await IOUtils.stat(path)).size || 0;
+  } catch {
+    return 0;
+  }
+}
+
+async function pathExists(path = "") {
+  try {
+    return await IOUtils.exists(path);
+  } catch {
+    return false;
+  }
+}
+
+function entryForModel(model = {}, overrideEntry = null) {
+  const entry =
+    overrideEntry || getModelCatalogEntry(model.catalogId || model.id);
+  if (!entry) {
+    throw new Error("Local model has no downloadable catalog entry.");
+  }
+  const errors = validateModelCatalogEntry(entry);
+  if (errors.length) {
+    throw new Error(`Model catalog entry is invalid: ${errors.join("; ")}`);
+  }
+  return entry;
+}
+
+function applyCatalogMetadata(model = {}, entry = {}) {
+  const artifacts = artifactList(entry);
+  return {
+    ...model,
+    id: model.id || entry.id,
+    name: model.name || entry.name,
+    kind: model.kind || entry.kind,
+    engine: model.engine || entry.engine,
+    catalogId: entry.id,
+    backend: entry.backend,
+    license: entry.license,
+    revision: entry.revision,
+    downloadURL: entry.downloadURL,
+    sourceRepository: entry.sourceRepository || "",
+    modelHubRootUrl: entry.modelHubRootUrl || "",
+    modelHubUrlTemplate: entry.modelHubUrlTemplate || "",
+    modelFile:
+      entry.modelFile ||
+      artifacts[0]?.sourcePath ||
+      artifacts[0]?.fileName ||
+      "",
+    modelTaskName: entry.modelTaskName || "",
+    artifactSha256: artifacts[0]?.sha256 || "",
+    artifactFiles: artifacts.map(artifact => ({
+      fileName: artifact.fileName,
+      sourcePath: artifact.sourcePath || "",
+      downloadURL: artifact.downloadURL || artifactDownloadURL(entry, artifact),
+      sha256: artifact.sha256,
+      sizeBytes: Number(artifact.sizeBytes) || 0,
+    })),
+    sizeMB: Number(entry.sizeMB) || Number(model.sizeMB) || 0,
+    storageMB: Number(entry.sizeMB) || Number(model.storageMB) || 0,
+    cpu: entry.cpu !== false,
+    gpu: !!entry.gpu,
+    quantization: entry.quantization || model.quantization || "unknown",
+    recommended: !!entry.recommended,
+    optional: !!entry.optional,
+  };
+}
+
+async function setModelState(modelId = "", patch = {}) {
+  await AILocalModels.init();
+  const model = AILocalModels.getModel(modelId);
+  if (!model) {
+    throw new Error("Local model not found.");
+  }
+  return AILocalModels.saveModel({
+    ...model,
+    ...patch,
+  });
+}
+
+async function availableBytesForPath(path = "") {
+  if (availableBytesProvider) {
+    return availableBytesProvider(path);
+  }
+  try {
+    await IOUtils.makeDirectory(path, { ignoreExisting: true });
+    const file = Cc["@mozilla.org/file/local;1"].createInstance(Ci.nsIFile);
+    file.initWithPath(path);
+    return file.diskSpaceAvailable;
+  } catch {
+    return null;
+  }
+}
+
+async function removePartialArtifacts(modelId = "") {
+  await IOUtils.remove(modelDirectory(modelId), {
+    ignoreAbsent: true,
+    recursive: true,
+  });
+}
+
+function abortReasonFor(modelId = "") {
+  return activeDownloads.get(modelId)?.abortReason || "";
+}
+
+export const AIModelDownloads = {
+  modelDirectory,
+  artifactPath,
+  legacyArtifactPath,
+
+  localModelResourceRoot(modelId = "") {
+    if (!modelId) {
+      return LOCAL_MODEL_RESOURCE_ROOT;
+    }
+    return `${LOCAL_MODEL_RESOURCE_ROOT}${safePathPart(modelId)}/`;
+  },
+
+  runtimeModelId(sourceRepository = "", modelId = "") {
+    const normalizedRepository = limitedString(sourceRepository, 240);
+    if (normalizedRepository.includes("/")) {
+      return normalizedRepository;
+    }
+    return safePathPart(modelId || sourceRepository);
+  },
+
+  resolvedPaths() {
+    return {
+      modelCacheRootDir: AIRuntimePaths.modelCacheRootDir(),
+      tempRootDir: AIRuntimePaths.tempRootDir(),
+    };
+  },
+
+  setAvailableBytesProviderForTests(provider = null) {
+    availableBytesProvider = typeof provider == "function" ? provider : null;
+  },
+
+  async catalogEntryForModel(modelId = "", overrideEntry = null) {
+    await AILocalModels.init();
+    const model = AILocalModels.getModel(modelId);
+    if (!model && !overrideEntry) {
+      throw new Error("Local model not found.");
+    }
+    return entryForModel(model || { id: modelId }, overrideEntry);
+  },
+
+  async preflightModelDownload(
+    modelId = "",
+    {
+      catalogEntry = null,
+      safetyMarginBytes = DEFAULT_DISK_SAFETY_MARGIN_BYTES,
+    } = {}
+  ) {
+    await AILocalModels.init();
+    const model = AILocalModels.getModel(modelId);
+    if (!model) {
+      throw new Error("Local model not found.");
+    }
+    const entry = entryForModel(model, catalogEntry);
+    const directory = modelDirectory(model.id);
+    const requiredBytes = requiredBytesForEntry(entry);
+    const availableBytes = await availableBytesForPath(directory);
+    const neededBytes =
+      requiredBytes + Math.max(0, Number(safetyMarginBytes) || 0);
+    const ok = availableBytes === null || availableBytes >= neededBytes;
+    return {
+      modelId: model.id,
+      directory,
+      requiredBytes,
+      safetyMarginBytes: Math.max(0, Number(safetyMarginBytes) || 0),
+      neededBytes,
+      availableBytes,
+      ok,
+      state: ok ? "ok" : "insufficient-space",
+      warning: ok
+        ? ""
+        : `Insufficient disk space: ${neededBytes} bytes needed, ${availableBytes} available.`,
+    };
+  },
+
+  async downloadModel(
+    modelId = "",
+    { catalogEntry = null, skipPreflight = false } = {}
+  ) {
+    await AILocalModels.init();
