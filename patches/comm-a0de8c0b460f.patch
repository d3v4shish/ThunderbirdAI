+  async #attachmentDeepInspection(attachments = []) {
+    const base = attachmentDeepInspection(attachments);
+    if (!this.#attachmentScanner) {
+      return base;
+    }
+    const details = [];
+    for (const [index, attachment] of attachments.entries()) {
+      const started = Date.now();
+      const baseRow = base[index] || {};
+      try {
+        const result = (await this.#attachmentScanner(attachment)) || {};
+        details.push({
+          ...baseRow,
+          ...attachment,
+          ...result,
+          backend: result.backend || "test-scanner",
+          durationMs: result.durationMs ?? Date.now() - started,
+          verdict: result.verdict || baseRow.verdict || "unknown",
+        });
+      } catch (error) {
+        details.push({
+          ...baseRow,
+          ...attachment,
+          backend: "test-scanner",
+          verdict: "error",
+          durationMs: Date.now() - started,
+          error: error.message,
+        });
+      }
+    }
+    return details.length ? details : base;
+  }
