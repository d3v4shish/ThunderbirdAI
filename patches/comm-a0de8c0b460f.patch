--- /dev/null
+++ b/mail/components/ai/test/unit/test_ai_ingest_pipeline.js
@@ -0,0 +1,393 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+do_get_profile();
+
+const { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+const { AIEndpoint } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIEndpoint.sys.mjs"
+);
+const { AIStorage } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+);
+const { AIPIIRules } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIPIIRules.sys.mjs"
+);
+const { AIExtractionRules } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIExtractionRules.sys.mjs"
+);
+const { AITemplates } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AITemplates.sys.mjs"
+);
+const { MessageGenerator, SyntheticMessageSet } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/MessageGenerator.sys.mjs"
+);
+const { MessageInjection } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/MessageInjection.sys.mjs"
+);
+const { TestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/TestUtils.sys.mjs"
+);
+
+let gTimelineGenerator = null;
+let gTimelineInjection = null;
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  Services.prefs.setBoolPref("mail.ai.backfill.enabled", false);
+  Services.prefs.setBoolPref("mail.ai.embeddings.enabled", true);
+  Services.prefs.setBoolPref("mail.ai.endpoint.background", true);
+  // This test covers the pre-profile endpoint-first ingest contract. Keep it
+  // explicit so the Balanced local-first default is covered separately.
+  Services.prefs.setStringPref("mail.ai.pipeline.profile", "legacy");
+  await AIStorage.clearGeneratedData();
+  await AIExtractionRules.clearGeneratedData();
+  await AITemplates.clearGeneratedData();
+  await AIService.init();
+
+  registerCleanupFunction(async () => {
+    await AIService.uninit();
+    Services.prefs.clearUserPref("mail.ai.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.enabled");
+    Services.prefs.clearUserPref("mail.ai.embeddings.enabled");
+    Services.prefs.clearUserPref("mail.ai.endpoint.background");
+    Services.prefs.clearUserPref("mail.ai.pipeline.profile");
+    gTimelineInjection?.teardownMessageInjection();
+    gTimelineInjection = null;
+    gTimelineGenerator = null;
+    await AIStorage.clearGeneratedData();
+    await AIExtractionRules.clearGeneratedData();
+    await AITemplates.clearGeneratedData();
+  });
+});
+
+async function createTimelineTestMessage({
+  from = "Sender <sender@example.com>",
+  subject = "Timeline test message",
+} = {}) {
+  if (!gTimelineInjection) {
+    gTimelineGenerator = new MessageGenerator();
+    gTimelineInjection = new MessageInjection(
+      { mode: "local" },
+      gTimelineGenerator
+    );
+  }
+  const folder = gTimelineInjection.getInboxFolder();
+  const existingKeys = new Set(
+    [...folder.messages].map(msgHdr => msgHdr.messageKey)
+  );
+  const message = gTimelineGenerator.makeMessage({
+    from,
+    subject,
+  });
+  await gTimelineInjection.addSetsToFolders(
+    [folder],
+    [new SyntheticMessageSet([message])]
+  );
+  return {
+    injection: {
+      teardownMessageInjection() {},
+    },
+    folder,
+    msgHdr: [...folder.messages].find(
+      msgHdr => !existingKeys.has(msgHdr.messageKey)
+    ),
+  };
+}
+
+function assertStagePrecedes(stageIds, before, after, message) {
+  Assert.less(stageIds.indexOf(before), stageIds.indexOf(after), message);
+}
+
+add_task(
+  async function test_ingest_pipeline_enforces_deterministic_order_without_assistant() {
+    await AIStorage.clearGeneratedData();
+    await AIExtractionRules.clearGeneratedData();
+    await AITemplates.clearGeneratedData();
+    const operations = [];
+    let piiInput = "";
+    let assistantSummaryCalls = 0;
+    const originalTemplateEvaluate = AITemplates.evaluate;
+    const originalExtractionEvaluate = AIExtractionRules.evaluate;
+    const originalPIIEvaluateText = AIPIIRules.evaluateText;
+    const originalCanUseEndpoint = AIEndpoint.canUseEndpoint;
+    const originalEmbedText = AIEndpoint.embedText;
+    const originalSummarizeMessage = AIEndpoint.summarizeMessage;
+
+    AITemplates.evaluate = async () => {
+      operations.push({ type: "template" });
+      return {
+        matchedTemplateId: "template-contract",
+        matchedTemplateName: "Contract follow-up",
+        templateSlots: {
+          caseId: "CASE-4107",
+        },
+        extractedEntities: {
+          templateMarkers: ["CASE-4107"],
+        },
+        templateConfig: {
+          piiFields: ["contacts"],
+        },
+      };
+    };
+    AIExtractionRules.evaluate = async () => {
+      operations.push({ type: "extraction" });
+      return {
+        extractions: [
+          {
+            id: "rule-contact",
+            name: "Extracted contact",
+            value: "hidden.person@extracted.invalid",
+          },
+        ],
+        extractedEntities: {
+          contacts: ["hidden.person@extracted.invalid"],
+          invoiceIds: ["INV-4107"],
+        },
+      };
+    };
+    AIPIIRules.evaluateText = async text => {
+      piiInput = text;
+      operations.push({ type: "pii-policy", text });
+      return {
+        decision: "redact",
+        highestSeverity: "high",
+        redactedText: "Deterministic redaction output",
+        matches: [{ id: "deterministic-pii" }],
+      };
+    };
+    AIEndpoint.canUseEndpoint = (_accountKey, options = {}) =>
+      ["embedder", "summarizer"].includes(options.role);
+    AIEndpoint.embedText = async text => {
+      operations.push({ type: "endpoint-role", role: "embedder", text });
+      return [7, 4, 1];
+    };
+    AIEndpoint.summarizeMessage = async message => {
+      operations.push({
+        type: "endpoint-role",
+        role: "summarizer",
+        text: message.body,
+      });
+      return {
+        summary: "Endpoint summarizer finished after embeddings.",
+      };
+    };
+
+    const { injection, folder, msgHdr } = await createTimelineTestMessage({
+      from: "Billing <billing@example.com>",
+      subject: "Invoice review needed",
+    });
+    folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    msgHdr.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+
+    try {
+      const messageId = `${folder.URI}#${msgHdr.messageKey}`;
+      AIService.requestAnalysis(msgHdr);
+      await TestUtils.waitForCondition(
+        () => !!AIStorage.getMessage(messageId),
+        "waiting for deterministic ingest analysis"
+      );
+
+      const record = AIStorage.getMessage(messageId);
+      const stageIds = record.timelineStages.map(stage => stage.id);
+      const stageById = new Map(
+        record.timelineStages.map(stage => [stage.id, stage])
+      );
+      const embedderCall = operations.find(
+        operation =>
+          operation.type == "endpoint-role" && operation.role == "embedder"
+      );
+      const summarizerCall = operations.find(
+        operation =>
+          operation.type == "endpoint-role" && operation.role == "summarizer"
+      );
+
+      assertStagePrecedes(
+        stageIds,
+        "parser",
+        "template",
+        "parse/trust should complete before template work"
+      );
+      assertStagePrecedes(
+        stageIds,
+        "parser",
+        "security",
+        "parse/trust should complete before security work"
+      );
+      assertStagePrecedes(
+        stageIds,
+        "template",
+        "extraction",
+        "template work should precede extraction"
+      );
+      assertStagePrecedes(
+        stageIds,
+        "extraction",
+        "pii",
+        "extraction should finish before PII consumes extracted text"
+      );
+      assertStagePrecedes(
+        stageIds,
+        "security",
+        "embedding",
+        "embeddings should wait for security prerequisites"
+      );
+      assertStagePrecedes(
+        stageIds,
+        "pii",
+        "embedding",
+        "embeddings should wait for PII prerequisites"
+      );
+      assertStagePrecedes(
+        stageIds,
+        "embedding",
+        "summary",
+        "summary should remain the last ingest stage"
+      );
+
+      Assert.ok(
+        !stageIds.some(id => String(id).startsWith("assistant-")),
+        "ingest timelines should not require Assistant stages"
+      );
+      Assert.equal(
+        assistantSummaryCalls,
+        0,
+        "Assistant chat synthesis must not run during ingest"
+      );
+      Assert.ok(
+        piiInput.includes("hidden.person@extracted.invalid"),
+        "PII should consume extracted text when deterministic extraction produced it"
+      );
+      Assert.equal(
+        stageById.get("pii")?.detail?.inputSource,
+        "canonical+extracted",
+        "PII stage should declare its canonical plus extracted inputs"
+      );
+      Assert.equal(
+        stageById.get("embedding")?.detail?.inputSource,
+        "redacted",
+        "embedding stage should use the post-PII redacted text"
+      );
+      Assert.ok(
+        stageById.get("embedding")?.detail?.policyReady,
+        "embedding stage should record that policy prerequisites were satisfied"
+      );
+      Assert.equal(
+        embedderCall?.text,
+        "Deterministic redaction output",
+        "embedder should receive the final post-PII text"
+      );
+      Assert.equal(
+        summarizerCall?.text,
+        "Deterministic redaction output",
+        "summarizer should receive the same post-PII text"
+      );
+      Assert.deepEqual(
+        record.embedding,
+        [7, 4, 1],
+        "stored record should keep the post-policy embedding"
+      );
+      Assert.equal(
+        record.summarySource,
+        "endpoint",
+        "ingest summaries should use the configured background endpoint"
+      );
+      Assert.equal(
+        record.summary,
+        "Endpoint summarizer finished after embeddings.",
+        "summary should come from the endpoint after the deterministic prerequisites"
+      );
+    } finally {
+      injection.teardownMessageInjection();
+      AITemplates.evaluate = originalTemplateEvaluate;
+      AIExtractionRules.evaluate = originalExtractionEvaluate;
+      AIPIIRules.evaluateText = originalPIIEvaluateText;
+      AIEndpoint.canUseEndpoint = originalCanUseEndpoint;
+      AIEndpoint.embedText = originalEmbedText;
+      AIEndpoint.summarizeMessage = originalSummarizeMessage;
+      await AIStorage.clearGeneratedData();
+      await AIExtractionRules.clearGeneratedData();
+      await AITemplates.clearGeneratedData();
+    }
+  }
+);
+
+add_task(async function test_endpoint_embedding_failure_and_recovery() {
+  await AIStorage.clearGeneratedData();
+  const originalCanUseEndpoint = AIEndpoint.canUseEndpoint;
+  const originalEmbedText = AIEndpoint.embedText;
+  let endpointState = "healthy";
+  let endpointCalls = 0;
+  AIEndpoint.canUseEndpoint = (_accountKey, options = {}) =>
+    options.role == "embedder";
+  AIEndpoint.embedText = async () => {
+    endpointCalls++;
+    if (endpointState == "failed") {
+      throw new Error("synthetic embedding endpoint outage");
+    }
+    return endpointState == "recovered" ? [9, 8, 7] : [7, 4, 1];
+  };
+
+  const analyze = async subject => {
+    const { folder, msgHdr } = await createTimelineTestMessage({ subject });
+    const messageId = `${folder.URI}#${msgHdr.messageKey}`;
+    AIService.requestAnalysis(msgHdr);
+    await TestUtils.waitForCondition(
+      () =>
+        AIStorage.getMessage(messageId)?.timelineStages?.some(
+          stage => stage.id == "embedding"
+        ),
+      `waiting for embedding stage: ${subject}`
+    );
+    return { messageId, record: AIStorage.getMessage(messageId) };
+  };
+
+  Services.prefs.setStringPref("mail.ai.embeddings.mode", "endpoint-first");
+  Services.prefs.setBoolPref("mail.ai.endpoint.background", true);
+  try {
+    const healthy = await analyze("Healthy endpoint embedding");
+    Assert.deepEqual(healthy.record.embedding, [7, 4, 1]);
+    Assert.equal(
+      healthy.record.timelineStages.find(stage => stage.id == "embedding")
+        .engine,
+      "endpoint"
+    );
+
+    endpointState = "failed";
+    const failed = await analyze("Failed endpoint embedding");
+    Assert.equal(failed.record.embedding.length, 32);
+    Assert.equal(
+      failed.record.timelineStages.find(stage => stage.id == "embedding")
+        .status,
+      "fallback"
+    );
+
+    endpointState = "recovered";
+    const recovered = await analyze("Recovered endpoint embedding");
+    Assert.deepEqual(recovered.record.embedding, [9, 8, 7]);
+    Assert.deepEqual(
+      AIStorage.getMessage(healthy.messageId).embedding,
+      [7, 4, 1],
+      "Recovery must not delete an existing endpoint or fallback index"
+    );
+    Assert.equal(
+      AIStorage.getMessage(failed.messageId).embedding.length,
+      32,
+      "Recovery must retain deterministic fallback vectors"
+    );
+
+    Services.prefs.setBoolPref("mail.ai.endpoint.background", false);
+    const callsBeforeDisabledRun = endpointCalls;
+    const disabled = await analyze("Background endpoint disabled");
+    Assert.equal(disabled.record.embedding.length, 32);
+    Assert.equal(endpointCalls, callsBeforeDisabledRun);
+  } finally {
+    AIEndpoint.canUseEndpoint = originalCanUseEndpoint;
+    AIEndpoint.embedText = originalEmbedText;
+    Services.prefs.clearUserPref("mail.ai.embeddings.mode");
+    Services.prefs.setBoolPref("mail.ai.endpoint.background", true);
+    await AIStorage.clearGeneratedData();
+  }
+});
diff --git a/mail/components/ai/test/unit/test_ai_json_store.js b/mail/components/ai/test/unit/test_ai_json_store.js
new file mode 100644
--- /dev/null
+++ b/mail/components/ai/test/unit/test_ai_json_store.js
@@ -0,0 +1,109 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+do_get_profile();
+
+const {
+  clearJSONStoreRecoveryArchives,
+  getJSONStoreRecoveryInventory,
+  initRecoverableJSONStore,
+} = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIJSONStore.sys.mjs"
+);
+const { AIRuntimePaths } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIRuntimePaths.sys.mjs"
+);
+const { TestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/TestUtils.sys.mjs"
+);
+
+const TEST_STORE_ID = "unit-json-store";
+const TEST_PATH = PathUtils.join(
+  AIRuntimePaths.profileConfigRootDir(),
+  "unit-json-store.json"
+);
+
+function normalizeTestData(data = {}) {
+  if (data.fail) {
+    throw new Error("forced normalizer failure");
+  }
+  return {
+    version: 1,
+    value: Number(data.value) || 0,
+  };
+}
+
+add_setup(async function () {
+  await IOUtils.makeDirectory(AIRuntimePaths.profileConfigRootDir(), {
+    createAncestors: true,
+    ignoreExisting: true,
+  });
+  await IOUtils.remove(TEST_PATH, { ignoreAbsent: true });
+  await clearJSONStoreRecoveryArchives(TEST_STORE_ID);
+  registerCleanupFunction(async () => {
+    await IOUtils.remove(TEST_PATH, { ignoreAbsent: true });
+    await clearJSONStoreRecoveryArchives(TEST_STORE_ID);
+  });
+});
+
+add_task(async function test_invalid_json_is_archived_and_rewritten() {
+  await IOUtils.writeUTF8(TEST_PATH, "{ definitely invalid json");
+
+  const { jsonFile, recovery } = await initRecoverableJSONStore({
+    path: TEST_PATH,
+    storeId: TEST_STORE_ID,
+    owner: "Unit JSON store",
+    dataPostProcessor: normalizeTestData,
+  });
+
+  Assert.equal(jsonFile.data.version, 1);
+  Assert.equal(jsonFile.data.value, 0);
+  Assert.equal(recovery.reason, "read-failed");
+  Assert.ok(recovery.archivedPath, "invalid JSON should be archived");
+
+  await TestUtils.waitForCondition(async () => {
+    try {
+      const rewritten = await IOUtils.readJSON(TEST_PATH);
+      return rewritten?.version == 1 && rewritten?.value == 0;
+    } catch {
+      return false;
+    }
+  }, "waiting for recovered JSON store to be rewritten");
+
+  const inventory = await getJSONStoreRecoveryInventory();
+  const archive = inventory.archives.find(
+    item => item.storeId == TEST_STORE_ID
+  );
+  Assert.ok(
+    archive,
+    "recovery inventory should list the archived invalid file"
+  );
+  Assert.greater(archive.sizeBytes, 0);
+});
+
+add_task(async function test_normalizer_failures_are_archived_and_clearable() {
+  await clearJSONStoreRecoveryArchives(TEST_STORE_ID);
+  await IOUtils.writeUTF8(TEST_PATH, JSON.stringify({ fail: true, value: 9 }));
+
+  const { jsonFile, recovery } = await initRecoverableJSONStore({
+    path: TEST_PATH,
+    storeId: TEST_STORE_ID,
+    owner: "Unit JSON store",
+    dataPostProcessor: normalizeTestData,
+  });
+
+  Assert.equal(jsonFile.data.version, 1);
+  Assert.equal(jsonFile.data.value, 0);
+  Assert.equal(recovery.reason, "normalize-failed");
+  Assert.ok(
+    recovery.archivedPath,
+    "normalizer failures should archive the incompatible source file"
+  );
+
+  const inventory = await clearJSONStoreRecoveryArchives(TEST_STORE_ID);
+  Assert.equal(
+    inventory.archives.filter(item => item.storeId == TEST_STORE_ID).length,
+    0,
+    "store-scoped recovery archive clearing should remove archived files"
+  );
+});
