+  async #qrFindings(attachments = [], data = {}) {
+    if (!this.#qrDecoder) {
+      return [];
+    }
+    const findings = [];
+    const senderDomain = senderDomainFor(
+      data.analysis?.author || data.message?.author || ""
+    );
+    for (const attachment of attachments) {
+      const contentType = String(
+        attachment.contentType || ""
+      ).toLocaleLowerCase();
+      const isImage = contentType.startsWith("image/");
+      const isPDF =
+        contentType.includes("pdf") || /\.pdf$/i.test(attachment.name || "");
+      if (!isImage && !isPDF) {
+        continue;
+      }
+      const decoded = await this.#qrDecoder(attachment, {
+        source: isPDF ? "pdf" : "image",
+      });
+      for (const item of Array.isArray(decoded) ? decoded : []) {
+        const decodedURL = item.decodedURL || item.url || "";
+        const domain = item.domain || hostnameForURL(decodedURL);
+        findings.push({
+          source: isPDF ? "pdf" : "image",
+          attachmentName: attachment.name || "",
+          decodedURL,
+          domain,
+          page: item.page || "",
+          reputation: item.reputation || "unknown",
+          senderMismatch: !!domain && !!senderDomain && domain != senderDomain,
+        });
+      }
+    }
+    return findings;
+  }
