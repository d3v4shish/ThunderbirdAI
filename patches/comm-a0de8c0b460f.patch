+add_task(async function test_failed_cold_start_can_be_retried() {
+  await AIService.uninit();
+  const originalInit = AIStorage.init;
+  let attempts = 0;
+  AIStorage.init = async function (...args) {
+    attempts++;
+    if (attempts == 1) {
+      throw new Error("synthetic cold-profile storage failure");
+    }
+    return originalInit.apply(this, args);
+  };
+  try {
+    await Assert.rejects(
+      AIService.init(),
+      /synthetic cold-profile storage failure/,
+      "A cold-start storage failure should be reported to the caller"
+    );
+    await AIService.init();
+    const runtimeStatus = await AIService.getRuntimeStatus();
+    Assert.ok(
+      runtimeStatus.active,
+      "A second initialization attempt should work"
+    );
+    Assert.greaterOrEqual(
+      attempts,
+      2,
+      "Storage initialization should be retried after the synthetic failure"
+    );
+  } finally {
+    AIStorage.init = originalInit;
+    await AIService.uninit();
+    await AIService.init();
+  }
+});
