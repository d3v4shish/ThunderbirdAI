--- /dev/null
+++ b/mail/components/ai/test/unit/test_ai_backfill_priorities.js
@@ -0,0 +1,225 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+do_get_profile();
+
+const { MailServices } = ChromeUtils.importESModule(
+  "resource:///modules/MailServices.sys.mjs"
+);
+const { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+const { AIStorage } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+);
+const { TestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/TestUtils.sys.mjs"
+);
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  Services.prefs.setBoolPref("mail.ai.backfill.enabled", false);
+  Services.prefs.setStringPref("mail.ai.backfill.mode", "minimum");
+  await AIStorage.clearGeneratedData();
+
+  registerCleanupFunction(async () => {
+    await AIStorage.clearGeneratedData();
+    Services.prefs.clearUserPref("mail.ai.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.mode");
+    await AIService.uninit();
+  });
+});
+
+function makeRawMessage({
+  from = "Sender <sender@example.com>",
+  to = "Receiver <receiver@example.com>",
+  subject = "Backfill priority test",
+  date = "Tue, 08 Jul 2026 12:00:00 +0000",
+  messageId = "<backfill-priority@example.com>",
+  inReplyTo = "",
+  references = "",
+  body = subject,
+} = {}) {
+  return [
+    `From: ${from}`,
+    `To: ${to}`,
+    `Subject: ${subject}`,
+    `Date: ${date}`,
+    `Message-ID: ${messageId}`,
+    ...(inReplyTo ? [`In-Reply-To: ${inReplyTo}`] : []),
+    ...(references ? [`References: ${references}`] : []),
+    "MIME-Version: 1.0",
+    'Content-Type: text/plain; charset="UTF-8"',
+    "",
+    body,
+    "",
+  ].join("\r\n");
+}
+
+function addRawMessage(folder, rawMessage) {
+  const existingKeys = new Set(
+    [...folder.messages].map(msgHdr => msgHdr.messageKey)
+  );
+  folder.addMessage(rawMessage);
+  return [...folder.messages].find(
+    msgHdr => !existingKeys.has(msgHdr.messageKey)
+  );
+}
+
+function messageIdForHeader(msgHdr) {
+  return `${msgHdr.folder.URI}#${msgHdr.messageKey}`;
+}
+
+add_task(
+  async function test_backfill_prioritizes_selection_visible_thread_current_folder_and_recent_mail() {
+    await AIService.uninit();
+
+    const account = MailServices.accounts.createLocalMailAccount();
+    account.addIdentity(MailServices.accounts.createIdentity());
+    const rootFolder = account.incomingServer.rootFolder.QueryInterface(
+      Ci.nsIMsgLocalMailFolder
+    );
+    const inboxFolder = rootFolder
+      .createLocalSubfolder("BackfillPriorityInbox")
+      .QueryInterface(Ci.nsIMsgLocalMailFolder);
+    inboxFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    inboxFolder.setFlag(Ci.nsMsgFolderFlags.Inbox);
+    const currentFolder = rootFolder
+      .createLocalSubfolder("BackfillPriorityCurrent")
+      .QueryInterface(Ci.nsIMsgLocalMailFolder);
+    currentFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    const recentFolder = rootFolder
+      .createLocalSubfolder("BackfillPriorityRecent")
+      .QueryInterface(Ci.nsIMsgLocalMailFolder);
+    recentFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    const historyFolder = rootFolder
+      .createLocalSubfolder("BackfillPriorityHistory")
+      .QueryInterface(Ci.nsIMsgLocalMailFolder);
+    historyFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+
+    const threadRootHeader = addRawMessage(
+      currentFolder,
+      makeRawMessage({
+        subject: "Project thread",
+        date: "Mon, 07 Jul 2026 18:00:00 +0000",
+        messageId: "<thread-root@backfill.test>",
+        body: "Thread root in the current folder.",
+      })
+    );
+    const selectedHeader = addRawMessage(
+      currentFolder,
+      makeRawMessage({
+        subject: "Re: Project thread",
+        date: "Tue, 08 Jul 2026 09:00:00 +0000",
+        messageId: "<thread-selected@backfill.test>",
+        inReplyTo: "<thread-root@backfill.test>",
+        references: "<thread-root@backfill.test>",
+        body: "Selected reply in the visible thread.",
+      })
+    );
+    const currentFolderOtherHeader = addRawMessage(
+      currentFolder,
+      makeRawMessage({
+        subject: "Current folder follow-up",
+        date: "Mon, 07 Jul 2026 12:00:00 +0000",
+        messageId: "<current-folder@backfill.test>",
+        body: "Another message in the current folder.",
+      })
+    );
+    const inboxRecentHeader = addRawMessage(
+      inboxFolder,
+      makeRawMessage({
+        subject: "Inbox recent",
+        date: "Mon, 07 Jul 2026 10:00:00 +0000",
+        messageId: "<inbox-recent@backfill.test>",
+        body: "Recent inbox message.",
+      })
+    );
+    const recentFolderHeader = addRawMessage(
+      recentFolder,
+      makeRawMessage({
+        subject: "Recent outside inbox",
+        date: "Sun, 06 Jul 2026 15:00:00 +0000",
+        messageId: "<recent-folder@backfill.test>",
+        body: "Recent non-inbox message.",
+      })
+    );
+    const historyNewerHeader = addRawMessage(
+      historyFolder,
+      makeRawMessage({
+        subject: "Older history one",
+        date: "Mon, 08 Jan 2024 09:00:00 +0000",
+        messageId: "<history-newer@backfill.test>",
+        body: "Older account-wide history.",
+      })
+    );
+    const historyOlderHeader = addRawMessage(
+      historyFolder,
+      makeRawMessage({
+        subject: "Older history two",
+        date: "Fri, 01 Dec 2023 09:00:00 +0000",
+        messageId: "<history-older@backfill.test>",
+        body: "Deep historical message.",
+      })
+    );
+
+    Assert.equal(
+      selectedHeader.threadId,
+      threadRootHeader.threadId,
+      "The selected message and the visible thread root should share a thread id"
+    );
+
+    await AIStorage.clearGeneratedData();
+    await AIService.init();
+    AIService.setCurrentSelection({
+      accountKey: account.incomingServer.key,
+      folderURI: currentFolder.URI,
+      messageIds: [messageIdForHeader(selectedHeader)],
+    });
+
+    const expectedOrder = [
+      messageIdForHeader(selectedHeader),
+      messageIdForHeader(threadRootHeader),
+      messageIdForHeader(currentFolderOtherHeader),
+      messageIdForHeader(inboxRecentHeader),
+      messageIdForHeader(recentFolderHeader),
+      messageIdForHeader(historyNewerHeader),
+      messageIdForHeader(historyOlderHeader),
+    ];
+    const expectedIds = new Set(expectedOrder);
+    const completedOrder = [];
+    const observer = {
+      observe(subject, topic, data) {
+        if (
+          topic == "mail-ai-analysis-updated" &&
+          expectedIds.has(data) &&
+          !completedOrder.includes(data)
+        ) {
+          completedOrder.push(data);
+        }
+      },
+    };
+    Services.obs.addObserver(observer, "mail-ai-analysis-updated");
+
+    try {
+      await AIService.analyzeMailScope({
+        accountKey: account.incomingServer.key,
+      });
+      await TestUtils.waitForCondition(
+        () => completedOrder.length == expectedOrder.length,
+        "waiting for prioritized backfill to analyze the seeded mailbox"
+      );
+      Assert.deepEqual(
+        completedOrder,
+        expectedOrder,
+        "Account-wide backfill should finish selected, visible-thread, current-folder, inbox/recent, and only then historical messages"
+      );
+    } finally {
+      Services.obs.removeObserver(observer, "mail-ai-analysis-updated");
+      AIService.clearPendingAnalysisQueue();
+      await AIStorage.clearGeneratedData();
+      MailServices.accounts.removeAccount(account, false);
+    }
+  }
+);
