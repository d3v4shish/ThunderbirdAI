+
+var { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+var { AIStorage } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+);
+var { AIEndpoint } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIEndpoint.sys.mjs"
+);
+
+function configuredAssistantConfig() {
+  return {
+    provider: "source",
+    sourceId: "source-1",
+    sourceName: "LocalAI",
+    sourceType: "ollama",
+    sourceAvailable: true,
+    endpointURL: "http://127.0.0.1:11434/v1/chat/completions",
+    model: "llama3",
+    background: false,
+    allowCloud: false,
+    enabled: true,
+  };
+}
+
+registerCleanupFunction(async () => {
+  Services.prefs.clearUserPref("mail.ai.enabled");
+  for (const tag of [
+    "ai-done",
+    "ai-follow-up",
+    "ai-important",
+    "ai-needs-reply",
+    "ai-newsletter",
+    "ai-receipt",
+    "ai-suspicious",
+    "ai-waiting",
+  ]) {
+    for (const suffix of ["tag", "color"]) {
+      const pref = `mailnews.tags.${tag}.${suffix}`;
+      if (Services.prefs.prefHasUserValue(pref)) {
+        Services.prefs.clearUserPref(pref);
+      }
+    }
+  }
+  await AIService.clearGeneratedData();
