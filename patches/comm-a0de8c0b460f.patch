+  }
+
+  const originalGetConfig = AIEndpoint.getConfig;
+  const originalRerank = AIEndpoint.rerank;
+  const originalSemanticSearch = AIStorage.semanticSearch;
+  let rerankInput = null;
+  AIStorage.semanticSearch = () => [
+    {
+      accountKey: "server1",
+      folderURI: "folder://learned",
+      messageKey: 1,
+      score: 1,
+      lexicalScore: 1,
+    },
