+  const recentEvents = Array.isArray(lane.timeline) ? lane.timeline : [];
+  const recommendedActions = (lane.actions || [])
+    .filter(action => action.enabled !== false)
+    .map(action => action.label);
+  const lines = [
+    "Redacted runtime repair report",
+    `Generated: ${new Date().toISOString()}`,
+    `Lane: ${lane.label || lane.id || "Unknown lane"}`,
+    `Health: ${lane.health?.state || "unknown"}`,
+    `Queue depth: ${runtimeLaneQueueDepth(lane.queue || {})}`,
+    `Active operation: ${
+      lane.liveActivity?.label || lane.activeWork?.label || "Idle"
+    }`,
+    `Active request: ${lane.activeWork?.requestId || "none"}`,
+    `Last failure: ${redactedSecurityString(lane.lastFailure?.message || "none")}`,
+    `Backend: ${redactedSecurityString(lane.backendIdentity?.summary || "unknown")}`,
+    `Warm policy: ${redactedSecurityString(
+      lane.runtimeBudget?.warmSummary || "unknown"
+    )}`,
+    `Budget: ${redactedSecurityString(budgetSummary || "no dedicated budget")}`,
+    "Recent events:",
+    ...(recentEvents.length
+      ? recentEvents.map(
+          event =>
+            `- ${event.at || "-"} [${event.severity}] action=${redactedSecurityString(
+              event.action || "event"
+            )}; request=${redactedSecurityString(
+              event.requestId || "none"
+            )}; backend=${redactedSecurityString(
+              event.backend || "unknown"
+            )}; model=${redactedSecurityString(
+              event.modelId || "none"
+            )}; repair=${redactedSecurityString(event.repairHint || "none")}`
