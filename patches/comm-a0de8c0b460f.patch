+add_task(
+  async function test_bulk_persistence_checkpoints_bound_full_store_writes() {
+    await AIStorage.clearGeneratedData();
+    Assert.equal(
+      AIStorage.getPersistenceStatus().checkpointMessages,
+      1000,
+      "row-level SQLite writes should checkpoint every 1,000 messages"
+    );
+    const originalSaveSoon = AIStorage._jsonFile.saveSoon;
+    let scheduledSaves = 0;
+    AIStorage._jsonFile.saveSoon = () => scheduledSaves++;
+    const token = AIStorage.beginBulkPersistence("test-2500-message-backfill", {
+      checkpointMessages: 1000,
+      checkpointIntervalMs: 60000,
+    });
+
+    try {
+      for (let batchStart = 0; batchStart < 2500; batchStart += 5) {
+        AIStorage.beginBatch();
+        try {
+          for (let index = batchStart; index < batchStart + 5; index++) {
+            AIStorage.setMessage(`folder://bulk#${index}`, {
+              accountKey: "server1",
+              folderURI: "folder://bulk",
+              messageKey: index,
+              subject: `Bulk message ${index}`,
+            });
+            AIStorage.noteBulkPersistenceProgress(1);
+          }
+        } finally {
+          AIStorage.endBatch();
+        }
+      }
+
+      Assert.equal(
+        scheduledSaves,
+        2,
+        "2,500 records should schedule only the 1,000 and 2,000 record checkpoints"
+      );
+      const activeStatus = AIStorage.getPersistenceStatus();
+      Assert.equal(activeStatus.pendingItems, 500);
+      Assert.equal(activeStatus.checkpoints, 2);
+      Assert.greater(
+        activeStatus.suppressedWrites,
+        400,
+        "small worker batches should be absorbed by the bulk persistence session"
+      );
+
+      AIStorage.endBulkPersistence(token);
+      Assert.equal(
+        scheduledSaves,
+        3,
+        "ending the bulk job should flush the final 500 records exactly once"
+      );
+      const finishedStatus = AIStorage.getPersistenceStatus();
+      Assert.ok(!finishedStatus.bulkActive);
+      Assert.equal(finishedStatus.pendingItems, 0);
+      Assert.equal(finishedStatus.checkpoints, 3);
+
+      AIStorage.setMessage("folder://bulk#after", {
+        accountKey: "server1",
+        folderURI: "folder://bulk",
+        messageKey: 2501,
+        subject: "Normal foreground update",
+      });
+      Assert.equal(
+        scheduledSaves,
+        4,
+        "normal foreground writes should resume after the bulk session"
+      );
+    } finally {
+      AIStorage.endBulkPersistence(token);
+      AIStorage._jsonFile.saveSoon = originalSaveSoon;
+    }
+  }
+);
