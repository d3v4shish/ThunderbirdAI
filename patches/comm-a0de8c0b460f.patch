+add_task(async function test_uninit_waits_for_in_flight_analysis() {
+  await AIStorage.clearGeneratedData();
+  const hadPipelineProfile = Services.prefs.prefHasUserValue(
+    "mail.ai.pipeline.profile"
+  );
+  const originalPipelineProfile = Services.prefs.getStringPref(
+    "mail.ai.pipeline.profile",
+    ""
+  );
+  const originalCanUseEndpoint = AIEndpoint.canUseEndpoint;
+  const originalEmbedText = AIEndpoint.embedText;
+  let embeddingStartedResolve;
+  const embeddingStarted = new Promise(resolve => {
+    embeddingStartedResolve = resolve;
+  });
+  let embeddingAborted = false;
+  let serviceRestarted = false;
+
+  Services.prefs.setStringPref("mail.ai.pipeline.profile", "legacy");
+  Services.prefs.setStringPref("mail.ai.embeddings.mode", "endpoint-first");
+  Services.prefs.setBoolPref("mail.ai.endpoint.background", true);
+  AIEndpoint.canUseEndpoint = (_accountKey, options = {}) =>
+    options.role == "embedder";
+  AIEndpoint.embedText = async (_text, _accountKey, { signal } = {}) =>
+    new Promise((_resolve, reject) => {
+      const abort = () => {
+        embeddingAborted = true;
+        reject(new DOMException("Analysis stopped.", "AbortError"));
+      };
+      if (signal?.aborted) {
+        abort();
+      } else {
+        signal?.addEventListener("abort", abort, { once: true });
+      }
+      embeddingStartedResolve();
+    });
+
+  const { injection, folder, msgHdr } = await createTimelineTestMessage({
+    from: "Lifecycle <lifecycle@example.com>",
+    subject: "Stop the in-flight embedding",
+  });
+  folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+  msgHdr.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+
+  try {
+    Assert.ok(AIService.requestAnalysis(msgHdr, { force: true }));
+    await embeddingStarted;
+
+    await AIService.uninit();
+
+    Assert.ok(
+      embeddingAborted,
+      "Service shutdown should abort the in-flight endpoint operation"
+    );
+    const runtime = await AIService.getRuntimeSnapshot(folder.server.key);
+    Assert.ok(
+      !runtime.processing,
+      "Shutdown should settle the processing loop"
+    );
+    Assert.equal(
+      runtime.activeWorkers,
+      0,
+      "Shutdown should not retain workers from the previous generation"
+    );
+
+    await AIService.init();
+    serviceRestarted = true;
+    const restartedRuntime = await AIService.getRuntimeSnapshot(
+      folder.server.key
+    );
+    Assert.ok(
+      !restartedRuntime.processing && !restartedRuntime.activeWorkers,
+      "A new service generation should start without stale analysis state"
+    );
+  } finally {
+    AIEndpoint.canUseEndpoint = originalCanUseEndpoint;
+    AIEndpoint.embedText = originalEmbedText;
+    Services.prefs.clearUserPref("mail.ai.embeddings.mode");
+    Services.prefs.clearUserPref("mail.ai.endpoint.background");
+    if (hadPipelineProfile) {
+      Services.prefs.setStringPref(
+        "mail.ai.pipeline.profile",
+        originalPipelineProfile
+      );
+    } else {
+      Services.prefs.clearUserPref("mail.ai.pipeline.profile");
+    }
+    if (!serviceRestarted) {
+      await AIService.init();
+    }
+    injection.teardownMessageInjection();
+    await AIStorage.clearGeneratedData();
+  }
+});
