+  #miningStatusSnapshot(accountKey = "global") {
+    const allAccounts = accountKey == MINING_ALL_ACCOUNTS_KEY;
+    const normalizedAccountKey = allAccounts
+      ? MINING_ALL_ACCOUNTS_KEY
+      : this.#normalizedMiningAccountKey(accountKey);
+    const mining = this.#miningData();
+    const candidates = this.#miningCandidates(normalizedAccountKey);
+    const rematchJobs = Object.values(mining.rematchJobs || {})
+      .filter(job => allAccounts || job.accountKey == normalizedAccountKey)
+      .map(job => {
+        const candidate = mining.candidates[job.candidateId] || null;
+        return {
+          ...job,
+          candidateLabel: candidate?.label || candidate?.id || "",
+          progressDetail: miningRematchProgressDetail(job),
+        };
+      })
+      .sort((left, right) => {
+        const stateRank = value => {
+          switch (value) {
+            case "running":
+              return 0;
+            case "queued":
+              return 1;
+            case "paused":
+              return 2;
+            case "complete":
+            default:
+              return 3;
+          }
+        };
+        const rankDelta = stateRank(left.state) - stateRank(right.state);
+        if (rankDelta) {
+          return rankDelta;
+        }
+        return String(left.id || "").localeCompare(String(right.id || ""));
+      });
+    const activeRematchJob =
+      rematchJobs.find(job => job.id == mining.activeRematchJobId) ||
+      rematchJobs.find(job => job.state == "running") ||
+      null;
+    return {
+      accountKey: normalizedAccountKey,
+      candidates,
+      suggestedTemplates: candidates.filter(
+        candidate =>
+          candidate.type == "template" && candidate.state == "suggested"
+      ),
+      suggestedExtractionRules: candidates.filter(
+        candidate =>
+          candidate.type == "extraction-rule" && candidate.state == "suggested"
+      ),
+      shadowCandidateCount: candidates.filter(
+        candidate => candidate.state == "shadow"
+      ).length,
+      suggestedCandidateCount: candidates.filter(
+        candidate => candidate.state == "suggested"
+      ).length,
+      rematchJobs,
+      activeRematchJob,
+      queuedRematchJobs: rematchJobs.filter(job =>
+        ["queued", "paused"].includes(job.state)
