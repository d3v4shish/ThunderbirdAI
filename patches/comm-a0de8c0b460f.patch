+  async runLocalModelSmokeTests({ modelIds = [] } = {}) {
+    await AILocalModels.init();
+    const selectedIds = new Set(arrayValues(modelIds, 50));
+    const roleAssignments = AILocalModels.getRoleAssignments();
+    const models = AILocalModels.listModels().filter(model => {
+      return !selectedIds.size || selectedIds.has(model.id);
+    });
+    return models.map(model => ({
+      ...modelSmokeTestRow(model, roleAssignments),
+      durationMs: 0,
+      state: "retired",
+      failureReason:
+        "Legacy local model execution is retired. Configure an Assistant endpoint instead.",
+    }));
+  }
+
+  async recordAIAnswerFeedback(feedback = {}) {
+    await AIStorage.init();
+    const entry = {
+      feature: String(feedback.feature || "assistant").slice(0, 80),
+      answerId: String(feedback.answerId || feedback.traceId || "").slice(
+        0,
+        120
+      ),
+      traceId: String(feedback.traceId || "").slice(0, 120),
+      messageId: String(feedback.messageId || "").slice(0, 800),
+      rating: String(feedback.rating || "").slice(0, 40),
+      issue: String(feedback.issue || "").slice(0, 80),
+      note: String(feedback.note || "").slice(0, 1000),
+      at: new Date().toISOString(),
+    };
+    AIStorage.recordAction("ai-answer-feedback", entry);
+    return entry;
+  }
+
+  async exportDiagnosticBundle() {
+    await AIStorage.init();
+    await AILocalModels.init();
+    await AISources.init();
+    const runtime = await this.getRuntimeSnapshot(null);
+    const governance = await this.getDataGovernanceData();
+    const assistantInspector = runtime.assistantInspector;
+    const diagnosticRuntime = { ...runtime };
+    delete diagnosticRuntime.assistantInspector;
+    delete diagnosticRuntime.runtimeInspectorTabs;
+    const lastAssistantTurn = assistantInspector?.lastCompletedTurn || null;
+    const bundle = {
+      version: 1,
+      generatedAt: new Date().toISOString(),
+      redacted: true,
+      exportPath: AIRuntimePaths.diagnosticBundlePath(),
+      runtime: redactedSecurityValue(diagnosticRuntime),
+      assistantActivity: lastAssistantTurn
+        ? {
+            id: limitedString(lastAssistantTurn.id, 120),
+            status: limitedString(lastAssistantTurn.status, 40),
+            stage: limitedString(lastAssistantTurn.stage, 80),
+            route: limitedString(lastAssistantTurn.route, 80),
+            answerMode: limitedString(lastAssistantTurn.answerMode, 80),
+            usedEndpoint: !!lastAssistantTurn.usedEndpoint,
+            fallbackUsed: !!lastAssistantTurn.fallbackUsed,
+            citationCount: Array.isArray(lastAssistantTurn.citations)
+              ? lastAssistantTurn.citations.length
+              : 0,
+            startedAt: limitedString(lastAssistantTurn.startedAt, 80),
+            finishedAt: limitedString(lastAssistantTurn.finishedAt, 80),
+            endpoint: redactedSecurityValue({
+              sourceId: lastAssistantTurn.endpoint?.sourceId || "",
+              sourceName: lastAssistantTurn.endpoint?.sourceName || "",
+              sourceType: lastAssistantTurn.endpoint?.sourceType || "",
+              provider: lastAssistantTurn.endpoint?.provider || "",
+              model: lastAssistantTurn.endpoint?.model || "",
+              endpointURL: lastAssistantTurn.endpoint?.endpointURL || "",
+            }),
+          }
+        : null,
+      sources: redactedSecurityValue(
+        AISources.getSources().map(source => ({
+          id: source.id,
+          name: source.name,
+          type: source.type,
+          endpointURL: source.endpointURL,
+          model: source.model,
+          allowCloud: !!source.allowCloud,
+          background: !!source.background,
+        }))
+      ),
+      localModels: redactedSecurityValue(AILocalModels.listModels()),
+      runtimeLogs: redactedSecurityValue(AIRuntimeLogging.getLogs()),
+      recentTraces: redactedSecurityValue(AIStorage.getRecentTraces(20)),
+      storageArtifacts: redactedSecurityValue(governance.artifacts || []),
+      healthDashboard: redactedSecurityValue(governance.healthDashboard || []),
+      traceSchema: await this.validateRecentAITraces(20),
+      heavyWorkPolicy: this.getHeavyWorkPolicy(),
+    };
+    await IOUtils.writeUTF8(bundle.exportPath, JSON.stringify(bundle, null, 2));
+    return bundle;
+  }
