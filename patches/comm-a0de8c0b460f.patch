+            </html:div>
+          </html:summary>
+          <html:div class="ai-extraction-advanced-body">
+            <hbox align="center" class="input-container wrap-container ai-rule-field">
+              <label data-l10n-id="ai-summaries-mode-label"
+                     control="aiSummaryMode"/>
+              <menulist id="aiSummaryMode"
+                        flex="1"
+                        oncommand="gGeneralPane.saveAISummaryMode();">
+                <menupopup>
+                  <menuitem value="endpoint-first"
+                            data-l10n-id="ai-processing-fallback-endpoint"/>
+                  <menuitem value="deterministic-only"
+                            data-l10n-id="ai-summaries-mode-local"/>
+                </menupopup>
