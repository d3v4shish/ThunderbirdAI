+    .toLocaleLowerCase();
+}
+
+function textMatchesTerms(text = "", terms = []) {
+  if (!terms.length) {
+    return false;
+  }
+  return terms.every(term => String(text || "").includes(term));
+}
+
+function localEmbedding(text = "") {
+  const vector = new Array(32).fill(0);
+  for (const word of String(text).toLocaleLowerCase().split(/\W+/u)) {
+    if (word.length < 3) {
+      continue;
+    }
+    let hash = 0;
+    for (let i = 0; i < word.length; i++) {
+      hash = (hash * 31 + word.charCodeAt(i)) >>> 0;
+    }
+    vector[hash % vector.length]++;
+  }
+  return vector;
+}
+
+async function queryEmbeddingFor(prompt = "", accountKey = null) {
+  if (!getBoolPref("mail.ai.embeddings.enabled", true)) {
+    return null;
+  }
+  const hasDedicatedSource = Services.prefs.prefHasUserValue(
+    "mail.ai.embedder.source_id"
+  );
+  const sourceId = getStringPref("mail.ai.embedder.source_id", "").trim();
+  if (!hasDedicatedSource || !sourceId) {
+    return {
+      embedding: localEmbedding(prompt),
+      model: LOCAL_EMBEDDING_MODEL,
+      sourceId: "",
+    };
+  }
+  try {
+    const config = AIEndpoint.getConfig(accountKey, {
+      role: "embedder",
+      sourceId,
+    });
+    const embedding = await AIEndpoint.embedText(
+      String(prompt || "").slice(0, 6000),
+      accountKey,
+      { role: "embedder", sourceId }
+    );
+    if (Array.isArray(embedding) && embedding.length) {
+      return {
+        embedding,
+        model: String(config.model || config.sourceId || sourceId),
+        sourceId: String(config.sourceId || sourceId),
+      };
+    }
+  } catch {}
+  return {
+    embedding: localEmbedding(prompt),
+    model: LOCAL_EMBEDDING_MODEL,
+    sourceId: "",
+  };
+}
+
+function retrievalQueryState(prompt, rollout) {
+  const constraints = assistantQueryConstraints(prompt);
+  const basePlan = assistantQueryPlan(prompt);
+  const hasAuthoritativeIdentifier = Boolean(constraints.identifiers.length);
+  const hasHardConstraints = Boolean(
+    hasAuthoritativeIdentifier ||
+    constraints.amounts.length ||
+    constraints.dates.length
+  );
+  let intent = basePlan.intent;
+  if (hasAuthoritativeIdentifier) {
+    intent = "exact_lookup";
+  } else if (hasHardConstraints) {
+    intent = "constrained_lookup";
+  }
+  const retrievalQuery = retrievalSearchQueryFor(prompt);
+  const adaptivePlan = rollout.adaptive
+    ? adaptiveRetrievalPlan(prompt, retrievalQuery, hasHardConstraints)
+    : {
+        applied: false,
+        reason: `rollout-stage-${rollout.stage}`,
+        searchBudget: 1,
+        scopeLocked: true,
+        queries: retrievalQuery ? [retrievalQuery] : [],
+      };
+  return {
+    constraints,
+    hasAuthoritativeIdentifier,
+    hasHardConstraints,
+    retrievalQuery,
+    adaptivePlan,
+    plan: {
+      ...basePlan,
+      version: RAG_QUERY_CONTRACT_VERSION,
+      intent,
+      constraints,
+      adaptive: {
+        applied: adaptivePlan.applied,
+        reason: adaptivePlan.reason,
+        searchBudget: adaptivePlan.searchBudget,
+        scopeLocked: adaptivePlan.scopeLocked,
+        queries: adaptivePlan.queries.slice(),
+      },
+    },
+  };
+}
+
+async function runAdaptiveRetrievalSearches({
+  adaptivePlan,
+  hasHardConstraints,
+  rollout,
+  scope,
+}) {
+  const semanticCandidates = [];
+  const lexicalCandidates = [];
+  const resultLists = [];
+  const searches = [];
+  if (hasHardConstraints) {
+    return {
+      semanticCandidates,
+      lexicalCandidates,
+      searchResults: [],
+      searches,
+      lexicalDiagnostics: null,
+    };
+  }
+  for (let index = 0; index < adaptivePlan.queries.length; index++) {
+    const query = adaptivePlan.queries[index];
+    const startedAt = Date.now();
+    const queryEmbeddingRun = rollout.dense
+      ? await queryEmbeddingFor(query, scope.accountKey)
+      : null;
+    const queryEmbedding = queryEmbeddingRun?.embedding || null;
+    const queryEmbeddingModel = queryEmbeddingRun?.model || "";
+    const queryEmbeddingSourceId = queryEmbeddingRun?.sourceId || "";
+    const semanticResults = rollout.dense
+      ? AIStorage.semanticSearch(
+          query,
+          scope.accountKey,
+          MAX_LOCAL_SEARCH_RESULTS,
+          scope,
+          queryEmbedding,
+          {
+            embeddingModel: queryEmbeddingModel,
+            embeddingSourceId: queryEmbeddingSourceId,
+          }
+        )
+      : [];
+    let lexicalRecords = [];
+    let lexicalDiagnostics = null;
+    try {
+      const lexicalSearch = await AIRAGIndex.search({
+        query,
+        queryEmbedding,
+        queryEmbeddingModel,
+        queryEmbeddingSourceId,
+        scope,
+        limit: MAX_LOCAL_SEARCH_RESULTS,
+      });
+      lexicalRecords = lexicalSearch.records;
+      lexicalDiagnostics = lexicalSearch.diagnostics;
+    } catch (error) {
+      lexicalDiagnostics = {
+        backend: "memory",
+        mode: "lexical-fallback",
+        resultCount: 0,
+        error: compactString(error?.message || error, 240),
+      };
+    }
+    semanticCandidates.push(...semanticResults);
+    lexicalCandidates.push(...lexicalRecords);
+    const fused = reciprocalRankFusion(
+      semanticResults,
+      lexicalRecords,
+      MAX_LOCAL_SEARCH_RESULTS
+    );
+    resultLists.push(fused);
+    searches.push({
+      index: index + 1,
+      query: compactString(query, 240),
+      semanticCandidateCount: semanticResults.length,
+      lexicalCandidateCount: lexicalRecords.length,
+      fusedCandidateCount: fused.length,
+      durationMs: Math.max(0, Date.now() - startedAt),
+      stopReason:
+        index + 1 == adaptivePlan.queries.length
+          ? "plan-complete"
+          : "continue-to-next-facet",
+      lexical: lexicalDiagnostics,
+    });
+  }
+  return {
+    semanticCandidates,
+    lexicalCandidates,
+    searchResults: fuseAdaptiveSearchResults(
+      resultLists,
+      MAX_LOCAL_SEARCH_RESULTS
+    ),
+    searches,
+    lexicalDiagnostics: searches[0]?.lexical || null,
+  };
+}
+
+async function authoritativeRetrieval({
+  constraints,
+  hasHardConstraints,
+  scope,
+  scopeRecords,
+}) {
+  if (!hasHardConstraints) {
+    return { records: [], diagnostics: null };
+  }
+  try {
+    const exactSearch = await AIRAGIndex.searchExact({
+      constraints,
+      scope,
+      limit: MAX_LOCAL_SEARCH_RESULTS,
+    });
+    const records = exactSearch.records
+      .map(record => AIStorage.getMessage(messageIdForRecord(record)))
+      .filter(record =>
+        recordMatchesAuthoritativeConstraints(record, constraints)
+      );
+    return { records, diagnostics: exactSearch.diagnostics };
+  } catch (error) {
+    const records = authoritativeRecordsForQuery(scopeRecords, constraints);
+    return {
+      records,
+      diagnostics: {
+        backend: "memory",
+        mode: "exact-fallback",
+        resultCount: records.length,
+        error: compactString(error?.message || error, 240),
+      },
+    };
+  }
+}
+
+function structuredSearchResults(records, hasAuthoritativeIdentifier) {
+  return records.map(record => ({
+    ...record,
+    messageId: messageIdForRecord(record),
+    score: 1,
+    similarity: 0,
+    lexicalScore: 1,
+    exactMatch: hasAuthoritativeIdentifier,
+    structuredMatch: true,
+    retrievalChannels: ["structured"],
+    reasons: [
+      hasAuthoritativeIdentifier
+        ? "Exact identifier match"
+        : "Structured constraint match",
+    ],
+  }));
+}
+
+function retrievalGraphExpansion({
+  graphRag,
+  hasHardConstraints,
+  maxRecords,
+  retrievalQuery,
+  scope,
+}) {
+  if (graphRag && !hasHardConstraints) {
+    return graphExpansionForQuery(retrievalQuery, scope, {
+      limit: Math.min(maxRecords * 2, 16),
+    });
+  }
+  return {
+    enabled: Boolean(graphRag),
+    queryTerms: [],
+    matchedTerms: [],
+    records: [],
+    scoreByMessageId: new Map(),
+  };
+}
+
+function retrievalCandidatesFor({
+  authoritativeRecords,
+  expandedRecords,
+  hasHardConstraints,
+  plannedRecords,
+  scopeRecords,
+}) {
+  if (hasHardConstraints) {
+    return authoritativeRecords;
+  }
+  if (expandedRecords.length) {
+    return expandedRecords;
+  }
+  if (plannedRecords.length) {
+    return plannedRecords;
+  }
+  return scopeRecords;
+}
+
+function relatedRetrievalMatches(
+  scopeRecords,
+  selectedRecords,
+  retrievalQuery
+) {
+  const queryTerms = searchTermsFor(retrievalQuery);
+  if (!queryTerms.length) {
+    return {
+      directMatches: [],
+      senderMatches: [],
+      entityMatches: [],
+      templateMatches: [],
+      threadMatches: [],
+    };
+  }
+  const directMatches = scopeRecords.filter(record =>
+    textMatchesTerms(retrievalTextForRecord(record), queryTerms)
+  );
+  const senderMatches = scopeRecords.filter(record => {
+    const email = senderEmail(record.author || "");
+    const domain = email.split("@").at(-1) || "";
+    return queryTerms.some(
+      term =>
+        email.includes(term) ||
+        domain.includes(term) ||
+        String(record.author || "")
+          .toLocaleLowerCase()
+          .includes(term)
+    );
+  });
+  const entityMatches = scopeRecords.filter(record =>
+    queryTerms.some(term =>
+      entityTermsForRecord(record).some(value => value.includes(term))
+    )
+  );
+  const seedRecords = [
+    ...selectedRecords,
+    ...directMatches.slice(0, 4),
+    ...entityMatches,
+  ];
+  const templateFamilies = new Set(
+    seedRecords.map(templateFamilyForRecord).filter(Boolean)
+  );
+  const repeatedTemplateFamilies = new Set(
+    groupByTemplateFamily(scopeRecords)
+      .filter(group => group.count > 1)
+      .map(group => group.family)
+  );
+  const templateMatches = scopeRecords.filter(record => {
+    const family = templateFamilyForRecord(record);
+    return repeatedTemplateFamilies.has(family) && templateFamilies.has(family);
+  });
+  const threadKeys = new Set(
+    seedRecords.map(threadKeyForRecord).filter(Boolean)
+  );
+  const repeatedThreadKeys = new Set(
+    groupByThread(scopeRecords)
+      .filter(group => group.count > 1)
+      .map(group => group.key)
+  );
+  const threadMatches = scopeRecords.filter(record => {
+    const key = threadKeyForRecord(record);
+    return repeatedThreadKeys.has(key) && threadKeys.has(key);
+  });
+  return {
+    directMatches,
+    senderMatches,
+    entityMatches,
+    templateMatches: templateFamilies.size ? templateMatches : [],
+    threadMatches: threadKeys.size ? threadMatches : [],
+  };
+}
+
+function selectedSearchSourceIds(searchResults, selectedIds) {
+  const ids = {
+    semantic: new Set(),
+    lexical: new Set(),
+    graph: new Set(),
+  };
+  for (const result of searchResults) {
+    const messageId = messageIdForRecord(result);
+    if (!selectedIds.has(messageId)) {
+      continue;
+    }
+    const type = searchResultSourceType(result);
+    if (["semantic", "hybrid"].includes(type)) {
+      ids.semantic.add(messageId);
+    }
+    if (["lexical", "hybrid"].includes(type)) {
+      ids.lexical.add(messageId);
+    }
+    if (type == "graph" || (result.retrievalChannels || []).includes("graph")) {
+      ids.graph.add(messageId);
+    }
+  }
+  return ids;
+}
+
+function selectedMatchIds(records, selectedIds) {
+  return new Set(
+    records
+      .map(messageIdForRecord)
+      .filter(messageId => selectedIds.has(messageId))
+  );
+}
+
+function retrievalCandidateSourceCounts({
+  authoritativeRecords,
+  hasAuthoritativeIdentifier,
+  matches,
+  plannedRecords,
+  searchResults,
+  selectedRecords,
+}) {
+  const selectedIds = new Set(selectedRecords.map(messageIdForRecord));
+  const searchIds = selectedSearchSourceIds(searchResults, selectedIds);
+  const directIds = selectedMatchIds(matches.directMatches, selectedIds);
+  const senderIds = selectedMatchIds(matches.senderMatches, selectedIds);
+  const entityIds = selectedMatchIds(matches.entityMatches, selectedIds);
+  const templateIds = selectedMatchIds(matches.templateMatches, selectedIds);
+  const threadIds = selectedMatchIds(matches.threadMatches, selectedIds);
+  const authoritativeIds = new Set(
+    authoritativeRecords.map(messageIdForRecord)
+  );
+  const accounted = messageId =>
+    searchIds.semantic.has(messageId) ||
+    searchIds.lexical.has(messageId) ||
+    searchIds.graph.has(messageId) ||
+    senderIds.has(messageId) ||
+    entityIds.has(messageId) ||
+    templateIds.has(messageId) ||
+    threadIds.has(messageId);
+  return {
+    exact: hasAuthoritativeIdentifier
+      ? selectedRecords.filter(record =>
+          authoritativeIds.has(messageIdForRecord(record))
+        ).length
+      : 0,
+    semantic: searchIds.semantic.size,
+    lexical: searchIds.lexical.size,
+    graph: searchIds.graph.size,
+    direct: directIds.size,
+    sender: senderIds.size,
+    entities: entityIds.size,
+    templates: templateIds.size,
+    thread: threadIds.size,
+    clusters: Math.max(
+      0,
+      selectedRecords.filter(record => !plannedRecords.includes(record)).length
+    ),
+    scopeFallback: selectedRecords.filter(
+      record => !accounted(messageIdForRecord(record))
+    ).length,
+  };
+}
+
+function retrievalRankingMode({
+  graphExpansion,
+  hasAuthoritativeIdentifier,
+  hasHardConstraints,
+  ranked,
+  rerankingEnabled,
+}) {
+  if (hasHardConstraints) {
+    return hasAuthoritativeIdentifier ? "exact-locked" : "constraint-filtered";
+  }
+  if (graphExpansion.records.length) {
+    return rerankingEnabled ? "graph-hybrid-reranked" : "graph-hybrid";
+  }
+  if (ranked.diagnostics.mode.startsWith("learned-")) {
+    return "learned-reranked";
+  }
+  return rerankingEnabled ? "reranked" : "retrieval-order";
+}
+
+async function retrievalContext({
+  prompt = "",
+  scope = { scopeMode: "all" },
+  limit = MAX_CONTEXT_RECORDS,
+  reranking = true,
+  graphRag = false,
+} = {}) {
+  const trimmedPrompt = String(prompt || "").trim();
+  const maxRecords = Math.max(1, Math.min(Number(limit) || 8, 20));
+  const scopeRecords = AIStorage.getMessagesByDate(scope);
+  const rollout = ragRollout();
+  const queryState = retrievalQueryState(trimmedPrompt, rollout);
+  const adaptive = await runAdaptiveRetrievalSearches({
+    adaptivePlan: queryState.adaptivePlan,
+    hasHardConstraints: queryState.hasHardConstraints,
+    rollout,
+    scope,
+  });
+  const authoritative = await authoritativeRetrieval({
+    constraints: queryState.constraints,
+    hasHardConstraints: queryState.hasHardConstraints,
+    scope,
+    scopeRecords,
+  });
+  let searchResults = queryState.hasHardConstraints
+    ? structuredSearchResults(
+        authoritative.records,
+        queryState.hasAuthoritativeIdentifier
+      )
+    : adaptive.searchResults;
+  // Exact/structured queries are deliberately graph-free: an identifier,
+  // amount, or date constraint must lock to canonical records rather than a
+  // related graph neighborhood. For ordinary questions, source-linked graph
+  // expansion is an opt-in third retrieval channel.
+  const graphExpansion = retrievalGraphExpansion({
+    graphRag,
+    hasHardConstraints: queryState.hasHardConstraints,
+    maxRecords,
+    retrievalQuery: queryState.retrievalQuery,
+    scope,
+  });
+  const lifecyclePriorityRecords = lifecycleComparisonPriorityRecords(
+    trimmedPrompt,
+    scopeRecords
+  );
+  if (graphExpansion.records.length) {
+    searchResults = mergeGraphSearchResults(searchResults, graphExpansion);
+  }
+  const plannedRecords = queryState.hasHardConstraints
+    ? authoritative.records
+    : recordsForPlan(queryState.plan, scopeRecords, searchResults);
+  const expandedRecords = queryState.hasHardConstraints
+    ? authoritative.records
+    : expandedContextRecords(
+        queryState.plan,
+        plannedRecords.length ? plannedRecords : scopeRecords,
+        scopeRecords,
+        searchResults,
+        Math.max(maxRecords, MAX_LOCAL_SEARCH_RESULTS)
+      );
+  const retrievalCandidates = retrievalCandidatesFor({
+    authoritativeRecords: authoritative.records,
+    expandedRecords,
+    hasHardConstraints: queryState.hasHardConstraints,
+    plannedRecords,
+    scopeRecords,
+  });
+  // semanticSearch always provides the relevance-ranked baseline. Disabling
+  // the optional reranker must never fall back to arbitrary mailbox order.
+  const ranked = await rankedContextRecords(
+    retrievalCandidates,
+    searchResults,
+    maxRecords,
+    {
+      query: queryState.retrievalQuery,
+      reranking: reranking && rollout.reranking,
+      accountKey: scope.accountKey,
+      priorityRecords: [
+        ...lifecyclePriorityRecords,
+        ...graphExpansion.records,
+      ],
+    }
+  );
+  const selectedRecords = withRequiredPriorityRecords(
+    lifecyclePriorityRecords,
+    ranked.records,
+    maxRecords
+  );
+  const matches = relatedRetrievalMatches(
+    scopeRecords,
+    selectedRecords,
+    queryState.retrievalQuery
+  );
+  const searchResultByMessageId = new Map(
+    searchResults.map(result => [messageIdForRecord(result), result])
+  );
+  const candidateSources = retrievalCandidateSourceCounts({
+    authoritativeRecords: authoritative.records,
+    hasAuthoritativeIdentifier: queryState.hasAuthoritativeIdentifier,
+    matches,
+    plannedRecords,
+    searchResults,
+    selectedRecords,
+  });
+  const semanticCoverage = AIStorage.getSemanticCoverage(scope);
+  const readiness = retrievalReadinessFor({
+    scopeRecords,
+    candidateSources,
+    semanticCoverage,
+  });
+  // Before the hierarchy stage, do not inject a whole-scope rollup into a
+  // narrow evidence answer. It is still derived from source records, but it
+  // changes the retrieval surface and therefore needs its own rollout gate.
+  const aggregate = aggregateRecords(
+    rollout.hierarchical ? scopeRecords : selectedRecords
+  );
+  const rerankingEnabled = reranking !== false && rollout.reranking;
+  const rerankingApplied = rerankingEnabled && selectedRecords.length > 1;
+  const rankingMode = retrievalRankingMode({
+    graphExpansion,
+    hasAuthoritativeIdentifier: queryState.hasAuthoritativeIdentifier,
+    hasHardConstraints: queryState.hasHardConstraints,
+    ranked,
+    rerankingEnabled,
+  });
+
+  return {
+    scope,
+    plan: queryState.plan,
+    retrievalQuery: queryState.retrievalQuery,
+    scopeRecords,
+    searchResults,
+    records: selectedRecords,
+    aggregate,
+    compressedContext: localSummarizerBundle({
+      prompt: trimmedPrompt,
+      records: selectedRecords,
+      searchResults,
+      aggregate,
+      redactionRequired: externalRedactionRequired(),
+    }),
+    candidateSources,
+    semanticCoverage,
+    readiness,
+    searchResultByMessageId,
+    queryContractVersion: RAG_QUERY_CONTRACT_VERSION,
+    constraints: queryState.constraints,
+    authoritativeMatchCount: authoritative.records.length,
+    exactMatchRequired: queryState.hasHardConstraints,
+    exactSearchDiagnostics: authoritative.diagnostics,
+    retrievalDiagnostics: {
+      rollout,
+      semanticCandidateCount: adaptive.semanticCandidates.length,
+      lexicalCandidateCount: adaptive.lexicalCandidates.length,
+      fusedCandidateCount: searchResults.length,
+      lexical: adaptive.lexicalDiagnostics,
+      adaptive: {
+        applied: queryState.adaptivePlan.applied,
+        reason: queryState.adaptivePlan.reason,
+        searchBudget: queryState.adaptivePlan.searchBudget,
+        searchesExecuted: adaptive.searches.length,
+        scopeLocked: queryState.adaptivePlan.scopeLocked,
+        scopeMode: scope.scopeMode || "all",
+        searches: adaptive.searches,
+      },
+      fusion: queryState.hasHardConstraints ? "constraint-lock" : "rrf",
+      rankConstant: queryState.hasHardConstraints ? 0 : RRF_RANK_CONSTANT,
+      reranker: ranked.diagnostics,
+      graph: {
+        enabled: !!graphRag,
+        applied: !!graphExpansion.records.length,
+        queryTerms: graphExpansion.queryTerms,
+        matchedTerms: graphExpansion.matchedTerms,
+        candidateCount: graphExpansion.records.length,
+        candidateMessageIds: graphExpansion.records
+          .map(record => messageIdForRecord(record))
+          .filter(Boolean)
+          .slice(0, 16),
+      },
+      lifecycleComparison: {
+        priorityMessageIds: lifecyclePriorityRecords
+          .map(record => messageIdForRecord(record))
+          .filter(Boolean),
+      },
+    },
+    rerankingEnabled,
+    rerankingApplied,
+    rankingMode,
+  };
+}
+
+function dedupeByTemplateFamily(records = [], limit = MAX_CONTEXT_RECORDS) {
+  const deduped = [];
+  const seen = new Set();
+  for (const record of records) {
+    const family =
+      templateFamilyForRecord(record) || messageIdForRecord(record);
+    if (seen.has(family)) {
+      continue;
+    }
+    seen.add(family);
+    deduped.push(record);
+    if (deduped.length >= limit) {
+      break;
+    }
+  }
+  return deduped;
+}
+
+function groupByTemplateFamily(records = []) {
+  const groups = new Map();
+  for (const record of records) {
+    const family = templateFamilyForRecord(record);
+    if (!family) {
+      continue;
+    }
+    const list = groups.get(family) || [];
+    list.push(record);
+    groups.set(family, list);
+  }
+  return Array.from(groups.entries())
+    .map(([family, familyRecords]) => ({
+      family,
+      count: familyRecords.length,
+      record: familyRecords[0],
+    }))
+    .sort(
+      (a, b) => b.count - a.count || (b.record.date || 0) - (a.record.date || 0)
+    );
+}
+
+function groupByThread(records = []) {
+  const groups = new Map();
+  for (const record of records) {
+    const key = threadKeyForRecord(record);
+    if (!key) {
+      continue;
+    }
+    const list = groups.get(key) || [];
+    list.push(record);
+    groups.set(key, list);
+  }
+  return Array.from(groups.entries())
+    .map(([key, threadRecords]) => ({
+      key,
+      count: threadRecords.length,
+      record: threadRecords[0],
+    }))
+    .sort(
+      (a, b) => b.count - a.count || (b.record.date || 0) - (a.record.date || 0)
+    );
+}
+
+function boundedEvidenceEntities(record = {}, redactionRequired = false) {
+  const entities = {};
+  for (const [name, rawValues] of Object.entries(
+    record.extractedEntities || {}
+  ).slice(0, 12)) {
+    const values = contextArrayValues(rawValues, 6, 240, redactionRequired);
+    if (values.length) {
+      entities[compactString(name, 80)] = values;
+    }
+  }
+  return entities;
+}
+
+function localSummarizerBundle({
+  prompt = "",
+  records = [],
+  searchResults = [],
+  aggregate = aggregateRecords(records),
+  redactionRequired = false,
+} = {}) {
+  const evidenceRecords = dedupeByTemplateFamily(records, MAX_CONTEXT_RECORDS);
+  const templateGroups = groupByTemplateFamily(records).slice(0, 6);
+  const threadGroups = groupByThread(records).slice(0, 6);
+  const actions = uniqueValues(
+    records.flatMap(record => arrayValues(record.actionItems, 3))
+  ).slice(0, 8);
+  const risks = uniqueValues(
+    records.flatMap(record => arrayValues(record.riskFlags, 3))
+  ).slice(0, 8);
+  const dates = uniqueValues(
+    records.flatMap(record => arrayValues(record.extractedEntities?.dates, 3))
+  ).slice(0, 8);
+  return {
+    prompt: compactString(prompt, 500),
+    aggregate,
+    evidenceCards: evidenceRecords.map(record => ({
+      messageId: messageIdForRecord(record),
+      subject: compactString(record.subject || "(no subject)", 160),
+      author: compactString(record.author || "", 120),
+      category: compactString(record.category || "", 80),
+      templateFamily: compactString(templateFamilyForRecord(record), 180),
