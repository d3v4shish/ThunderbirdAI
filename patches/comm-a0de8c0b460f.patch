+      }
+      if (context.job.readMessages % 20 == 0) {
+        this.#mailboxDigestProgress(
+          context,
+          "reading",
+          `Read ${context.job.readMessages}/${context.job.totalMessages} emails; ${context.job.mappedMessages} summarized.`
+        );
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
