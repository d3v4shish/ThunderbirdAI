+  }
+
+  #mailboxDigestCitations(finalNode, metadata) {
+    const citedIds = new Set([
+      ...(finalNode.evidenceIds || []),
+      ...[
+        ...finalNode.themes,
+        ...finalNode.actions,
+        ...finalNode.deadlines,
+        ...finalNode.decisions,
+        ...finalNode.risks,
+      ].flatMap(item => item.evidenceIds || []),
+    ]);
+    const metadataById = new Map(metadata.map(item => [item.messageId, item]));
+    return Array.from(citedIds)
+      .map(id => metadataById.get(id))
+      .filter(Boolean)
+      .slice(0, MAILBOX_DIGEST_MAX_EVIDENCE_IDS);
