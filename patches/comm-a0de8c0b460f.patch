+  for (const line of text.split("\n")) {
+    const candidates = [];
+    if (/^\s*[-*]\s+/.test(line)) {
+      candidates.push({
+        value: line,
+        start: lineOffset,
+        end: lineOffset + line.length,
+      });
+    } else {
+      const matcher = /[^.!?]+[.!?]?/gu;
+      let match;
+      while ((match = matcher.exec(line))) {
+        const followingSource = line
+          .slice(match.index + match[0].length)
+          .match(/^\s*\[(?:mailbox|folder|tool):\/\/[^\]\s]+\]/u)?.[0];
+        candidates.push({
+          value: `${match[0]}${followingSource || ""}`,
+          start: lineOffset + match.index,
+          end:
+            lineOffset +
+            match.index +
+            match[0].length +
+            (followingSource?.length || 0),
+        });
+      }
+    }
+    for (const candidate of candidates) {
+      const claim = candidate.value.replace(/^[-*\s]+/, "").trim();
+      const uncitedClaim = claim
+        .replace(/\s*\[(?:mailbox|folder|tool):\/\/[^\]\s]+\]/gu, "")
+        .trim();
+      if (
+        claim.length < 12 ||
+        /^\[(?:mailbox|folder|tool):\/\//u.test(claim) ||
+        /^\d+\s+message\(s\)/i.test(claim) ||
+        /^[^.!?]{1,80}:$/u.test(claim) ||
+        /^(?:exact record locked:|grounded evidence only|evidence summary:|no endpoint synthesis was used)/i.test(
