+  // "Meera" and project aliases such as "Atlas" resolve safely through the
+  // graph's deterministic node matching.
+  for (const match of String(prompt || "").matchAll(
+    /\b[A-Z][\p{L}\d-]*(?:\s+[A-Z][\p{L}\d-]*){0,2}\b/gu
+  )) {
+    add(match[0], 1000 + match[0].split(/\s+/).length, "user-prompt");
+  }
