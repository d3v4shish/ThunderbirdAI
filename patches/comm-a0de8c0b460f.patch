+      ...options,
+      scope,
+    });
+  }
+
+  getMailboxDigestJob(jobId = "") {
+    return AIStorage.getMailboxDigestJob(jobId);
+  }
+
+  getMailboxDigestProgress(jobId = "") {
+    const job = AIStorage.getMailboxDigestJob(jobId);
+    return job ? this.#mailboxDigestProgressSnapshot(job) : null;
+  }
+
