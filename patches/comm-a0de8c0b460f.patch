+    /\b(?:contact|address book|calendar|event|task)\b/u.test(text) ||
+    /\b(?:prepare|draft)\s+(?:a\s+)?(?:reply|workflow|move|tag|filter|calendar|task)\b/u.test(
+      text
+    ) ||
+    /\b(?:reply|workflow)\s+proposal\b/u.test(text)
