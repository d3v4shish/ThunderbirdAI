+      Assert.equal(result.status, "ok");
+      Assert.equal(result.retrievalSummary.scopeRecordCount, 4);
+      Assert.equal(result.retrievalSummary.selectedRecords.length, 4);
+      Assert.equal(result.retrievalSummary.contextBudget.includedCount, 4);
+      Assert.greater(result.retrievalSummary.searchResultCount, 0);
