+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+var { AISources } = ChromeUtils.importESModule(
+  "resource:///modules/AISources.sys.mjs"
+);
+var { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+
+function cloneJSON(value) {
+  return JSON.parse(JSON.stringify(value));
+}
+
+function setUserPref(name, value) {
+  if (typeof value == "boolean") {
+    Services.prefs.setBoolPref(name, value);
+    return;
+  }
+  if (typeof value == "number") {
+    Services.prefs.setIntPref(name, value);
+    return;
+  }
+  Services.prefs.setStringPref(name, String(value));
+}
+
+async function resetAIActiveConfigTestState() {
+  for (const pref of [
+    "mail.ai.enabled",
+    "mail.ai.provider",
+    "mail.ai.source_id",
+    "mail.ai.background.source_id",
+    "mail.ai.endpoint.background",
+    "mail.ai.backfill.paused",
+  ]) {
+    if (Services.prefs.prefHasUserValue(pref)) {
+      Services.prefs.clearUserPref(pref);
+    }
+  }
+  await AISources.clearGeneratedData();
+  await AIService.clearGeneratedData();
+}
+
+async function withAIConfigState(
+  { sources = [], prefs = {}, runtimeSnapshot = null } = {},
+  task
+) {
+  await resetAIActiveConfigTestState();
+
+  const originalGetRuntimeSnapshot = AIService.getRuntimeSnapshot;
+
+  try {
+    for (const source of sources) {
+      await AISources.upsertSource(source);
+    }
+    for (const [pref, value] of Object.entries(prefs)) {
+      setUserPref(pref, value);
+    }
+    if (runtimeSnapshot) {
+      AIService.getRuntimeSnapshot = async () => cloneJSON(runtimeSnapshot);
+    }
+
+    await task({ runtimeSnapshot });
+  } finally {
+    AIService.getRuntimeSnapshot = originalGetRuntimeSnapshot;
+    await closePrefsTab();
+    await resetAIActiveConfigTestState();
+  }
+}
+
+registerCleanupFunction(async () => {
+  await closePrefsTab();
+  await resetAIActiveConfigTestState();
+});
+
+add_task(
+  async function test_ai_active_configuration_rows_cover_enabled_disabled_and_unavailable_states() {
+    const assistantSource = {
+      id: "assistant-ollama",
+      name: "LocalAI",
+      type: "ollama",
+      endpointURL: "http://127.0.0.1:11434/v1/chat/completions",
+      model: "llama3",
+      background: false,
+      allowCloud: false,
+    };
+    const backgroundSource = {
+      id: "background-openai",
+      name: "Cloud GPT",
+      type: "openai-compatible",
+      endpointURL: "http://127.0.0.1:8080/v1/chat/completions",
+      model: "gpt-4o-mini",
+      background: true,
+      allowCloud: true,
+    };
+
+    await withAIConfigState(
+      {
+        sources: [assistantSource, backgroundSource],
+        prefs: {
+          "mail.ai.enabled": true,
+          "mail.ai.provider": "source",
+          "mail.ai.source_id": assistantSource.id,
+          "mail.ai.background.source_id": backgroundSource.id,
+          "mail.ai.endpoint.background": true,
+          "mail.ai.backfill.paused": false,
+        },
+        runtimeSnapshot: {
+          enabled: true,
+          paused: false,
+          assistantRuntime: {
+            // An endpoint-backed Assistant reports `endpoint`, not `ready`.
+            // The active configuration must still expose the selected model.
+            state: "endpoint",
+            sourceName: assistantSource.name,
+            sourceType: assistantSource.type,
+            provider: "ollama",
+            model: assistantSource.model,
+          },
+          endpoint: {
+            usableInBackground: true,
+            backgroundEnabled: true,
+          },
+          roleAssignments: {},
+          localModels: [],
+          subsystems: {
+            assistant: {
+              label: "Assistant",
+              summary: "ready",
+              detail: "Assistant uses local retrieval and mailbox evidence",
+            },
+            retrieval: {
+              label: "Retrieval",
+              summary: "ready",
+              indexedCount: 0,
+            },
+            runtime: {
+              label: "Runtime",
+              summary: "idle",
+            },
+          },
+        },
+      },
+      async () => {
+        const { prefsDocument, prefsWindow } = await openNewPrefsTab("paneAI");
+
+        await TestUtils.waitForCondition(
+          () =>
+            prefsDocument.getElementById("aiActiveSourceSummary")
+              ?.textContent == "Ollama (LocalAI / llama3)",
+          "waiting for the enabled Assistant active configuration"
