+      !AIStorage.getMessage(messageId),
+      "automatic new-mail analysis should not run while paused"
+    );
+
+    Assert.ok(
+      AIService.requestAnalysis(msgHdr),
+      "an explicit request should promote the queued background item"
+    );
+    await TestUtils.waitForCondition(async () => {
+      const snapshot = await AIService.getRuntimeSnapshot(
+        account.incomingServer.key
+      );
+      return (
+        !!AIStorage.getMessage(messageId) &&
+        !snapshot.processing &&
+        !snapshot.activeWorkers &&
+        !snapshot.queueLength
+      );
+    }, "waiting for the explicit request to finish while paused");
+  } finally {
+    AIService.clearPendingAnalysisQueue();
+    await AIService.uninit();
+    await AIStorage.clearGeneratedData();
+    Services.prefs.clearUserPref("mail.ai.backfill.paused");
+    MailServices.accounts.removeAccount(account, false);
+  }
+});
