+  async function test_exhaustive_mailbox_digest_maps_full_bodies_and_caches() {
+    await AIStorage.clearGeneratedData();
+    const { accountKey, analysisFolder } =
+      createLocalAnalysisFolder("mailboxDigest");
+    const generator = new MessageGenerator();
+    const longBody = `${"Long context filler. ".repeat(
+      3200
+    )}BEYOND_OLD_SUMMARY_PREFIX`;
+    for (const [index, body] of [
+      [1, "Approve the launch budget by Friday."],
+      [2, longBody],
+      [3, "Decision: postpone the migration. Risk: expiring certificate."],
+    ]) {
+      analysisFolder.addMessage(
+        generator
+          .makeMessage({
+            from: `Digest Sender ${index} <digest${index}@example.com>`,
+            subject: `Digest message ${index}`,
+            body: { body },
+          })
+          .toMessageString()
+      );
+    }
+
+    let mapCalls = 0;
+    let sawLongBodySentinel = false;
+    const restoreEndpoint = installMockAssistantEndpoint({
+      async handler(messages) {
+        const content = String(messages.at(-1)?.content || "");
+        const payload = mailboxDigestJSONFromPrompt(messages);
+        if (content.startsWith("EMAIL_CHUNKS_JSON:")) {
+          mapCalls++;
+          const items = payload.map(entry => {
+            sawLongBodySentinel ||= entry.body.includes(
+              "BEYOND_OLD_SUMMARY_PREFIX"
+            );
+            return {
+              id: entry.id,
+              summary: `Mapped ${entry.subject}, chunk ${entry.chunk}.`,
+              category: entry.subject.endsWith("1") ? "finance" : "operations",
+              themes: [`Theme for ${entry.subject}`],
+              actions: entry.subject.endsWith("1")
+                ? ["Approve the launch budget"]
+                : [],
+              deadlines: entry.subject.endsWith("1") ? ["Friday"] : [],
+              decisions: entry.subject.endsWith("3")
+                ? ["Postpone the migration"]
+                : [],
+              risks: entry.subject.endsWith("3")
+                ? ["Expiring certificate"]
+                : [],
+            };
+          });
+          return {
+            answer: JSON.stringify({ items }),
+            attempts: [{ state: "ok", transport: "ollama-openai" }],
+          };
+        }
+
+        const evidenceIds = Array.from(
+          new Set(payload.flatMap(node => node.evidenceIds || []))
+        );
+        return {
+          answer: JSON.stringify({
+            summary: "Three messages cover a budget, migration, and risk.",
+            category: "operations",
+            themes: [{ text: "Budget and migration planning", evidenceIds }],
+            actions: [{ text: "Approve the launch budget", evidenceIds }],
+            deadlines: [{ text: "Friday", evidenceIds }],
+            decisions: [{ text: "Postpone the migration", evidenceIds }],
+            risks: [{ text: "Expiring certificate", evidenceIds }],
+            evidenceIds,
+          }),
+          attempts: [{ state: "ok", transport: "ollama-openai" }],
+        };
+      },
+    });
+
+    try {
+      const progressSnapshots = [];
+      const result = await AIService.askAssistant({
+        prompt: "Create an exhaustive whole-folder executive summary.",
+        accountKey,
+        folderURI: analysisFolder.URI,
+        scopeMode: "folder",
+        mailboxSummary: true,
+        onProgress(progress) {
+          if (progress.mailboxDigestProgress) {
+            progressSnapshots.push(progress.mailboxDigestProgress);
+          }
+        },
+      });
+
+      Assert.equal(result.route, "mailbox_digest");
+      Assert.equal(result.mailboxDigest.status, "complete");
+      Assert.equal(result.mailboxDigest.coverage.totalMessages, 3);
+      Assert.equal(result.mailboxDigest.coverage.summarizedMessages, 3);
+      Assert.greater(
+        result.mailboxDigest.coverage.chunkCount,
+        3,
+        "a body beyond the former prefix limit should be split into chunks"
+      );
+      Assert.ok(
+        sawLongBodySentinel,
+        "the endpoint should receive content beyond the old summary prefix"
+      );
+      Assert.greater(result.mailboxDigest.citations.length, 0);
+      Assert.greater(progressSnapshots.length, 0);
+      const finalProgress = progressSnapshots.at(-1);
+      Assert.equal(finalProgress.phase, "complete");
+      Assert.equal(finalProgress.totals.messages, 3);
+      Assert.equal(finalProgress.counters.processed, 3);
+      Assert.equal(finalProgress.counters.summarized, 3);
+      Assert.equal(finalProgress.checkpoint.persistedMessages, 3);
+      Assert.greater(finalProgress.endpoint.calls, 0);
+      Assert.greaterOrEqual(finalProgress.endpoint.p50Ms, 0);
+      for (let index = 1; index < progressSnapshots.length; index++) {
+        Assert.greaterOrEqual(
+          progressSnapshots[index].counters.processed,
+          progressSnapshots[index - 1].counters.processed,
+          "the normalized processed count should never move backwards"
+        );
+      }
+      const storedProgress = AIService.getMailboxDigestProgress(
+        result.mailboxDigest.jobId
+      );
+      Assert.equal(storedProgress.counters.processed, 3);
+      Assert.equal(storedProgress.state, "complete");
+
+      const callsAfterFirstDigest = mapCalls;
+      const cached = await AIService.askAssistant({
+        prompt: "Create an exhaustive whole-folder executive summary.",
+        accountKey,
+        folderURI: analysisFolder.URI,
+        scopeMode: "folder",
+        mailboxSummary: true,
+      });
+      Assert.ok(cached.mailboxDigest.cached);
+      Assert.equal(
+        mapCalls,
+        callsAfterFirstDigest,
+        "an unchanged scope should reuse the final cached digest"
+      );
+    } finally {
+      restoreEndpoint();
+      await AIStorage.clearGeneratedData();
+    }
+  }
+);
