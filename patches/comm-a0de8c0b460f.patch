+      runtimeState: "missing",
+      runtimeInstalled: false,
+      runtimePresenceState: "missing",
+      runtimeStorageBytes: 0,
+      runtimeStorageMB: 0,
+      lastTestResult: "",
+      lastProbeAt: "",
+      lastProbeLatencyMs: 0,
+      lastProbeError: "",
