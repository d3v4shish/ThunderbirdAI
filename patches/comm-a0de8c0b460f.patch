+  async getSecurityCenterData(msgHdr, options = {}) {
+    const data = await this.getMessageTimelineData(msgHdr, options);
+    if (!data) {
+      return null;
+    }
+    const analysis = data.analysis || {};
+    const privateRecord = AIStorage.getMessage(messageIdFor(msgHdr)) || {};
+    const detectionData = {
+      ...data,
+      analysis: {
+        ...analysis,
+        localText: privateRecord.localText || analysis.localText || "",
+        trustedText: privateRecord.trustedText || analysis.trustedText || "",
+      },
+    };
+    const sidecar = data.sidecar || {};
+    const attachmentManifest = sidecar.attachmentManifest?.length
+      ? sidecar.attachmentManifest
+      : analysis.attachmentManifest || [];
+    const piiPreview = analysis.externalSafeText
+      ? {
+          matchTypes: arrayValues(analysis.piiRuleIds, 20),
+          redactedPayload: analysis.externalSafeText,
+        }
+      : {
+          matchTypes: arrayValues(analysis.piiRuleIds, 20),
+          redactedPayload: "",
+        };
+    const linkRows = linkInvestigationRows(data);
+    if (
+      linkRows.length &&
+      Object.keys(privateRecord).length &&
+      !privateRecord.extractedEntities?.links?.length
+    ) {
+      AIStorage.setMessage(messageIdFor(msgHdr), {
+        ...privateRecord,
+        extractedEntities: {
+          ...(privateRecord.extractedEntities || {}),
+          links: linkRows.map(link => ({
+            visibleText: link.visibleText,
+            realURL: link.realURL,
+            reputationVerdict: link.reputationVerdict,
+          })),
+        },
+      });
+    }
+    const optionalSecurityStep = async (label, fallback, task) => {
+      try {
+        return await task();
+      } catch (error) {
+        this.#log.debug(`Security ${label} unavailable: ${error}`);
+        return fallback;
+      }
+    };
+    const urlReputationRows = await optionalSecurityStep(
+      "URL reputation",
+      [],
+      () => this.#urlReputationRows(linkRows)
+    );
+    const qrScanFindings = await optionalSecurityStep("QR scan", [], () =>
+      this.#qrFindings(attachmentManifest, data)
+    );
+    const attachmentDetails = await optionalSecurityStep(
+      "attachment inspection",
+      [],
+      () => this.#attachmentDeepInspection(attachmentManifest)
