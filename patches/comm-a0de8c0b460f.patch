+  async #mailboxDigestEndpointJSON(
+    messages,
+    accountKey,
+    config,
+    { activityKind = "mailbox-digest", signal = null } = {}
+  ) {
+    const result = await AIEndpoint.chatWithDebug(messages, accountKey, {
+      role: "summarizer",
+      configOverride: config,
+      activityKind,
+      signal,
+    });
+    return {
+      value: parseMailboxDigestJSON(result.answer),
+      attempts: result.attempts || [],
