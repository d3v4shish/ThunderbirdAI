+  #rawAuthEvidence(auth = {}) {
+    const entries = [];
+    const add = (mechanism, source = {}) => {
+      entries.push({
+        mechanism,
+        status: source.status || "unknown",
+        alignedDomain:
+          source.alignedDomain ||
+          source.alignedDkimDomain ||
+          source.alignedSpfDomain ||
+          source.domain ||
+          source.envelopeFrom ||
+          "",
+        rawHeaderSnippet: redactedSecurityString(
+          source.rawHeaderSnippet ||
+            source.raw ||
+            source.header ||
+            source.authenticationResults ||
+            ""
+        ).slice(0, 500),
+        verifierSource: source.verifierSource || "Thunderbird local verifier",
+        failureReason:
+          source.failureReason || source.error || source.implication || "",
+        recommendedAction:
+          String(source.status || "").toLocaleLowerCase() == "pass"
+            ? "No action required from this mechanism alone."
+            : "Verify sender identity before acting.",
+      });
+    };
+    add("SPF", auth.spf || {});
+    add("DKIM", auth.dkim?.signatures?.[0] || auth.dkim || {});
+    add("DMARC", auth.dmarc || {});
+    add("ARC", auth.arc || {});
+    return entries;
+  }
