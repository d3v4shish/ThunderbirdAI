@@ -0,0 +1,75 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+const { AIModelRuntime } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIModelRuntime.sys.mjs"
+);
+
+registerCleanupFunction(async () => {
+  AIModelRuntime.setTestBackend(null);
+  AIModelRuntime.setTestMLEngineFactory(null);
+  AIModelRuntime.resetFailedState();
+  AIModelRuntime.clearLogs();
+  await AIModelRuntime.stop();
+});
+
+add_task(async function test_legacy_runtime_is_permanently_disabled() {
+  const status = AIModelRuntime.status();
+  Assert.equal(status.state, "disabled");
+  Assert.equal(status.pid, "");
+  Assert.equal(status.queueDepth, 0);
+  Assert.equal(status.activeRequest, null);
+  Assert.equal(status.health.state, "disabled");
+
+  const probe = await AIModelRuntime.probe();
+  Assert.ok(!probe.ok);
+  Assert.ok(probe.summary.includes("execution has been removed"));
+  Assert.ok(probe.summary.includes("configured endpoint"));
+});
+
+add_task(async function test_legacy_run_fails_without_starting_a_process() {
+  AIModelRuntime.clearLogs();
+  AIModelRuntime.setTestBackend({
+    async run() {
+      throw new Error("A retired backend must never be called.");
+    },
+  });
+
+  await Assert.rejects(
+    AIModelRuntime.run("legacy.gguf", "summarizer", { text: "mail" }),
+    error =>
+      error.aiHelperRemoved &&
+      error.message.includes(
+        "Legacy local summarizer execution has been removed"
+      ) &&
+      error.message.includes("configured endpoint or deterministic fallback")
+  );
+
+  const status = AIModelRuntime.status();
+  Assert.equal(status.state, "disabled");
+  Assert.equal(status.pid, "");
+  Assert.equal(status.queueDepth, 0);
+  Assert.equal(status.activeRequest, null);
+
+  const events = AIModelRuntime.getDebugEvents();
+  Assert.equal(events.length, 1);
+  Assert.equal(events[0].command, "run");
+  Assert.equal(events[0].state, "disabled");
+});
+
+add_task(async function test_legacy_lifecycle_actions_are_noops() {
+  let status = await AIModelRuntime.restart();
+  Assert.equal(status.state, "disabled");
+  Assert.equal(status.pid, "");
+
+  status = AIModelRuntime.clearQueue();
+  Assert.equal(status.queueDepth, 0);
+
+  const cancellation = await AIModelRuntime.cancel("retired-request");
+  Assert.ok(!cancellation.ok);
+  Assert.equal(cancellation.requestId, "retired-request");
+
+  status = await AIModelRuntime.stop();
+  Assert.equal(status.state, "disabled");
+  Assert.equal(status.pid, "");
+});
