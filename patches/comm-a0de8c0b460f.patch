+  async refreshAITemplateUI() {
+    const popup = document.getElementById("aiTemplatePopup");
+    if (!popup) {
+      return;
+    }
+    await AITemplates.init();
+    this.populateAITemplateAccounts();
+    const accountKey = this.getSelectedAITemplateAccountKey();
+    const templates = await AIService.getTemplates(accountKey);
+    this._aiTemplatesCurrent = templates;
+    popup.replaceChildren();
+    for (const template of templates) {
+      const item = document.createXULElement("menuitem");
+      item.value = template.id;
+      item.label = template.name || template.id;
+      popup.append(item);
+    }
+    const list = document.getElementById("aiTemplateList");
+    if (templates.length) {
+      const selectedId =
+        templates.some(template => template.id == list.value) && list.value
+          ? list.value
+          : templates[0].id;
+      list.value = selectedId;
+      this.loadAITemplate();
+    } else {
+      list.value = "";
+      this.loadAITemplate(this.makeAITemplate());
+    }
+    await this.refreshAITemplateSuggestions();
+    await this.refreshAIMinedTemplateFamilies();
+    document.getElementById("aiTemplateStatus").value =
+      `${templates.length} template${templates.length == 1 ? "" : "s"} for ${accountKey}`;
+    await this.refreshAISidebarSummaries();
+  },
+
+  async onAIMinedTemplateAccountChanged() {
+    await this.refreshAIMinedTemplateFamilies();
+  },
+
+  setAIMinedTemplateStatus(
+    statusNode,
+    accountKey,
+    candidates,
+    filteredCandidates,
+    visibleCandidates
+  ) {
+    const learningCount = candidates.filter(
+      candidate => candidate.state == "shadow"
+    ).length;
+    const reviewCount = candidates.filter(
+      candidate => candidate.state == "suggested"
+    ).length;
+    const summaries = [];
+    if (reviewCount) {
+      summaries.push(`${reviewCount} ready to review`);
+    }
+    if (learningCount) {
+      summaries.push(`${learningCount} still learning`);
+    }
+    const displayedDetail =
+      filteredCandidates.length > visibleCandidates.length
+        ? `Showing ${visibleCandidates.length} of ${filteredCandidates.length} matching families.`
+        : "";
+    const filterDetail =
+      filteredCandidates.length != candidates.length
+        ? `${filteredCandidates.length} of ${candidates.length} families match the filter.`
+        : "";
+    statusNode.textContent = summaries.length
+      ? [
+          accountKey == "all" ? "All accounts" : "",
+          ...summaries,
+          filterDetail,
+          displayedDetail,
+        ]
+          .filter(Boolean)
+          .join(" · ")
+      : "No recurring patterns found yet. Analyze at least three related messages from the same sender to create a reviewable family.";
+  },
+
+  getFilteredAIMinedTemplateCandidates(candidates = []) {
+    const filter = document
+      .getElementById("aiMinedTemplateFilter")
+      ?.value.trim()
+      .toLocaleLowerCase();
+    if (!filter) {
+      return candidates;
+    }
+    return candidates.filter(candidate => {
+      const template = candidate.template || {};
+      return [
+        candidate.label,
+        candidate.partition?.senderDomain,
+        template.name,
+        template.match?.subject?.value,
+        ...(candidate.exampleMessages || []).map(example => example.subject),
+      ]
+        .join("\n")
+        .toLocaleLowerCase()
+        .includes(filter);
+    });
+  },
+
+  async refreshAIMinedTemplateFamilies() {
+    const list = document.getElementById("aiMinedTemplateFamilies");
+    const statusNode = document.getElementById("aiMinedTemplateStatus");
+    if (!list || !statusNode) {
+      return;
+    }
+    const minedSelect = document.getElementById("aiMinedTemplateAccount");
+    const accountKey = minedSelect?.value || "all";
+    const mining = await AIService.getMiningStatus(accountKey);
+    const candidates = (mining.candidates || []).filter(
+      candidate => candidate.type == "template"
+    );
+    const filteredCandidates =
+      this.getFilteredAIMinedTemplateCandidates(candidates);
+    const visibleCandidates = [...filteredCandidates]
+      .sort((left, right) => {
+        const stateDelta =
+          Number(right.state == "suggested") -
+          Number(left.state == "suggested");
+        if (stateDelta) {
+          return stateDelta;
+        }
+        return (
+          (Number(right.observedCount) || 0) - (Number(left.observedCount) || 0)
+        );
+      })
+      .slice(0, MAX_VISIBLE_MINED_TEMPLATE_FAMILIES);
+    this._aiMinedTemplateCandidates = visibleCandidates;
+    list.replaceChildren();
+    this.setAIMinedTemplateStatus(
+      statusNode,
+      accountKey,
+      candidates,
+      filteredCandidates,
+      visibleCandidates
+    );
+
+    const accountLabels = new Map(
+      accountItems().map(account => [account.key, account.label])
+    );
+    for (const candidate of visibleCandidates) {
+      const template = candidate.template || {};
+      const card = document.createElement("article");
+      card.className = "ai-mined-template-family";
+      card.dataset.state = candidate.state || "shadow";
+
+      const heading = document.createElement("div");
+      heading.className = "ai-mined-template-family-heading";
+      const name = document.createElement("strong");
+      name.textContent = candidate.label || template.name || "Mined template";
+      heading.append(name);
+      const state = document.createElement("span");
+      state.className = "ai-mined-template-family-state";
+      const observed = Number(candidate.observedCount) || 0;
+      const threshold = Number(candidate.threshold) || 3;
+      state.textContent =
+        candidate.state == "suggested"
+          ? `Ready to review · ${observed} messages`
+          : `Learning · ${observed}/${threshold} messages`;
+      heading.append(state);
+      card.append(heading);
+
+      const detail = document.createElement("div");
+      detail.className = "ai-mined-template-family-detail";
+      const domain = candidate.partition?.senderDomain || "unknown sender";
+      const subject =
+        template.match?.subject?.value ||
+        candidate.exampleMessages?.[0]?.subject ||
+        "No subject pattern";
+      const account =
+        accountLabels.get(candidate.accountKey) || "Unknown account";
+      detail.textContent = `${account} · From ${domain} · Subject: ${subject}`;
+      card.append(detail);
+
+      const examples = (candidate.exampleMessages || [])
+        .map(example => example.subject)
+        .filter(Boolean)
+        .slice(0, 2);
+      if (examples.length) {
+        const exampleLine = document.createElement("div");
+        exampleLine.className = "ai-mined-template-family-examples";
+        exampleLine.textContent = `Examples: ${examples.join(" · ")}`;
+        card.append(exampleLine);
+      }
+
+      const rematch = (mining.rematchJobs || []).find(
+        job => job.candidateId == candidate.id
+      );
+      if (rematch && rematch.state != "complete") {
+        const progress = document.createElement("div");
+        progress.className = "ai-mined-template-family-examples";
+        progress.textContent =
+          rematch.progressDetail || `Rematch ${rematch.state}.`;
+        card.append(progress);
+      }
+      if (candidate.state == "suggested" && template.id) {
+        const actions = document.createElement("div");
+        actions.className = "ai-mined-template-family-actions";
+        const review = document.createElement("button");
+        review.type = "button";
+        review.textContent = "Review in editor";
+        review.addEventListener("click", () => {
+          this.openAIMinedTemplateInEditor(candidate.id).catch(console.error);
+        });
+        actions.append(review);
+        card.append(actions);
+      }
+      list.append(card);
+    }
+  },
+
+  async openAIMinedTemplateInEditor(candidateId = "") {
+    const candidate = this._aiMinedTemplateCandidates?.find(
+      item => item.id == candidateId
+    );
+    if (!candidate?.template) {
+      return;
+    }
+    const templateSelect = document.getElementById("aiTemplateAccount");
+    if (
+      templateSelect &&
+      candidate.accountKey &&
+      candidate.accountKey != "global" &&
+      templateSelect.value != candidate.accountKey
+    ) {
+      templateSelect.value = candidate.accountKey;
+      await this.refreshAITemplateUI();
+    }
+    const editor = document.getElementById("aiManualTemplateEditor");
+    if (editor) {
+      editor.open = true;
+    }
+    this.loadAITemplate({
+      ...candidate.template,
+      id: "",
+      createdFrom: "suggested",
+    });
+    document.getElementById("aiTemplateStatus").value =
+      "Mined family loaded into the manual editor. Review its conditions, then save it to activate the rule.";
+    editor?.scrollIntoView({ block: "nearest" });
+  },
+
+  async refreshAITemplateSuggestions() {
+    const popup = document.getElementById("aiTemplateSuggestionPopup");
+    const list = document.getElementById("aiTemplateSuggestionList");
+    if (!popup || !list) {
+      return;
+    }
+    const accountKey = this.getSelectedAITemplateAccountKey();
+    const suggestions = await AIService.getSuggestedTemplates(accountKey);
+    this._aiTemplateSuggestions = suggestions;
+    popup.replaceChildren();
+    for (const template of suggestions) {
+      const item = document.createXULElement("menuitem");
+      item.value = template.id;
+      item.label = template.name || template.id;
+      popup.append(item);
+    }
+    list.value = suggestions[0]?.id || "";
+  },
+
+  async saveAITemplate() {
+    const accountKey = this.getSelectedAITemplateAccountKey();
+    const templates = await AIService.getTemplates(accountKey);
+    const selectedId = this.getSelectedAITemplateId();
+    const existing =
+      templates.find(template => template.id == selectedId) || null;
+    const updated = this.getAITemplateFromForm(existing);
+    if (!this.hasAITemplateMatchCondition(updated)) {
+      document.getElementById("aiTemplateStatus").value =
+        "Add a From, Subject, or Body condition before saving a template.";
+      return;
+    }
+    if (existing) {
+      Object.assign(existing, updated, { id: existing.id });
+    } else {
+      templates.push(updated);
+    }
+    await AIService.setTemplates(accountKey, templates);
+    await this.refreshAITemplateUI();
+    document.getElementById("aiTemplateList").value = updated.id;
+    this.loadAITemplate(updated);
+    document.getElementById("aiTemplateStatus").value = "Template saved.";
+  },
+
+  newAITemplate() {
+    const template = { ...this.makeAITemplate(), id: "" };
+    this.loadAITemplate(template);
+    document.getElementById("aiTemplateStatus").value =
+      "New unsaved template. Select Save template when it is ready.";
+  },
+
