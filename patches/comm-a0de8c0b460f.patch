+  return email.split("@").at(-1) || "";
+}
+
+function matchesCondition(haystack, condition = {}) {
+  const value = limitedString(condition.value);
+  if (!value) {
+    return true;
+  }
+  if (condition.mode == "regex") {
+    const source = String(haystack ?? "");
+    return (
+      safeRegexTest(value, source, { flags: "iu" }) ||
+      source
+        .split(/\r?\n/u)
+        .some(line => safeRegexTest(value, line, { flags: "iu" }))
+    );
+  }
+  return normalizeText(haystack).includes(normalizeText(value));
+}
+
+function matchAllUnique(text, pattern, limit = 6) {
+  const regex = new RegExp(pattern.source, pattern.flags);
+  const matches = new Set();
+  for (const match of String(text ?? "").matchAll(regex)) {
+    matches.add(limitedString(match[1] ?? match[0], 160));
+    if (matches.size >= limit) {
+      break;
+    }
+  }
+  return Array.from(matches);
+}
+
+function extractSlots(text, typedSlots = []) {
+  const slots = {};
+  for (const slotType of typedSlots) {
+    const pattern = SLOT_PATTERNS.get(slotType);
+    if (!pattern) {
+      continue;
+    }
+    const values = matchAllUnique(text, pattern, 6);
+    if (values.length) {
+      slots[slotType] = values;
+    }
+  }
+  return slots;
+}
+
+function slotifiedText(text = "", typedSlots = []) {
+  let output = limitedString(text, 240);
+  for (const slotType of typedSlots) {
+    const pattern = SLOT_PATTERNS.get(slotType);
+    if (!pattern) {
+      continue;
+    }
+    output = output.replace(
+      new RegExp(pattern.source, pattern.flags),
+      `{{${slotType}}}`
+    );
+  }
+  return output;
+}
+
+function renderTemplateSummary(templateText = "", slots = {}) {
+  let output = limitedString(templateText, 600);
+  for (const [slotType, values] of Object.entries(slots)) {
+    output = output.replaceAll(`{{${slotType}}}`, values[0] || "");
+  }
+  return output.trim();
+}
+
+function templateFamilyFor(template = {}) {
+  return `template:${template.id}`;
+}
+
+function templateScore(message, template) {
+  const body = message.body || message.localText || "";
+  // An empty manual template used to match every message, making its test
+  // result look like a mined family (for example, “50 of 50”). A template
+  // must have at least one explicit mailbox predicate before it can affect
+  // analysis; typed slots enrich a match but do not define its scope.
+  if (
+    ![
+      template.match?.from?.value,
+      template.match?.subject?.value,
+      template.match?.body?.value,
+    ].some(value => String(value || "").trim())
+  ) {
+    return null;
+  }
+  if (
+    !matchesCondition(message.author, template.match?.from) ||
+    !matchesCondition(message.subject, template.match?.subject) ||
+    !matchesCondition(body, template.match?.body)
+  ) {
+    return null;
+  }
+  const slots = extractSlots(
+    [message.subject, body].filter(Boolean).join("\n"),
+    template.match?.typedSlots || []
+  );
+  for (const slotType of template.match?.typedSlots || []) {
+    if (!slots[slotType]?.length) {
+      return null;
+    }
+  }
+  let score = 0;
+  if (template.match?.from?.value) {
+    score += 3;
+  }
+  if (template.match?.subject?.value) {
+    score += 3;
+  }
+  if (template.match?.body?.value) {
+    score += 2;
+  }
+  score += Object.keys(slots).length;
+  if (template.summaryTemplate) {
+    score += 1;
+  }
+  return { score, slots };
+}
+
+function inferSlotTypes(messages = []) {
+  const candidates = [];
+  for (const slotType of SLOT_TYPES) {
+    const everyMessageHasSlot = messages.every(message => {
+      const values = extractSlots(
+        [message.subject, message.body].filter(Boolean).join("\n"),
+        [slotType]
+      );
+      return values[slotType]?.length;
+    });
+    if (everyMessageHasSlot) {
+      candidates.push(slotType);
+    }
+  }
+  return candidates.slice(0, 4);
+}
+
+function inferTemplate(messages = [], options = {}) {
+  const normalizedMessages = messages
+    .map(message => {
+      return {
+        messageId: limitedString(message.messageId, 200),
+        author: limitedString(message.author, 200),
+        subject: limitedString(message.subject, 240),
+        body: limitedString(message.body || message.localText, MAX_TEXT),
+      };
+    })
+    .filter(message => message.author || message.subject || message.body);
