diff --git a/mail/test/marionette/test_ai_old_profile_smoke.py b/mail/test/marionette/test_ai_old_profile_smoke.py
new file mode 100644
--- /dev/null
+++ b/mail/test/marionette/test_ai_old_profile_smoke.py
@@ -0,0 +1,332 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+import hashlib
+import json
+from pathlib import Path
+
+from marionette_driver import Wait
+from marionette_harness import MarionetteTestCase
+
+
+SOURCE_ID = "source-old-profile-migration"
+SOURCE_URL = "http://127.0.0.1:11434/v1/chat/completions"
+SOURCE_MODEL = "llama3.2"
+FOLDER_NAME = "AIOldProfileMigration"
+
+
+class TestAIOldProfileSmoke(MarionetteTestCase):
+    """Verify that a helper-era profile migrates without losing user data."""
+
+    def setUp(self):
+        MarionetteTestCase.setUp(self)
+        self.marionette.set_context(self.marionette.CONTEXT_CHROME)
+        self.marionette.timeout.script = 120
+
+    def run_async(self, script, script_args=None):
+        wrapped = f"""
+            let args = Array.from(arguments);
+            let resolve = args.pop();
+            (async () => {{
+                try {{
+                    resolve(["ok", await (async (...scriptArgs) => {{ {script} }})(...args)]);
+                }} catch (error) {{
+                    resolve(["error", error?.message || String(error), error?.stack || ""]);
+                }}
+            }})();
+        """
+        result = self.marionette.execute_async_script(
+            wrapped,
+            script_args=script_args or [],
+            new_sandbox=False,
+        )
+        if result[0] != "ok":
+            raise AssertionError(f"Async chrome script failed: {result[1]}\n{result[2]}")
+        return result[1]
+
+    def mail_store_digest(self):
+        profile = Path(self.marionette.profile_path)
+        digest = {}
+        for root_name in ("Mail", "ImapMail"):
+            root = profile / root_name
+            if not root.exists():
+                continue
+            for path in root.rglob("*"):
+                if not path.is_file() or path.suffix == ".msf":
+                    continue
+                relative = path.relative_to(profile).as_posix()
+                digest[relative] = {
+                    "size": path.stat().st_size,
+                    "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+                }
+        return digest
+
+    def test_old_profile_migrates_to_endpoint_without_data_loss(self):
+        seeded = self.run_async(
+            """
+            const { MailServices } = ChromeUtils.importESModule(
+              "resource:///modules/MailServices.sys.mjs"
+            );
+            const { AIService } = ChromeUtils.importESModule(
+              "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+            );
+            const { AIStorage } = ChromeUtils.importESModule(
+              "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+            );
+            const { AISources } = ChromeUtils.importESModule(
+              "resource:///modules/AISources.sys.mjs"
+            );
+            await AIService.init();
+            await AISources.init();
+
+            let localServer;
+            try {
+              localServer = MailServices.accounts.localFoldersServer;
+            } catch {
+              MailServices.accounts.createLocalMailAccount();
+              localServer = MailServices.accounts.localFoldersServer;
+            }
+            const root = localServer.rootFolder.QueryInterface(
+              Ci.nsIMsgLocalMailFolder
+            );
+            let folder = root.getChildNamed("AIOldProfileMigration");
+            if (!folder) {
+              folder = root.createLocalSubfolder("AIOldProfileMigration");
+            }
+            if (!folder.hasMessages) {
+              folder.QueryInterface(Ci.nsIMsgLocalMailFolder).addMessage([
+                "From: Migration Sender <migration@example.invalid>",
+                "To: Migration Recipient <recipient@example.invalid>",
+                "Subject: Preserve this old-profile message",
+                "Message-ID: <ai-old-profile-migration@example.invalid>",
+                "Date: Tue, 19 Aug 2026 09:00:00 +0530",
+                "MIME-Version: 1.0",
+                "Content-Type: text/plain; charset=UTF-8",
+                "",
+                "The migration acceptance value is forty-two.",
+                "",
+              ].join("\\r\\n"));
+            }
+            const msgHdr = [...folder.messages][0];
+            const messageId = `${folder.URI}#${msgHdr.messageKey}`;
+            AIStorage.setMessage(messageId, {
+              accountKey: localServer.key,
+              folderURI: folder.URI,
+              messageKey: msgHdr.messageKey,
+              subject: msgHdr.mime2DecodedSubject,
+              author: msgHdr.mime2DecodedAuthor,
+              summary: "Preserved migration analysis.",
+              category: "operations",
+              localText: "The migration acceptance value is forty-two.",
+              embedding: [1, 0, 0],
+            });
+            await AISources.upsertSource({
+              id: "source-old-profile-migration",
+              name: "Preserved old-profile endpoint",
+              type: "openai-compatible",
+              endpointURL: "http://127.0.0.1:11434/v1/chat/completions",
+              model: "llama3.2",
+              organization: "",
+              project: "",
+              background: true,
+              allowCloud: false,
+            });
+
+            Services.prefs.setBoolPref("mail.ai.enabled", true);
+            Services.prefs.setStringPref("mail.ai.provider", "source");
+            Services.prefs.setStringPref(
+              "mail.ai.source_id",
+              "source-old-profile-migration"
+            );
+            Services.prefs.setStringPref("mail.ai.assistant.mode", "gpu-local");
+            Services.prefs.setStringPref(
+              "mail.ai.assistant.cpu_model_id",
+              "legacy-assistant-cpu"
+            );
+            Services.prefs.setStringPref(
+              "mail.ai.assistant.gpu_model_id",
+              "legacy-assistant-gpu"
+            );
+            Services.prefs.setStringPref(
+              "mail.ai.assistant_fallback.source_id",
+              "source-old-profile-migration"
+            );
+            Services.prefs.setStringPref(
+              "mail.ai.llm_chat.source_id",
+              "source-old-profile-migration"
+            );
+            Services.prefs.setBoolPref(
+              "mail.ai.assistant.allow_external_fallback",
+              true
+            );
+            Services.prefs.setStringPref("mail.ai.summaries.mode", "helper-local");
+            Services.prefs.setBoolPref("mail.ai.summaries.allow_llm_fallback", true);
+            Services.prefs.setStringPref("mail.ai.embeddings.mode", "onnx-local");
+            Services.prefs.setStringPref(
+              "mail.ai.helper.llama.gpu_offload_mode",
+              "max"
+            );
+            Services.prefs.setBoolPref("mail.ai.helper.debug_bridge.enabled", true);
+
+            await new Promise(resolve => setTimeout(resolve, 300));
+            return { folderURI: folder.URI, messageId };
+            """
+        )
+        digest_before = self.mail_store_digest()
+
+        self.marionette.quit(in_app=True)
+
+        profile = Path(self.marionette.profile_path)
+        artifact_path = profile / "ai-models" / "legacy-assistant.gguf"
+        artifact_path.parent.mkdir(parents=True, exist_ok=True)
+        artifact_path.write_bytes(b"retained legacy model fixture\n")
+        registry_path = profile / "ai-local-models.json"
+        registry_path.write_text(
+            json.dumps(
+                {
+                    "version": 2,
+                    "models": [
+                        {
+                            "id": "legacy-assistant-cpu",
+                            "name": "Legacy Assistant CPU",
+                            "kind": "generator",
+                            "backend": "gguf",
+                            "installed": True,
+                            "artifactPath": str(artifact_path),
+                        },
+                        {
+                            "id": "legacy-summarizer",
+                            "name": "Legacy Summarizer",
+                            "kind": "generator",
+                            "backend": "onnx",
+                            "installed": True,
+                        },
+                        {
+                            "id": "legacy-embedder",
+                            "name": "Legacy Embedder",
+                            "kind": "embedder",
+                            "backend": "onnx",
+                            "installed": True,
+                        },
+                        {
+                            "id": "legacy-pii",
+                            "name": "Legacy PII",
+                            "kind": "classifier",
+                            "backend": "onnx",
+                            "installed": True,
+                        },
+                    ],
+                    "roleAssignments": {
+                        "assistant": "legacy-assistant-cpu",
+                        "summarizer": "legacy-summarizer",
+                        "embedder": "legacy-embedder",
+                        "pii-recognizer": "legacy-pii",
+                        "category-classifier": "legacy-pii",
+                        "spam-advisory": "legacy-pii",
+                    },
+                    "assistantBundleId": "legacy-helper-bundle",
+                },
+                indent=2,
+            ),
+            encoding="utf-8",
+        )
+
+        self.marionette.start_session()
+        self.marionette.set_context(self.marionette.CONTEXT_CHROME)
+        self.marionette.timeout.script = 120
+        Wait(self.marionette, timeout=30).until(
+            lambda mn: len(mn.chrome_window_handles) >= 1
+        )
+
+        migrated = self.run_async(
+            """
+            const [folderURI, messageId] = scriptArgs;
+            const { AIService } = ChromeUtils.importESModule(
+              "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+            );
+            const { AIModelRuntime } = ChromeUtils.importESModule(
+              "moz-src:///comm/mail/components/ai/modules/AIModelRuntime.sys.mjs"
+            );
+            const { AILocalModels } = ChromeUtils.importESModule(
+              "moz-src:///comm/mail/components/ai/modules/AILocalModels.sys.mjs"
+            );
+            const { AISources } = ChromeUtils.importESModule(
+              "resource:///modules/AISources.sys.mjs"
+            );
+            const { AIStorage } = ChromeUtils.importESModule(
+              "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+            );
+            await AIService.init();
+            const runtime = await AIService.getRuntimeSnapshot(null);
+            const source = AISources.getSource("source-old-profile-migration");
+            const roles = AILocalModels.getRoleAssignments();
+            const legacyModel = AILocalModels.getModel("legacy-assistant-cpu");
+            const record = AIStorage.getMessage(messageId);
+            return {
+              runtime,
+              source,
+              roles,
+              legacyModel,
+              record,
+              folderURI,
+              prefs: {
+                assistantMode: Services.prefs.getStringPref("mail.ai.assistant.mode"),
+                summariesMode: Services.prefs.getStringPref("mail.ai.summaries.mode"),
+                embeddingsMode: Services.prefs.getStringPref("mail.ai.embeddings.mode"),
+                sourceId: Services.prefs.getStringPref("mail.ai.source_id"),
+                retiredStillSet: [
+                  "mail.ai.assistant.cpu_model_id",
+                  "mail.ai.assistant.gpu_model_id",
+                  "mail.ai.assistant_fallback.source_id",
+                  "mail.ai.llm_chat.source_id",
+                  "mail.ai.assistant.allow_external_fallback",
+                  "mail.ai.summaries.allow_llm_fallback",
+                  "mail.ai.helper.llama.gpu_offload_mode",
+                  "mail.ai.helper.debug_bridge.enabled",
+                ].filter(pref => Services.prefs.prefHasUserValue(pref)),
+              },
+              helper: {
+                status: AIModelRuntime.status(),
+                bridge: AIModelRuntime.getDebugBridgeStatus(),
+              },
+            };
+            """,
+            [seeded["folderURI"], seeded["messageId"]],
+        )
+
+        self.assertEqual(migrated["prefs"]["assistantMode"], "endpoint")
+        self.assertEqual(migrated["prefs"]["summariesMode"], "endpoint-first")
+        self.assertEqual(migrated["prefs"]["embeddingsMode"], "endpoint-first")
+        self.assertEqual(migrated["prefs"]["sourceId"], SOURCE_ID)
+        self.assertEqual(migrated["prefs"]["retiredStillSet"], [])
+
