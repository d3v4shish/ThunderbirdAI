new file mode 100644
--- /dev/null
+++ b/mail/components/ai/modules/AIJSONStore.sys.mjs
@@ -0,0 +1,210 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { JSONFile } from "resource://gre/modules/JSONFile.sys.mjs";
+import { AIRuntimePaths } from "moz-src:///comm/mail/components/ai/modules/AIRuntimePaths.sys.mjs";
+
+const MAX_OWNER_LENGTH = 120;
+const MAX_STORE_ID_LENGTH = 80;
+const RECOVERY_FILE_RE = /^([a-z0-9-]+)--(\d+)--(.+)$/i;
+
+function limitedString(value = "", limit = 2000) {
+  return String(value ?? "")
+    .replace(/\0/g, "")
+    .trim()
+    .slice(0, limit);
+}
+
+function normalizedStoreId(storeId = "") {
+  const normalized = limitedString(storeId, MAX_STORE_ID_LENGTH)
+    .toLocaleLowerCase()
+    .replace(/[^a-z0-9-]+/g, "-")
+    .replace(/^-+|-+$/g, "");
+  return normalized || "ai-json-store";
+}
+
+function archiveFileName(path = "", storeId = "") {
+  return [
+    normalizedStoreId(storeId),
+    Date.now(),
+    `${Math.random().toString(36).slice(2, 8)}-${PathUtils.filename(path)}`,
+  ].join("--");
+}
+
+async function archiveBrokenStore(path = "", storeId = "") {
+  if (!(await IOUtils.exists(path))) {
+    return "";
+  }
+  const recoveryRootDir = AIRuntimePaths.recoveryRootDir();
+  await IOUtils.makeDirectory(recoveryRootDir, {
+    createAncestors: true,
+    ignoreExisting: true,
+  });
+  const archivePath = PathUtils.join(
+    recoveryRootDir,
+    archiveFileName(path, storeId)
+  );
+  try {
+    await IOUtils.move(path, archivePath, { noOverwrite: false });
+    return archivePath;
+  } catch {
+    return "";
+  }
+}
+
+function recoveryEntryFromPath(path = "", sizeBytes = 0) {
+  const fileName = PathUtils.filename(path);
+  const match = fileName.match(RECOVERY_FILE_RE);
+  if (!match) {
+    return null;
+  }
+  const storeId = normalizedStoreId(match?.[1] || "");
+  const recoveredAtMs = Number(match?.[2]) || 0;
+  return {
+    path,
+    fileName,
+    storeId,
+    recoveredAtMs,
+    recoveredAt: recoveredAtMs ? new Date(recoveredAtMs).toISOString() : "",
+    sizeBytes: Number(sizeBytes) || 0,
+  };
+}
+
+function inventoryFromArchives(path = "", archives = []) {
+  const storeMap = new Map();
+  let sizeBytes = 0;
+  for (const archive of archives) {
+    sizeBytes += archive.sizeBytes;
+    if (!storeMap.has(archive.storeId)) {
+      storeMap.set(archive.storeId, {
+        storeId: archive.storeId,
+        count: 0,
+        sizeBytes: 0,
+        lastRecoveredAt: "",
+      });
+    }
+    const row = storeMap.get(archive.storeId);
+    row.count++;
+    row.sizeBytes += archive.sizeBytes;
+    if (!row.lastRecoveredAt || row.lastRecoveredAt < archive.recoveredAt) {
+      row.lastRecoveredAt = archive.recoveredAt;
+    }
+  }
+  return {
+    path,
+    count: archives.length,
+    sizeBytes,
+    archives: archives
+      .slice()
+      .sort((left, right) => right.recoveredAtMs - left.recoveredAtMs),
+    stores: [...storeMap.values()].sort((left, right) => {
+      return (
+        right.count - left.count ||
+        right.lastRecoveredAt.localeCompare(left.lastRecoveredAt) ||
+        left.storeId.localeCompare(right.storeId)
+      );
+    }),
+  };
+}
+
+export async function initRecoverableJSONStore({
+  path = "",
+  storeId = "",
+  owner = "",
+  dataPostProcessor = data => data,
+  ...jsonFileOptions
+} = {}) {
+  const jsonFile = new JSONFile({
+    path,
+    ...jsonFileOptions,
+  });
+  let rawData = {};
+  let recovery = null;
+  const normalizedOwner = limitedString(owner, MAX_OWNER_LENGTH);
+
+  try {
+    rawData = await IOUtils.readJSON(path);
+  } catch (error) {
+    if (!(DOMException.isInstance(error) && error.name == "NotFoundError")) {
+      recovery = {
+        storeId: normalizedStoreId(storeId),
+        owner: normalizedOwner,
+        path,
+        archivedPath: await archiveBrokenStore(path, storeId),
+        reason: "read-failed",
+        recoveredAt: new Date().toISOString(),
+        error: limitedString(error?.message || error),
+      };
+    }
+    rawData = {};
+  }
+
+  try {
+    jsonFile.data = dataPostProcessor(rawData);
+  } catch (error) {
+    recovery ||= {
+      storeId: normalizedStoreId(storeId),
+      owner: normalizedOwner,
+      path,
+      archivedPath: await archiveBrokenStore(path, storeId),
+      reason: "normalize-failed",
+      recoveredAt: new Date().toISOString(),
+      error: limitedString(error?.message || error),
+    };
+    try {
+      jsonFile.data = dataPostProcessor({});
+    } catch (fallbackError) {
+      recovery.fallbackError = limitedString(
+        fallbackError?.message || fallbackError
+      );
+      jsonFile.data = {};
+    }
+  }
+
+  if (recovery) {
+    jsonFile.saveSoon();
+  }
+
+  return {
+    jsonFile,
+    recovery,
+  };
+}
+
+export async function getJSONStoreRecoveryInventory() {
+  const path = AIRuntimePaths.recoveryRootDir();
+  let children = [];
+  try {
+    children = await IOUtils.getChildren(path);
+  } catch {
+    return inventoryFromArchives(path, []);
+  }
+
+  const archives = [];
+  for (const child of children) {
+    try {
+      const stat = await IOUtils.stat(child);
+      if (stat.type == "directory") {
+        continue;
+      }
+      const archive = recoveryEntryFromPath(child, stat.size);
+      if (archive) {
+        archives.push(archive);
+      }
+    } catch {}
+  }
+  return inventoryFromArchives(path, archives);
+}
+
+export async function clearJSONStoreRecoveryArchives(storeId = "") {
+  const normalized = normalizedStoreId(storeId);
+  const inventory = await getJSONStoreRecoveryInventory();
+  for (const archive of inventory.archives) {
+    if (storeId && archive.storeId != normalized) {
+      continue;
+    }
+    await IOUtils.remove(archive.path, { ignoreAbsent: true });
+  }
+  return getJSONStoreRecoveryInventory();
+}
