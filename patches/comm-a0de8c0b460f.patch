+});
+
+add_task(async function test_prompt_building_and_override() {
+  await AIPromptConfig.clearGeneratedData();
+  AIPromptConfig.setFeatureInstruction("assistant", "Feature text");
+  AIPromptConfig.setSourceInstruction("source-1", "Source text");
+  Assert.equal(
+    AIPromptConfig.buildPrompt("assistant", "Base prompt", {
+      sourceId: "source-1",
+    }),
+    "Base prompt\n\nFeature text\n\nSource text"
+  );
+  AIPromptConfig.setRawOverride("assistant", "Raw prompt");
+  Assert.equal(
+    AIPromptConfig.buildPrompt("assistant", "Base prompt", {
+      sourceId: "source-1",
+    }),
+    "Raw prompt"
+  );
+});
+
+add_task(
+  async function test_legacy_conversational_prompts_migrate_to_assistant_prompt() {
+    await AIPromptConfig.clearGeneratedData();
+    await IOUtils.writeUTF8(
+      PathUtils.join(PathUtils.profileDir, "ai-prompts.json"),
+      JSON.stringify({
+        version: 1,
+        featureInstructions: {
+          chat: "Legacy chat instruction",
+        },
+        rawOverrides: {
+          "llm-chat": "Legacy raw override",
+        },
+      })
+    );
+    AIPromptConfig._jsonFile = null;
+    await AIPromptConfig.init();
+
+    const config = AIPromptConfig.getConfig();
+    Assert.equal(
+      config.featureInstructions.assistant,
+      "Legacy chat instruction",
+      "legacy conversational instructions should migrate to Assistant"
+    );
+    Assert.ok(
+      !("chat" in config.featureInstructions),
+      "legacy chat feature keys should not survive migration"
+    );
+    Assert.ok(
+      !("llm-chat" in config.featureInstructions),
+      "legacy llm-chat feature keys should not survive migration"
+    );
+    Assert.equal(
+      config.rawOverrides.assistant,
+      "Legacy raw override",
+      "legacy conversational raw overrides should migrate to Assistant"
+    );
+    Assert.ok(
+      !("chat" in config.rawOverrides),
+      "legacy chat raw override keys should not survive migration"
+    );
+    Assert.ok(
+      !("llm-chat" in config.rawOverrides),
+      "legacy llm-chat raw override keys should not survive migration"
+    );
+    Assert.equal(
+      AIPromptConfig.buildPrompt("assistant", "Base prompt"),
+      "Legacy raw override",
+      "Assistant callers should resolve through the migrated Assistant prompt"
+    );
+    Assert.equal(
+      AIPromptConfig.buildPrompt("chat", "Base prompt"),
+      "Legacy raw override",
+      "legacy chat callers should resolve through the Assistant prompt"
+    );
+    Assert.equal(
+      AIPromptConfig.buildPrompt("llm-chat", "Base prompt"),
+      "Legacy raw override",
+      "legacy llm-chat callers should resolve through the Assistant prompt"
+    );
+  }
+);
+
+add_task(
+  async function test_legacy_conversational_prompts_do_not_override_assistant_prompt() {
+    await AIPromptConfig.clearGeneratedData();
+    await IOUtils.writeUTF8(
+      PathUtils.join(PathUtils.profileDir, "ai-prompts.json"),
+      JSON.stringify({
+        version: 1,
+        featureInstructions: {
+          assistant: "Current Assistant instruction",
+          chat: "Legacy chat instruction",
+        },
+        rawOverrides: {
+          assistant: "Current Assistant override",
+          "llm-chat": "Legacy raw override",
+        },
+      })
+    );
+    AIPromptConfig._jsonFile = null;
+    await AIPromptConfig.init();
+
+    const config = AIPromptConfig.getConfig();
+    Assert.equal(
+      config.featureInstructions.assistant,
+      "Current Assistant instruction",
+      "legacy conversational instructions should not override Assistant text"
+    );
+    Assert.equal(
+      config.rawOverrides.assistant,
+      "Current Assistant override",
+      "legacy conversational raw overrides should not override Assistant text"
+    );
+    Assert.equal(
+      AIPromptConfig.buildPrompt("assistant", "Base prompt"),
+      "Current Assistant override",
+      "Assistant prompt resolution should keep the explicit Assistant override"
+    );
+  }
+);
diff --git a/mail/components/ai/test/unit/test_ai_provider_pause.js b/mail/components/ai/test/unit/test_ai_provider_pause.js
new file mode 100644
--- /dev/null
+++ b/mail/components/ai/test/unit/test_ai_provider_pause.js
@@ -0,0 +1,356 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+do_get_profile();
+
+const { AIChat } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIChat.sys.mjs"
+);
+const { AIEndpoint } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIEndpoint.sys.mjs"
+);
+const { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+const { AIStorage } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+);
+
+function pauseProvider(
+  accountKey = "global",
+  errorMessage = "AI endpoint timed out"
+) {
+  AIStorage.recordProviderFailure(accountKey, errorMessage);
+  AIStorage.recordProviderFailure(accountKey, errorMessage);
+  AIStorage.recordProviderFailure(accountKey, errorMessage);
+  Assert.equal(
+    AIStorage.getProviderStatus(accountKey)?.state,
+    "paused",
+    "provider should enter paused state after repeated failures"
+  );
+}
+
+function configuredAssistantConfig({ sourceType = "ollama" } = {}) {
+  return {
+    provider: "source",
+    sourceId: "source-1",
+    sourceName: "LocalAI",
+    sourceType,
+    sourceAvailable: true,
+    endpointURL: "http://127.0.0.1:11434/v1/chat/completions",
+    model: "llama3",
+    background: false,
+    allowCloud: false,
+    enabled: true,
+  };
+}
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  await AIService.clearGeneratedData();
+  registerCleanupFunction(async () => {
+    Services.prefs.setBoolPref("mail.ai.enabled", false);
+    AIService.scheduleAssistantFallbackHealthProbe();
+    Services.prefs.clearUserPref("mail.ai.enabled");
+    await AIService.clearGeneratedData();
+  });
+});
+
+add_task(
+  async function test_assistant_chat_is_suppressed_until_provider_reset() {
+    await AIService.clearGeneratedData();
+    AIStorage.setMessage("folder://inbox#1", {
+      accountKey: "server1",
+      folderURI: "folder://inbox",
+      messageKey: 1,
+      subject: "Example",
+      author: "Alice <alice@example.com>",
+      summary: "Compact summary",
+      category: "personal",
+    });
+
+    const originalCanUse = AIEndpoint.canUseEndpoint;
+    const originalGetConfig = AIEndpoint.getConfig;
+    const originalChatWithDebug = AIEndpoint.chatWithDebug;
+    let callCount = 0;
+    AIEndpoint.canUseEndpoint = () => true;
+    AIEndpoint.getConfig = () =>
+      configuredAssistantConfig({ sourceType: "openai-compatible" });
+    AIEndpoint.chatWithDebug = async () => {
+      callCount++;
+      return {
+        answer: "OK",
+        config: AIEndpoint.getConfig(),
+        attempts: [],
+      };
+    };
+
+    try {
+      pauseProvider("server1");
+
+      const blocked = await AIChat.ask({
+        prompt: "What does this message need?",
+        accountKey: "server1",
+        folderURI: "folder://inbox",
+        scopeMode: "folder",
+      });
+
+      Assert.equal(blocked.status, "unavailable");
+      Assert.ok(blocked.answer.includes("temporarily paused"));
+      Assert.equal(
+        callCount,
+        0,
+        "paused Assistant chat should not reach the endpoint"
+      );
+      let trace = AIStorage.getRecentTraces(1, {
+        type: "assistant",
+        accountKey: "server1",
+      })[0];
+      Assert.equal(trace.status, "unavailable");
+      Assert.equal(trace.pausedBeforeAttempt, true);
+      Assert.ok(!trace.pauseBypassed);
+
+      AIStorage.resetProviderStatus("server1");
+      const resumed = await AIChat.ask({
+        prompt: "What does this message need?",
+        accountKey: "server1",
+        folderURI: "folder://inbox",
+        scopeMode: "folder",
+      });
+
+      Assert.equal(resumed.status, "ok");
+      Assert.equal(
+        callCount,
+        1,
+        "Assistant chat should resume once hold-off is reset"
+      );
+      trace = AIStorage.getRecentTraces(1, {
+        type: "assistant",
+        accountKey: "server1",
+      })[0];
+      Assert.equal(trace.status, "ok");
+      Assert.equal(trace.pausedBeforeAttempt, false);
+    } finally {
+      AIEndpoint.canUseEndpoint = originalCanUse;
+      AIEndpoint.getConfig = originalGetConfig;
+      AIEndpoint.chatWithDebug = originalChatWithDebug;
+    }
+  }
+);
+
+add_task(
+  async function test_raw_assistant_chat_is_suppressed_until_provider_reset() {
+    await AIService.clearGeneratedData();
+
+    const originalCanUse = AIEndpoint.canUseEndpoint;
+    const originalGetConfig = AIEndpoint.getConfig;
+    const originalChatWithDebug = AIEndpoint.chatWithDebug;
+    let callCount = 0;
+    AIEndpoint.canUseEndpoint = () => true;
+    AIEndpoint.getConfig = () => configuredAssistantConfig();
+    AIEndpoint.chatWithDebug = async () => {
+      callCount++;
+      return {
+        answer: "OK",
+        config: AIEndpoint.getConfig(),
+        attempts: [],
+      };
+    };
+
+    try {
+      pauseProvider("server2");
+
+      const blocked = await AIChat.askRaw({
+        prompt: "hello",
+        accountKey: "server2",
+        attachedContextLabel: "Selected messages",
+        attachedContextText: '{"summary":"Example"}',
+      });
+
+      Assert.equal(blocked.status, "unavailable");
+      Assert.ok(blocked.answer.includes("temporarily paused"));
+      Assert.equal(
+        callCount,
+        0,
+        "paused raw Assistant chat should not reach the endpoint"
+      );
+      let trace = AIStorage.getRecentTraces(1, {
+        type: "assistant",
+        accountKey: "server2",
+      })[0];
+      Assert.equal(trace.status, "unavailable");
+      Assert.equal(trace.pausedBeforeAttempt, true);
+      Assert.ok(!trace.pauseBypassed);
+
+      AIStorage.resetProviderStatus("server2");
+      const resumed = await AIChat.askRaw({
+        prompt: "hello",
+        accountKey: "server2",
+        attachedContextLabel: "Selected messages",
+        attachedContextText: '{"summary":"Example"}',
+      });
+
+      Assert.equal(resumed.status, "ok");
+      Assert.equal(
+        callCount,
+        1,
+        "raw Assistant chat should resume once hold-off is reset"
+      );
+      trace = AIStorage.getRecentTraces(1, {
+        type: "assistant",
+        accountKey: "server2",
+      })[0];
+      Assert.equal(trace.status, "ok");
+      Assert.equal(trace.pausedBeforeAttempt, false);
+    } finally {
+      AIEndpoint.canUseEndpoint = originalCanUse;
+      AIEndpoint.getConfig = originalGetConfig;
+      AIEndpoint.chatWithDebug = originalChatWithDebug;
+    }
+  }
+);
+
+add_task(
+  async function test_light_health_probes_continue_during_inference_pause() {
+    await AIService.clearGeneratedData();
+
+    const originalCanUse = AIEndpoint.canUseEndpoint;
+    const originalGetConfig = AIEndpoint.getConfig;
+    const originalTestConnectionDetailed = AIEndpoint.testConnectionDetailed;
+    const originalProbeOllamaHealthDetailed =
+      AIEndpoint.probeOllamaHealthDetailed;
+    let inferenceCallCount = 0;
+    let healthProbeCallCount = 0;
+    AIEndpoint.canUseEndpoint = () => true;
+    AIEndpoint.getConfig = () => configuredAssistantConfig();
+    AIEndpoint.testConnectionDetailed = async () => {
+      inferenceCallCount++;
+      return {
+        answer: "OK",
+        config: AIEndpoint.getConfig(),
+        attempts: [{ attemptNumber: 1, durationMs: 12 }],
+      };
+    };
+    AIEndpoint.probeOllamaHealthDetailed = async () => {
+      healthProbeCallCount++;
+      return {
+        config: AIEndpoint.getConfig(),
+        installedModel: { name: "llama3:latest" },
+        modelCount: 1,
+        latencyMs: 8,
+      };
+    };
+
+    try {
+      pauseProvider("server3");
+
+      await Assert.rejects(
+        AIService.testEndpointDetailed("server3", {
+          role: "assistant-fallback",
+          sourceId: "source-1",
+        }),
+        /temporarily paused/
+      );
+      Assert.equal(
+        inferenceCallCount,
+        0,
+        "explicit endpoint tests should not bypass pause"
+      );
+
+      let health = await AIService.probeAssistantFallbackHealth("server3");
+      Assert.equal(health.state, "paused");
+      Assert.equal(
+        health.reachabilityState,
+        "reachable",
+        "a paused provider can still report Ollama reachability"
+      );
+      Assert.equal(
+        healthProbeCallCount,
+        1,
+        "lightweight health probes should continue during inference hold-off"
+      );
+      Assert.equal(
+        inferenceCallCount,
+        0,
+        "health probes must not perform inference"
+      );
+
+      AIStorage.resetProviderStatus("server3");
+      const result = await AIService.testEndpointDetailed("server3", {
+        role: "assistant-fallback",
+        sourceId: "source-1",
+      });
+      Assert.equal(result.answer, "OK");
+      Assert.equal(inferenceCallCount, 1);
+
+      health = await AIService.probeAssistantFallbackHealth("server3");
+      Assert.equal(health.state, "available");
+      Assert.equal(healthProbeCallCount, 2);
+      Assert.equal(
+        inferenceCallCount,
+        1,
+        "lightweight health probes must remain separate from endpoint tests"
+      );
+    } finally {
+      AIEndpoint.canUseEndpoint = originalCanUse;
+      AIEndpoint.getConfig = originalGetConfig;
+      AIEndpoint.testConnectionDetailed = originalTestConnectionDetailed;
+      AIEndpoint.probeOllamaHealthDetailed = originalProbeOllamaHealthDetailed;
+      Services.prefs.setBoolPref("mail.ai.enabled", false);
+      AIService.scheduleAssistantFallbackHealthProbe();
+      Services.prefs.setBoolPref("mail.ai.enabled", true);
+    }
+  }
+);
+
+add_task(async function test_prompt_sandbox_stays_suppressed_until_reset() {
+  await AIService.clearGeneratedData();
+
+  const originalCanUse = AIEndpoint.canUseEndpoint;
+  const originalGetConfig = AIEndpoint.getConfig;
+  const originalChatWithDebug = AIEndpoint.chatWithDebug;
+  let callCount = 0;
+  AIEndpoint.canUseEndpoint = () => true;
+  AIEndpoint.getConfig = () => configuredAssistantConfig();
+  AIEndpoint.chatWithDebug = async () => {
+    callCount++;
+    return {
+      answer: "Sandbox OK",
+      config: AIEndpoint.getConfig(),
+      attempts: [],
+    };
+  };
+
+  try {
+    pauseProvider("global");
+
+    const blocked = await AIService.testPromptSandbox({
+      feature: "assistant",
+      sourceId: "source-1",
+    });
+    Assert.ok(!blocked.ok);
+    Assert.ok(blocked.errorMessage.includes("temporarily paused"));
+    Assert.equal(callCount, 0, "prompt sandbox should not bypass pause");
+    let trace = AIStorage.getTrace(blocked.traceId);
+    Assert.equal(trace.status, "failed");
+    Assert.equal(trace.attempts.length, 0);
+
+    AIStorage.resetProviderStatus("global");
+    const resumed = await AIService.testPromptSandbox({
+      feature: "assistant",
+      sourceId: "source-1",
+    });
+    Assert.ok(resumed.ok);
+    Assert.equal(
+      callCount,
+      1,
+      "prompt sandbox should resume once hold-off is reset"
+    );
+    trace = AIStorage.getTrace(resumed.traceId);
+    Assert.equal(trace.status, "ok");
+  } finally {
