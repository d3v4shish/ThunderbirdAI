+
+const tabmail = document.getElementById("tabmail");
+const about3Pane = tabmail.currentAbout3Pane;
+const generator = new MessageGenerator();
+const ANALYZED_AT = 123456;
+const SCAN_UPDATED_AT = 123499;
+
+let account;
+
+function messageIdForHeader(msgHdr) {
+  return `${msgHdr.folder.URI}#${msgHdr.messageKey}`;
+}
+
+function stage(id, status = "complete") {
+  return { id, status };
+}
+
+function seedRecord(msgHdr) {
+  const messageId = messageIdForHeader(msgHdr);
+  AttachmentScanCache.setSummary(msgHdr, "clean");
+  msgHdr.setStringProperty("aiSecurityVerdict", "review");
+  msgHdr.setStringProperty("aiSummary", "Baseline summary");
+  msgHdr.setStringProperty("aiTooltipSummary", "Baseline summary");
+  msgHdr.setStringProperty("aiTemplateName", "Invoice template");
+  msgHdr.setStringProperty("aiScanState", "scanned");
+  msgHdr.setUint32Property("aiLastAnalyzedAt", ANALYZED_AT);
+  msgHdr.setUint32Property("aiScanUpdatedAt", SCAN_UPDATED_AT);
+  AIStorage.setMessage(messageId, {
+    accountKey: account.incomingServer.key,
+    folderURI: msgHdr.folder.URI,
+    messageKey: msgHdr.messageKey,
+    subject: msgHdr.mime2DecodedSubject,
+    author: msgHdr.mime2DecodedAuthor,
+    date: msgHdr.dateInSeconds,
+    summary: "Baseline summary",
+    summarySource: "local-model",
+    embedding: [1, 0, 1],
+    matchedTemplateId: "template-1",
+    matchedTemplateName: "Invoice template",
+    templateFamily: "invoice",
+    templateSlots: {
+      amount: ["$19.99"],
+      date: ["Friday"],
+    },
+    templateConfig: {
+      extractionFields: ["amount", "date"],
+      suppressions: [],
+      piiFields: [],
+    },
+    templateCategory: "finance",
+    templateCategoryMode: "override",
+    extractions: [
+      {
+        ruleId: "rule-1",
+        ruleName: "Order id",
+        entities: {
+          order_id: ["ORDER-42"],
+        },
+      },
+    ],
+    extractedEntities: {
+      amount: ["$19.99"],
+      date: ["Friday"],
+      order_id: ["ORDER-42"],
+      links: ["https://phish.invalid/review"],
+    },
+    securityAssessment: {
+      verdict: "review",
+      summary: "Link needs review",
+    },
+    timelineStages: [
+      stage("parser"),
+      stage("template"),
+      stage("extraction"),
+      stage("security"),
+      stage("embedding"),
+      stage("summary"),
+    ],
+    tooltipSummary: "Baseline summary",
+  });
+}
+
+function assertNeighborStillComplete(messageId) {
+  const neighborRecord = AIStorage.getMessage(messageId);
+  Assert.ok(neighborRecord, "Neighbor record should remain present");
+  Assert.equal(neighborRecord.summary, "Baseline summary");
+  Assert.deepEqual(neighborRecord.embedding, [1, 0, 1]);
+  Assert.equal(neighborRecord.matchedTemplateName, "Invoice template");
+  Assert.equal(neighborRecord.extractions[0].ruleId, "rule-1");
+  Assert.equal(neighborRecord.securityAssessment.verdict, "review");
+}
+
+function assertPendingStage(record, stageId) {
+  const timelineStage = record.timelineStages.find(
+    timelineEntry => timelineEntry.id == stageId
+  );
+  Assert.equal(
+    timelineStage?.status,
+    "pending",
+    `${stageId} should be marked pending after the artifact clear`
+  );
+}
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  Services.prefs.setBoolPref("mail.ai.backfill.enabled", false);
