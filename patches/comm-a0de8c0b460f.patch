+  async #urlReputationRows(links = []) {
+    const providers = this.#urlReputationProviders.length
+      ? this.#urlReputationProviders
+      : [
+          {
+            id: "local-cache",
+            privacy: "local",
+            ttlSeconds: 86400,
+            lookup: async url => ({
+              verdict: "unknown",
+              confidence: "low",
+              url,
+            }),
+          },
+        ];
+    const allowExternal = Services.prefs.getBoolPref(
+      "mail.security.url_reputation.allow_external",
+      false
+    );
+    const cache = await readSecurityJSON("url-reputation-cache.json", {});
+    const nowMs = Date.now();
+    const rows = [];
+    for (const link of links) {
+      const url = link.realURL || link.visibleText || "";
+      if (!url) {
+        continue;
+      }
+      for (const provider of providers) {
+        const providerId = String(provider.id || provider.name || "provider");
+        const privacy = String(provider.privacy || "local");
+        const cacheKey = `${providerId}\n${url}`;
+        const cached = cache[cacheKey];
+        const ttlSeconds = Number(
+          provider.ttlSeconds || cached?.ttlSeconds || 86400
+        );
+        if (
+          cached?.checkedAt &&
+          nowMs - Number(cached.checkedAt) < ttlSeconds * 1000
+        ) {
+          rows.push({
+            ...cached,
+            url,
+            realURL: url,
+            reputationProvider: providerId,
+            provider: providerId,
+            privacy,
+            cacheAge: `${Math.max(0, Math.round((nowMs - cached.checkedAt) / 1000))}s`,
+            cached: true,
+          });
+          continue;
+        }
+        if (privacy == "external" && !allowExternal) {
+          rows.push({
+            url,
+            realURL: url,
+            reputationProvider: providerId,
+            provider: providerId,
+            privacy,
+            reputationVerdict: "unknown",
+            verdict: "unknown",
+            reputationConfidence: "none",
+            confidence: "none",
+            reputationError: "privacy-disabled",
+            error: "privacy-disabled",
+            cacheAge: "not cached",
+          });
+          continue;
+        }
+        try {
+          const result = (await provider.lookup(url, { link })) || {};
+          const row = {
+            url,
+            realURL: url,
+            reputationProvider: providerId,
+            provider: providerId,
+            privacy,
+            reputationVerdict:
+              result.verdict || result.reputationVerdict || "unknown",
+            verdict: result.verdict || result.reputationVerdict || "unknown",
+            reputationConfidence:
+              result.confidence || result.reputationConfidence || "unknown",
+            confidence:
+              result.confidence || result.reputationConfidence || "unknown",
+            cacheAge: "live",
+            ttlSeconds,
+            checkedAt: nowMs,
+          };
+          cache[cacheKey] = row;
+          rows.push(row);
+        } catch (error) {
+          rows.push({
+            url,
+            realURL: url,
+            reputationProvider: providerId,
+            provider: providerId,
+            privacy,
+            reputationVerdict: "unknown",
+            verdict: "unknown",
+            reputationConfidence: "none",
+            confidence: "none",
+            reputationError: error.message,
+            error: error.message,
+            cacheAge: "not cached",
+          });
+        }
+      }
+    }
+    await writeSecurityJSON("url-reputation-cache.json", cache);
+    return rows;
+  }
+
+  #linksWithReputation(links = [], rows = []) {
+    return links.map(link => {
+      const matches = rows.filter(
+        row => row.url == link.realURL || row.realURL == link.realURL
+      );
+      const match =
+        matches.find(
+          row =>
+            (row.verdict || row.reputationVerdict) &&
+            (row.verdict || row.reputationVerdict) != "unknown" &&
+            !(row.error || row.reputationError)
+        ) ||
+        matches.find(row => !(row.error || row.reputationError)) ||
+        matches[0];
+      if (!match) {
+        return link;
+      }
+      const verdict =
+        match.verdict ||
+        match.reputationVerdict ||
+        link.reputationVerdict ||
+        "unknown";
+      const existingVerdict = link.reputationVerdict || "";
+      return {
+        ...link,
+        reputationProvider: match.provider || match.reputationProvider,
+        reputationVerdict:
+          verdict == "unknown" && existingVerdict ? existingVerdict : verdict,
+        reputationConfidence: match.confidence || match.reputationConfidence,
+        reputationError: match.error || match.reputationError || "",
+        cacheAge: match.cacheAge || "",
+      };
+    });
+  }
