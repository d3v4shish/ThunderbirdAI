+
+        const targetRecord = AIStorage.getMessage(targetId);
+        if (artifact == "all") {
+          Assert.equal(targetRecord, null);
+          Assert.equal(targetHdr.getStringProperty("aiSummary"), "");
+          Assert.equal(targetHdr.getStringProperty("aiTemplateName"), "");
+          Assert.equal(targetHdr.getStringProperty("aiSecurityVerdict"), "");
