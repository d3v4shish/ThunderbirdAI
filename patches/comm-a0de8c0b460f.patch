+      about3Pane.threadTree.invalidate = originalInvalidate;
+      for (const [hdr, snapshot] of snapshots) {
+        restoreThreadMarkerState(hdr, snapshot);
+      }
+      restoreThreadListViewPref(originalListViewPref);
+      if (!analysisWasPaused) {
+        AIService.resumeAnalysis();
+      }
+    }
+  }
