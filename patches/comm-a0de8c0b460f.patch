+
+function extractAttachedContextText(request = []) {
+  const userMessage = Array.isArray(request) ? request[1]?.content || "" : "";
+  const marker = "ATTACHED_CONTEXT_JSON:\n";
+  const index = userMessage.indexOf(marker);
+  Assert.greaterOrEqual(
+    index,
+    0,
+    "raw Assistant request should include attached context"
+  );
+  return userMessage.slice(index + marker.length);
+}
+
+function extractEmailJSON(request = []) {
+  const userMessage = Array.isArray(request) ? request[1]?.content || "" : "";
+  const marker = "EMAIL_JSON:\n";
+  const index = userMessage.indexOf(marker);
+  Assert.greaterOrEqual(index, 0, "summary request should include EMAIL_JSON");
+  return JSON.parse(userMessage.slice(index + marker.length));
+}
+
+function stubAssistantEndpoint() {
+  const originalCanUse = AIEndpoint.canUseEndpoint;
+  const originalGetConfig = AIEndpoint.getConfig;
+  const originalChatWithDebug = AIEndpoint.chatWithDebug;
+  const originalChat = AIEndpoint.chat;
+  const seen = [];
+
+  AIEndpoint.canUseEndpoint = () => true;
+  AIEndpoint.getConfig = () => ({
+    provider: "source",
+    sourceId: "source-1",
+    sourceName: "LocalAI",
+    sourceType: "ollama",
+    endpointURL: "http://127.0.0.1:11434/v1/chat/completions",
+    model: "llama3",
+  });
+  AIEndpoint.chatWithDebug = async input => {
+    seen.push(input);
+    return {
+      answer: "OK",
+      config: AIEndpoint.getConfig(),
+      attempts: [],
+    };
+  };
+  AIEndpoint.chat = async input => {
+    seen.push(input);
+    return JSON.stringify({
+      summary: "Redacted summary",
+      category: "personal",
+      suggestedTags: [],
+      actionItems: [],
+      riskFlags: [],
+      riskLevel: "low",
+      priority: "normal",
+      status: "reviewed",
+      extractedEntities: {},
+    });
+  };
+
+  return {
+    seen,
+    restore() {
+      AIEndpoint.canUseEndpoint = originalCanUse;
+      AIEndpoint.getConfig = originalGetConfig;
+      AIEndpoint.chatWithDebug = originalChatWithDebug;
+      AIEndpoint.chat = originalChat;
+    },
+  };
+}
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  await AIPIIRules.clearGeneratedData();
