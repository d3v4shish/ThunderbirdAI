+    this.#mailboxDigestProgress(
+      context,
+      "reading",
+      `Processing ${context.headers.length} emails from the frozen scope.`,
+      { force: true, checkpoint: true }
+    );
+    for (const header of context.headers) {
+      this.#assertMailboxDigestActive(context.controller.signal);
+      const meta = mailboxDigestHeaderMetadata(header);
+      const { messageId } = meta;
+      context.metadata.push(meta);
+      let message = null;
+      try {
+        message = await this.#readMessage(
+          header,
+          MAILBOX_DIGEST_MAX_BODY_CHARS,
+          { mailboxDigest: true }
+        );
+      } catch {}
+      context.job.readMessages++;
+      if (!message?.bodyInfo) {
+        context.job.unavailableMessages++;
+        context.messageStates.set(messageId, {
+          ...meta,
+          unavailable: true,
+          nodes: [],
+        });
+        if (context.job.readMessages % 20 == 0) {
+          this.#mailboxDigestProgress(
+            context,
+            "reading",
+            `Processed ${context.job.mappedMessages + context.job.unavailableMessages}/${context.job.totalMessages} emails.`
+          );
+          await new Promise(resolve => setTimeout(resolve, 0));
+        }
+        continue;
+      }
+      const body = String(message.body || "");
+      const bodyHash = sha256HexForText(
+        JSON.stringify([meta.subject, meta.author, meta.date, body])
+      );
+      const truncated = !!message.bodyInfo.truncated;
+      if (truncated) {
+        context.job.truncatedMessages++;
