+    return false;
+  }
+  return /\b(?:cite|citation|source|explicit|owner|deadline|rollback|what\s+changed|compare|comparison|difference|proposal|approval|decision|connected|connect|related|linked|relationship|assigned|who\s+owns)\b/u.test(
