+    generatedAt: new Date().toISOString(),
+    redacted: true,
+    laneId: lane.id || "",
+    laneLabel: lane.label || lane.id || "",
+    summary: `${recentEvents.length} recent event(s); ${
+      recommendedActions.length
+    } repair action(s) ready to copy.`,
+    recentEvents: recentEvents.map(event => ({ ...event })),
+    recommendedActions,
+    text: lines.join("\n"),
+  };
+}
+
+function runtimeLanePlacementSummary(roleRows = []) {
+  return roleRows
