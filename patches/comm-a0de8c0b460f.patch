+
+  #mailboxDigestLimitations(job) {
+    const limitations = [];
+    if (job.unavailableMessages) {
+      limitations.push(
+        `${job.unavailableMessages} message body or bodies were unavailable locally.`
+      );
+    }
+    if (job.truncatedMessages) {
+      limitations.push(
+        `${job.truncatedMessages} message body or bodies exceeded the ${MAILBOX_DIGEST_MAX_BODY_CHARS.toLocaleString()} character safety ceiling.`
+      );
+    }
+    if (job.failedMessages) {
+      limitations.push(
+        `${job.failedMessages} message body or bodies failed mapping or reduction.`
+      );
+    }
+    return limitations;
+  }
