+      Assert.equal(disabled.status, "disabled");
+      Services.prefs.setBoolPref("mail.ai.enabled", true);
+      Assert.deepEqual(
+        deterministicTemplateExtractionSnapshot(
+          AIStorage.getMessage(messageId)
+        ),
+        expected,
+        "disabled Assistant should not rewrite deterministic template or extraction outputs"
+      );
+
+      Services.prefs.setStringPref("mail.ai.assistant.mode", "endpoint");
+      let restoreEndpoint = installMockAssistantEndpoint({
+        async handler() {
+          const error = new Error("AI endpoint timed out");
+          error.aiEndpointDebug = {
+            attempts: [
+              {
+                transport: "ollama-openai",
+                requestURL: "http://127.0.0.1:11434/v1/chat/completions",
+                errorMessage: "AI endpoint timed out",
+              },
+            ],
+          };
+          throw error;
+        },
+      });
+      try {
+        const failed = await AIService.askAssistant({
+          prompt: "Summarize the debit alert.",
+          accountKey,
+          folderURI: folder.URI,
+          messageIds: [messageId],
+          scopeMode: "selected",
+        });
+        Assert.ok(
+          ["fallback", "unavailable"].includes(failed.status),
+          "Assistant failure should either fall back locally or report unavailable"
+        );
+      } finally {
+        restoreEndpoint();
+      }
+
+      const afterFailure = AIStorage.getMessage(messageId);
+      Assert.deepEqual(
+        deterministicTemplateExtractionSnapshot(afterFailure),
+        expected,
+        "failed Assistant runs should keep deterministic template and extraction outputs intact"
+      );
+
+      const controller = new AbortController();
+      // The preceding simulated endpoint failure intentionally exercises the
+      // unavailable path. Cancellation is a separate behavior: reset the
+      // per-account circuit breaker so this request reaches the cancellable
+      // endpoint mock instead of being suppressed as a paused provider.
+      AIStorage.resetProviderStatus(accountKey);
+      restoreEndpoint = installMockAssistantEndpoint({
+        async handler(_messages, _accountKey, options = {}) {
+          Assert.ok(
+            options.signal,
+            "Assistant requests should still pass a cancellable signal to the endpoint layer"
+          );
+          const error = new Error("AI endpoint cancelled");
+          error.aiEndpointDebug = {
+            attempts: [
+              {
+                transport: "ollama-openai-stream",
+                requestURL: "http://127.0.0.1:11434/v1/chat/completions",
+                streamEvents: [
+                  { type: "start", text: "" },
+                  { type: "partial", text: "Partial" },
+                ],
+                errorMessage: "AI endpoint cancelled",
+              },
+            ],
+          };
+          throw error;
+        },
+      });
+      try {
+        const cancelled = await AIService.askAssistant({
+          prompt: "List the extracted payment fields.",
+          accountKey,
+          folderURI: folder.URI,
+          messageIds: [messageId],
+          scopeMode: "selected",
+          stream: true,
+          signal: controller.signal,
+        });
+        Assert.equal(cancelled.status, "cancelled");
+        Assert.equal(cancelled.answer, "Assistant request cancelled.");
+      } finally {
+        restoreEndpoint();
+      }
+
+      const afterCancelled = AIStorage.getMessage(messageId);
+      Assert.deepEqual(
+        deterministicTemplateExtractionSnapshot(afterCancelled),
+        expected,
+        "cancelled Assistant runs should keep deterministic template and extraction outputs intact"
+      );
+
+      const stageIds = afterCancelled.timelineStages.map(stage => stage.id);
+      Assert.less(
+        stageIds.indexOf("template"),
+        stageIds.indexOf("extraction"),
+        "template matching should stay ahead of extraction after Assistant traces are merged"
