--- /dev/null
+++ b/mail/components/ai/modules/AIPromptConfig.sys.mjs
@@ -0,0 +1,173 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  clearJSONStoreRecoveryArchives,
+  initRecoverableJSONStore,
+} from "moz-src:///comm/mail/components/ai/modules/AIJSONStore.sys.mjs";
+import { AIRuntimePaths } from "moz-src:///comm/mail/components/ai/modules/AIRuntimePaths.sys.mjs";
+
+const LEGACY_ASSISTANT_COMPAT_FEATURE_KEYS = new Set(["chat", "llm-chat"]);
+
+function plainObject(value) {
+  return value && typeof value == "object" && !Array.isArray(value)
+    ? value
+    : {};
+}
+
+function limitedString(value, limit = 8000) {
+  return String(value ?? "")
+    .trim()
+    .slice(0, limit);
+}
+
+function normalizeMap(map = {}) {
+  const result = {};
+  for (const [key, value] of Object.entries(plainObject(map))) {
+    result[key] = limitedString(value);
+  }
+  return result;
+}
+
+function normalizeFeatureMap(map = {}) {
+  const input = plainObject(map);
+  const result = {};
+  for (const [key, value] of Object.entries(input)) {
+    const normalizedKey = normalizeAssistantFeatureKey(key);
+    if (normalizedKey == "assistant" && key != "assistant") {
+      continue;
+    }
+    result[normalizedKey] = limitedString(value);
+  }
+  const assistantValue =
+    limitedString(input.assistant) ||
+    limitedString(input.chat) ||
+    limitedString(input["llm-chat"]);
+  if (assistantValue) {
+    result.assistant = assistantValue;
+  }
+  return result;
+}
+
+function normalizeAssistantFeatureKey(feature = "") {
+  const key = String(feature ?? "").trim();
+  return key == "assistant" || LEGACY_ASSISTANT_COMPAT_FEATURE_KEYS.has(key)
+    ? "assistant"
+    : key;
+}
+
+export const AIPromptConfig = {
+  _jsonFile: null,
+  _initPromise: null,
+
+  async init() {
+    if (this._jsonFile?.dataReady) {
+      return;
+    }
+    if (this._initPromise) {
+      await this._initPromise;
+      return;
+    }
+    this._initPromise = (async () => {
+      await IOUtils.makeDirectory(AIRuntimePaths.profileConfigRootDir(), {
+        createAncestors: true,
+        ignoreExisting: true,
+      });
+      const { jsonFile } = await initRecoverableJSONStore({
+        storeId: "ai-prompts",
+        owner: "AI prompts",
+        path: AIRuntimePaths.promptsFilePath(),
+        dataPostProcessor(data = {}) {
+          return {
+            version: 1,
+            featureInstructions: normalizeFeatureMap(data.featureInstructions),
+            sourceInstructions: normalizeMap(data.sourceInstructions),
+            rawOverrides: normalizeFeatureMap(data.rawOverrides),
+            debugEnabled: !!data.debugEnabled,
+          };
+        },
+      });
+      this._jsonFile = jsonFile;
+    })();
+    try {
+      await this._initPromise;
+    } finally {
+      this._initPromise = null;
+    }
+  },
+
+  get data() {
+    if (!this._jsonFile?.dataReady) {
+      throw new Error("AI prompt config storage is not ready");
+    }
+    return this._jsonFile.data;
+  },
+
+  saveSoon() {
+    this._jsonFile?.saveSoon();
+  },
+
+  getConfig() {
+    return {
+      featureInstructions: { ...this.data.featureInstructions },
+      sourceInstructions: { ...this.data.sourceInstructions },
+      rawOverrides: { ...this.data.rawOverrides },
+      debugEnabled: !!this.data.debugEnabled,
+    };
+  },
+
+  setFeatureInstruction(feature = "", text = "") {
+    this.data.featureInstructions[normalizeAssistantFeatureKey(feature)] =
+      limitedString(text);
+    this.saveSoon();
+  },
+
+  setSourceInstruction(sourceId = "", text = "") {
+    this.data.sourceInstructions[sourceId] = limitedString(text);
+    this.saveSoon();
+  },
+
+  setRawOverride(feature = "", text = "") {
+    this.data.rawOverrides[normalizeAssistantFeatureKey(feature)] =
+      limitedString(text);
+    this.saveSoon();
+  },
+
+  setDebugEnabled(enabled) {
+    this.data.debugEnabled = !!enabled;
+    this.saveSoon();
+  },
+
+  rewriteNormalizedData() {
+    this.data.featureInstructions = normalizeFeatureMap(
+      this.data.featureInstructions
+    );
+    this.data.sourceInstructions = normalizeMap(this.data.sourceInstructions);
+    this.data.rawOverrides = normalizeFeatureMap(this.data.rawOverrides);
+    this.data.debugEnabled = !!this.data.debugEnabled;
+    this.saveSoon();
+    return this.getConfig();
+  },
+
+  buildPrompt(feature = "", base = "", { sourceId = "" } = {}) {
+    const normalizedFeature = normalizeAssistantFeatureKey(feature);
+    const override = this.data.rawOverrides[normalizedFeature];
+    if (override) {
+      return override;
+    }
+    const featureText = this.data.featureInstructions[normalizedFeature];
+    const sourceText = this.data.sourceInstructions[sourceId];
+    return [base, featureText, sourceText].filter(Boolean).join("\n\n");
+  },
+
+  async clearGeneratedData() {
+    await IOUtils.remove(AIRuntimePaths.promptsFilePath(), {
+      ignoreAbsent: true,
+    });
+    await clearJSONStoreRecoveryArchives("ai-prompts");
+    this._jsonFile = null;
+    this._initPromise = null;
+    await this.init();
+  },
+};
diff --git a/mail/components/ai/modules/AIRuntimeLogging.sys.mjs b/mail/components/ai/modules/AIRuntimeLogging.sys.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/ai/modules/AIRuntimeLogging.sys.mjs
@@ -0,0 +1,252 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const MAX_RUNTIME_LOGS = 400;
+const SENSITIVE_KEY_PATTERN =
+  /(?:prompt|message|body|content|text|response|subject|author|token|secret|authorization|api[-_]?key|password|input|output|query)/i;
+
+let gRuntimeLogs = [];
+let gRuntimeLogSerial = 0;
+
+function limitedString(value, maxChars = 1200) {
+  return String(value ?? "")
+    .replace(/\s+/g, " ")
+    .trim()
+    .slice(0, maxChars);
+}
+
+function deepClone(value) {
+  if (Array.isArray(value)) {
+    return value.map(item => deepClone(item));
+  }
+  if (value && typeof value == "object") {
+    return Object.fromEntries(
+      Object.entries(value).map(([key, item]) => [key, deepClone(item)])
+    );
+  }
+  return value;
+}
+
+function redactString(value = "") {
+  return limitedString(value, 4000)
+    .replace(/\bBearer\s+[A-Za-z0-9._~+/=-]+\b/gi, "Bearer <redacted>")
+    .replace(/\bsk-[A-Za-z0-9_-]{12,}\b/g, "<redacted-api-key>")
+    .replace(/\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi, "<EMAIL>")
+    .replace(/\b\d{13,19}\b/g, "<NUMBER>");
+}
+
+function redactValue(value, key = "") {
+  if (value == null) {
+    return value;
+  }
+  if (typeof value == "string") {
+    return SENSITIVE_KEY_PATTERN.test(key) ? "<redacted>" : redactString(value);
+  }
+  if (typeof value == "number" || typeof value == "boolean") {
+    return value;
+  }
+  if (Array.isArray(value)) {
+    return value.slice(0, 20).map(item => redactValue(item, key));
+  }
+  if (typeof value == "object") {
+    const entries = Object.entries(value).slice(0, 40);
+    return Object.fromEntries(
+      entries.map(([entryKey, entryValue]) => [
+        entryKey,
+        redactValue(entryValue, entryKey),
+      ])
+    );
+  }
+  return limitedString(value, 400);
+}
+
+function parsedTraceRequest(trace = {}) {
+  if (trace.request && typeof trace.request == "object") {
+    return trace.request;
+  }
+  if (typeof trace.request != "string" || !trace.request) {
+    return {};
+  }
+  try {
+    return JSON.parse(trace.request);
+  } catch {
+    return {};
+  }
+}
+
+function normalizedRole(value = "") {
+  switch (String(value || "").trim()) {
+    case "generator":
+    case "helper-llm":
+      return "assistant";
+    default:
+      return String(value || "").trim();
+  }
+}
+
+function normalizedLogEntry(entry = {}) {
+  return {
+    id: `ai-runtime-log-${Date.now().toString(36)}-${++gRuntimeLogSerial}`,
+    createdAt: new Date().toISOString(),
+    category: limitedString(entry.category || "runtime", 80) || "runtime",
+    action: limitedString(entry.action || "event", 80) || "event",
+    state: limitedString(entry.state || "ok", 40) || "ok",
+    requestId:
+      limitedString(entry.requestId || entry.traceId || entry.id, 160) ||
+      `request-${gRuntimeLogSerial}`,
+    traceId: limitedString(entry.traceId, 160),
+    role: normalizedRole(entry.role || ""),
+    modelId: limitedString(entry.modelId, 160),
+    backend: limitedString(entry.backend, 120),
+    detail: redactString(entry.detail || ""),
+    error: redactString(entry.error || ""),
+    fields: redactValue(entry.fields || entry.metadata || {}, ""),
+    redacted: true,
+  };
+}
+
+function filterMatches(entry = {}, filter = "") {
+  if (!filter) {
+    return true;
+  }
+  const haystack = JSON.stringify(entry).toLocaleLowerCase();
+  return haystack.includes(String(filter).trim().toLocaleLowerCase());
+}
+
+function firstTruthy(...values) {
+  for (const value of values) {
+    if (value) {
+      return value;
+    }
+  }
+  return "";
+}
+
+function traceAction(fallbackUsed, state) {
+  if (fallbackUsed) {
+    return "backend-fallback";
+  }
+  return state == "cancelled" ? "backend-cancelled" : "backend-selection";
+}
+
+function traceBackend(trace = {}) {
+  if (trace.answerMode == "direct-rag") {
+    return "direct-rag";
+  }
+  if (trace.answerMode == "local") {
+    return "legacy-local-disabled";
+  }
+  return firstTruthy(trace.sourceType, trace.answerMode);
+}
+
+function traceDetail(trace = {}, fallbackUsed = false) {
+  if (trace.decisionReason) {
+    return trace.decisionReason;
+  }
+  return fallbackUsed
+    ? "Assistant fell back to a secondary backend."
+    : "Assistant selected a conversational backend.";
+}
+
+function lastAttemptFields(attempt = null) {
+  if (!attempt) {
+    return {};
+  }
+  return {
+    transport: attempt.transport || "",
+    requestURL: attempt.requestURL || "",
+    httpStatus: Number(attempt.httpStatus) || 0,
+    retryReason: attempt.retryReason || "",
+    fallbackReason: attempt.fallbackReason || "",
+    errorMessage: attempt.errorMessage || "",
+  };
+}
+
+export const AIRuntimeLogging = {
+  clear() {
+    gRuntimeLogs = [];
+  },
+
+  record(entry = {}) {
+    const normalized = normalizedLogEntry(entry);
+    gRuntimeLogs.unshift(normalized);
+    gRuntimeLogs = gRuntimeLogs.slice(0, MAX_RUNTIME_LOGS);
+    return deepClone(normalized);
+  },
+
+  recordTrace(trace = {}) {
+    const request = parsedTraceRequest(trace);
+    const retrieval = request.retrievalSummary || {};
+    const budget = trace.contextBudget || retrieval.contextBudget || {};
+    const attempts = Array.isArray(trace.attempts) ? trace.attempts : [];
+    const lastAttempt = attempts.length ? attempts[attempts.length - 1] : null;
+    const fallbackUsed = !!trace.fallbackUsed;
+    const state = limitedString(trace.status || "unknown", 40) || "unknown";
+    return this.record({
+      category: "assistant-trace",
+      action: traceAction(fallbackUsed, state),
+      state,
+      requestId: trace.id || trace.traceId || "",
+      traceId: trace.id || trace.traceId || "",
+      role: trace.type || "assistant",
+      modelId: trace.model || trace.assistantRuntimeModel || "",
+      backend: traceBackend(trace),
+      detail: traceDetail(trace, fallbackUsed),
+      fields: {
+        route: trace.route || "",
+        answerMode: trace.answerMode || "",
+        sourceId: trace.sourceId || "",
+        sourceName: trace.sourceName || "",
+        providerStateBeforeAttempt: trace.providerStateBeforeAttempt || "",
+        pausedBeforeAttempt: !!trace.pausedBeforeAttempt,
+        scopeMode: trace.scopeMode || retrieval.scopeMode || "",
+        retrievedRecordCount:
+          Number(retrieval.retrievedRecordCount) ||
+          trace.citations?.length ||
+          0,
+        citationCount: Array.isArray(trace.citations)
+          ? trace.citations.length
+          : 0,
+        contextBudget: {
+          includedCount: Number(budget.includedCount) || 0,
+          excludedCount: Number(budget.excludedCount) || 0,
+          truncated: !!budget.truncated,
+          redacted: !!budget.redacted,
+          finalPromptTokens: Number(budget.finalPromptTokens) || 0,
+          finalPromptBytes: Number(budget.finalPromptBytes) || 0,
+        },
+        lastAttempt: lastAttemptFields(lastAttempt),
+      },
+    });
+  },
+
+  getLogs({
+    filter = "",
+    category = "",
+    action = "",
+    state = "",
+    requestId = "",
+    limit = 200,
+  } = {}) {
+    const max = Math.max(1, Math.min(Number(limit) || 200, MAX_RUNTIME_LOGS));
+    return gRuntimeLogs
+      .filter(entry => {
+        if (category && entry.category != category) {
+          return false;
+        }
+        if (action && entry.action != action) {
+          return false;
+        }
+        if (state && entry.state != state) {
+          return false;
+        }
+        if (requestId && entry.requestId != requestId) {
+          return false;
+        }
+        return filterMatches(entry, filter);
+      })
+      .slice(0, max)
+      .map(entry => deepClone(entry));
+  },
+};
