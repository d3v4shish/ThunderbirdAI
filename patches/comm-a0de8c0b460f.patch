+  async runAIDoctor() {
+    const runtime = await this.getRuntimeSnapshot(null);
+    const governance = await this.getDataGovernanceData();
+    const issues = [];
+    const addIssue = (component, rootCause, actionId, repair) => {
+      issues.push({
+        order: issues.length + 1,
+        component,
+        rootCause,
+        actionId,
+        repair,
+      });
+    };
+    if (!runtime.enabled) {
+      addIssue(
+        "AI Mail Assistant",
+        "AI is disabled.",
+        "first-run-endpoint",
+        "Run first-run setup or enable AI in settings."
+      );
+    }
+    if (
+      !runtime.assistantFallback ||
+      ["dead", "unavailable"].includes(runtime.assistantFallback.state)
+    ) {
+      addIssue(
+        "Assistant endpoint",
+        runtime.assistantFallback?.detail ||
+          runtime.assistantFallback?.summary ||
+          "Endpoint is unavailable.",
+        "test-endpoint",
+        "Test endpoint, inspect URL/model, then increase timeout if the endpoint is slow."
+      );
+    }
+    if (runtime.queueBlocked || runtime.queueLength > runtime.maxQueueSize) {
+      addIssue(
+        "Analysis queue",
+        `${runtime.queueLength} queued message(s) are blocked.`,
+        "clear-queue",
+        "Clear the queue or resume workers."
+      );
+    }
+    const storageBytes = Number(governance.artifactTotals?.diskBytes) || 0;
+    if (storageBytes > 50 * 1024 * 1024) {
+      addIssue(
+        "Storage",
+        `AI artifacts use ${storageBytes} byte(s).`,
+        "cleanup",
+        "Review cleanup impact and clear large generated artifacts."
+      );
+    }
+    if (!issues.length) {
+      addIssue(
+        "AI system",
+        "No blocking issues detected.",
+        "none",
+        "No repair action is required."
+      );
+    }
+    return {
+      version: 1,
+      generatedAt: new Date().toISOString(),
+      summary: `${issues.length} diagnostic item(s)`,
+      issues,
+      repairSteps: issues.map(issue => ({
+        order: issue.order,
+        actionId: issue.actionId,
+        label: issue.repair,
+      })),
+    };
+  }
