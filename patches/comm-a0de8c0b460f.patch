+  const backendClasses = uniqueStringValues(
+    roleRows.map(row => row.backendLabel)
+  );
+  const hostClasses = uniqueStringValues(roleRows.map(row => row.hostLabel));
+  const processClasses = uniqueStringValues(
+    roleRows.map(row => row.processLabel)
+  );
+  const summary = uniqueStringValues(
+    transportKinds.join(" + "),
+    backendClasses.join(" + "),
+    roleIdentityRows.map(row => row.identity).join("; ")
+  ).join(" | ");
+  const detail = uniqueStringValues(
+    roleRows.map(row =>
+      uniqueStringValues(
+        row.label
+          ? `${row.label} uses ${row.placementLabel || "Not assigned"}`
+          : "",
+        row.backendLabel ? `via ${row.backendLabel}` : "",
+        row.modelName ? ` / ${row.modelName}` : ""
+      ).join(" ")
+    ),
+    roleRows.map(row => row.detail)
+  ).join(". ");
+  return runtimeLaneBackendIdentitySnapshot({
+    transportKinds,
+    backendClasses,
+    hostClasses,
+    processClasses,
+    modelIdentity:
+      roleIdentityRows.length == 1
+        ? roleIdentityRows[0].identity.replace(/^[^:]+:\s*/, "")
+        : "",
+    roleIdentityRows,
+    summary,
+    detail: detail || `${laneLabel || "Lane"} backend identity is unavailable.`,
+  });
