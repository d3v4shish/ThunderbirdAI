+function roleBackedRuntimeLaneBudget(roleRows = [], laneLabel = "") {
+  const estimatedRamMB = roleRows.reduce(
+    (sum, row) => sum + (row.estimatedRamMB || 0),
+    0
+  );
+  const estimatedVramMB = roleRows.reduce(
+    (sum, row) => sum + (row.estimatedVramMB || 0),
+    0
+  );
+  const residentStates = uniqueStringValues(
+    roleRows.map(row => row.residentState)
+  );
+  const keepWarmPolicies = uniqueStringValues(
+    roleRows.map(row => row.keepWarmPolicy)
+  );
+  const warmSummary = uniqueStringValues(
+    residentStates.map(runtimeLaneResidentStateLabel),
+    keepWarmPolicies.map(runtimeLaneKeepWarmPolicyLabel)
+  ).join(" | ");
+  const memorySummary =
+    summarizeRolePlacementMemory({
+      estimatedRamMB,
+      estimatedVramMB,
+    }) || "0 MB local";
+  const concurrencyRows = [];
+  const seenConcurrency = new Set();
+  for (const row of roleRows) {
+    const key = [
+      row.placementId || "",
+      row.maxConcurrentLocalLoads || 0,
+      row.maxWarmLocalModels || 0,
+      row.keepWarmPolicy || "",
+    ].join("|");
+    if (seenConcurrency.has(key)) {
+      continue;
+    }
+    seenConcurrency.add(key);
+    concurrencyRows.push(
+      runtimeLaneConcurrencyRowSnapshot({
+        label: row.placementLabel || row.label || laneLabel,
+        kind: row.placementId || "unknown",
+        cap: row.maxConcurrentLocalLoads || 0,
+        summary: lazyConditional(
+          row.maxConcurrentLocalLoads > 0,
+          () =>
+            `${row.placementLabel || row.label || laneLabel} ${row.maxConcurrentLocalLoads} concurrent local load(s)`,
+          () =>
+            lazyConditional(
+              row.placementId == "built-in-native",
+              () =>
+                `${row.placementLabel || row.label || laneLabel} stays in-process`,
+              () =>
+                `${row.placementLabel || row.label || laneLabel} has no separate local load queue`
+            )
+        ),
+        detail: uniqueStringValues(row.policyReason, row.overflowPolicy).join(
+          ". "
+        ),
+      })
+    );
+  }
+  const concurrencySummary =
+    concurrencyRows.map(row => row.summary).join("; ") ||
+    "No dedicated concurrency cap";
+  return runtimeLaneBudgetSnapshot({
+    residentStates,
+    keepWarmPolicies,
+    estimatedRamMB,
+    estimatedVramMB,
+    memorySummary,
+    warmSummary,
+    concurrencyRows,
+    concurrencySummary,
+    summary: uniqueStringValues(
+      warmSummary,
+      memorySummary,
+      concurrencySummary
+    ).join(" | "),
+    detail:
+      uniqueStringValues(
+        roleRows.map(row => row.policyReason),
+        roleRows.map(row => row.overflowPolicy)
+      ).join(". ") ||
+      `${laneLabel || "Lane"} does not expose a dedicated runtime budget.`,
+  });
+}
