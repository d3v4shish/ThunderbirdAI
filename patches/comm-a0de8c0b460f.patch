+  renderAITestLog(
+    logId,
+    { target = "AI", state = "INFO", message = "", detail = "" } = {}
+  ) {
+    const log = document.getElementById(logId);
+    if (!log) {
+      return;
+    }
+    const timestamp = new Date().toLocaleTimeString();
+    const parts = [
+      `[${timestamp}]`,
+      target,
+      `${state.toUpperCase()}:`,
+      message,
+    ];
+    if (detail) {
+      parts.push(`(${detail})`);
+    }
+    log.textContent = parts.filter(Boolean).join(" ");
+    log.dataset.state = state.toLowerCase();
+    if (logId == "aiAssistantTestLog") {
+      this.selectAIAssistantLogTab("test");
+    }
+    this._aiTestLogState ||= {};
+    this._aiTestLogState[logId] = {
+      target,
+      state,
+      message,
+      detail,
+    };
+  },
+
+  renderAIAssistantBootstrapLog(result = {}) {
+    const log = document.getElementById("aiAssistantBootstrapLog");
+    if (!log) {
+      return;
+    }
+    const steps = Array.isArray(result.steps) ? result.steps : [];
+    const lines = [
+      `${result.status == "failed" ? "FAIL" : "PASS"}: ${
+        result.summary || "Assistant runtime bootstrap has not run yet."
+      }`,
+    ];
+    for (const step of steps) {
+      lines.push(
+        `${String(step.label || step.id || "Step").trim()}: ${String(
+          step.status || "unknown"
+        ).toUpperCase()}${step.detail ? ` - ${step.detail}` : ""}`
+      );
+    }
+    if (result.durationMs) {
+      lines.push(`Duration: ${result.durationMs} ms`);
+    }
+    log.textContent = lines.join("\n");
+    log.dataset.state = result.status == "failed" ? "fail" : "pass";
+    this.selectAIAssistantLogTab("bootstrap");
+  },
+
+  _labelForAIRolePlacementState(value = "") {
+    return String(value || "").replaceAll("-", " ");
+  },
+
+  _describeAIRolePlacement(placement = null) {
+    if (!placement) {
+      return "";
+    }
+    const parts = [placement.placementLabel || placement.label || "Unknown"];
+    if (placement.backendLabel) {
+      parts.push(placement.backendLabel);
+    }
+    if (placement.residentState) {
+      parts.push(
+        `resident ${this._labelForAIRolePlacementState(
+          placement.residentState
+        )}`
+      );
+    }
+    if (placement.state && placement.state != "ready") {
+      parts.push(
+        `state ${this._labelForAIRolePlacementState(placement.state)}`
+      );
+    }
+    if (placement.hostLabel) {
+      parts.push(`host ${placement.hostLabel}`);
+    }
+    if (placement.processLabel) {
+      parts.push(`process ${placement.processLabel}`);
+    }
+    if (placement.transportLabel) {
+      parts.push(`transport ${placement.transportLabel}`);
+    }
+    return `${placement.label || "Role"}: ${parts.join(" / ")}`;
+  },
+
+  _describeAIRolePlacements(runtimeStatus = null) {
+    const rolePlacements = runtimeStatus?.rolePlacements || null;
+    if (!rolePlacements) {
+      return "";
+    }
+    return [
+      "assistant",
+      "summarizer",
+      "embedder",
+      "category-classifier",
+      "pii-recognizer",
+    ]
+      .map(role => this._describeAIRolePlacement(rolePlacements[role]))
+      .filter(Boolean)
+      .join(" | ");
+  },
+
+  _describeAIAssistantWorkflowMap(runtimeStatus = null) {
+    const stages = runtimeStatus?.assistantWorkflowMap?.stages || [];
+    if (!stages.length) {
+      return "";
+    }
+    return [
+      "Assistant workflow:",
+      ...stages.map(
+        (stage, index) =>
+          `${index + 1}. ${stage.label} [${stage.kind}] - owner ${stage.owner} - ${
+            stage.handoff
+          }`
+      ),
+    ].join("\n");
+  },
+
+  _describeAIMailIngestArchitecture(runtimeStatus = null) {
+    const sidecars = runtimeStatus?.mailIngestArchitecture?.sidecars || [];
+    if (!sidecars.length) {
+      return "";
+    }
+    return [
+      "Mail ingest architecture:",
+      ...sidecars.map(
+        (sidecar, index) =>
+          `${index + 1}. ${sidecar.label} - owner ${sidecar.owner} - owns ${
+            sidecar.owns
+          } - consumes ${sidecar.consumes} - emits ${sidecar.emits} - handoff ${
+            sidecar.handoff
+          }`
+      ),
+    ].join("\n");
+  },
+
+  _describeAIParserTrustPipeline(runtimeStatus = null) {
+    const stages = runtimeStatus?.parserTrustPipeline?.stages || [];
+    if (!stages.length) {
+      return "";
+    }
+    return [
+      "Parser and trust pipeline:",
+      ...stages.map(
+        (stage, index) => `${index + 1}. ${stage.label} - ${stage.detail}`
+      ),
+    ].join("\n");
