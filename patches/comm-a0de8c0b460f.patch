+  validateAITrace(trace = {}) {
+    const errors = [];
+    const requireField = field => {
+      if (
+        trace[field] === undefined ||
+        trace[field] === null ||
+        trace[field] === ""
+      ) {
+        errors.push(`missing ${field}`);
+      }
+    };
+    for (const field of ["id", "type", "status", "createdAt"]) {
+      requireField(field);
+    }
+    if (trace.request === undefined || trace.request === null) {
+      errors.push("missing request");
+    }
+    if (trace.response === undefined || trace.response === null) {
+      errors.push("missing response");
+    }
+    if (!Array.isArray(trace.attempts)) {
+      errors.push("missing attempts");
+    } else {
+      trace.attempts.forEach((attempt, index) => {
+        if (!attempt.startedAt) {
+          errors.push(`attempt ${index + 1} missing startedAt`);
+        }
+        if (!attempt.finishedAt) {
+          errors.push(`attempt ${index + 1} missing finishedAt`);
+        }
+        if (!Number.isFinite(Number(attempt.durationMs))) {
+          errors.push(`attempt ${index + 1} missing durationMs`);
+        }
+        if (!attempt.requestURL && !trace.endpointURL) {
+          errors.push(`attempt ${index + 1} missing requestURL`);
+        }
+      });
+    }
+    const validationText = traceValidationTextFields(trace).join("\n");
+    if (/Bearer\s+[A-Za-z0-9._-]+/.test(validationText)) {
+      errors.push("unredacted bearer token");
+    }
+    if (/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i.test(validationText)) {
+      errors.push("unredacted email address");
+    }
+    return {
+      schemaVersion: 1,
+      valid: !errors.length,
+      errors,
+    };
+  }
+
+  async validateRecentAITraces(limit = 20) {
+    await AIStorage.init();
+    const traces = AIStorage.getRecentTraces(limit);
+    const results = traces.map(trace => ({
+      id: trace.id,
+      ...this.validateAITrace(trace),
+    }));
+    return {
+      schemaVersion: 1,
+      checked: results.length,
+      valid: results.every(result => result.valid),
+      results,
+    };
+  }
