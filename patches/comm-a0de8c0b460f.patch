diff --git a/mail/components/preferences/aiDebug.js b/mail/components/preferences/aiDebug.js
new file mode 100644
--- /dev/null
+++ b/mail/components/preferences/aiDebug.js
@@ -0,0 +1,353 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+var { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+
+function safeJSONParse(value) {
+  if (!value || typeof value != "string") {
+    return null;
+  }
+  try {
+    return JSON.parse(value);
+  } catch {
+    return null;
+  }
+}
+
+function addRow(container, label, value) {
+  const row = document.createElement("div");
+  row.style.marginBottom = "4px";
+  const strong = document.createElement("strong");
+  strong.textContent = `${label}:`;
+  row.appendChild(strong);
+  row.append(` ${value || "-"}`);
+  container.appendChild(row);
+}
+
+function addSection(container, title) {
+  const section = document.createElement("section");
+  section.style.border = "1px solid color-mix(in srgb, currentColor 18%, transparent)";
+  section.style.borderRadius = "10px";
+  section.style.padding = "10px";
+  section.style.marginBottom = "8px";
+  const heading = document.createElement("strong");
+  heading.textContent = title;
+  section.appendChild(heading);
+  container.appendChild(section);
+  return section;
+}
+
+function addPre(container, value) {
+  const pre = document.createElement("pre");
+  pre.style.whiteSpace = "pre-wrap";
+  pre.style.marginTop = "6px";
+  pre.textContent =
+    typeof value == "string" ? value : JSON.stringify(value ?? null, null, 2);
+  container.appendChild(pre);
+}
+
+var gAIDebugDialog = {
+  _timelineData: null,
+  _conversationData: null,
+  _retestResult: null,
+
+  get args() {
+    return window.arguments?.[0] || {};
+  },
+
+  get conversationType() {
+    return "assistant";
+  },
+
+  updateModeControls() {
+    const retest = document.getElementById("retestAIDebugTarget");
+    const reset = document.getElementById("resetAIDebugProvider");
+    const clear = document.getElementById("clearAIDebugLogs");
+    for (const button of [retest, reset, clear]) {
+      if (!button) {
+        continue;
+      }
+      button.hidden = false;
+      button.disabled = false;
+    }
+  },
+
+  renderTimeline() {
+    const container = document.getElementById("aiDebugTimeline");
+    container.replaceChildren();
+    if (!this._timelineData) {
+      container.textContent =
+        "Open this window from a message to inspect the full analysis timeline.";
+      return;
+    }
+
+    const { message = {}, stages = [], canonicalText = "", bodyInfo = null } =
+      this._timelineData;
+    const fragment = document.createDocumentFragment();
+
+    const meta = document.createElement("div");
+    meta.style.marginBottom = "12px";
+    for (const [label, value] of [
+      ["Message", message.subject || "(no subject)"],
+      ["Author", message.author || ""],
+      ["Folder", message.folderURI || ""],
+    ]) {
+      addRow(meta, label, value);
+    }
+    fragment.appendChild(meta);
+
+    for (const [index, stage] of stages.entries()) {
+      const card = addSection(fragment, `${index + 1}. ${stage.label || stage.id || "stage"}`);
+      const status = document.createElement("div");
+      status.style.marginTop = "6px";
+      status.textContent = String(stage.status || "unknown").toUpperCase();
+      card.appendChild(status);
+      if (stage.summary) {
+        const summary = document.createElement("p");
+        summary.style.margin = "8px 0";
+        summary.textContent = stage.summary;
+        card.appendChild(summary);
+      }
+      if (stage.detail) {
+        const details = document.createElement("details");
+        const summary = document.createElement("summary");
+        summary.textContent = "Details";
+        details.appendChild(summary);
+        addPre(details, stage.detail);
+        card.appendChild(details);
+      }
+    }
+
+    const canonical = document.createElement("details");
+    canonical.open = true;
+    const canonicalSummary = document.createElement("summary");
+    canonicalSummary.textContent = "Canonical body";
+    canonical.appendChild(canonicalSummary);
+    addPre(canonical, bodyInfo || {});
+    addPre(canonical, canonicalText || "(empty)");
+    fragment.appendChild(canonical);
+
+    container.appendChild(fragment);
+  },
+
+  renderFocus() {
+    const container = document.getElementById("aiDebugFocus");
+    container.replaceChildren();
+
+    const data = this._conversationData;
+    if (!data) {
+      container.textContent = "No Assistant debug data is available yet.";
+      return;
+    }
+
+    if (this._retestResult) {
+      const resultCard = addSection(container, "Latest Retest");
+      addRow(resultCard, "Status", this._retestResult.state);
+      addRow(resultCard, "Message", this._retestResult.message);
+      if (this._retestResult.attempts?.length) {
+        addPre(resultCard, this._retestResult.attempts);
+      }
+    }
+
+    const health = addSection(container, "Health");
+    addRow(health, "Account", data.accountKey);
+    addRow(health, "Source", data.config?.sourceName || data.config?.sourceId || "-");
+    addRow(health, "Type", data.config?.sourceType || data.config?.provider || "-");
+    addRow(health, "Model", data.config?.model || "-");
+    addRow(health, "URL", data.config?.endpointURL || "-");
+    addRow(health, "Usable", data.config?.usable ? "yes" : "no");
+    addRow(health, "Provider state", data.providerStatus?.state || "never-tested");
+    addRow(health, "Paused until", data.providerStatus?.pausedUntil
+      ? new Date(data.providerStatus.pausedUntil).toLocaleString()
+      : "-");
+    addRow(health, "Last success", data.providerStatus?.lastSuccessAt || "-");
+    addRow(health, "Last failure", data.providerStatus?.lastFailureAt || "-");
+    addRow(health, "Last error", data.providerStatus?.lastError || "-");
+
+    const latestTrace = data.trace || data.traces?.[0] || null;
+    if (!latestTrace) {
+      const empty = addSection(container, "Recent Assistant Traces");
+      empty.append("No Assistant traces were stored for this account and source.");
+      return;
+    }
+    const provenance = data.traceProvenance || latestTrace.provenance || null;
+
+    if (provenance) {
+      const provenanceSection = addSection(container, "Answer Provenance");
+      addRow(provenanceSection, "Backend", provenance.backendPath || "-");
+      addRow(provenanceSection, "Backend detail", provenance.backendLabel || "-");
+      addRow(provenanceSection, "Model", provenance.model || "none");
+      addRow(
+        provenanceSection,
+        "Fallback occurred",
+        provenance.fallbackOccurred ? "yes" : "no"
+      );
+      addRow(
+        provenanceSection,
+        "Retrieval evidence attached",
+        provenance.evidence?.retrievalAttached ? "yes" : "no"
+      );
+      addRow(
+        provenanceSection,
+        "Template evidence attached",
+        provenance.evidence?.templateAttached ? "yes" : "no"
+      );
+      addRow(
+        provenanceSection,
+        "Extraction evidence attached",
+        provenance.evidence?.extractionAttached ? "yes" : "no"
+      );
+      addRow(
+        provenanceSection,
+        "Security evidence attached",
+        provenance.evidence?.securityAttached ? "yes" : "no"
+      );
+    }
+
+    const latest = addSection(container, "Latest Attempt");
+    addRow(latest, "Status", latestTrace.status || "-");
+    addRow(latest, "Answer mode", latestTrace.answerMode || "-");
+    addRow(latest, "Attached context", latestTrace.attachedContextLabel || "-");
+    addRow(latest, "Paused before attempt", latestTrace.pausedBeforeAttempt ? "yes" : "no");
+    addRow(latest, "Pause bypassed", latestTrace.pauseBypassed ? "yes" : "no");
+    addRow(latest, "Provider state before attempt", latestTrace.providerStateBeforeAttempt || "-");
+    addRow(latest, "Created", latestTrace.createdAt || "-");
+
+    const attempts = addSection(container, "Attempt Timeline");
+    for (const attempt of latestTrace.attempts || []) {
+      const details = document.createElement("details");
+      const summary = document.createElement("summary");
+      summary.textContent = `Attempt ${attempt.attemptNumber || "?"}: ${
+        attempt.transport || "request"
+      }${attempt.httpStatus ? ` (${attempt.httpStatus})` : ""}${
+        attempt.errorMessage ? ` - ${attempt.errorMessage}` : ""
+      }`;
+      details.appendChild(summary);
+      addPre(details, attempt);
+      attempts.appendChild(details);
+    }
+
+    const requestSection = addSection(container, "Request");
+    addPre(requestSection, safeJSONParse(latestTrace.request) || latestTrace.request || {});
+
+    const responseSection = addSection(container, "Response");
+    addPre(responseSection, latestTrace.response || "(empty)");
+
+    const traceSection = addSection(container, "Stored Trace");
+    addPre(traceSection, latestTrace);
+  },
+
+  async refresh() {
+    this.updateModeControls();
+
+    let runtime;
+    let traces;
+    try {
+      this._conversationData = await AIService.getConversationDebugData({
+        type: this.conversationType,
+        traceId: this.args.traceId || "",
+        accountKey: this.args.accountKey || "global",
+        sourceId: this.args.sourceId || "",
+        limit: 20,
+      });
+    } catch (error) {
+      this._conversationData = { error: String(error), traces: [] };
+    }
+    runtime = this._conversationData.runtime || {
+      error: this._conversationData.error || "",
+    };
+    traces = this._conversationData.traces || [];
+
+    this._timelineData = this.args.timeline || null;
+    document.getElementById("aiDebugRuntime").textContent = JSON.stringify(
+      runtime,
+      null,
+      2
+    );
+    document.getElementById("aiDebugTraces").textContent = JSON.stringify(
+      traces,
+      null,
+      2
+    );
+    this.renderFocus();
+    this.renderTimeline();
+  },
+
+  async retest() {
+    try {
+      const result = await AIService.testEndpointDetailed(
+        this.args.accountKey || "global",
+        {
+          sourceId: this.args.sourceId || "",
+          role: "assistant",
+        }
+      );
+      this._retestResult = {
+        state: "PASS",
+        message: "Assistant source responded successfully.",
+        attempts: result.attempts || [],
+      };
+    } catch (error) {
+      this._retestResult = {
+        state: "FAIL",
+        message: error.message,
+        attempts: error.aiEndpointDebug?.attempts || [],
+      };
+    }
+    await this.refresh();
+  },
+
+  async resetProvider() {
+    await AIService.resetProviderHoldOff(this.args.accountKey || "global");
+    this._retestResult = {
+      state: "INFO",
+      message: "Provider hold-off was reset for this account.",
+      attempts: [],
+    };
+    await this.refresh();
+  },
+
+  async clearLogs() {
+    await AIService.clearDebugTraces({
+      type: this.conversationType,
+      accountKey: this.args.accountKey || "global",
+      sourceId: this.args.sourceId || "",
+    });
+    this._retestResult = {
+      state: "INFO",
+      message: "Cleared stored Assistant traces for this account.",
+      attempts: [],
+    };
+    await this.refresh();
+  },
+
+  copy() {
+    Cc["@mozilla.org/widget/clipboardhelper;1"]
+      .getService(Ci.nsIClipboardHelper)
+      .copyString(
+        JSON.stringify(
+          {
+            focus: document.getElementById("aiDebugFocus").innerText,
+            runtime: document.getElementById("aiDebugRuntime").textContent,
+            traces: document.getElementById("aiDebugTraces").textContent,
+            timeline: document.getElementById("aiDebugTimeline").innerText,
+          },
+          null,
+          2
+        )
+      );
+  },
+};
+
+window.addEventListener(
+  "load",
+  () => {
+    gAIDebugDialog.refresh().catch(console.error);
+  },
+  { once: true }
+);
