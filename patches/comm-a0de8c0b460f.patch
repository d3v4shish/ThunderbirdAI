+    const visibleStates = new Set([
+      "preparing",
+      "queued",
+      "running",
+      "complete",
+      "partial",
+      "failed",
+      "cancelled",
+    ]);
+    this.analysisJob.hidden = !job || !visibleStates.has(job.state);
+    if (this.analysisJob.hidden) {
+      return;
+    }
+    const terminal = ["complete", "partial", "failed", "cancelled"].includes(
+      job.state
+    );
+    const processed = Math.min(
+      job.totalCount || 0,
+      (job.completedCount || 0) +
+        (job.failedCount || 0) +
+        (terminal ? job.unavailableCount || 0 : 0)
+    );
+    const total = Math.max(job.totalCount || 0, 1);
+    const stateLabel =
+      {
+        preparing: "Preparing",
+        queued: "Queued",
+        running: "Reanalyzing",
+        complete: "Completed",
+        partial: "Completed with errors",
+        failed: "Reanalysis failed",
+        cancelled: "Reanalysis cancelled",
+      }[job.state] || "Reanalysis";
+    const label = this.analysisJob.querySelector('[data-role="label"]');
+    const count = this.analysisJob.querySelector('[data-role="count"]');
+    const progress = this.analysisJob.querySelector('[data-role="progress"]');
+    const detail = this.analysisJob.querySelector('[data-role="detail"]');
+    const cancel = this.analysisJob.querySelector(
+      'button[data-runtime-action="cancel-reanalysis"]'
+    );
+    const labelText = `${
+      job.artifact == "endpoint-upgrade" ? "Ollama upgrade" : stateLabel
+    }: ${this.analysisArtifactLabel(job.artifact)}`;
+    if (label.textContent != labelText) {
+      label.textContent = labelText;
+    }
+    const countText = `${processed}/${job.totalCount || 0}`;
+    if (count.textContent != countText) {
+      count.textContent = countText;
+    }
+    if (progress.max != total) {
+      progress.max = total;
+    }
+    if (progress.value != processed) {
+      progress.value = processed;
+    }
+    const detailText = [
+      job.artifact == "endpoint-upgrade"
+        ? `Batch ${Math.max(1, (job.upgradeBatchNumber || 0) + 1)} · ${
+            job.upgradeBatchSize || 1
+          } messages`
+        : "",
+      job.upgradePriorityCount
+        ? `${job.upgradePriorityCount} visible messages first`
+        : "",
+      job.upgradeWaitingUntil > Date.now()
+        ? `Next batch in ${Math.max(
+            1,
+            Math.ceil((job.upgradeWaitingUntil - Date.now()) / 1000)
+          )}s`
+        : "",
+      job.activeCount ? `${job.activeCount} active` : "",
+      job.queuedCount ? `${job.queuedCount} queued` : "",
+      job.remainingCount ? `${job.remainingCount} waiting` : "",
+      job.failedCount ? `${job.failedCount} failed` : "",
+      job.unavailableCount ? `${job.unavailableCount} unavailable` : "",
+      job.preparingFolderCount
+        ? `${job.preparedFolderCount || 0}/${job.preparingFolderCount} folders repaired`
+        : "",
+      job.currentPhaseLabel ? `Now: ${job.currentPhaseLabel}` : "",
+      job.statusDetail || "",
+    ]
+      .filter(Boolean)
+      .join(" · ");
+    if (detail.textContent != detailText) {
+      detail.textContent = detailText;
+    }
+    cancel.hidden = !["preparing", "queued", "running"].includes(job.state);
+  },
