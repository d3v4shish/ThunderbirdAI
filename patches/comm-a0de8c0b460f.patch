+  async #recordSenderHistory(data = {}) {
+    const analysis = data.analysis || {};
+    const author = analysis.author || data.message?.author || "";
+    const email = senderEmailFor(author);
+    const domain = senderDomainFor(author);
+    const verdict = analysis.securityAssessment?.verdict || "safe";
+    const rawHistory = await readSecurityJSON("sender-history.json", {
+      senders: {},
+      domains: {},
+    });
+    const baseHistory =
+      rawHistory && typeof rawHistory == "object" && !Array.isArray(rawHistory)
+        ? rawHistory
+        : {};
+    const history = {
+      ...baseHistory,
+      senders:
+        baseHistory.senders &&
+        typeof baseHistory.senders == "object" &&
+        !Array.isArray(baseHistory.senders)
+          ? baseHistory.senders
+          : {},
+      domains:
+        baseHistory.domains &&
+        typeof baseHistory.domains == "object" &&
+        !Array.isArray(baseHistory.domains)
+          ? baseHistory.domains
+          : {},
+    };
+    const nowISO = new Date().toISOString();
+    const senderKey = email || author || "unknown";
+    const sender = history.senders[senderKey] || {
+      firstSeen: nowISO,
+      messageCount: 0,
+      safeCount: 0,
+      suspiciousCount: 0,
+      dangerousCount: 0,
+      inAddressBook: false,
+    };
+    sender.messageCount++;
+    sender.lastSeen = nowISO;
+    if (verdict == "dangerous") {
+      sender.dangerousCount++;
+      sender.suspiciousCount++;
+    } else if (verdict == "suspicious") {
+      sender.suspiciousCount++;
+    } else {
+      sender.safeCount++;
+    }
+    sender.reputation =
+      sender.suspiciousCount || sender.dangerousCount
+        ? "has suspicious history"
+        : "previously safe";
+    history.senders[senderKey] = sender;
+    if (domain) {
+      const domainHistory = history.domains[domain] || {
+        firstSeen: nowISO,
+        messageCount: 0,
+        safeCount: 0,
+        suspiciousCount: 0,
+      };
+      domainHistory.messageCount++;
+      domainHistory.lastSeen = nowISO;
+      if (verdict == "suspicious" || verdict == "dangerous") {
+        domainHistory.suspiciousCount++;
+      } else {
+        domainHistory.safeCount++;
+      }
+      history.domains[domain] = domainHistory;
+    }
+    await writeSecurityJSON("sender-history.json", history);
+    return {
+      ...sender,
+      email,
+      domain,
+      domainHistory: domain
+        ? `${history.domains[domain].messageCount} message(s)`
+        : "",
+    };
+  }
