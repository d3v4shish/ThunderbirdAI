+++ b/mail/components/preferences/test/browser/browser_aiRuntimeLanes.js
@@ -0,0 +1,231 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+var { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+
+registerCleanupFunction(async () => {
+  if (Services.prefs.prefHasUserValue("mail.ai.enabled")) {
+    Services.prefs.clearUserPref("mail.ai.enabled");
+  }
+  await AIService.clearGeneratedData();
+  await closePrefsTab();
+});
+
+function lane({
+  id,
+  label,
+  state = "ready",
+  backend,
+  actions = [],
+  activeLabel = "",
+  failure = "",
+}) {
+  return {
+    id,
+    label,
+    health: { state },
+    queue: { partitioned: true, depth: state == "queued" ? 2 : 0 },
+    backendIdentity: { summary: backend },
+    runtimeBudget: {
+      warmSummary:
+        id == "AssistantEndpointExecutor"
+          ? "Provider-managed warmth"
+          : "On demand",
+      memorySummary: "0 MB dedicated model memory",
+      concurrencySummary: "Thunderbird scheduler",
+    },
+    timeline: [
+      {
+        at: "2026-08-19T00:00:00.000Z",
+        severity: failure ? "error" : "info",
+        action: failure ? "failure" : "ready",
+        requestId: `${id}-request`,
+        backend,
+        modelId: id == "AssistantEndpointExecutor" ? "llama3.2" : "",
+        repairHint: actions[0]?.label || "",
+      },
+    ],
+    repairReport: {
+      summary: "1 recent event; redacted report is ready to copy.",
+      text: `Redacted runtime repair report\nLane: ${label}\nMarkers: <EMAIL> <NUMBER>`,
+    },
+    liveActivity: activeLabel ? { label: activeLabel } : null,
+    activeWork: activeLabel ? { requestId: `${id}-request` } : null,
+    lastFailure: failure ? { message: failure } : null,
+    actions,
+  };
+}
+
+add_task(
+  async function test_runtime_pane_surfaces_endpoint_only_lanes_and_actions() {
+    Services.prefs.setBoolPref("mail.ai.enabled", true);
+    await AIService.clearGeneratedData();
+
+    const originals = {
+      getRuntimeReport: AIService.getRuntimeReport,
+      getRuntimeSnapshot: AIService.getRuntimeSnapshot,
+      getDataGovernanceData: AIService.getDataGovernanceData,
+      testEndpointDetailed: AIService.testEndpointDetailed,
+      resetProviderHoldOff: AIService.resetProviderHoldOff,
+      restartBackgroundAnalysis: AIService.restartBackgroundAnalysis,
+      clearPendingAnalysisQueue: AIService.clearPendingAnalysisQueue,
+    };
+    const calls = [];
+
+    try {
+      const baseRuntime = await originals.getRuntimeReport.call(
+        AIService,
+        null
+      );
+      const baseGovernance =
+        await originals.getDataGovernanceData.call(AIService);
+      const lanes = [
+        lane({
+          id: "AssistantEndpointExecutor",
+          label: "Assistant endpoint executor",
+          backend: "external HTTP | ollama | LocalAI / llama3.2",
+          activeLabel: "Assistant endpoint request active",
+          failure: "Endpoint timeout",
+          actions: [
+            { id: "test-endpoint", label: "Test Assistant endpoint" },
+            { id: "reset-provider-holdoff", label: "Reset provider hold-off" },
+          ],
+        }),
+        lane({
+          id: "SummaryPipeline",
+          label: "Summary pipeline",
+          backend: "endpoint first | deterministic fallback",
+          actions: [
+            { id: "test-endpoint", label: "Test summary endpoint" },
+            { id: "restart-analysis", label: "Restart summary analysis" },
+          ],
+        }),
+        lane({
+          id: "DeterministicAnalysisWorker",
+          label: "Deterministic analysis worker",
+          state: "queued",
+          backend: "built-in native | classifier, PII, lexical vectors",
+          actions: [
+            { id: "restart-analysis", label: "Resume background analysis" },
+            { id: "clear-analysis-queue", label: "Clear analysis queue" },
+          ],
+        }),
+        lane({
+          id: "MiningWorker",
+          label: "Mining worker",
+          backend: "internal queue | template and regex mining",
+          actions: [
+            { id: "restart-analysis", label: "Resume mining" },
+            { id: "clear-analysis-queue", label: "Clear mining queue" },
+          ],
+        }),
+      ];
+      const runtimeReport = {
+        ...baseRuntime,
+        runtimeLanes: lanes,
+        runtimeLaneOrder: lanes.map(item => item.id),
+        runtimeLanesById: Object.fromEntries(
+          lanes.map(item => [item.id, item])
+        ),
+      };
+      AIService.getRuntimeReport = async () =>
+        JSON.parse(JSON.stringify(runtimeReport));
+      AIService.getRuntimeSnapshot = async () =>
+        JSON.parse(JSON.stringify(runtimeReport));
+      AIService.getDataGovernanceData = async () => baseGovernance;
+      AIService.testEndpointDetailed = async (_accountKey, options) => {
+        calls.push(`test:${options.role}`);
+        return { config: { sourceName: "LocalAI" } };
+      };
+      AIService.resetProviderHoldOff = async () => calls.push("reset-holdoff");
+      AIService.restartBackgroundAnalysis = () => {
+        calls.push("restart-analysis");
+        return { status: "complete", summary: "Analysis resumed." };
+      };
+      AIService.clearPendingAnalysisQueue = () => {
+        calls.push("clear-analysis-queue");
+        return { status: "complete", summary: "Queue cleared." };
+      };
+
+      const runtimePane = await openNewPrefsTab("paneRuntime");
+      const runtimeDocument = runtimePane.prefsDocument;
+      await TestUtils.waitForCondition(
+        () =>
+          runtimeDocument
+            .getElementById("aiRuntimeLaneDetails")
+            .textContent.includes("Assistant endpoint executor [ready]"),
+        "waiting for endpoint-only runtime lanes"
+      );
+      const details = runtimeDocument.getElementById(
+        "aiRuntimeLaneDetails"
+      ).textContent;
+      for (const expected of [
+        "Assistant endpoint executor",
+        "Summary pipeline",
+        "Deterministic analysis worker",
+        "Mining worker",
+        "external HTTP | ollama | LocalAI / llama3.2",
+        "Last failure: Endpoint timeout",
+        "Actions: Test Assistant endpoint | Reset provider hold-off",
+      ]) {
+        Assert.ok(
+          details.includes(expected),
+          `lane details should include ${expected}`
+        );
+      }
+      Assert.ok(!details.includes("SummaryGGUFHelper"));
+      Assert.ok(!details.includes("Helper local"));
+      Assert.ok(!details.includes("llama.cpp"));
+
+      runtimePane.prefsWindow.gGeneralPane.copyAIRuntimeLaneRepairReport(
+        "AssistantEndpointExecutor"
+      );
+      const clipboard = await getClipboardText();
+      Assert.ok(clipboard.includes("Redacted runtime repair report"));
+      Assert.ok(
+        clipboard.includes("<EMAIL>") && clipboard.includes("<NUMBER>")
+      );
+
+      await AIService.runRuntimeLaneAction(
+        "AssistantEndpointExecutor",
+        "test-endpoint"
+      );
+      await AIService.runRuntimeLaneAction(
+        "AssistantEndpointExecutor",
+        "reset-provider-holdoff"
+      );
+      await AIService.runRuntimeLaneAction("SummaryPipeline", "test-endpoint");
+      await AIService.runRuntimeLaneAction(
+        "DeterministicAnalysisWorker",
+        "restart-analysis"
+      );
+      await AIService.runRuntimeLaneAction(
+        "MiningWorker",
+        "clear-analysis-queue"
+      );
+      Assert.deepEqual(calls, [
+        "test:assistant",
+        "reset-holdoff",
+        "test:summarizer",
+        "restart-analysis",
+        "clear-analysis-queue",
+      ]);
+    } finally {
+      Object.assign(AIService, originals);
+      await closePrefsTab();
+    }
+  }
+);
+
+function getClipboardText() {
+  return new Promise(resolve => {
+    document.onpaste = event => {
+      document.onpaste = null;
+      resolve(event.clipboardData.getData("text/plain"));
+    };
+    EventUtils.synthesizeKey("v", { accelKey: 1 });
+  });
+}
