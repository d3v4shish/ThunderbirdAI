+      stale: false,
+      cached: false,
+      generatedAt,
+      updatedAt: generatedAt,
+      recordGeneration: AIStorage.getRecordGeneration(),
+      source: {
+        sourceId: context.config.sourceId || "",
+        sourceName: context.config.sourceName || "Local Ollama",
+        sourceType: context.config.sourceType || "ollama",
+        model: context.config.model || "",
+        privateNetwork: true,
