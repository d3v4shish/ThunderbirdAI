+add_task(async function test_sqlite_write_amplification_gate() {
+  await AIStorage.clearGeneratedData();
+  AIStorage.beginBatch();
+  try {
+    for (let index = 0; index < 5000; index++) {
+      AIStorage.setMessage(`folder://write-gate#${index}`, {
+        accountKey: "server1",
+        folderURI: "folder://write-gate",
+        messageKey: index,
+        subject: `Write gate message ${index}`,
+        summary: `Stable message body ${index} ${"x".repeat(1024)}`,
+      });
+    }
+  } finally {
+    AIStorage.endBatch();
+  }
+  await AIStorage._jsonFile.flush();
+  const before = AIStorage.getPersistenceStatus();
+
+  AIStorage.beginBatch();
+  try {
+    for (let index = 0; index < 25; index++) {
+      AIStorage.setMessage(`folder://write-gate#${index}`, {
+        ...AIStorage.getMessage(`folder://write-gate#${index}`),
+        summary: `Updated row ${index} ${"y".repeat(1024)}`,
+      });
+    }
+  } finally {
+    AIStorage.endBatch();
+  }
+  await AIStorage._jsonFile.flush();
+  const after = AIStorage.getPersistenceStatus();
+
+  Assert.equal(
+    after.physicalWrites - before.physicalWrites,
+    1,
+    "a batched checkpoint should commit in one SQLite transaction"
+  );
+  Assert.lessOrEqual(
+    after.rowsUpserted - before.rowsUpserted,
+    25 + 10,
+    "only changed records and bounded section rows may be upserted"
+  );
+  Assert.less(
+    after.serializedBytes - before.serializedBytes,
+    256 * 1024,
+    "updating 25 rows must not serialize the multi-megabyte mailbox"
+  );
+});
