+add_task(async function test_queue_overflow_records_deferred_recovery_scope() {
+  await AIService.uninit();
+  await AIStorage.clearGeneratedData();
+
+  const account = MailServices.accounts.createLocalMailAccount();
+  account.addIdentity(MailServices.accounts.createIdentity());
+  const rootFolder = account.incomingServer.rootFolder.QueryInterface(
+    Ci.nsIMsgLocalMailFolder
+  );
+  const inboxFolder = rootFolder
+    .createLocalSubfolder("BackfillDeferredRecovery")
+    .QueryInterface(Ci.nsIMsgLocalMailFolder);
+  inboxFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+  inboxFolder.setFlag(Ci.nsMsgFolderFlags.Inbox);
+
+  const firstHeader = addRawMessage(
+    inboxFolder,
+    makeRawMessage({
+      subject: "Deferred recovery one",
+      date: "Tue, 08 Jul 2026 12:00:00 +0000",
+      messageId: "<deferred-1@backfill.test>",
+      body: "First queued analysis item.",
+    })
+  );
+  const secondHeader = addRawMessage(
+    inboxFolder,
+    makeRawMessage({
+      subject: "Deferred recovery two",
+      date: "Tue, 08 Jul 2026 11:00:00 +0000",
+      messageId: "<deferred-2@backfill.test>",
+      body: "Second queued analysis item.",
+    })
+  );
+
+  const accountKey = account.incomingServer.key;
+  const firstId = messageIdForHeader(firstHeader);
+  const secondId = messageIdForHeader(secondHeader);
+
+  Services.prefs.setBoolPref("mail.ai.backfill.paused", true);
+  await AIService.init();
+
+  try {
+    Assert.ok(
+      AIService.requestAnalysis(firstHeader),
+      "first message should enter the analysis queue"
+    );
+    AIService.onFolderPropertyFlagChanged(secondHeader);
+
+    let snapshot = await AIService.getRuntimeSnapshot(accountKey);
+    Assert.equal(snapshot.analysisRecovery.pendingCount, 1);
+    Assert.equal(snapshot.analysisRecovery.state, "pending");
+    Assert.equal(
+      snapshot.analysisRecovery.pendingScopes[0].scope.folderURI,
+      inboxFolder.URI,
+      "deferred recovery should retain the folder scope that overflowed"
+    );
+    // The priority request is allowed to drain as soon as the idle runner is
+    // scheduled. Do not assert the transient queue depth after awaiting the
+    // runtime snapshot: under parallel load the idle runner can finish first.
+    // The persisted recovery scope above is the durable evidence that the
+    // second message overflowed the bounded queue.
+
+    await TestUtils.waitForCondition(async () => {
+      const currentSnapshot = await AIService.getRuntimeSnapshot(accountKey);
+      return (
+        !!AIStorage.getMessage(firstId) &&
+        !currentSnapshot.processing &&
+        !currentSnapshot.queueLength
+      );
+    }, "waiting for the forced message request to drain while paused");
+
+    Services.prefs.setBoolPref("mail.ai.backfill.enabled", true);
+    AIService.resumeAnalysis();
+
+    await TestUtils.waitForCondition(async () => {
+      const currentSnapshot = await AIService.getRuntimeSnapshot(accountKey);
+      return (
+        !!AIStorage.getMessage(firstId) &&
+        !!AIStorage.getMessage(secondId) &&
+        currentSnapshot.analysisRecovery.pendingCount == 0 &&
+        !currentSnapshot.processing &&
+        !currentSnapshot.backfilling &&
+        !currentSnapshot.queueLength
+      );
+    }, "waiting for deferred recovery bookkeeping to clear");
+
+    snapshot = await AIService.getRuntimeSnapshot(accountKey);
+    Assert.equal(snapshot.analysisRecovery.pendingCount, 0);
+    Assert.ok(
+      !!AIStorage.getMessage(secondId),
+      "deferred recovery should analyze the overflowed message"
+    );
+  } finally {
+    await AIService.uninit();
+    await AIStorage.clearGeneratedData();
+    Services.prefs.clearUserPref("mail.ai.backfill.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.paused");
+    MailServices.accounts.removeAccount(account, false);
+  }
+});
