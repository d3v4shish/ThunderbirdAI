+    AIEndpoint.canUseEndpoint = originalCanUse;
+    AIEndpoint.getConfig = originalGetConfig;
+    AIEndpoint.chatWithDebug = originalChatWithDebug;
+  }
+
+  const extractAttachedContext = request => {
+    const userMessage = Array.isArray(request) ? request[1]?.content || "" : "";
+    const marker = "ATTACHED_CONTEXT_JSON:\n";
+    const index = userMessage.indexOf(marker);
+    Assert.greaterOrEqual(index, 0, "attached context should be present");
+    return JSON.parse(userMessage.slice(index + marker.length));
