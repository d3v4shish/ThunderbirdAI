+  // Narrative, source-backed questions must be based on focused evidence
+  // rather than a generic overview. Specialist tools (transactions, cached
+  // contacts, and cached calendars) already return canonical focused records
+  // and should not pay the latency of an unrelated graph traversal.
+  const text = String(prompt || "").toLocaleLowerCase();
+  if (
+    /\b(?:transaction|debit|credit|merchant|spent|spend|payment|purchase|currency)\b/u.test(
+      text
