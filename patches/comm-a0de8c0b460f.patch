+
+function senderDomain(author = "") {
+  const text = String(author ?? "");
+  const match =
+    text.match(/<([^>]+)>/) ||
+    text.match(/\b([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})\b/i);
