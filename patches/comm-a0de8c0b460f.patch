+      id: `template-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,
+      name: "Mail template",
+      enabled: true,
+      createdFrom: "manual",
+      match: {
+        from: { mode: "contains", value: "" },
+        subject: { mode: "contains", value: "" },
+        body: { mode: "contains", value: "" },
+        typedSlots: [],
+      },
+      summaryMode: "template",
+      summaryTemplate: "",
+      categoryMode: "prior",
+      categoryValue: "",
+      extractionFields: [],
+      suppressions: [],
+      piiFields: [],
+      examples: [],
+    };
