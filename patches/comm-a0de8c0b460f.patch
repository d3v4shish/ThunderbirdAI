+  },
+
+  async clearGeneratedData() {
+    await IOUtils.remove(AIRuntimePaths.templatesFilePath(), {
+      ignoreAbsent: true,
+    });
+    await clearJSONStoreRecoveryArchives("ai-templates");
+    this._jsonFile = null;
+    this._initPromise = null;
+    await this.init();
+  },
+
+  importAccount(accountKey = "global", data = {}, replace = false) {
+    const imported = Array.isArray(data.templates)
+      ? data.templates.map(normalizeTemplate)
+      : [];
+    if (replace) {
+      this.setTemplates(accountKey, imported);
+      return this.getTemplates(accountKey);
+    }
+    this.setTemplates(
+      accountKey,
+      uniqueTemplates([...this.getTemplates(accountKey), ...imported])
+    );
+    return this.getTemplates(accountKey);
+  },
+
+  evaluate(message, accountKey = "global") {
+    let bestMatch = null;
+    for (const template of this.getActiveTemplates(accountKey)) {
+      if (!template.enabled) {
+        continue;
+      }
+      const matched = templateScore(message, template);
+      if (!matched) {
+        continue;
+      }
+      if (!bestMatch || matched.score > bestMatch.score) {
+        bestMatch = {
+          template,
+          slots: matched.slots,
+          score: matched.score,
+        };
+      }
+    }
+    if (!bestMatch) {
+      return null;
+    }
+    const summary =
+      bestMatch.template.summaryMode == "template"
+        ? renderTemplateSummary(
+            bestMatch.template.summaryTemplate,
+            bestMatch.slots
+          )
+        : "";
+    const extractedEntities = {};
+    for (const [slotType, values] of Object.entries(bestMatch.slots)) {
+      extractedEntities[slotType] = values.slice(0, 6);
+    }
+    return {
+      matchedTemplateId: bestMatch.template.id,
+      matchedTemplateName: bestMatch.template.name,
+      templateFamily: templateFamilyFor(bestMatch.template),
+      templateSlots: bestMatch.slots,
+      templateCategory: bestMatch.template.categoryValue,
+      templateCategoryMode: bestMatch.template.categoryMode,
+      templateSummaryMode: bestMatch.template.summaryMode,
+      templateSummary: summary,
+      templateConfig: {
+        extractionFields: bestMatch.template.extractionFields,
+        suppressions: bestMatch.template.suppressions,
+        piiFields: bestMatch.template.piiFields,
+      },
+      extractedEntities,
+    };
+  },
+
+  createTemplateFromMessages(messages = [], options = {}) {
+    return inferTemplate(messages, options);
+  },
+
+  testTemplate(template, messages = []) {
+    const normalized = normalizeTemplate(template);
+    return messages.map(message => {
+      const matched = templateScore(message, normalized);
+      return {
+        messageId: limitedString(message.messageId, 200),
+        subject: limitedString(message.subject, 200),
+        author: limitedString(message.author, 200),
+        matched: !!matched,
+        score: matched?.score || 0,
+        slots: matched?.slots || {},
+      };
+    });
+  },
+
+  suggestFromRecords(records = [], accountKey = "global") {
+    const groups = new Map();
+    for (const record of records) {
+      const domain = senderDomain(record.author);
+      const subject = normalizedSkeleton(record.subject);
+      if (!domain || !subject) {
+        continue;
+      }
+      const key = `${domain}|${subject}`;
+      if (!groups.has(key)) {
+        groups.set(key, []);
+      }
+      groups.get(key).push({
+        messageId: record.messageId || "",
+        author: record.author || "",
+        subject: record.subject || "",
+        body: record.body || record.localText || "",
+      });
+    }
+    const existingKeys = new Set(
+      this.getActiveTemplates(accountKey).map(template => {
+        return [
+          normalizeText(template.match?.from?.value),
+          normalizeText(template.match?.subject?.value),
+        ].join("|");
+      })
+    );
+    return Array.from(groups.values())
+      .filter(messages => messages.length >= 3)
+      .map(messages =>
+        inferTemplate(messages, {
+          createdFrom: "suggested",
+        })
+      )
+      .filter(template => {
+        const key = [
+          normalizeText(template.match?.from?.value),
+          normalizeText(template.match?.subject?.value),
+        ].join("|");
+        return !existingKeys.has(key);
+      })
+      .slice(0, 12);
+  },
+};
diff --git a/mail/components/ai/modules/AITrainingData.sys.mjs b/mail/components/ai/modules/AITrainingData.sys.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/ai/modules/AITrainingData.sys.mjs
@@ -0,0 +1,433 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import {
+  clearJSONStoreRecoveryArchives,
+  initRecoverableJSONStore,
+} from "moz-src:///comm/mail/components/ai/modules/AIJSONStore.sys.mjs";
+import { AIRuntimePaths } from "moz-src:///comm/mail/components/ai/modules/AIRuntimePaths.sys.mjs";
+
+const MAX_EXAMPLES = 5000;
+
+function plainObject(value) {
+  return value && typeof value == "object" && !Array.isArray(value)
+    ? value
+    : {};
+}
+
+function limitedString(value, limit = 4000) {
+  return String(value ?? "")
+    .trim()
+    .slice(0, limit);
+}
+
+function normalizeLabel(value = "") {
+  return limitedString(value, 80)
+    .toLocaleLowerCase()
+    .replace(/[^\p{L}\p{N}._-]+/gu, "-")
+    .replace(/^-+|-+$/gu, "");
+}
+
+function makeId(prefix = "example") {
+  return `${prefix}-${Date.now().toString(36)}-${Math.random()
+    .toString(36)
+    .slice(2, 8)}`;
+}
+
+function tokenize(text) {
+  return limitedString(text, 12000)
+    .toLocaleLowerCase()
+    .replace(/[^\p{L}\p{N}]+/gu, " ")
+    .split(/\s+/u)
+    .filter(token => token && token.length > 2)
+    .slice(0, 512);
+}
+
+function normalizeExample(example = {}) {
+  return {
+    id: limitedString(example.id, 80) || makeId(),
+    label: normalizeLabel(example.label) || "uncategorized",
+    text: limitedString(example.text, 12000),
+    subject: limitedString(example.subject, 240),
+    author: limitedString(example.author, 240),
+    messageId: limitedString(example.messageId, 240),
+    include: example.include !== false,
+    holdout: !!example.holdout,
+    addedAt: limitedString(example.addedAt, 80) || new Date().toISOString(),
+  };
+}
+
+function normalizeDataset(dataset = {}, name = "categories") {
+  const labels = plainObject(dataset.labels);
+  const normalizedLabels = {};
+  for (const [label, value] of Object.entries(labels)) {
+    const key = normalizeLabel(label);
+    if (!key) {
+      continue;
+    }
+    normalizedLabels[key] = {
+      enabled: value?.enabled !== false,
+      displayName: limitedString(value?.displayName || label, 120) || key,
+      mappedCategory: limitedString(value?.mappedCategory || key, 80),
+    };
+  }
+  return {
+    name,
+    labels: normalizedLabels,
+    examples: Array.isArray(dataset.examples)
+      ? dataset.examples.slice(0, MAX_EXAMPLES).map(normalizeExample)
+      : [],
+    model: plainObject(dataset.model),
+  };
+}
+
+function defaultDatasets() {
+  return {
+    categories: normalizeDataset({}, "categories"),
+    "spam-ham": normalizeDataset({}, "spam-ham"),
+    "tone-intent": normalizeDataset({}, "tone-intent"),
+    custom: normalizeDataset({}, "custom"),
+  };
+}
+
+function scoreConfidence(bestScore, secondScore) {
+  const gap = bestScore - secondScore;
+  if (gap > 10) {
+    return "high";
+  }
+  if (gap > 4) {
+    return "medium";
+  }
+  return "low";
+}
+
+const CURRENT_ENGINE = "multinomial-naive-bayes";
+const LEGACY_ENGINES = new Set(["fasttext-supervised", CURRENT_ENGINE]);
+
+export const AITrainingData = {
+  _jsonFile: null,
+  _initPromise: null,
+
+  async init() {
+    if (this._jsonFile?.dataReady) {
+      return;
+    }
+    if (this._initPromise) {
+      await this._initPromise;
+      return;
+    }
+    this._initPromise = (async () => {
+      await IOUtils.makeDirectory(AIRuntimePaths.profileConfigRootDir(), {
+        createAncestors: true,
+        ignoreExisting: true,
+      });
+      const { jsonFile } = await initRecoverableJSONStore({
+        storeId: "ai-training-data",
+        owner: "AI training data",
+        path: PathUtils.join(
+          AIRuntimePaths.profileConfigRootDir(),
+          "ai-training-sets.json"
+        ),
+        dataPostProcessor(data = {}) {
+          const datasets = plainObject(data.datasets);
+          const normalized = defaultDatasets();
+          for (const [name, dataset] of Object.entries(datasets)) {
+            normalized[name] = normalizeDataset(dataset, name);
+          }
+          return {
+            version: 1,
+            datasets: normalized,
+          };
+        },
+      });
+      this._jsonFile = jsonFile;
+    })();
+    try {
+      await this._initPromise;
+    } finally {
+      this._initPromise = null;
+    }
+  },
+
+  get data() {
+    if (!this._jsonFile?.dataReady) {
+      throw new Error("AI training data storage is not ready");
+    }
+    return this._jsonFile.data;
+  },
+
+  saveSoon() {
+    this._jsonFile?.saveSoon();
+  },
+
+  getDataset(name = "categories") {
+    return normalizeDataset(this.data.datasets[name], name);
+  },
+
+  setDataset(name = "categories", dataset = {}) {
+    this.data.datasets[name] = normalizeDataset(dataset, name);
+    this.saveSoon();
+  },
+
+  listDatasets() {
+    return Object.keys(this.data.datasets).sort();
+  },
+
+  listLabels(name = "categories") {
+    return Object.entries(this.getDataset(name).labels).map(([id, value]) => ({
+      id,
+      ...value,
+    }));
+  },
+
+  saveLabel(name = "categories", label = "", data = {}) {
+    const dataset = this.getDataset(name);
+    const id = normalizeLabel(label || data.id || data.displayName);
+    if (!id) {
+      throw new Error("Label is required.");
+    }
+    dataset.labels[id] = {
+      enabled: data.enabled !== false,
+      displayName: limitedString(data.displayName || label || id, 120) || id,
+      mappedCategory: limitedString(data.mappedCategory || id, 80) || id,
+    };
+    this.setDataset(name, dataset);
+    return { id, ...dataset.labels[id] };
+  },
+
+  renameLabel(name = "categories", oldId = "", nextLabel = "") {
+    const dataset = this.getDataset(name);
+    const nextId = normalizeLabel(nextLabel);
+    if (!dataset.labels[oldId] || !nextId) {
+      throw new Error("Unable to rename label.");
+    }
+    dataset.labels[nextId] = {
+      ...dataset.labels[oldId],
+      displayName: limitedString(nextLabel, 120) || nextId,
+    };
+    delete dataset.labels[oldId];
+    dataset.examples = dataset.examples.map(example =>
+      example.label == oldId ? { ...example, label: nextId } : example
+    );
+    this.setDataset(name, dataset);
+  },
+
+  mergeLabels(name = "categories", sourceIds = [], targetId = "") {
+    const dataset = this.getDataset(name);
+    const normalizedTarget = normalizeLabel(targetId);
+    if (!normalizedTarget) {
+      throw new Error("Target label is required.");
+    }
+    if (!dataset.labels[normalizedTarget]) {
+      this.saveLabel(name, normalizedTarget, { displayName: targetId });
+    }
+    const sourceSet = new Set(sourceIds.map(normalizeLabel).filter(Boolean));
+    dataset.examples = dataset.examples.map(example =>
+      sourceSet.has(example.label)
+        ? { ...example, label: normalizedTarget }
+        : example
+    );
+    for (const id of sourceSet) {
+      if (id != normalizedTarget) {
+        delete dataset.labels[id];
+      }
+    }
+    this.setDataset(name, dataset);
+  },
+
+  addExamples(name = "categories", label = "", examples = []) {
+    const dataset = this.getDataset(name);
+    const normalizedLabel = normalizeLabel(label);
+    if (!normalizedLabel) {
+      throw new Error("A label is required.");
+    }
+    if (!dataset.labels[normalizedLabel]) {
+      this.saveLabel(name, normalizedLabel, { displayName: label });
+      dataset.labels = this.getDataset(name).labels;
+    }
+    const prepared = examples.map(example =>
+      normalizeExample({
+        ...example,
+        label: normalizedLabel,
+      })
+    );
+    dataset.examples.push(...prepared);
+    dataset.examples = dataset.examples.slice(-MAX_EXAMPLES);
+    this.setDataset(name, dataset);
+    return prepared;
+  },
+
+  updateExample(name = "categories", exampleId = "", updates = {}) {
+    const dataset = this.getDataset(name);
+    const index = dataset.examples.findIndex(
+      example => example.id == exampleId
+    );
+    if (index < 0) {
+      throw new Error("Training example not found.");
+    }
+    dataset.examples[index] = normalizeExample({
+      ...dataset.examples[index],
+      ...updates,
+    });
+    this.setDataset(name, dataset);
+    return dataset.examples[index];
+  },
+
+  removeExample(name = "categories", exampleId = "") {
+    const dataset = this.getDataset(name);
+    dataset.examples = dataset.examples.filter(
+      example => example.id != exampleId
+    );
+    this.setDataset(name, dataset);
+  },
+
+  dedupeExamples(name = "categories") {
+    const dataset = this.getDataset(name);
+    const seen = new Set();
+    dataset.examples = dataset.examples.filter(example => {
+      const key = `${example.label}\n${example.messageId}\n${example.text}`;
+      if (seen.has(key)) {
+        return false;
+      }
+      seen.add(key);
+      return true;
+    });
+    this.setDataset(name, dataset);
+  },
+
+  rebuild(name = "categories") {
+    const dataset = this.getDataset(name);
+    const activeLabels = Object.entries(dataset.labels).filter(
+      ([, value]) => value.enabled !== false
+    );
+    const labelStats = {};
+    const vocabulary = new Map();
+    let exampleCount = 0;
+    for (const [label] of activeLabels) {
+      labelStats[label] = {
+        tokenCounts: Object.create(null),
+        totalTokens: 0,
+        exampleCount: 0,
+      };
+    }
+    for (const example of dataset.examples) {
+      if (!example.include || example.holdout || !labelStats[example.label]) {
+        continue;
+      }
+      const tokens = tokenize(
+        [example.subject, example.author, example.text]
+          .filter(Boolean)
+          .join("\n")
+      );
+      exampleCount++;
+      labelStats[example.label].exampleCount++;
+      for (const token of tokens) {
+        vocabulary.set(token, true);
+        labelStats[example.label].tokenCounts[token] =
+          (labelStats[example.label].tokenCounts[token] || 0) + 1;
+        labelStats[example.label].totalTokens++;
+      }
+    }
+    dataset.model = {
+      // This implementation is a local multinomial Naive Bayes scorer. It
+      // never was a fastText runtime; naming it accurately keeps diagnostics
+      // and A/B evaluations honest.
+      engine: CURRENT_ENGINE,
+      builtAt: new Date().toISOString(),
+      labelCount: activeLabels.length,
+      exampleCount,
+      vocabularySize: vocabulary.size,
+      labelStats,
+    };
+    this.setDataset(name, dataset);
+    return dataset.model;
+  },
+
+  classifyText(name = "categories", text = "") {
+    const dataset = this.getDataset(name);
+    const model = plainObject(dataset.model);
+    if (!LEGACY_ENGINES.has(model.engine) || !plainObject(model.labelStats)) {
+      return null;
+    }
+    const tokens = tokenize(text);
+    if (!tokens.length) {
+      return null;
+    }
+    const vocabSize = Math.max(1, Number(model.vocabularySize) || 1);
+    const scores = [];
+    const totalExamples = Math.max(
+      1,
+      Object.values(model.labelStats).reduce(
+        (total, stats) => total + (Number(stats.exampleCount) || 0),
+        0
+      )
+    );
+    for (const [label, stats] of Object.entries(model.labelStats)) {
+      const tokenCounts = plainObject(stats.tokenCounts);
+      let score = Math.log(
+        Math.max(1, Number(stats.exampleCount) || 0) / totalExamples
+      );
+      const totalTokens = Math.max(1, Number(stats.totalTokens) || 1);
+      for (const token of tokens) {
+        const count = Number(tokenCounts[token] || 0);
+        score += Math.log((count + 1) / (totalTokens + vocabSize));
+      }
+      scores.push({
+        label,
+        score,
+        exampleCount: Number(stats.exampleCount) || 0,
+      });
+    }
+    scores.sort((left, right) => right.score - left.score);
+    const best = scores[0];
+    if (!best) {
+      return null;
+    }
+    const second = scores[1]?.score ?? best.score - 1;
+    return {
+      label: best.label,
+      confidence: scoreConfidence(best.score, second),
+      scores: scores.slice(0, 5),
+      engine: CURRENT_ENGINE,
+    };
+  },
+
+  exportDataset(name = "categories") {
+    return JSON.stringify(this.getDataset(name), null, 2);
+  },
+
+  importDataset(name = "categories", raw = {}, replace = false) {
+    const current = this.getDataset(name);
+    const incoming = normalizeDataset(raw, name);
+    if (replace) {
+      this.setDataset(name, incoming);
+      return;
+    }
+    this.setDataset(name, {
+      ...current,
+      labels: {
+        ...current.labels,
+        ...incoming.labels,
+      },
+      examples: current.examples.concat(incoming.examples).slice(-MAX_EXAMPLES),
+      model: current.model,
+    });
+  },
+
+  async clearGeneratedData() {
+    await IOUtils.remove(
+      PathUtils.join(
+        AIRuntimePaths.profileConfigRootDir(),
+        "ai-training-sets.json"
+      ),
+      {
+        ignoreAbsent: true,
+      }
+    );
+    await clearJSONStoreRecoveryArchives("ai-training-data");
+    this._jsonFile = null;
+    this._initPromise = null;
+    await this.init();
+  },
+};
