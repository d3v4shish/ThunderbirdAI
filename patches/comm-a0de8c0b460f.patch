+}
+
+function roleBackedRuntimeLaneBackendIdentity(roleRows = [], laneLabel = "") {
+  const roleIdentityRows = runtimeLaneRoleIdentityRows(roleRows);
+  const transportKinds = uniqueStringValues(
+    roleRows.map(row => row.transportLabel)
