+        chunkChars: MAILBOX_DIGEST_CHUNK_CHARS,
+        chunkOverlapChars: MAILBOX_DIGEST_CHUNK_OVERLAP_CHARS,
+        packChars: MAILBOX_DIGEST_PACK_CHARS,
