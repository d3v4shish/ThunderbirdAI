+
+  getAITemplateFromForm(existingTemplate = null) {
+    const template = existingTemplate
+      ? {
+          ...existingTemplate,
+          match: {
+            ...(existingTemplate.match || {}),
+          },
+        }
+      : this.makeAITemplate();
+    template.name =
+      document.getElementById("aiTemplateName").value.trim() || template.name;
+    template.enabled = document.getElementById("aiTemplateEnabled").checked;
+    template.summaryMode =
+      document.getElementById("aiTemplateSummaryMode").value || "template";
+    template.summaryTemplate = document
+      .getElementById("aiTemplateSummaryTemplate")
+      .value.trim();
+    template.categoryMode =
+      document.getElementById("aiTemplateCategoryMode").value || "prior";
+    template.categoryValue = document
+      .getElementById("aiTemplateCategoryValue")
+      .value.trim();
+    template.match = {
+      from: {
+        mode: document.getElementById("aiTemplateFromMode").value || "contains",
+        value: document.getElementById("aiTemplateFromValue").value.trim(),
+      },
+      subject: {
+        mode:
+          document.getElementById("aiTemplateSubjectMode").value || "contains",
+        value: document.getElementById("aiTemplateSubjectValue").value.trim(),
+      },
+      body: {
+        mode: document.getElementById("aiTemplateBodyMode").value || "contains",
+        value: document.getElementById("aiTemplateBodyValue").value.trim(),
+      },
+      typedSlots: document
+        .getElementById("aiTemplateTypedSlots")
+        .value.split(/[\n,]+/u)
+        .map(value => value.trim())
+        .filter(Boolean),
+    };
+    template.extractionFields = document
+      .getElementById("aiTemplateExtractionFields")
+      .value.split(/[\n,]+/u)
+      .map(value => value.trim())
+      .filter(Boolean);
+    template.suppressions = document
+      .getElementById("aiTemplateSuppressions")
+      .value.split(/[\n,]+/u)
+      .map(value => value.trim())
+      .filter(Boolean);
+    template.piiFields = document
+      .getElementById("aiTemplatePIIFields")
+      .value.split(/[\n,]+/u)
+      .map(value => value.trim())
+      .filter(Boolean);
+    return template;
+  },
