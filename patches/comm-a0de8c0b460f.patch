+  async probeAssistantFallbackHealth(accountKey = null) {
+    await AIStorage.init();
+    await AISources.init();
+    const normalizedAccountKey =
+      accountKey || this.#currentSelection.accountKey || "global";
+    const effectiveAccountKey =
+      normalizedAccountKey == "global" ? null : normalizedAccountKey;
+    const config = AIEndpoint.getConfig(effectiveAccountKey, {
+      role: "assistant-fallback",
+    });
+    const probeKey = this.#assistantFallbackProbeKey(
+      normalizedAccountKey,
+      config.sourceId || config.endpointURL || config.provider || "",
+      config
+    );
+    if (
+      !getBoolPref("mail.ai.health_probe.enabled", true) ||
+      Services.io.offline
+    ) {
+      this.#notifyRuntimeChanged();
+      return this.#assistantFallbackHealthFor(normalizedAccountKey, config);
+    }
+    if (!config.endpointURL || !config.model) {
+      this.#notifyRuntimeChanged();
+      this.scheduleAssistantFallbackHealthProbe({
+        accountKey: normalizedAccountKey,
+      });
+      return this.#assistantFallbackHealthFor(normalizedAccountKey, config);
+    }
+    if (this.#assistantFallbackProbeInFlight.has(probeKey)) {
+      return this.#assistantFallbackHealthFor(normalizedAccountKey, config);
+    }
+    this.#assistantFallbackProbeInFlight.add(probeKey);
+    this.#notifyRuntimeChanged();
+    try {
+      await this.#runAssistantEndpointTransition(
+        {
+          owner: "background",
+          kind: "health-probe",
+          label: "Assistant endpoint health probe",
+          accountKey: normalizedAccountKey,
+          role: "assistant-fallback",
+          sourceId: config.sourceId || "",
+          sourceName:
+            config.sourceName || config.sourceType || config.provider || "",
+          model: config.model || "",
+          endpointURL: config.endpointURL || "",
+          coalesceKey: `probe:${probeKey}`,
+          cancellable: true,
+        },
+        async ({ signal }) => {
+          try {
+            if (
+              !AIEndpoint.canUseEndpoint(effectiveAccountKey, {
+                role: "assistant-fallback",
+              })
+            ) {
+              this.#assistantFallbackProbeTrace({
+                accountKey: normalizedAccountKey,
+                config,
+                errorMessage:
+                  "Assistant endpoint is disabled by current settings.",
+              });
+              return;
+            }
+            const result = await AIEndpoint.probeOllamaHealthDetailed(
+              effectiveAccountKey,
+              {
+                sourceId: config.sourceId || "",
+                role: "assistant-fallback",
+                activityKind: "probe",
+                signal,
+              }
+            );
+            this.#assistantFallbackProbeTrace({
+              accountKey: normalizedAccountKey,
+              config: result.config || config,
+              answer: `${result.modelCount} installed model(s); ${result.installedModel.name} found.`,
+              attempts: [
+                {
+                  transport: "ollama-model-list",
+                  durationMs: result.latencyMs,
+                },
+              ],
+            });
+          } catch (error) {
+            if (
+              signal?.aborted ||
+              isAssistantEndpointTransitionAbortError(error)
+            ) {
+              return;
+            }
+            this.#assistantFallbackProbeTrace({
+              accountKey: normalizedAccountKey,
+              config: error.aiEndpointDebug?.config || config,
+              attempts: error.aiEndpointDebug?.attempts || [],
+              errorMessage: error.message,
+              failureKind: error.aiProviderFailureKind || "transport",
+            });
+          }
+        }
+      );
+    } finally {
+      this.#assistantFallbackProbeInFlight.delete(probeKey);
+      this.#notifyRuntimeChanged();
+      this.scheduleAssistantFallbackHealthProbe({
+        accountKey: normalizedAccountKey,
+      });
+    }
+    return this.#assistantFallbackHealthFor(normalizedAccountKey, config);
+  }
