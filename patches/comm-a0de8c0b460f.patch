+  renderAIPromptSandboxLog(logId, result = {}) {
+    const log = document.getElementById(logId);
+    if (!log) {
+      return;
+    }
+    const state = result.ok ? "PASS" : "FAIL";
+    log.dataset.state = state.toLowerCase();
+    log.textContent = [
+      `${state}: ${result.feature || "prompt"} prompt sandbox`,
+      `Trace: ${result.traceId || "not recorded"}`,
+      `Source: ${result.sourceName || result.sourceId || "default"}`,
+      `Model: ${result.model || "not resolved"}`,
+      `Endpoint: ${result.endpointURL || "not resolved"}`,
+      `Attempts: ${result.attempts ?? 0}`,
+      `Request preview:\n${result.requestPreview || ""}`,
+      `Response preview:\n${result.responsePreview || result.errorMessage || ""}`,
+    ].join("\n");
+  },
+
+  async testAIPromptSandbox(
+    feature,
+    { statusId = "", logId = "", targetLabel = "" } = {}
+  ) {
+    const normalizedFeature = feature == "summary" ? "summary" : "assistant";
+    const inputIdByFeature = {
+      assistant: "aiAssistantPrompt",
+      summary: "aiSummaryPrompt",
+    };
+    const sourceRoleByFeature = {
+      assistant: "assistant",
+      summary: "background",
+    };
+    const status = statusId ? document.getElementById(statusId) : null;
+    const target = targetLabel || feature || "Prompt";
+    if (status) {
+      status.value = `Testing ${target} prompt...`;
+    }
+    const result = await AIService.testPromptSandbox({
+      feature: normalizedFeature,
+      sourceId: this.getAISourceBindingValue(
+        sourceRoleByFeature[normalizedFeature] || ""
+      ),
+      featureInstruction:
+        document.getElementById(inputIdByFeature[normalizedFeature])?.value ||
+        "",
+      rawOverride: document.getElementById("aiPromptRawOverride")?.value || "",
+      debugEnabled:
+        document.getElementById("aiPromptDebugEnabled")?.checked || false,
+    });
+    if (status) {
+      status.value = result.ok
+        ? `${target} prompt sandbox passed. Trace ${result.traceId}.`
+        : `${target} prompt sandbox failed. Trace ${result.traceId}.`;
+    }
+    this.renderAIPromptSandboxLog(logId, result);
+  },
