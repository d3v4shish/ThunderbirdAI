+        cardRowHeight,
+        "Thread card markers should stay within the fixed row height"
+      );
+      const cardBounds = cardRow.getBoundingClientRect();
+      for (const selector of [
+        ".sender",
+        ".date",
+        ".subject",
+        ".thread-card-ai-phases",
