+        this.#recordMailboxDigestEndpointTiming(
+          context,
+          Date.now() - startedAt,
+          reduced.calls
+        );
+        node = reduced.node;
+        context.job.reductionCalls += reduced.calls;
+        context.job.reductionRounds = Math.max(
+          context.job.reductionRounds,
+          reduced.rounds
+        );
+      }
+      node.evidenceIds = [messageId];
+      context.messageNodes.set(messageId, node);
+      context.job.mappedMessages++;
