+      /[^a-z0-9_-]/gi,
+      "_"
+    )}`;
+  },
+
+  aiLocalModelRuntimePresenceText(model = {}) {
+    if (!model.managedRuntime && (model.catalogId || model.backend)) {
+      const artifactFiles = model.artifactFiles || [];
+      const hasArtifacts = artifactFiles.some(file => !!file.path);
+      return model.runtimePresenceState == "present" ||
+        (hasArtifacts &&
+          (model.artifactState == "verified" || model.installState == "ready"))
+        ? "Installed in Thunderbird model cache"
+        : "Missing from Thunderbird model cache";
+    }
+    if (!model.managedRuntime) {
+      return "Not a managed runtime";
+    }
+    switch (model.runtimePresenceState) {
+      case "present":
+        return "Installed for Ollama endpoint";
+      case "unknown":
+        return "Ollama endpoint state unavailable";
+      case "missing":
+      default:
+        return "Missing from Ollama endpoint";
+    }
+  },
+
+  aiLocalModelRuntimeStorageText(model = {}) {
+    if (model.runtimeStorageBytes > 0) {
+      const [amount, unit] = DownloadUtils.convertByteUnits(
+        model.runtimeStorageBytes
+      );
+      return `${amount} ${unit} (${model.runtimeStorageBytes.toLocaleString()} bytes)`;
+    }
+    if (model.runtimeStorageMB > 0) {
+      return `${model.runtimeStorageMB} MB`;
+    }
+    return model.managedRuntime || model.catalogId || model.backend
+      ? "Unknown"
+      : "n/a";
+  },
+
+  aiLocalModelEffectiveInstallState(model = {}) {
+    const installState = model.installState || "";
+    if (
+      [
+        "queued",
+        "downloading",
+        "installing",
+        "paused",
+        "cancelled",
+        "failed",
+      ].includes(installState)
+    ) {
+      return installState;
+    }
+    if (!model.managedRuntime && (model.catalogId || model.backend)) {
+      const artifactFiles = model.artifactFiles || [];
+      const hasArtifacts = artifactFiles.some(file => !!file.path);
+      if (
+        model.runtimePresenceState == "present" ||
+        (hasArtifacts &&
+          (model.artifactState == "verified" || model.installState == "ready"))
+      ) {
+        return "ready";
+      }
+      return model.artifactState == "blocked" ? "blocked" : "missing";
+    }
+    return installState || (model.installed ? "ready" : "missing");
+  },
+
+  aiLocalModelSupportsTesting(_model = {}) {
+    return false;
+  },
+
+  renderAILocalModelsRuntimeStatus(state = {}) {
+    const status = document.getElementById("aiLocalModelsRuntimeStatus");
+    if (!status) {
+      return;
+    }
+    const models = state.models || [];
+    const endpointActivity = this._describeAIEndpointActivity(
+      state.endpointActivity || null
+    );
+    if (endpointActivity) {
+      status.hidden = false;
+      status.value = `${endpointActivity.label}: ${endpointActivity.detail}`;
+      status.dataset.state = "active";
+      return;
+    }
+    const activeInstallModel = models.find(model =>
+      ["downloading", "installing", "queued", "paused"].includes(
+        model.installState || model.runtimeState || ""
+      )
+    );
+    if (activeInstallModel) {
+      const installState =
+        activeInstallModel.installState ||
+        activeInstallModel.runtimeState ||
+        "downloading";
+      let label = "Model download in progress";
+      if (installState == "queued") {
+        label = "Model install queued";
+      } else if (installState == "paused") {
+        label = "Model download paused";
+      }
+      const rawProgress = Math.max(
+        0,
+        Math.min(100, Number(activeInstallModel.downloadProgress) || 0)
+      );
+      const detail = [
+        activeInstallModel.name || activeInstallModel.id || "local model",
+        installState,
+        rawProgress ? `${rawProgress}%` : "",
+      ]
+        .filter(Boolean)
+        .join(" / ");
+      status.hidden = false;
+      status.value = `${label}: ${detail}`;
+      status.dataset.state = ["paused", "queued"].includes(installState)
+        ? "info"
+        : "active";
+      return;
+    }
+    const assistantFallbackHealth = state.assistantFallbackHealth || null;
+    if (assistantFallbackHealth?.state == "checking") {
+      const detail = [
+        assistantFallbackHealth.sourceName || "Assistant endpoint",
+        assistantFallbackHealth.model || "",
+        assistantFallbackHealth.endpointURL || "",
+      ]
+        .filter(Boolean)
+        .join(" / ");
+      status.hidden = false;
+      status.value = `Endpoint probe in progress: ${detail}`;
+      status.dataset.state = "active";
+      return;
+    }
+    status.hidden = true;
+    status.value = "";
+    delete status.dataset.state;
+  },
+
+  _describeAIEndpointActivity(endpointActivity = null) {
+    const activeRequest = endpointActivity?.activeRequests?.[0] || null;
+    if (!activeRequest) {
+      return null;
+    }
+    let label = "Endpoint request in progress";
+    switch (activeRequest.kind) {
+      case "probe":
+        label = "Endpoint probe in progress";
+        break;
+      case "assistant-send":
+        label = "Assistant endpoint request in progress";
+        break;
+      case "summary-send":
+        label = "Summary endpoint request in progress";
+        break;
+      case "embedding":
+        label = "Endpoint embedding request in progress";
+        break;
+    }
+    return {
+      label,
+      detail: [
+        activeRequest.sourceName ||
+          activeRequest.sourceType ||
+          activeRequest.provider ||
+          "endpoint",
+        activeRequest.model || "",
+        activeRequest.transport || "",
+        activeRequest.cancellable ? "cancellable" : "non-cancellable",
+      ]
+        .filter(Boolean)
+        .join(" / "),
+      request: activeRequest,
+    };
+  },
+
+  aiLocalModelArtifactPathText(model = {}) {
+    return (
+      model.artifactPath ||
+      model.artifactFiles?.find(file => file.path)?.path ||
+      "n/a"
+    );
+  },
+
+  ensureAILocalModelsUIStructure() {
+    // The markup intentionally contains the complete migration-cleanup UI.
+    // Do not recreate retired install, runtime, or role-assignment controls.
+  },
+
+  ensureAILocalModelsCardsContainer() {
+    this.ensureAILocalModelsUIStructure();
+    return document.getElementById("aiLocalModelsCards");
+  },
+
+  renderAILocalModelsOverview(state = {}) {
+    const overview = document.getElementById("aiLocalModelsOverview");
+    if (!overview) {
+      return;
+    }
+    overview.replaceChildren();
+    const models = state.models || [];
+    const retainedArtifacts = models.filter(
+      model => model.runtimeProvider != "built-in-native"
+    ).length;
+    for (const line of [
+      retainedArtifacts
+        ? `${retainedArtifacts} retained legacy artifact${
+            retainedArtifacts == 1 ? "" : "s"
+          } available for cleanup.`
+        : "No retained local-model artifacts.",
+      "Assistant and Summaries use configured endpoints or deterministic processing; they never execute models from this inventory.",
+    ]) {
+      const row = document.createElement("div");
+      row.textContent = line;
+      overview.append(row);
+    }
+  },
+
+  renderAILocalModelCards(state = {}) {
+    const container = this.ensureAILocalModelsCardsContainer();
+    if (!container) {
+      return;
+    }
+    if (this._aiLocalModelCardsRenderFrame) {
+      cancelAnimationFrame(this._aiLocalModelCardsRenderFrame);
+      this._aiLocalModelCardsRenderFrame = null;
+    }
+    if (this._aiLocalModelCardsRenderTimer) {
+      clearTimeout(this._aiLocalModelCardsRenderTimer);
+      this._aiLocalModelCardsRenderTimer = null;
+    }
+    this._aiLocalModelCardsRenderToken =
+      (this._aiLocalModelCardsRenderToken || 0) + 1;
+    const renderToken = this._aiLocalModelCardsRenderToken;
+    const createHTML = tag =>
+      document.createElementNS("http://www.w3.org/1999/xhtml", tag);
+    const models = [...(state.models || [])];
+    models.sort((left, right) => {
+      const leftReady = this.aiLocalModelEffectiveInstallState(left) == "ready";
+      const rightReady =
+        this.aiLocalModelEffectiveInstallState(right) == "ready";
+      if (leftReady != rightReady) {
+        return leftReady ? -1 : 1;
+      }
+      return String(left.name || left.id).localeCompare(
+        String(right.name || right.id)
+      );
+    });
+    container.replaceChildren();
+    if (!models.length) {
+      const empty = createHTML("div");
+      empty.className = "tip-caption";
+      empty.textContent = "No local models recorded.";
+      container.append(empty);
+      return;
+    }
+    const addTextLine = (parent, label, value) => {
+      const row = createHTML("div");
+      row.className = "ai-local-model-meta-row";
+      const labelNode = createHTML("span");
+      labelNode.textContent = `${label}:`;
+      const valueNode = createHTML("span");
+      valueNode.textContent = value || "n/a";
+      row.append(labelNode, valueNode);
+      parent.append(row);
+    };
+    // Each card presents all independent lifecycle and role states for one
+    // immutable model snapshot.
+    // eslint-disable-next-line complexity
+    const cardSections = models.map(model => () => {
+      const logId = this.aiLocalModelLogId(model.id);
+      const effectiveInstallState =
+        this.aiLocalModelEffectiveInstallState(model);
+      const card = createHTML("section");
+      card.id = this.aiLocalModelCardId(model.id);
+      card.className = "ai-local-model-card";
+
+      const header = createHTML("div");
+      header.className = "ai-local-model-card-header";
+
+      const title = createHTML("div");
+      title.className = "ai-local-model-card-title";
+      const titleLabel = createHTML("strong");
+      titleLabel.textContent = model.name || model.id || "Local model";
+      titleLabel.className = "text-title";
+      const subtitle = createHTML("span");
+      subtitle.className = "tip-caption";
+      let storageLabel = "manual entry";
+      if (model.managedRuntime) {
+        storageLabel = "managed runtime";
+      } else if (model.catalogId || model.backend) {
+        storageLabel = "Thunderbird cache";
+      }
+      subtitle.textContent = [
+        model.kind || "model",
+        storageLabel,
+        model.engine ||
+          model.backend ||
+          model.runtimeProvider ||
+          "unknown engine",
+      ]
+        .filter(Boolean)
+        .join(" / ");
+      title.append(titleLabel, subtitle);
+
+      const badges = createHTML("div");
+      badges.className = "ai-local-model-badges";
+      const addBadge = (text, stateValue = "") => {
+        const badge = createHTML("span");
+        badge.className = "ai-local-model-badge";
+        if (stateValue) {
+          badge.dataset.state = stateValue;
+        }
+        badge.textContent = text;
+        badges.append(badge);
+      };
+      addBadge(effectiveInstallState, effectiveInstallState);
+      addBadge(
+        this.aiLocalModelRuntimePresenceText(model),
+        model.runtimePresenceState || (model.installed ? "present" : "missing")
+      );
+      addBadge(
+        model.cpu === false ? "CPU off" : "CPU",
+        model.cpu === false ? "missing" : "available"
+      );
+      addBadge(
+        model.gpu ? "GPU" : "GPU optional",
+        model.gpu ? "available" : "idle"
+      );
+      header.append(title, badges);
+      card.append(header);
+
+      const meta = createHTML("div");
+      meta.className = "ai-local-model-meta";
+      addTextLine(
+        meta,
+        "State",
+        [effectiveInstallState, model.runtimeState || ""]
+          .filter(Boolean)
+          .join(" / ")
+      );
+      addTextLine(meta, "Runtime", this.aiLocalModelRuntimePresenceText(model));
+      addTextLine(meta, "Storage", this.aiLocalModelRuntimeStorageText(model));
+      addTextLine(meta, "Artifact", model.artifactState || "n/a");
+      addTextLine(meta, "Last test", model.lastTestResult || "untested");
+      addTextLine(
+        meta,
+        "Capability",
+        model.userFacingCapabilitySummary ||
+          model.userFacingLastInstallError ||
+          model.userFacingLastProbeError ||
+          model.capabilitySummary ||
+          model.lastInstallError ||
+          model.lastProbeError ||
+          "No capability probe recorded."
+      );
+      card.append(meta);
+
+      const actions = createHTML("div");
+      actions.className = "ai-local-model-card-actions";
+      const addAction = (label, handler, disabled = false) => {
+        const button = createHTML("button");
+        button.className = "button";
+        button.type = "button";
+        button.textContent = label;
+        button.disabled = disabled;
+        button.addEventListener("click", handler);
+        actions.append(button);
+      };
+      if (model.runtimeProvider != "built-in-native") {
+        addAction("Delete retained artifact", () =>
+          this.deleteAILocalModel(model.id, logId)
+        );
+        card.append(actions);
+      }
+
+      const log = createHTML("div");
+      log.id = logId;
+      log.className = "tip-caption ai-local-model-log";
+      card.append(log);
+      if (this._aiLocalModelCardLogState?.[model.id]) {
+        this.renderAITestLog(logId, this._aiLocalModelCardLogState[model.id]);
+      }
+
+      const details = createHTML("details");
+      const detailsSummary = createHTML("summary");
+      detailsSummary.textContent = "Artifact and source details";
+      details.append(detailsSummary);
+      const detailsGrid = createHTML("div");
+      detailsGrid.className = "ai-local-model-meta";
+      addTextLine(detailsGrid, "License", model.license || "n/a");
+      addTextLine(
+        detailsGrid,
+        "Source",
+        model.downloadURL || model.sourceRepository || "n/a"
+      );
+      addTextLine(
+        detailsGrid,
+        "Checksum",
+        model.artifactSha256 || model.artifactFiles?.[0]?.sha256 || "n/a"
+      );
+      addTextLine(
+        detailsGrid,
+        "Cache path",
+        this.aiLocalModelArtifactPathText(model)
+      );
+      if (model.lastProbeAt) {
+        addTextLine(detailsGrid, "Last probe", model.lastProbeAt);
+      }
+      if (model.lastProbeLatencyMs) {
+        addTextLine(
+          detailsGrid,
+          "Probe latency",
+          `${model.lastProbeLatencyMs} ms`
+        );
+      }
+      details.append(detailsGrid);
+      card.append(details);
+      container.append(card);
+    });
+    let rendered = 0;
+    const renderBatch = limit => {
+      if (this._aiLocalModelCardsRenderToken != renderToken) {
+        return;
+      }
+      const target = Math.min(cardSections.length, rendered + limit);
+      while (rendered < target) {
+        cardSections[rendered++]();
+      }
+      if (rendered < cardSections.length) {
+        const scheduleNextBatch = () => {
+          if (this._aiLocalModelCardsRenderToken != renderToken) {
+            return;
+          }
+          if (this._aiLocalModelCardsRenderFrame) {
+            cancelAnimationFrame(this._aiLocalModelCardsRenderFrame);
+            this._aiLocalModelCardsRenderFrame = null;
+          }
+          if (this._aiLocalModelCardsRenderTimer) {
+            clearTimeout(this._aiLocalModelCardsRenderTimer);
+            this._aiLocalModelCardsRenderTimer = null;
+          }
+          renderBatch(4);
+        };
+        this._aiLocalModelCardsRenderFrame = requestAnimationFrame(() => {
+          scheduleNextBatch();
+        });
+        this._aiLocalModelCardsRenderTimer = setTimeout(() => {
+          scheduleNextBatch();
+        }, 16);
+        return;
+      }
+      this._aiLocalModelCardsRenderFrame = null;
+      this._aiLocalModelCardsRenderTimer = null;
+    };
+    renderBatch(
+      cardSections.length <= 12
+        ? cardSections.length
+        : Math.max(1, Math.min(4, cardSections.length))
+    );
+  },
+
+  aiLocalModelsCurrentPaneId() {
+    return (
+      document.querySelector(".main-content[hidden='false']")?.id ||
+      document
+        .querySelector("[data-category='paneLocalModels']")
+        ?.closest(".main-content")?.id ||
+      ""
+    );
+  },
+
+  isAILocalModelsBulkInstallActive() {
+    return !!this._aiLocalModelsBulkInstallState?.active;
+  },
+
+  aiLocalModelsInstallTargetIds(state = this._aiLocalModelsState) {
+    if (this._aiLocalModelsBulkInstallState?.targetIds?.length) {
+      return [...this._aiLocalModelsBulkInstallState.targetIds];
+    }
+    return (state?.models || [])
+      .filter(
+        model =>
+          !model.installed &&
+          (model.managedRuntime || model.catalogId || model.recommended)
+      )
+      .map(model => model.id);
+  },
+
+  describeAILocalModelsInstallProgress(state = this._aiLocalModelsState) {
+    if (!this.isAILocalModelsBulkInstallActive()) {
+      return null;
+    }
+    const targetIds = this.aiLocalModelsInstallTargetIds(state);
+    if (!targetIds.length) {
+      return {
+        total: 0,
+        completed: 0,
+        failed: 0,
+        percent: 100,
+        detail: "All recommended local models are already installed.",
+      };
+    }
+    const modelById = new Map(
+      (state?.models || []).map(model => [model.id, model])
+    );
+    let progressUnits = 0;
+    let completed = 0;
+    let failed = 0;
+    const active = [];
+    for (const modelId of targetIds) {
+      const model = modelById.get(modelId) || {};
+      const name = model.name || modelId;
+      const installState =
+        model.installState || (model.installed ? "ready" : "missing");
+      if (model.installed || installState == "ready") {
+        completed++;
+        progressUnits += 1;
+        continue;
+      }
+      if (["failed", "cancelled"].includes(installState)) {
+        failed++;
+        progressUnits += 1;
+        active.push(`${name}: ${installState}`);
+        continue;
+      }
+      if (installState == "queued") {
+        progressUnits += 0.02;
+        active.push(`${name}: queued`);
+        continue;
+      }
+      const rawProgress = Math.max(
+        0,
+        Math.min(100, Number(model.downloadProgress) || 0)
+      );
+      const fractionalProgress =
+        installState == "installing"
+          ? Math.max(0.7, rawProgress / 100)
+          : Math.max(0.05, rawProgress / 100);
+      progressUnits += Math.min(0.99, fractionalProgress);
+      active.push(
+        rawProgress
+          ? `${name}: ${installState} ${rawProgress}%`
+          : `${name}: ${installState}`
+      );
+    }
+    const total = targetIds.length;
+    const percent = Math.max(
+      completed + failed >= total ? 100 : 1,
+      Math.min(100, Math.round((progressUnits / total) * 100))
+    );
+    let detail = "Waiting for local model runtime updates...";
+    if (active.length) {
+      detail = `Active: ${active.slice(0, 3).join(" | ")}`;
+    } else if (completed + failed >= total) {
+      detail = "Finalizing installed model inventory...";
+    }
+    return {
+      total,
+      completed,
+      failed,
+      percent,
+      detail,
+    };
+  },
+
+  updateAILocalModelsBusyUI(state = this._aiLocalModelsState) {
+    this.ensureAILocalModelsUIStructure();
+    const busy = this.isAILocalModelsBulkInstallActive();
+    const progressBox = document.getElementById(
+      "aiLocalModelsInstallProgressBox"
+    );
+    const progress = document.getElementById("aiLocalModelsInstallProgress");
+    const progressLabel = document.getElementById(
+      "aiLocalModelsInstallProgressLabel"
+    );
+    const status = document.getElementById("aiLocalModelsStatus");
+    for (const id of [
+      "installRecommendedAILocalModels",
+      "refreshAILocalModels",
+      "aiLocalModelList",
+      "newAILocalModel",
+      "saveAILocalModel",
+      "deleteAILocalModel",
+      "testAILocalModel",
+    ]) {
+      const node = document.getElementById(id);
+      if (node) {
+        if (node.localName == "menulist") {
+          node.dataset.aiBusy = busy ? "true" : "false";
+        } else {
+          node.disabled = !!busy;
+        }
+      }
+    }
+    if (!progressBox || !progress || !progressLabel) {
+      return;
+    }
+    if (!busy) {
+      progressBox.hidden = true;
+      progress.value = 0;
+      progressLabel.value = "";
+      return;
+    }
+    const summary = this.describeAILocalModelsInstallProgress(state);
+    progressBox.hidden = false;
+    progress.value = summary?.percent || 0;
+    progressLabel.value = summary
+      ? `Installing recommended local models: ${summary.completed + summary.failed} of ${
+          summary.total
+        } complete. ${summary.detail}`
+      : "Installing recommended local models...";
+    if (status) {
+      status.value = progressLabel.value;
+    }
+  },
+
+  scheduleAILocalModelsRuntimeRefresh(delayMs = 150) {
+    if (this._aiLocalModelsRuntimeRefreshTimer) {
+      return;
+    }
+    this._aiLocalModelsRuntimeRefreshTimer = setTimeout(async () => {
+      this._aiLocalModelsRuntimeRefreshTimer = null;
+      if (this._aiLocalModelsRefreshInFlight) {
+        if (this.isAILocalModelsBulkInstallActive()) {
+          this._aiLocalModelsRefreshPending = true;
+        }
+        return;
+      }
+      if (
+        !this.isAILocalModelsBulkInstallActive() &&
+        this.aiLocalModelsCurrentPaneId() != "paneLocalModels"
+      ) {
+        return;
+      }
+      this._aiLocalModelsRefreshInFlight = true;
+      try {
+        await this.refreshAILocalModelsUI({
+          preserveBusyState: true,
+          preserveStatus: true,
+        });
+      } finally {
+        this._aiLocalModelsRefreshInFlight = false;
+        if (this._aiLocalModelsRefreshPending) {
+          this._aiLocalModelsRefreshPending = false;
+          this.scheduleAILocalModelsRuntimeRefresh();
+        }
+      }
+    }, delayMs);
+  },
+
+  holdAILocalModelsStatusMessage(message = "", durationMs = 2000) {
+    const normalizedMessage = String(message || "").trim();
+    if (!normalizedMessage) {
+      this._aiLocalModelsHeldStatus = null;
+      return;
+    }
+    this._aiLocalModelsHeldStatus = {
+      message: normalizedMessage,
+      expiresAt: Date.now() + Math.max(250, durationMs),
+    };
+  },
+
+  getHeldAILocalModelsStatusMessage() {
+    const heldStatus = this._aiLocalModelsHeldStatus;
+    if (!heldStatus) {
+      return "";
+    }
+    if (heldStatus.expiresAt <= Date.now()) {
+      this._aiLocalModelsHeldStatus = null;
+      return "";
+    }
+    return heldStatus.message || "";
+  },
+
+  scheduleAIPreferencesRuntimeRefresh(delayMs = 150) {
+    if (this._aiPreferencesRuntimeRefreshTimer) {
+      return;
+    }
+    this._aiPreferencesRuntimeRefreshTimer = setTimeout(async () => {
+      this._aiPreferencesRuntimeRefreshTimer = null;
+      const activePane =
+        document.querySelector(".main-content[hidden='false']")?.id || "";
+      try {
+        if (activePane == "paneLocalModels") {
+          this.scheduleAILocalModelsRuntimeRefresh(0);
+          return;
+        }
+        if (["paneAssistant", "paneSources"].includes(activePane)) {
+          await this.refreshAISourceUI();
+          return;
+        }
+        if (activePane == "paneRuntime") {
+          await this.updateAIRuntimeStatus();
+          return;
+        }
+        if (activePane == "paneAI") {
+          await this.refreshAISidebarSummaries();
+        }
+      } catch (error) {
+        console.error(error);
+      }
+    }, delayMs);
+  },
+
+  async refreshAILocalModelsUI({ preserveStatus = false } = {}) {
+    const status = document.getElementById("aiLocalModelsStatus");
+    const runtimeStatus = document.getElementById("aiLocalModelsRuntimeStatus");
+    const refreshToken = (this._aiLocalModelsRefreshToken || 0) + 1;
+    this._aiLocalModelsRefreshToken = refreshToken;
+    this.ensureAILocalModelsUIStructure();
+    if (this._aiLocalModelCardsRenderFrame) {
+      cancelAnimationFrame(this._aiLocalModelCardsRenderFrame);
+      this._aiLocalModelCardsRenderFrame = null;
+    }
+    if (this._aiLocalModelCardsRenderTimer) {
+      clearTimeout(this._aiLocalModelCardsRenderTimer);
+      this._aiLocalModelCardsRenderTimer = null;
+    }
+    const overview = document.getElementById("aiLocalModelsOverview");
+    if (overview) {
+      overview.replaceChildren();
+      const row = document.createElement("div");
+      row.textContent = "Loading local model inventory...";
+      overview.append(row);
+    }
