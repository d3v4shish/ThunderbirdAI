+      subject: "Invoice 4107 approval",
+      author: "Vendor Ops <vendor@vendor.invalid>",
+      summary: "Second vendor message with the same template family.",
+      category: "finance",
+      extractedEntities: {
+        invoiceIds: ["4108"],
+      },
+      localText: "Matching vendor template family evidence.",
+      date: 8,
