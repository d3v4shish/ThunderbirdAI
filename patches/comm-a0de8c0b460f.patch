+      const result = await AIService.installRecommendedLocalModels();
+      const failures = result.failed?.length || 0;
+      let message = "All recommended local models are already installed.";
+      if (result.installed.length) {
+        message = `Installed ${result.installed.length} local model${
+          result.installed.length == 1 ? "" : "s"
