+  async clearDataArtifact(id, { skipRefresh = false } = {}) {
+    await AIStorage.init();
+    const records = AIStorage.getMessages();
+    switch (id) {
+      case "traces":
+        AIStorage.clearTraces({});
+        break;
+      case "summaries":
+        AIStorage.clearMailboxDigests();
+        for (const record of records) {
+          const next = { ...record };
+          delete next.summary;
+          delete next.summarySource;
+          delete next.category;
+          delete next.status;
+          delete next.searchText;
+          AIStorage.setMessage(storageIdForAIRecord(record), next);
+        }
+        break;
+      case "embeddings":
+        for (const record of records) {
+          const next = { ...record };
+          delete next.embedding;
+          delete next.embeddingModel;
+          delete next.embeddingSourceId;
+          AIStorage.setMessage(storageIdForAIRecord(record), next);
+        }
+        break;
+      case "templates":
+        await AITemplates.clearGeneratedData();
+        break;
+      case "pii-config":
+        await AIPIIRules.clearGeneratedData();
+        break;
+      case "security-logs":
+        await IOUtils.remove(AIRuntimePaths.securityReportsPath(), {
+          ignoreAbsent: true,
+        });
+        break;
+      case "url-cache":
+        await IOUtils.remove(AIRuntimePaths.urlReputationCachePath(), {
+          ignoreAbsent: true,
+        });
+        break;
+      case "sender-history":
+        await IOUtils.remove(AIRuntimePaths.senderHistoryPath(), {
+          ignoreAbsent: true,
+        });
+        break;
+      case "attachment-scan-cache":
+        for (const record of records) {
+          try {
+            const msgHdr = this.#messageHeaderForRecord(record);
+            msgHdr.setStringProperty(AttachmentScanCache.propertyName, "");
+          } catch {}
+        }
+        break;
+      case "model-files":
+        await AILocalModels.init();
+        for (const model of AILocalModels.listModels()) {
+          if (model.installed) {
+            await this.deleteLocalModel(model.id);
+          }
+        }
+        break;
+      case "partial-downloads":
+        await AILocalModels.init();
+        for (const model of AILocalModels.listModels()) {
+          if (!hasPartialModelArtifacts(model)) {
+            continue;
+          }
+          await AIModelDownloads.deleteModelArtifacts(model.id);
+        }
+        break;
+      case "temp-runtime-files":
+        await IOUtils.remove(AIRuntimePaths.tempRootDir(), {
+          ignoreAbsent: true,
+          recursive: true,
+        });
+        break;
+      case "diagnostic-bundles":
+        await IOUtils.remove(AIRuntimePaths.diagnosticBundlePath(), {
+          ignoreAbsent: true,
+        });
+        break;
+      case "recovery-archives":
+        await clearJSONStoreRecoveryArchives();
+        break;
+      case "runtime-logs":
+      case "helper-logs": // Legacy artifact identifier accepted for migration.
+        AIModelRuntime.clearLogs();
+        AIRuntimeLogging.clear();
+        break;
+      default:
+        throw new Error("Unknown data artifact.");
+    }
+    this.#notifyRuntimeChanged();
+    return skipRefresh ? null : this.getDataGovernanceData();
+  }
