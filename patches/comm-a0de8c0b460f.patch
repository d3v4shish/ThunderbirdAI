+  // The editor maps one complete optional template record into its controls.
+  // eslint-disable-next-line complexity
+  loadAITemplate(template = null) {
+    const list = document.getElementById("aiTemplateList");
+    const selected = template?.id || this.getSelectedAITemplateId();
+    const stored = this._aiTemplatesCurrent?.find(item => item.id == selected);
