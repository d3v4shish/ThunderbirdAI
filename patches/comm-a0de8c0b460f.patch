+  const originalGetConfig = AIEndpoint.getConfig;
+  const originalGetAssistantModeState = AIEndpoint.getAssistantModeState;
+  const originalChatWithDebug = AIEndpoint.chatWithDebug;
+  const originalChatStreamWithDebug = AIEndpoint.chatStreamWithDebug;
