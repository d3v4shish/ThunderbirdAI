+  const merged = new Map();
+  for (const result of searchResults) {
+    const messageId = messageIdForRecord(result);
+    if (messageId) {
+      merged.set(messageId, { ...result });
+    }
+  }
+  for (const record of graphExpansion.records) {
+    const messageId = messageIdForRecord(record);
+    if (!messageId) {
+      continue;
+    }
+    const graphScore = Math.min(
+      1,
+      Number(graphExpansion.scoreByMessageId.get(messageId)) || 0
+    );
+    const existing = merged.get(messageId);
+    if (existing) {
+      existing.retrievalChannels = uniqueValues([
+        ...(existing.retrievalChannels || []),
+        "graph",
+      ]);
+      existing.graphScore = Math.max(
+        Number(existing.graphScore) || 0,
+        graphScore
+      );
+      existing.reasons = uniqueValues([
+        ...(existing.reasons || []),
+        "Source-linked graph expansion",
+      ]);
+      continue;
+    }
+    // Keep graph-only evidence competitive with an RRF result but below a
+    // structured match. Field-aware reranking still evaluates the mail text.
+    merged.set(messageId, {
+      ...record,
+      messageId,
+      score: graphScore / (RRF_RANK_CONSTANT + 1),
+      graphScore,
+      retrievalChannels: ["graph"],
+      reasons: ["Source-linked graph expansion"],
+    });
+  }
+  return Array.from(merged.values())
+    .sort(
+      (left, right) =>
+        Number(right.score || 0) - Number(left.score || 0) ||
+        Number(right.graphScore || 0) - Number(left.graphScore || 0) ||
+        (Number(right.date) || 0) - (Number(left.date) || 0)
