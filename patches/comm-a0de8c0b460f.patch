+function graphEntityPlanForEvidence(prompt = "", records = []) {
+  const explicit = relationshipGraphPathRequest(prompt);
+  if (explicit) {
+    return { ...explicit, source: "explicit-user-entities" };
+  }
+  const ignored = new Set([
+    "a",
+    "an",
+    "and",
+    "ask",
+    "cite",
+    "do",
+    "build",
+    "find",
+    "not",
+    "each",
+    "every",
+    "explicit",
+    "facts",
+    "final",
+    "first",
+    "for",
+    "from",
+    "how",
+    "initial",
+    "launch",
+    "list",
+    "message",
+    "messages",
+    "only",
+    "owner",
+    "deadline",
+    "deadlines",
+    "person",
+    "persons",
+    "assigned",
+    "separately",
+    "source",
+    "the",
+    "then",
+    "using",
+    "what",
+    "related",
+    "condition",
+    "dependencies",
+    "event",
+    "events",
+  ]);
+  const candidates = new Map();
+  const add = (value, score, source) => {
+    const label = compactString(value || "", 120).replace(/[,:;]+$/u, "");
+    const normalized = label.toLocaleLowerCase();
+    const words = normalized.split(/\s+/u);
+    if (
+      !label ||
+      label.length < 3 ||
+      ignored.has(normalized) ||
+      words.some(word => ignored.has(word)) ||
+      /^\d/.test(label)
+    ) {
+      return;
+    }
+    const current = candidates.get(normalized);
+    if (!current || score > current.score) {
+      candidates.set(normalized, { label, score, source });
+    }
+  };
