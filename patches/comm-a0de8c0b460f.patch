+
+add_task(async function test_ai_debug_retest_waits_for_provider_reset() {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  await AIService.clearGeneratedData();
+
+  const originalGetRuntimeSnapshot = AIService.getRuntimeSnapshot;
+  const originalCanUse = AIEndpoint.canUseEndpoint;
+  const originalGetConfig = AIEndpoint.getConfig;
+  const originalTestConnectionDetailed = AIEndpoint.testConnectionDetailed;
+  let endpointCalls = 0;
+
+  AIService.getRuntimeSnapshot = async () => ({
+    enabled: true,
+    assistantRuntime: {
+      state: "ready",
+    },
+  });
+  AIEndpoint.canUseEndpoint = () => true;
+  AIEndpoint.getConfig = () => configuredAssistantConfig();
+  AIEndpoint.testConnectionDetailed = async () => {
+    endpointCalls++;
+    return {
+      answer: "OK",
+      config: AIEndpoint.getConfig(),
+      attempts: [
+        {
+          attemptNumber: 1,
+          transport: "ollama-openai",
+          requestURL: "http://127.0.0.1:11434/v1/chat/completions",
+        },
+      ],
+    };
+  };
+
+  AIStorage.recordProviderFailure("global", "AI endpoint timed out");
+  AIStorage.recordProviderFailure("global", "AI endpoint timed out");
+  AIStorage.recordProviderFailure("global", "AI endpoint timed out");
+
+  const dialogPromise = BrowserTestUtils.domWindowOpenedAndLoaded();
+  window.openDialog(
+    "chrome://messenger/content/preferences/aiDebug.xhtml",
+    "",
+    "chrome,dialog=no,resizable",
+    {
+      accountKey: "global",
+      sourceId: "source-1",
+    }
+  );
+
+  const dialog = await dialogPromise;
+  try {
+    await TestUtils.waitForCondition(
+      () =>
+        dialog.document
+          .getElementById("aiDebugFocus")
+          .innerText.includes("Provider state: paused"),
+      "waiting for the debug dialog to show the paused provider state"
+    );
+
+    dialog.document.getElementById("retestAIDebugTarget").click();
+    await TestUtils.waitForCondition(
+      () =>
+        dialog.document
+          .getElementById("aiDebugFocus")
+          .innerText.includes("temporarily paused"),
+      "waiting for the retest action to surface the provider pause"
+    );
+    Assert.equal(
+      endpointCalls,
+      0,
+      "retest should not hit the endpoint transport while hold-off is active"
+    );
+
+    dialog.document.getElementById("resetAIDebugProvider").click();
+    await TestUtils.waitForCondition(
+      () =>
+        dialog.document
+          .getElementById("aiDebugFocus")
+          .innerText.includes("Provider hold-off was reset for this account."),
+      "waiting for the reset action to clear provider hold-off"
+    );
+
+    dialog.document.getElementById("retestAIDebugTarget").click();
+    await TestUtils.waitForCondition(
+      () =>
+        dialog.document
+          .getElementById("aiDebugFocus")
+          .innerText.includes("Assistant source responded successfully."),
+      "waiting for the retest action to succeed after reset"
+    );
+    Assert.equal(
+      endpointCalls,
+      1,
+      "retest should resume normal endpoint probing once hold-off is reset"
+    );
+  } finally {
+    const closed = BrowserTestUtils.windowClosed(dialog);
+    dialog.close();
+    await closed;
+    AIService.getRuntimeSnapshot = originalGetRuntimeSnapshot;
+    AIEndpoint.canUseEndpoint = originalCanUse;
+    AIEndpoint.getConfig = originalGetConfig;
+    AIEndpoint.testConnectionDetailed = originalTestConnectionDetailed;
+  }
+});
