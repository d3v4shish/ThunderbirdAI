+
+  const originalSnapshot = AIService.getRuntimeSnapshot;
+  const originalProgress = AIService.getAnalysisProgress;
+  let snapshotCalls = 0;
+  let progressCalls = 0;
+
+  AIService.getRuntimeSnapshot = async function (...args) {
+    snapshotCalls++;
+    return originalSnapshot.apply(this, args);
+  };
+  AIService.getAnalysisProgress = async function (...args) {
+    progressCalls++;
+    return originalProgress.apply(this, args);
+  };
+
