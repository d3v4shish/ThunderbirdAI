+        Assert.equal(
+          prefsDocument.getElementById("aiActiveBackgroundSummary").textContent,
+          "Cloud GPT (OpenAI-Compatible Source / gpt-4o-mini)",
+          "AI control center should show the assigned background source inline"
+        );
+        Assert.ok(
+          !prefsDocument.getElementById("aiActiveAssistantDisable").disabled,
+          "Assistant disable action should stay enabled while AI is enabled"
+        );
+        Assert.ok(
+          !prefsDocument.getElementById("aiActiveBackgroundChange").disabled,
+          "Background change action should stay enabled while AI is enabled"
+        );
+        Assert.ok(
+          !prefsDocument.getElementById("aiActiveBackgroundToggle").disabled,
+          "Background pause action should stay enabled while AI is enabled"
+        );
+
+        prefsDocument.getElementById("aiActiveAssistantChange").click();
+        await TestUtils.waitForCondition(
+          () => prefsWindow.gLastCategory.category == "paneAssistant",
+          "waiting for Assistant change action to open Assistant settings"
+        );
+
+        await openExistingPrefsTab("paneAI");
+        prefsDocument.getElementById("aiActiveBackgroundChange").click();
+        await TestUtils.waitForCondition(
+          () => prefsWindow.gLastCategory.category == "paneSources",
+          "waiting for Background change action to open Sources settings"
+        );
+      }
+    );
+
+    await withAIConfigState(
+      {
+        sources: [assistantSource, backgroundSource],
+        prefs: {
+          "mail.ai.enabled": false,
+          "mail.ai.provider": "source",
+          "mail.ai.source_id": assistantSource.id,
+          "mail.ai.background.source_id": backgroundSource.id,
+          "mail.ai.endpoint.background": true,
+          "mail.ai.backfill.paused": false,
+        },
+        runtimeSnapshot: {
+          enabled: false,
+          paused: false,
+          assistantRuntime: null,
+          endpoint: {
+            usableInBackground: true,
+            backgroundEnabled: true,
+          },
+          roleAssignments: {},
+          localModels: [],
+          subsystems: {
+            assistant: {
+              label: "Assistant",
+              summary: "disabled",
+            },
+            retrieval: {
+              label: "Retrieval",
+              summary: "limited",
+              indexedCount: 0,
+            },
+            runtime: {
+              label: "Runtime",
+              summary: "idle",
+            },
+          },
+        },
+      },
+      async () => {
+        const { prefsDocument } = await openNewPrefsTab("paneAI");
+
+        await TestUtils.waitForCondition(
+          () =>
+            prefsDocument.getElementById("aiActiveSourceSummary")
+              ?.textContent == "Disabled",
+          "waiting for disabled Assistant active configuration"
+        );
+        Assert.equal(
+          prefsDocument.getElementById("aiActiveSourceSummary").textContent,
+          "Disabled",
+          "AI control center should show Assistant as disabled when AI is off"
+        );
+        Assert.equal(
+          prefsDocument.getElementById("aiActiveBackgroundSummary").textContent,
+          "Disabled",
+          "AI control center should show Background analysis as disabled when AI is off"
+        );
+        Assert.ok(
+          !prefsDocument.getElementById("aiActiveAssistantChange").disabled,
+          "Assistant change action should stay enabled when AI is disabled"
+        );
+        Assert.ok(
+          !prefsDocument.getElementById("aiActiveBackgroundChange").disabled,
+          "Background change action should stay enabled when AI is disabled"
+        );
+        Assert.ok(
+          prefsDocument.getElementById("aiActiveAssistantDisable").disabled,
+          "Assistant disable action should disable itself when AI is already off"
+        );
+        Assert.ok(
+          prefsDocument.getElementById("aiActiveBackgroundToggle").disabled,
+          "Background pause action should disable itself when AI is already off"
+        );
