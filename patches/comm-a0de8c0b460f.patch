+async function pathUsage(path = "") {
+  if (!path) {
+    return {
+      exists: false,
+      kind: "missing",
+      sizeBytes: 0,
+      fileCount: 0,
+    };
+  }
+  try {
+    const stat = await IOUtils.stat(path);
+    if (stat.type != "directory") {
+      return {
+        exists: true,
+        kind: stat.type || "file",
+        sizeBytes: Number(stat.size) || 0,
+        fileCount: 1,
+      };
+    }
+    let sizeBytes = 0;
+    let fileCount = 0;
+    const pending = [path];
+    while (pending.length) {
+      const current = pending.pop();
+      const children = await IOUtils.getChildren(current, {
+        ignoreAbsent: true,
+      });
+      for (const child of children) {
+        try {
+          const childStat = await IOUtils.stat(child);
+          if (childStat.type == "directory") {
+            pending.push(child);
+            continue;
+          }
+          sizeBytes += Number(childStat.size) || 0;
+          fileCount += 1;
+        } catch {}
+      }
+    }
+    return {
+      exists: true,
+      kind: "directory",
+      sizeBytes,
+      fileCount,
+    };
+  } catch {
+    return {
+      exists: false,
+      kind: "missing",
+      sizeBytes: 0,
+      fileCount: 0,
+    };
+  }
