+          this.#mailboxDigestProgress(
+            context,
+            "reading",
+            `Processed ${context.job.mappedMessages + context.job.unavailableMessages}/${context.job.totalMessages} emails; ${context.job.cacheHits} reused from cache.`
+          );
+          await new Promise(resolve => setTimeout(resolve, 0));
+        }
+        continue;
+      }
+      const safeBody = redactionRequired
+        ? AIPIIRules.evaluateText(body, { scope: "external" }).redactedText
