+    ) {
+      return false;
+    }
+    const riskFlags = new Set(arrayValues(record.riskFlags, 40));
+    const evidenceIds = new Set(
+      [
+        ...arrayValues(record.securityAssessment?.evidenceIds, 40),
+        ...arrayValues(record.riskFlags, 40),
+      ].slice(0, 80)
+    );
+    if (
+      arrayValues(criteria.riskFlags, 20).some(flag => !riskFlags.has(flag))
+    ) {
+      return false;
+    }
+    if (
+      arrayValues(criteria.evidenceIds, 20).some(id => !evidenceIds.has(id))
+    ) {
+      return false;
+    }
+    if (criteria.linkHost) {
+      const links = Array.isArray(record.extractedEntities?.links)
+        ? record.extractedEntities.links.slice(0, 20)
+        : [];
+      const hasHost = links.some(link => {
+        const url =
+          typeof link == "string" ? link : link.realURL || link.url || "";
+        return hostnameForURL(url) == criteria.linkHost;
+      });
+      if (!hasHost) {
+        return false;
+      }
+    }
+    return true;
+  }
