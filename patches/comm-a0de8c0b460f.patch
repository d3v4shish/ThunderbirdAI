+  async inspectLocalRoleLoadPlan(requestedRoles = [], accountKey = null) {
+    const snapshot = await this.getRuntimeSnapshot(accountKey);
+    return inspectLocalRoleLoadPlan(snapshot.rolePlacements, requestedRoles);
+  }
+
+  async inspectLocalResidencySequence(steps = [], accountKey = null) {
+    const normalizedSteps = [];
+    for (const step of steps || []) {
+      if (step?.rolePlacements) {
+        normalizedSteps.push({
+          label: step.label || "",
+          requestedRoles: step.requestedRoles || [],
+          rolePlacements: step.rolePlacements,
+          assistantExecutionProfile: step.assistantExecutionProfile || "",
+        });
+        continue;
+      }
+      const snapshot = await this.getRuntimeSnapshot(
+        step?.accountKey || accountKey
+      );
+      normalizedSteps.push({
+        label: step?.label || "",
+        requestedRoles: step?.requestedRoles || [],
+        rolePlacements: snapshot.rolePlacements,
+        assistantExecutionProfile:
+          snapshot.assistantRuntime?.executionProfile || "",
+      });
+    }
+    return inspectLocalResidencySequence(normalizedSteps);
+  }
