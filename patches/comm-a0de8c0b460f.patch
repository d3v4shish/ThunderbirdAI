+        "URL scan",
+        urlReputationRows.length ? "complete" : "skipped",
+      ],
+      [
+        "attachment-scan",
+        "Attachment scan",
+        attachmentDetails.length ? "complete" : "skipped",
+      ],
+      ["qr-scan", "QR scan", qrScanFindings.length ? "complete" : "skipped"],
+      [
+        "ai-exposure",
+        "AI exposure",
