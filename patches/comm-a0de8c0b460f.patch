+      prefsDocument.getElementById("aiEndpointConcurrency").value = 2;
+      prefsWindow.gGeneralPane.updateAIPerformanceControls();
+      Assert.deepEqual(
+        changedPrefs,
+        [],
+        "unchanged AI performance settings should not rewrite prefs"
+      );
+      Assert.equal(
+        broadcastCalls,
+        0,
+        "unchanged AI performance settings should not rebroadcast runtime state"
+      );
+
+      prefsDocument.getElementById("aiAnalysisPerformanceMode").value =
+        "minimum";
+      prefsWindow.gGeneralPane.updateAIPerformanceControls();
+      Assert.equal(
+        broadcastCalls,
+        1,
+        "one performance settings action should broadcast runtime state once"
+      );
+      Assert.deepEqual(
+        changedPrefs.sort(),
+        prefNames.slice().sort(),
+        "changing the performance mode should only touch the expected prefs"
+      );
+      Assert.equal(
+        Services.prefs.getStringPref("mail.ai.backfill.mode"),
+        "minimum",
+        "the selected performance mode should persist"
+      );
+      Assert.equal(
+        Services.prefs.getIntPref("mail.ai.backfill.max_workers"),
+        1,
+        "minimum mode should clamp worker count"
+      );
+    } finally {
+      AIService.broadcastRuntimeChanged = originalBroadcast;
+      for (const prefName of prefNames) {
+        Services.prefs.removeObserver(prefName, prefObserver);
+      }
+    }
+
+    await closePrefsTab();
+    await resetAISourceTestState();
+  }
+);
