+      ? Math.max(1000, Date.parse(nextProbeAt) - Date.now())
+      : this.#assistantHealthProbeIntervalMs();
+    this.#assistantFallbackProbeTimer = setTimeout(
+      () => {
+        this.#assistantFallbackProbeTimer = null;
+        void this.probeAssistantFallbackHealth(targetAccountKey).catch(
+          error => {
+            this.#log.debug(`Unable to probe Assistant endpoint: ${error}`);
+          }
+        );
+      },
+      immediate ? ASSISTANT_FALLBACK_PROBE_STARTUP_DELAY_MS : scheduledDelayMs
+    );
+  }
