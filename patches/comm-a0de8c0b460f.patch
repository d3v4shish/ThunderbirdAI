+  // eslint-disable-next-line complexity
+  renderCoverageProgress(runtimeStatus = null) {
+    if (!this.coverageProgress) {
+      return;
+    }
+    const hasScopeProgress = !!(
+      runtimeStatus?.analysisProgress || runtimeStatus?.scopeSummary
+    );
+    this.coverageProgress.hidden = !hasScopeProgress;
+    if (!hasScopeProgress) {
+      return;
+    }
+    const progress =
+      runtimeStatus?.analysisProgress || runtimeStatus?.scopeSummary || {};
+    const scopeQueue =
+      runtimeStatus?.scopeSummary?.queueSummary ||
+      runtimeStatus?.queueSummary ||
+      {};
+    const totalMessages = Math.max(0, Number(progress.totalMessages) || 0);
+    const reportedAnalyzed = Number(progress.analyzedMessages);
+    const analyzedMessages = Math.min(
+      totalMessages,
+      Math.max(
+        0,
+        Number.isFinite(reportedAnalyzed)
+          ? reportedAnalyzed
+          : totalMessages - (Number(progress.remainingAnalysisCount) || 0)
+      )
+    );
+    const remainingMessages = Math.max(
+      0,
+      Number.isFinite(Number(progress.remainingAnalysisCount))
+        ? Number(progress.remainingAnalysisCount)
+        : totalMessages - analyzedMessages
+    );
+    const queuedMessages = Math.max(
+      0,
+      Number(scopeQueue.aiQueuedMessageCount ?? progress.queuedMessages) || 0
+    );
+    const activeMessages = Math.max(
+      0,
+      Number(scopeQueue.aiActiveMessageCount ?? progress.activeWorkers) || 0
+    );
+    const isWorking =
+      !!runtimeStatus?.processing ||
+      !!runtimeStatus?.backfilling ||
+      !!queuedMessages ||
+      !!activeMessages ||
+      (!!remainingMessages && !!scopeQueue.aiPendingMessageCount);
+    const label = this.coverageProgress.querySelector('[data-role="label"]');
+    const count = this.coverageProgress.querySelector('[data-role="count"]');
+    const bar = this.coverageProgress.querySelector('[data-role="progress"]');
+    const detail = this.coverageProgress.querySelector('[data-role="detail"]');
+    let labelText = "Mail analysis";
+    let countText = "No mail in this scope";
+    let detailText = "Choose a mail scope to see its analysis state.";
+    let state = "complete";
+    if (totalMessages) {
+      countText = `${analyzedMessages}/${totalMessages}`;
+      detailText = [
+        remainingMessages ? `${remainingMessages} remaining` : "Ready for RAG",
+        activeMessages ? `${activeMessages} active` : "",
+        queuedMessages ? `${queuedMessages} queued` : "",
+      ]
+        .filter(Boolean)
+        .join(" · ");
+      if (isWorking) {
+        labelText = "Analyzing mail";
+        state = "active";
+      } else if (remainingMessages) {
+        labelText = "Analysis waiting";
+        state = "waiting";
+      } else {
+        labelText = "Mail analysis up to date";
+      }
+    }
+    label.textContent = labelText;
+    count.textContent = countText;
+    bar.max = Math.max(totalMessages, 1);
+    bar.value = analyzedMessages;
+    detail.textContent = detailText;
+    this.coverageProgress.dataset.state = state;
+    this.coverageProgress.setAttribute(
+      "aria-label",
+      `${labelText}: ${countText}. ${detailText}`
+    );
+  },
