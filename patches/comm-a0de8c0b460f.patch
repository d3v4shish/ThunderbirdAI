+
+  populateAITemplateAccounts() {
+    const popup = document.getElementById("aiTemplateAccountPopup");
+    const minedPopup = document.getElementById("aiMinedTemplateAccountPopup");
+    if (!popup && !minedPopup) {
+      return;
+    }
+    const accounts = accountItems();
+    const minedAccounts = [{ key: "all", label: "All accounts" }, ...accounts];
+    const populate = (target, items) => {
+      if (!target) {
+        return;
+      }
+      target.replaceChildren();
+      for (const account of items) {
+        const item = document.createXULElement("menuitem");
+        item.value = account.key;
+        item.label = account.label;
+        target.append(item);
+      }
+    };
+    populate(popup, accounts);
+    populate(minedPopup, minedAccounts);
+    const select = document.getElementById("aiTemplateAccount");
+    if (!select) {
+      return;
+    }
+    if (!select.value || !accounts.some(item => item.key == select.value)) {
+      select.value = "global";
+    }
+    const minedSelect = document.getElementById("aiMinedTemplateAccount");
+    if (
+      minedSelect &&
+      (!minedSelect.value ||
+        !minedAccounts.some(item => item.key == minedSelect.value))
+    ) {
+      minedSelect.value = "all";
+    }
+  },
