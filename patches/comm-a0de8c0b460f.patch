+  #observeMiningCandidate(record = {}, type = "") {
+    const accountKey = this.#normalizedMiningAccountKey(record.accountKey);
+    const mining = this.#miningData();
+    const recordKey = miningTemplateCandidateKeyForRecord(record);
+    const directCandidate = recordKey
+      ? mining.candidates?.[miningCandidateId(type, accountKey, recordKey)] ||
+        null
+      : null;
+    const recordDomain = senderDomainFor(record.author || "");
+    // Extraction candidates have exact sender/subject identities. Template
+    // candidates can learn changing alphabetic slots, but only inside the
+    // same account and sender-domain partition. This prevents every incoming
+    // message from re-running Drain-style learning against the global shadow
+    // candidate set.
+    const structurallyMatchingCandidate =
+      directCandidate ||
+      (type == "template"
+        ? Object.values(mining.candidates || {}).find(candidate => {
+            return (
+              candidate.type == type &&
+              candidate.accountKey == accountKey &&
+              miningCandidateSenderDomain(candidate) == recordDomain &&
+              (miningCandidateMatchesRecord(candidate, record) ||
+                miningTemplateCandidateCanLearnRecord(candidate, record))
+            );
+          })
+        : null);
+    const key = structurallyMatchingCandidate?.key || recordKey;
+    if (!key) {
+      return null;
+    }
+    const example = miningCandidateExampleFromRecord(record);
+    const candidateId =
+      structurallyMatchingCandidate?.id ||
+      miningCandidateId(type, accountKey, key);
+    const existing = structurallyMatchingCandidate ||
+      mining.candidates[candidateId] || {
+        id: candidateId,
+        type,
+        accountKey,
+        key,
+        label: "",
+        state: "shadow",
+        observedCount: 0,
+        threshold: MINING_PROMOTION_THRESHOLD,
+        lastObservedAt: "",
+        promotedAt: "",
+        rematchJobId: "",
+        observedMessageIds: [],
+        exampleMessages: [],
+        template: null,
+        rule: null,
+      };
+    const observedMessageIds = new Set(existing.observedMessageIds || []);
+    const nextExamples = [
+      example,
+      ...(existing.exampleMessages || []).filter(
+        item => item.messageId != example.messageId
+      ),
+    ]
+      .sort(
+        (left, right) => (Number(right.date) || 0) - (Number(left.date) || 0)
+      )
+      .slice(0, MAX_MINING_EXAMPLE_MESSAGES);
+    observedMessageIds.add(example.messageId);
+    const previewMessages = nextExamples.map(item => ({
+      messageId: item.messageId,
+      author: item.author,
+      subject: item.subject,
+      body: item.body,
+    }));
+    const builtCandidate = lazyConditional(
+      type == "template",
+      () => miningTemplateCandidateForRecords(previewMessages, accountKey),
+      () =>
+        lazyConditional(
+          type == "extraction-rule" &&
+            Array.isArray(record.extractions) &&
+            record.extractions.length,
+          () =>
+            miningExtractionRuleCandidateForRecords(
+              previewMessages,
+              accountKey
+            ),
+          () => null
+        )
+    );
+    if (!builtCandidate) {
+      return null;
+    }
+    const observedCount = observedMessageIds.size;
+    const threshold = existing.threshold || MINING_PROMOTION_THRESHOLD;
+    const promoted =
+      existing.state != "suggested" && observedCount >= threshold;
+    // Once a candidate is promoted, preserve its learned structure. New mail
+    // can increase the observation count but cannot silently rewrite a
+    // suggested template that a user may be reviewing.
+    const candidate = {
+      ...existing,
+      ...(existing.state == "suggested" ? {} : builtCandidate),
+      // Re-learning changes the newest example, not the identity of the
+      // cluster. Keep the first candidate id/key stable so observations do
+      // not fork into one two-message candidate per alphabetic slot value.
+      id: candidateId,
+      key,
+      state: promoted ? "suggested" : existing.state,
+      observedCount,
+      threshold,
+      lastObservedAt: new Date().toISOString(),
+      promotedAt: promoted
+        ? existing.promotedAt || new Date().toISOString()
+        : existing.promotedAt || "",
+      observedMessageIds: Array.from(observedMessageIds).slice(
+        0,
+        MAX_MINING_MATCH_IDS
+      ),
+      exampleMessages: nextExamples,
+    };
+    mining.candidates[candidate.id] = candidate;
