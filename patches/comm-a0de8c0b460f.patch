+
+  // Model lifecycle actions share one guarded transition and logging path so
+  // UI state cannot diverge between install/test/remove operations.
+  // eslint-disable-next-line complexity
+  async runAILocalModelAction(
+    modelId = "",
+    action = "test",
+    logId = "aiLocalModelsTestLog"
+  ) {
+    const resolvedModelId =
+      modelId || document.getElementById("aiLocalModelList")?.value || "";
+    if (!resolvedModelId) {
+      return;
+    }
+    const methods = {
+      install: "installLocalModel",
+      retry: "retryFailedLocalModelDownload",
+      pause: "pauseLocalModelDownload",
+      resume: "resumeLocalModelDownload",
+      cancel: "cancelLocalModelDownload",
+      test: "testLocalModel",
+      remove: "deleteLocalModel",
+    };
+    const messages = {
+      install: "Installing",
+      retry: "Retrying install",
+      pause: "Pausing download",
+      resume: "Resuming download",
+      cancel: "Cancelling download",
+      test: "Testing",
+      remove: "Removing",
+    };
+    const methodName = methods[action];
+    if (!methodName) {
+      return;
+    }
+    const currentModel =
+      this._aiLocalModelsState?.models?.find(
+        model => model.id == resolvedModelId
+      ) || null;
+    const status = document.getElementById("aiLocalModelsStatus");
+    if (status) {
+      status.value = `${messages[action] || "Running"} ${
+        currentModel?.name || resolvedModelId
+      }...`;
+    }
+    try {
+      const result = await AIService[methodName](resolvedModelId);
+      let message = `${messages[action] || "Action"} completed.`;
+      if (action == "test") {
+        message = result?.lastTestResult || "Local model is available.";
+      } else if (action == "remove") {
+        message = "Local model deleted.";
+        if (currentModel?.managedRuntime) {
+          message = `${currentModel.name} removed from the managed local runtime.`;
+        } else if (currentModel?.catalogId || currentModel?.backend) {
+          message = `${currentModel.name} removed from the Thunderbird model cache.`;
+        }
+      } else if (action == "install" || action == "retry") {
+        message = `${currentModel?.name || resolvedModelId} install action queued.`;
+      }
+      const logState = {
+        target: currentModel?.name || "Local model",
+        state: "PASS",
+        message,
+        detail: resolvedModelId,
+      };
+      this._aiLocalModelCardLogState ||= {};
+      this._aiLocalModelCardLogState[resolvedModelId] = logState;
+      if (status) {
+        status.value = message;
+      }
+      await this.refreshAILocalModelsUI({ preserveStatus: true });
+      this.renderAITestLog(logId, logState);
+      if (status) {
+        status.value = message;
+      }
+    } catch (error) {
+      const failure = {
+        target: currentModel?.name || "Local model",
+        state: "FAIL",
+        message: error.message,
+        detail: resolvedModelId,
+      };
+      this._aiLocalModelCardLogState ||= {};
+      this._aiLocalModelCardLogState[resolvedModelId] = failure;
+      this.renderAITestLog(logId, failure);
+      if (status) {
+        status.value = `${
+          currentModel?.name || "Local model"
+        } action failed: ${error.message}`;
+      }
+    }
+  },
+
+  async deleteAILocalModel(
+    modelId = document.getElementById("aiLocalModelList")?.value || "",
+    logId = "aiLocalModelsTestLog"
+  ) {
+    const resolvedLogId =
