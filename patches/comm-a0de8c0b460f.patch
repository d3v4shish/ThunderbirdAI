+          await this.#flushMailboxDigestPack(context);
+        }
+        context.pack.push({
+          id: `${messageId}@${index + 1}`,
+          messageId,
+          subject: meta.subject,
+          author: meta.author,
+          date: meta.date,
+          chunkIndex: index,
+          chunkCount: chunks.length,
+          body: chunk,
+        });
