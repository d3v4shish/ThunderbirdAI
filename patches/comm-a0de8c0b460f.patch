+add_task(
+  async function test_template_and_extraction_outputs_survive_disabled_failed_and_cancelled_assistant() {
+    const { injection, folder, messageId, accountKey } =
+      await createDeterministicTemplateExtractionAnalysis();
+
+    try {
+      const beforeAssistant = AIStorage.getMessage(messageId);
+      const expected = deterministicTemplateExtractionSnapshot(beforeAssistant);
+
+      Services.prefs.setBoolPref("mail.ai.enabled", false);
