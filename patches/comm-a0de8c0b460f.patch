diff --git a/mail/components/ai/modules/AIMessagePhases.sys.mjs b/mail/components/ai/modules/AIMessagePhases.sys.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/ai/modules/AIMessagePhases.sys.mjs
@@ -0,0 +1,351 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AIStorage } from "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs";
+
+export const THREAD_MESSAGE_PHASES = Object.freeze([
+  { id: "canonicalization", label: "Canon" },
+  { id: "template", label: "Tpl" },
+  { id: "rag", label: "RAG" },
+  { id: "pii", label: "PII" },
+  { id: "summary", label: "Sum" },
+]);
+
+let gTemplateMiningIndex = new Map();
+let gTemplateMiningSerial = 0;
+let gAppliedTemplateMiningSerial = -1;
+
+function messageIdForRecord(record = {}) {
+  return record?.folderURI ? `${record.folderURI}#${record.messageKey}` : "";
+}
+
+function timelineStage(record = {}, stageId = "") {
+  return Array.isArray(record?.timelineStages)
+    ? record.timelineStages.find(stage => stage?.id == stageId) || null
+    : null;
+}
+
+function stageState(record = {}, stageId = "", { allowFallback = false } = {}) {
+  const status = String(timelineStage(record, stageId)?.status || "")
+    .trim()
+    .toLocaleLowerCase();
+  if (status == "complete" || status == "skipped") {
+    return "complete";
+  }
+  if (status == "fallback") {
+    return allowFallback ? "degraded" : "pending";
+  }
+  if (["failed", "error", "unavailable"].includes(status)) {
+    return "failed";
+  }
+  return "pending";
+}
+
+function hasEmbeddingVector(record = {}) {
+  return Array.isArray(record?.embedding) && !!record.embedding.length;
+}
+
+function hasTemplateArtifacts(record = {}) {
+  return !!(
+    record?.matchedTemplateId ||
+    record?.matchedTemplateName ||
+    Object.keys(record?.templateSlots || {}).length
+  );
+}
+
+function emptyTemplateMiningSummary() {
+  return {
+    observed: false,
+    candidateId: "",
+    candidateState: "",
+    candidateLabel: "",
+    observedCount: 0,
+    rematchJobId: "",
+    rematchState: "",
+    rematchProgress: "",
+  };
+}
+
+function templateMiningPriority(summary = null) {
+  switch (
+    String(summary?.rematchState || "")
+      .trim()
+      .toLocaleLowerCase()
+  ) {
+    case "failed":
+      return 60;
+    case "running":
+      return 50;
+    case "queued":
+      return 40;
+    case "paused":
+      return 35;
+    case "complete":
+      return 30;
+    default:
+      switch (
+        String(summary?.candidateState || "")
+          .trim()
+          .toLocaleLowerCase()
+      ) {
+        case "suggested":
+          return 20;
+        case "shadow":
+          return 10;
+        default:
+          return summary?.observed ? 5 : 0;
+      }
+  }
+}
+
+function rematchProgressDetail(job = {}) {
+  const processedCount = Math.max(0, Number(job.processedCount) || 0);
+  const totalCount = Math.max(0, Number(job.totalCount) || 0);
+  switch (
+    String(job.state || "")
+      .trim()
+      .toLocaleLowerCase()
+  ) {
+    case "running":
+      return `${processedCount}/${totalCount || "?"} recent-first rematch records processed.`;
+    case "queued":
+      return "Recent-first rematch is queued.";
+    case "paused":
+      return `${processedCount}/${totalCount || "?"} recent-first rematch records processed before pause.`;
+    case "complete":
+      return `${processedCount}/${totalCount || processedCount} recent-first rematch records processed.`;
+    case "failed":
+      return "Recent-first rematch failed.";
+    default:
+      return "";
+  }
+}
+
+function rebuildTemplateMiningIndex() {
+  const nextIndex = new Map();
+  const mining = AIStorage.data?.mining || {};
+  const candidates = Object.values(mining.candidates || {});
+  const rematchJobs = mining.rematchJobs || {};
+  for (const candidate of candidates) {
+    if (candidate?.type != "template") {
+      continue;
+    }
+    const summary = {
+      observed: true,
+      candidateId: String(candidate.id || ""),
+      candidateState: String(candidate.state || ""),
+      candidateLabel: String(candidate.label || ""),
+      observedCount: Math.max(0, Number(candidate.observedCount) || 0),
+      rematchJobId: String(candidate.rematchJobId || ""),
+      rematchState: "",
+      rematchProgress: "",
+    };
+    const rematchJob =
+      summary.rematchJobId && rematchJobs[summary.rematchJobId]
+        ? rematchJobs[summary.rematchJobId]
+        : null;
+    if (rematchJob) {
+      summary.rematchState = String(rematchJob.state || "");
+      summary.rematchProgress = rematchProgressDetail(rematchJob);
+    }
+    for (const messageId of candidate.observedMessageIds || []) {
+      const current = nextIndex.get(messageId) || null;
+      if (
+        !current ||
+        templateMiningPriority(summary) > templateMiningPriority(current) ||
+        (templateMiningPriority(summary) == templateMiningPriority(current) &&
+          summary.observedCount > current.observedCount)
+      ) {
+        nextIndex.set(messageId, { ...summary });
+      }
+    }
+  }
+  gTemplateMiningIndex = nextIndex;
+  gAppliedTemplateMiningSerial = gTemplateMiningSerial;
+}
+
+function ensureTemplateMiningIndex() {
+  if (gAppliedTemplateMiningSerial == gTemplateMiningSerial) {
+    return;
+  }
+  rebuildTemplateMiningIndex();
+}
+
+function templateMiningSummaryForRecord(record = {}) {
+  const messageId = messageIdForRecord(record);
+  if (!messageId) {
+    return emptyTemplateMiningSummary();
+  }
+  ensureTemplateMiningIndex();
+  return gTemplateMiningIndex.get(messageId) || emptyTemplateMiningSummary();
+}
+
+function canonicalizationState(record = {}) {
+  const state = stageState(record, "canonicalization");
+  if (
+    state == "pending" &&
+    (record?.body || record?.localText || record?.canonicalBodyInfo)
+  ) {
+    return "complete";
+  }
+  return state;
+}
+
+function templateState(record = {}) {
+  const storedTemplateState = stageState(record, "template", {
+    allowFallback: true,
+  });
+  let directTemplateState = storedTemplateState;
+  if (hasTemplateArtifacts(record)) {
+    directTemplateState = ["failed", "degraded"].includes(storedTemplateState)
+      ? storedTemplateState
+      : "complete";
+  }
+  const miningSummary = templateMiningSummaryForRecord(record);
+  if (
+    directTemplateState == "failed" ||
+    miningSummary.rematchState == "failed"
+  ) {
+    return "failed";
+  }
+  if (miningSummary.observed) {
+    if (
+      directTemplateState == "complete" &&
+      (!miningSummary.rematchState || miningSummary.rematchState == "complete")
+    ) {
+      return "complete";
+    }
+    return "degraded";
+  }
+  return directTemplateState;
+}
+
+function piiState(record = {}) {
+  const directState = stageState(record, "pii", { allowFallback: true });
+  if (record?.piiDecision || record?.piiSensitivity) {
+    if (directState == "failed") {
+      return "failed";
+    }
+    return directState == "degraded" ? "degraded" : "complete";
+  }
+  return directState;
+}
+
+function ragState(record = {}) {
+  if (!Services.prefs.getBoolPref("mail.ai.embeddings.enabled", true)) {
+    return "degraded";
+  }
+  const directState = stageState(record, "embedding", { allowFallback: true });
+  if (hasEmbeddingVector(record)) {
+    if (directState == "failed") {
+      return "failed";
+    }
+    return directState == "degraded" ? "degraded" : "complete";
+  }
+  return directState;
+}
+
+function summaryState(record = {}) {
+  const directState = stageState(record, "summary", { allowFallback: true });
+  if (String(record?.summary || "").trim()) {
+    if (directState == "failed") {
+      return "failed";
+    }
+    return directState == "degraded" ? "degraded" : "complete";
+  }
+  return directState;
+}
+
+function detailForPendingPhase(phaseId = "") {
+  return (
+    {
+      canonicalization:
+        "Canonical body selection is still pending for this message.",
+      template:
+        "Template matching and mining are still pending for this message.",
+      rag: "RAG indexing is waiting for embeddings for this message.",
+      pii: "PII analysis is still pending for this message.",
+      summary: "Summary generation is still pending for this message.",
+    }[phaseId] || "AI analysis is still pending for this message."
+  );
+}
+
+export function invalidateAIMessagePhaseCaches() {
+  gTemplateMiningSerial++;
+}
+
+export function messagePhaseStateForRecord(record = null, phaseId = "") {
+  if (!record) {
+    if (
+      phaseId == "rag" &&
+      !Services.prefs.getBoolPref("mail.ai.embeddings.enabled", true)
+    ) {
+      return "degraded";
+    }
+    return "pending";
+  }
+  switch (phaseId) {
+    case "canonicalization":
+      return canonicalizationState(record);
+    case "template":
+      return templateState(record);
+    case "rag":
+      return ragState(record);
+    case "pii":
+      return piiState(record);
+    case "summary":
+      return summaryState(record);
+    default:
+      return "pending";
+  }
+}
+
+export function messagePhaseDetailForRecord(record = null, phaseId = "") {
+  if (!record) {
+    return detailForPendingPhase(phaseId);
+  }
+  if (phaseId == "template") {
+    const details = [];
+    const stageSummary = timelineStage(record, "template")?.summary || "";
+    const miningSummary = templateMiningSummaryForRecord(record);
+    if (stageSummary) {
+      details.push(stageSummary);
+    } else if (hasTemplateArtifacts(record)) {
+      details.push("Template matching is complete for this message.");
+    }
+    if (miningSummary.observed) {
+      details.push(
+        miningSummary.candidateState == "suggested"
+          ? `${miningSummary.candidateLabel || "Suggested template"} has been promoted for rematch.`
+          : `${miningSummary.candidateLabel || "Template mining"} observed this message.`
+      );
+      if (miningSummary.rematchProgress) {
+        details.push(miningSummary.rematchProgress);
+      }
+    }
+    return details.filter(Boolean).join(" ") || detailForPendingPhase(phaseId);
+  }
+  if (phaseId == "rag") {
+    return hasEmbeddingVector(record)
+      ? `${record.embedding.length} embedding dimension(s) are available for retrieval.`
+      : timelineStage(record, "embedding")?.summary ||
+          detailForPendingPhase(phaseId);
+  }
+  return (
+    timelineStage(record, phaseId)?.summary ||
+    timelineStage(
+      record,
+      {
+        canonicalization: "canonicalization",
+        pii: "pii",
+        summary: "summary",
+      }[phaseId] || phaseId
+    )?.summary ||
+    detailForPendingPhase(phaseId)
+  );
+}
+
+export function templateMiningSummaryForMessageRecord(record = {}) {
+  return templateMiningSummaryForRecord(record);
+}
diff --git a/mail/components/ai/modules/AIModelCatalog.sys.mjs b/mail/components/ai/modules/AIModelCatalog.sys.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/ai/modules/AIModelCatalog.sys.mjs
@@ -0,0 +1,132 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const HEX_SHA256 = /^[0-9a-f]{64}$/i;
+const PINNED_REVISION = /^[0-9a-f]{40}$/i;
+const FLOATING_REVISIONS = new Set(["main", "master", "latest"]);
+// Learned local model downloads are retired. This empty catalog deliberately
+// does not delete artifacts already present in a profile; AILocalModels keeps
+// those records as a compatibility inventory for explicit user cleanup.
+export const AI_MODEL_CATALOG = [];
+
+function limitedString(value, maxChars = 400) {
+  return String(value ?? "")
+    .trim()
+    .slice(0, maxChars);
+}
+
+function artifactList(entry = {}) {
+  return Array.isArray(entry.artifacts) ? entry.artifacts : [];
+}
+
+function urlRevision(url = "") {
+  const match = limitedString(url, 1000).match(/\/resolve\/([^/]+)\//);
+  return match?.[1] || "";
+}
+
+function looksLikePlaceholderRevision(revision = "") {
+  return /^0{39}[0-9a-f]$/i.test(revision);
+}
+
+function looksLikePlaceholderSha256(sha256 = "") {
+  return /^0{63}[0-9a-f]$/i.test(sha256);
+}
+
+export function validateModelCatalogEntry(entry = {}) {
+  const errors = [];
+  const id = limitedString(entry.id, 120);
+  const revision = limitedString(entry.revision, 120);
+  const downloadURL = limitedString(entry.downloadURL, 1000);
+  const license = limitedString(entry.license, 120);
+  const backend = limitedString(entry.backend, 80);
+  const artifacts = artifactList(entry);
+
+  if (!id) {
+    errors.push("id is required");
+  }
+  if (!limitedString(entry.name, 200)) {
+    errors.push("name is required");
+  }
+  if (!limitedString(entry.role, 80)) {
+    errors.push("role is required");
+  }
+  if (!backend) {
+    errors.push("backend is required");
+  }
+  if (!downloadURL) {
+    errors.push("downloadURL is required");
+  }
+  if (!license) {
+    errors.push("license is required");
+  }
+  if (!PINNED_REVISION.test(revision)) {
+    errors.push("revision must be a pinned 40 character content revision");
+  }
+  if (looksLikePlaceholderRevision(revision)) {
+    errors.push("revision must not be a placeholder value");
+  }
+  if (FLOATING_REVISIONS.has(revision.toLocaleLowerCase())) {
+    errors.push("revision must not be floating");
+  }
+  if (downloadURL.includes("/resolve/")) {
+    const revisionInURL = urlRevision(downloadURL);
+    if (!revisionInURL) {
+      errors.push("downloadURL must include /resolve/<revision>/");
+    } else if (FLOATING_REVISIONS.has(revisionInURL.toLocaleLowerCase())) {
+      errors.push("downloadURL must not use a floating revision");
+    } else if (revisionInURL != revision) {
+      errors.push("downloadURL revision must match revision");
+    }
+  }
+  if (!artifacts.length) {
+    errors.push("at least one artifact is required");
+  }
+  for (const artifact of artifacts) {
+    if (!limitedString(artifact.fileName, 200)) {
+      errors.push("artifact fileName is required");
+    }
+    if (!HEX_SHA256.test(limitedString(artifact.sha256, 80))) {
+      errors.push("artifact sha256 must be 64 hex characters");
+    }
+    if (looksLikePlaceholderSha256(limitedString(artifact.sha256, 80))) {
+      errors.push("artifact sha256 must not be a placeholder value");
+    }
+    if (Number(artifact.sizeBytes) <= 0) {
+      errors.push("artifact sizeBytes must be positive");
+    }
+  }
+  return errors;
+}
+
+export function validateModelCatalog(catalog = AI_MODEL_CATALOG) {
+  const seen = new Set();
+  const errors = [];
+  for (const entry of catalog) {
+    const id = limitedString(entry.id, 120);
+    if (seen.has(id)) {
+      errors.push(`${id}: duplicate id`);
+    }
+    seen.add(id);
+    for (const error of validateModelCatalogEntry(entry)) {
+      errors.push(`${id || "unknown"}: ${error}`);
+    }
+  }
+  return errors;
+}
+
+export function getModelCatalog() {
+  return AI_MODEL_CATALOG.map(entry => ({
+    ...entry,
+    artifacts: artifactList(entry).map(artifact => ({ ...artifact })),
+  }));
+}
+
+export function getModelCatalogEntry(modelId = "") {
+  const id = limitedString(modelId, 120);
+  return getModelCatalog().find(entry => entry.id == id) || null;
+}
+
+export function getRecommendedModelCatalogEntries() {
+  return getModelCatalog().filter(entry => entry.recommended);
+}
diff --git a/mail/components/ai/modules/AIModelDownloads.sys.mjs b/mail/components/ai/modules/AIModelDownloads.sys.mjs
