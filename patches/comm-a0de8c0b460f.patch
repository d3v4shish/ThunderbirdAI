+    const threadNodes = [];
+    let calls = 0;
+    let rounds = 0;
+    let completed = 0;
+    for (const nodes of threads.values()) {
+      let node = nodes[0];
+      if (nodes.length > 1) {
+        const reduced = await this.#reduceMailboxDigestNodes(
+          nodes,
+          accountKey,
+          config,
+          signal
+        );
+        node = reduced.node;
+        calls += reduced.calls;
+        rounds = Math.max(rounds, reduced.rounds);
+      }
+      if (node) {
+        threadNodes.push(node);
+      }
+      completed++;
+      onThread?.({ completed, total: threads.size, calls, rounds });
