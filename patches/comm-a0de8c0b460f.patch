+function cloneValue(value) {
+  if (Array.isArray(value)) {
+    return value.map(item => cloneValue(item));
+  }
+  if (value && typeof value == "object") {
+    return Object.fromEntries(
+      Object.entries(value).map(([key, item]) => [key, cloneValue(item)])
+    );
+  }
+  return value;
+}
+
+function mergeObjects(base = {}, override = {}) {
+  const merged = { ...base };
+  for (const [key, value] of Object.entries(override || {})) {
+    if (
+      value &&
+      typeof value == "object" &&
+      !Array.isArray(value) &&
+      merged[key] &&
+      typeof merged[key] == "object" &&
+      !Array.isArray(merged[key])
+    ) {
+      merged[key] = mergeObjects(merged[key], value);
+    } else {
+      merged[key] = cloneValue(value);
+    }
+  }
+  return merged;
+}
+
+function disabledStatus() {
+  return {
+    pid: "",
+    state: "disabled",
+    queueDepth: 0,
+    activeRequest: null,
+    restartCount: 0,
+    crashCount: 0,
+    lastHeartbeatAt: "",
+    lastError: "",
+    userFacingLastError: "",
+    debugBridge: {
+      enabled: false,
+      listening: false,
+      endpointURL: "",
+      loopbackOnly: true,
+      tokenRequired: false,
+    },
+    health: {
+      state: "disabled",
+      problems: [],
+      restartRecommended: false,
+      backoffMs: 0,
+    },
+  };
+}
+
+let gStatusOverride = {};
+let gDebugEvents = [];
+
+function statusSnapshot() {
+  return cloneValue(mergeObjects(disabledStatus(), gStatusOverride));
+}
+
+function recordEvent({
+  command = "",
+  role = "",
+  modelId = "",
+  state = "disabled",
+  error = "",
+  summary = "",
+} = {}) {
+  const entry = {
+    id: `legacy-local-runtime-${Date.now().toString(36)}-${gDebugEvents.length + 1}`,
+    createdAt: new Date().toISOString(),
+    command,
+    role,
+    modelId,
+    backend: "",
+    state,
+    error,
+    summary,
+    fallbackDecision: summary,
+    durationMs: 0,
+    inputBytes: 0,
+    outputBytes: 0,
+    requestId: "",
+  };
+  gDebugEvents.unshift(entry);
+  gDebugEvents = gDebugEvents.slice(0, 100);
+  return cloneValue(entry);
+}
+
+function removedRuntimeMessage(role = "") {
+  const normalizedRole = String(role || "").trim() || "local model";
+  return `Legacy local ${normalizedRole} execution has been removed. Use the configured endpoint or deterministic fallback.`;
+}
+
+function disabledRuntimeError(role = "") {
+  const error = new Error(removedRuntimeMessage(role));
+  error.aiHelperRemoved = true;
+  return error;
+}
+
+function normalizedExecutionProfile(profile = "") {
+  return String(profile || "").trim() == "gpu-local"
+    ? "gpu-local"
+    : "cpu-local";
+}
+
+function executionProfileDetails(profile = "", { backend = "llama.cpp" } = {}) {
+  const executionProfile = normalizedExecutionProfile(profile);
+  return {
+    executionProfile,
+    backend,
+    deviceLabel: executionProfile == "gpu-local" ? "GPU" : "CPU",
+    contextWindow: 0,
+    batchSize: 0,
+    microBatchSize: 0,
+    gpuOffloadLayers: executionProfile == "gpu-local" ? -1 : 0,
+    gpuOffloadLabel: executionProfile == "gpu-local" ? "auto" : "disabled",
+    offloadKqv: false,
+    kvCacheDtype: "",
+    summary: "Legacy local execution is retired.",
+  };
+}
+
+export const AIModelRuntime = {
+  status() {
+    return statusSnapshot();
+  },
+
+  async probe() {
+    recordEvent({
+      command: "probe",
+      state: "disabled",
+      summary: removedRuntimeMessage("runtime"),
+    });
+    return {
+      ok: false,
+      summary: removedRuntimeMessage("runtime"),
+      runtime: statusSnapshot(),
+    };
+  },
+
+  async inspectModel(modelId = "", options = {}) {
+    const role = options?.role || "";
+    const summary = removedRuntimeMessage(role || modelId || "model");
+    recordEvent({
+      command: "inspect",
+      role,
+      modelId,
+      state: "disabled",
+      summary,
+    });
+    return {
+      ok: false,
+      canRun: false,
+      summary,
+      modelId: String(modelId || ""),
+      role,
+      runtime: statusSnapshot(),
+    };
+  },
+
+  async run(modelId = "", role = "", _input = {}, _options = {}) {
+    const summary = removedRuntimeMessage(role || modelId || "model");
+    recordEvent({
+      command: "run",
+      role,
+      modelId,
+      state: "disabled",
+      error: summary,
+      summary,
+    });
+    throw disabledRuntimeError(role);
+  },
+
+  async restart() {
+    recordEvent({
+      command: "restart",
+      state: "disabled",
+      summary:
+        "Legacy local runtime restart was ignored because the runtime has been removed.",
+    });
+    return statusSnapshot();
+  },
+
+  async restartIfUnhealthy() {
+    return this.restart();
+  },
+
+  async stop() {
+    recordEvent({
+      command: "stop",
+      state: "disabled",
+      summary:
+        "Legacy local runtime stop was ignored because the runtime has been removed.",
+    });
+    return statusSnapshot();
+  },
+
+  clearQueue() {
+    recordEvent({
+      command: "clear-queue",
+      state: "disabled",
+      summary: "Legacy local runtime queue is not used.",
+    });
+    return statusSnapshot();
+  },
+
+  clearLogs() {
+    gDebugEvents = [];
+    return statusSnapshot();
+  },
+
+  resetFailedState() {
+    gStatusOverride = {};
+    return statusSnapshot();
+  },
+
+  getDebugEvents() {
+    return cloneValue(gDebugEvents);
+  },
+
+  getDebugBridgeStatus() {
+    return cloneValue(statusSnapshot().debugBridge);
+  },
+
+  async cancel(requestId = "") {
+    return {
+      ok: false,
+      requestId: String(requestId || ""),
+      summary: "No legacy local runtime request is active.",
+    };
+  },
+
+  setTestBackend(_backend = null) {},
+
+  setTestMLEngineFactory(_factory = null) {},
+
+  setTestState(state = {}) {
+    gStatusOverride = mergeObjects(gStatusOverride, state || {});
+    return statusSnapshot();
+  },
+
+  getAssistantExecutionProfileDetails(profile = "", options = {}) {
+    return executionProfileDetails(profile, options);
+  },
+};
