+
+  async testAITemplate() {
+    try {
+      const accountKey = this.getSelectedAITemplateAccountKey();
+      const template = this.getAITemplateFromForm();
+      if (!this.hasAITemplateMatchCondition(template)) {
+        throw new Error(
+          "Add a From, Subject, or Body condition before testing a template."
+        );
+      }
+      const results = await AIService.testTemplate(accountKey, template);
+      const matched = results.filter(result => result.matched).length;
+      const message = `Template matched ${matched} of ${results.length} recent messages.`;
+      document.getElementById("aiTemplateStatus").value = message;
+      this.renderAITestLog("aiTemplateTestLog", {
+        target: "Template",
+        state: "PASS",
+        message,
+        detail: template.name || "Current template",
+      });
+      this.updateAITemplatePreview(results);
+    } catch (error) {
+      const message = `Template test failed: ${error.message}`;
+      document.getElementById("aiTemplateStatus").value = message;
+      this.renderAITestLog("aiTemplateTestLog", {
+        target: "Template",
+        state: "FAIL",
+        message,
+      });
+    }
+  },
+
