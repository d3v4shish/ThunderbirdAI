+function renderComposeDLPDebugLog(debug = null) {
+  const container = document.getElementById("composeDLPDebugLog");
+  if (!container) {
+    return;
+  }
+  container.replaceChildren();
+  if (!debug) {
+    container.hidden = true;
+    return;
+  }
+
+  container.hidden = false;
+  const title = document.createElement("strong");
+  title.textContent = "DLP / PII check";
+  container.appendChild(title);
+
+  const dlpSignals = (debug.dlpSignals || [])
+    .map(signal => signal.id || signal.label)
+    .filter(Boolean)
+    .join(", ");
+  let aiDLP = "skipped";
+  if (debug.aiDLP?.ran) {
+    aiDLP = debug.aiDLP.warned ? "warned" : "checked";
+  }
+  if (debug.aiDLP?.failureReason) {
+    aiDLP += ` (${debug.aiDLP.failureReason})`;
+  }
+  if (debug.aiDLP?.redactedForEndpoint) {
+    aiDLP += " (PII redacted before endpoint request)";
+  }
+
+  const rows = [
+    `Outcome: ${debug.outcome || "unknown"}`,
+    `DLP signals: ${dlpSignals || "none"}`,
+    `PII decision: ${debug.pii?.decision || "allow"} / ${
+      debug.pii?.severity || "low"
+    }`,
+    `PII match types: ${(debug.pii?.matchTypes || []).join(", ") || "none"}`,
+    `AI DLP: ${aiDLP}`,
+    `External recipients: ${debug.externalRecipientCount || 0}`,
+  ];
+  if (debug.reason) {
+    rows.push(`Reason: ${debug.reason}`);
+  }
+
+  for (const row of rows) {
+    const line = document.createElement("div");
+    line.textContent = row;
+    container.appendChild(line);
+  }
+}
