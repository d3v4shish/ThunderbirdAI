+  ) {
+    return "missing-model";
+  }
+  if (/checksum mismatch|failed verification|sha-?256|checksum/i.test(text)) {
+    return "checksum";
+  }
+  if (/permission denied|access denied|operation not permitted/.test(text)) {
+    return "permission";
+  }
+  if (
+    /connection refused|econnrefused|could not connect|network is unreachable|dns|name or service not known/.test(
+      text
+    )
+  ) {
+    return "unreachable";
+  }
+  if (/timed out|timeout/.test(text)) {
+    return phase == "startup" || backendPath == "Helper local"
+      ? "startup-timeout"
+      : "timeout";
+  }
+  if (
+    phase == "startup" &&
+    /spawn|launch|start|bootstrap|crash|executable|missing binary|no such file/.test(
+      text
+    )
+  ) {
+    return "startup";
+  }
