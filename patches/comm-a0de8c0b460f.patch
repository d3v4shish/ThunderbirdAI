+      Assert.less(
+        stageIds.indexOf("extraction"),
+        stageIds.indexOf("assistant-source-selection"),
+        "deterministic extraction should remain before Assistant synthesis stages"
+      );
+
+      const publicRecord = await AIService.getMessageSummary(messageId);
+      Assert.equal(publicRecord.matchedTemplateName, "UPI debit template");
+      Assert.ok(
+        publicRecord.extractedEntities.amounts?.includes("250 INR"),
+        "public message summaries should still expose deterministic regex outputs"
+      );
+      Assert.ok(
+        publicRecord.extractedEntities.upiIds?.includes("alice@upi"),
+        "public message summaries should still expose extracted UPI ids after Assistant cancellation"
+      );
+    } finally {
+      injection.teardownMessageInjection();
+      await AIStorage.clearGeneratedData();
+      await AIExtractionRules.clearGeneratedData();
+      await AITemplates.clearGeneratedData();
+      Services.prefs.clearUserPref("mail.ai.assistant.mode");
+      Services.prefs.setBoolPref("mail.ai.enabled", true);
+    }
+  }
