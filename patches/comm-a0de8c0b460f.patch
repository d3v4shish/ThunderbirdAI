+                  id="testAISummarizer"
+                  data-l10n-id="ai-summaries-action-test"
+                  oncommand="gGeneralPane.testAISummaryRuntime({
+                    statusId: 'aiSummaryStatus',
+                    logId: 'aiSummaryTestLog',
+                    targetLabel: 'Summarizer'
+                  });"/>
+          <button is="highlightable-button"
+                  data-l10n-id="ai-summaries-action-open-settings"
+                  oncommand="gGeneralPane.openAIPreferencePane('paneAI', 'showAISummaryPane');"/>
+        </hbox>
+        <label id="aiSummaryTestLog" class="indent tip-caption"/>
+        <label id="aiSummaryStatus" class="indent tip-caption"/>
+      </vbox>
+    </html:fieldset>
+  </html:div>
+
+  <html:div data-category="paneSummaries">
+    <html:fieldset data-category="paneSummaries">
+      <html:legend data-l10n-id="ai-summaries-prompt-label"></html:legend>
+      <vbox>
+        <hbox align="center" class="input-container wrap-container ai-rule-field">
+          <label data-l10n-id="ai-summaries-prompt-label"
+                 control="aiSummaryPrompt"/>
+          <html:input id="aiSummaryPrompt"
+                      type="text"
+                      oninput="gGeneralPane.markAIFeaturePromptDirty('summary');"/>
+        </hbox>
+        <hbox class="indent ai-inline-actions">
+          <button is="highlightable-button"
+                  id="saveAISummaryPrompt"
+                  data-l10n-id="ai-prompts-save"
+                  oncommand="gGeneralPane.saveAIFeaturePrompt('summary');"/>
+          <button is="highlightable-button"
+                  id="testAISummaryPrompt"
+                  data-l10n-id="ai-prompts-test"
+                  oncommand="gGeneralPane.testAIPromptSandbox('summary', {
+                    statusId: 'aiSummaryPromptStatus',
+                    logId: 'aiSummaryPromptSandboxLog',
+                    targetLabel: 'Summaries'
+                  });"/>
+        </hbox>
+        <label id="aiSummaryPromptStatus" class="indent tip-caption"/>
+        <html:pre id="aiSummaryPromptSandboxLog"
+                  class="indent tip-caption ai-rule-json"/>
+      </vbox>
+    </html:fieldset>
+  </html:div>
+</html:template>
