+    const bootstrapTab = document.getElementById(
+      "aiAssistantStatusTabBootstrap"
+    );
+    const testTab = document.getElementById("aiAssistantStatusTabTest");
+    const bootstrapLog = document.getElementById("aiAssistantBootstrapLog");
+    const testLog = document.getElementById("aiAssistantTestLog");
+    bootstrapTab?.toggleAttribute("selected", selectedTab == "bootstrap");
+    testTab?.toggleAttribute("selected", selectedTab == "test");
+    if (bootstrapLog) {
+      bootstrapLog.hidden = selectedTab != "bootstrap";
+    }
+    if (testLog) {
+      testLog.hidden = selectedTab != "test";
+    }
