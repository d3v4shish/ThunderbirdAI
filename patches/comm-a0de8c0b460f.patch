+        message,
+        detail: failures
+          ? result.failed.map(item => `${item.name}: ${item.error}`).join(" | ")
+          : "",
+      };
+      this.renderAITestLog(
+        "aiLocalModelsActionLog",
+        this._aiLocalModelsActionLogState
+      );
+      await this.refreshAILocalModelsUI({ preserveBusyState: true });
+      this._aiLocalModelsBulkInstallState = null;
+      this.updateAILocalModelsBusyUI(this._aiLocalModelsState);
+      document.getElementById("aiLocalModelsStatus").value = message;
+    } catch (error) {
+      await this.refreshAILocalModelsUI({ preserveBusyState: true });
+      this._aiLocalModelsBulkInstallState = null;
+      this.updateAILocalModelsBusyUI(this._aiLocalModelsState);
+      document.getElementById("aiLocalModelsStatus").value =
+        `Local-role model install failed: ${error.message}`;
+      this._aiLocalModelsActionLogState = {
+        target: "Local-role models",
+        state: "FAIL",
+        message: error.message,
+      };
+      this.renderAITestLog(
+        "aiLocalModelsActionLog",
+        this._aiLocalModelsActionLogState
+      );
+    }
+  },
+
