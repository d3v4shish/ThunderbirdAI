+                <menuitem value="profile" label="Use profile"/>
+                <menuitem value="local" label="Local only"/>
+                <menuitem value="endpoint" label="Prefer Ollama"/>
+              </menupopup>
+            </menulist>
+          </hbox>
+          <hbox align="center" class="input-container wrap-container ai-rule-field">
