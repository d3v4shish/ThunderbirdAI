+function securityReportText(report) {
+  const lines = [];
+  lines.push(`Subject: ${report.subject || "(no subject)"}`);
+  lines.push(`Generated: ${report.generatedAt}`);
+  lines.push(`Overall status: ${statusLabel(reportSummaryStatus(report))}`);
+  lines.push(reportSummaryText(report));
+  for (const section of securityDetailDefinitions(report)) {
+    lines.push("");
+    lines.push(`${section.label}: ${statusLabel(section.status)}`);
+    for (const item of section.items) {
+      lines.push(`- ${item}`);
+    }
+  }
+  return lines.join("\n");
+}
+
+async function updateMessageSecurityDetailsPane(focusSection = "") {
+  if (!isMessageSecurityDetailsPaneVisible()) {
+    return;
+  }
+  if (!gMessage) {
+    gLastMessageSecurityReport = null;
+    await populateSecurityDetailsPane(null, focusSection);
+    return;
+  }
+  const report = await buildMessageSecurityReport();
+  gLastMessageSecurityReport = report;
+  await populateSecurityDetailsPane(report, focusSection);
+}
+
+async function openMessageSecurityDetailsPane(focusSection = "") {
+  const pane = document.getElementById("messageSecurityDetailsPane");
+  if (pane) {
+    pane.hidden = false;
+  }
+  await updateMessageSecurityDetailsPane(focusSection);
+  pane?.scrollIntoView({ block: "start", behavior: "smooth" });
+}
+
+async function copyMessageSecurityReport() {
+  const report =
+    gLastMessageSecurityReport || (await buildMessageSecurityReport());
+  gLastMessageSecurityReport = report;
+  Cc["@mozilla.org/widget/clipboardhelper;1"]
+    .getService(Ci.nsIClipboardHelper)
+    .copyString(securityReportText(report));
+}
+
+async function exportMessageSecurityReport() {
+  const report =
+    gLastMessageSecurityReport || (await buildMessageSecurityReport());
+  gLastMessageSecurityReport = report;
+  const picker = Cc["@mozilla.org/filepicker;1"].createInstance(
+    Ci.nsIFilePicker
+  );
+  picker.init(window, "Export Security Report", Ci.nsIFilePicker.modeSave);
+  picker.defaultExtension = "json";
+  picker.defaultString = `security-report-${Date.now()}.json`;
+  picker.appendFilter("JSON", "*.json");
+  picker.appendFilters(Ci.nsIFilePicker.filterAll);
+  const result = await new Promise(resolve => picker.open(resolve));
+  if (
+    result != Ci.nsIFilePicker.returnOK &&
+    result != Ci.nsIFilePicker.returnReplace
+  ) {
+    return;
+  }
+  await IOUtils.writeUTF8(picker.file.path, JSON.stringify(report, null, 2));
+}
