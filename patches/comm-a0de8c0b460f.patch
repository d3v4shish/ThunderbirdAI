+
+function normalizedSkeleton(text) {
+  return normalizeText(text)
+    .replace(/\bhttps?:\/\/\S+\b/gu, "#")
+    .replace(/\b[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}\b/gu, "#")
+    .replace(/\b[a-f0-9]{8,}\b/gu, "#")
+    .replace(/\b\d+\b/gu, "#")
+    .replace(/[^\p{L}\p{N}#]+/gu, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+// Template learning deliberately considers only a small, human-readable body
+// surface. Quoted history, signatures, and bulk footer language otherwise
+// become the most frequent "template" in a mailbox.
+function meaningfulBodyUnits(text = "") {
+  const units = [];
+  let inSignature = false;
+  for (const rawLine of String(text).split(/\r?\n/u)) {
+    const line = limitedString(rawLine, 280);
+    if (!line) {
+      continue;
+    }
+    if (/^--\s*$/u.test(line)) {
+      inSignature = true;
+      continue;
+    }
+    if (inSignature || /^>/.test(line)) {
+      continue;
+    }
+    if (
+      line.length < 12 ||
+      /\b(?:unsubscribe|privacy policy|terms of service|view (?:this )?(?:email|message) in (?:your )?browser)\b/i.test(
+        line
+      )
+    ) {
+      continue;
+    }
+    units.push(line);
+    if (units.length >= 8) {
+      break;
+    }
+  }
+  return units;
+}
+
+function inferredBodyStructure(messages = []) {
+  if (messages.length < 2) {
+    return null;
+  }
+  const firstUnits = messages.map(
+    message => meaningfulBodyUnits(message.body)[0]
+  );
+  if (firstUnits.some(unit => !unit)) {
+    return null;
+  }
+  return mineDrain3Template(firstUnits);
