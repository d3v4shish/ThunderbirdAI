+add_task(async function testThreadPaneHeaderHotRefreshUsesSnapshot() {
+  about3Pane.restoreState({ folderURI: folder.URI });
+  await BrowserTestUtils.waitForCondition(
+    () => about3Pane.gFolder?.URI == folder.URI,
+    "The test folder should be displayed"
