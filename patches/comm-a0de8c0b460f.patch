+  };
+  Assert.ok(
+    validateModelCatalogEntry(floating).some(error =>
+      error.includes("revision")
+    )
+  );
+
+  const placeholder = {
+    ...validCatalogEntry(),
+    revision: `0`.repeat(39) + "3",
+    downloadURL: `https://example.test/model/resolve/${`0`.repeat(39)}3/model.onnx`,
+    artifacts: [
+      {
+        ...validCatalogEntry().artifacts[0],
+        sha256: `${"0".repeat(63)}3`,
+      },
+    ],
+  };
+  Assert.ok(
+    validateModelCatalogEntry(placeholder).some(error =>
+      error.includes("placeholder")
+    )
+  );
+});
+
+add_task(function test_sha256_helper_remains_available_for_legacy_cleanup() {
+  const bytes = new TextEncoder().encode("legacy artifact");
+  Assert.equal(
+    sha256HexForByteArray(bytes),
+    "696a1889f352f8549a4a8c638f7981cc9fc4f5993dcd54e0ada26bf9f38fdaf9"
+  );
+});
+
+add_task(async function test_artifacts_are_removed_only_by_explicit_cleanup() {
+  await AILocalModels.clearGeneratedData();
+  const modelId = "legacy-cleanup-model";
+  const modelDirectory = PathUtils.join(
+    AIRuntimePaths.modelCacheRootDir(),
+    modelId
+  );
+  const artifactPath = PathUtils.join(modelDirectory, "model.gguf");
+  await IOUtils.makeDirectory(modelDirectory, {
+    createAncestors: true,
+    ignoreExisting: true,
+  });
+  await IOUtils.writeUTF8(artifactPath, "legacy artifact");
+  AILocalModels.saveModel({
+    id: modelId,
+    name: "Legacy cleanup model",
+    kind: "generator",
+    backend: "gguf",
+    installed: true,
+    artifactPath: modelDirectory,
+    artifactFiles: [{ fileName: "model.gguf", path: artifactPath }],
