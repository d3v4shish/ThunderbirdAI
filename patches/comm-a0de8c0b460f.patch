+      case "sending":
+        return "sending";
+      case "tool-planning":
+      case "tool-running":
+      case "tool-results":
+        return "retrieving";
+      case "synthesizing":
+        return "answering";
+      case "direct-rag":
+        return "answering";
+      case "cancelled":
+        return "cancelled";
+      case "failed":
+      case "unavailable":
+        return "failed";
+      case "complete":
+      case "ok":
