+
+  _describeAIAssistantRuntimeStatus(runtimeStatus) {
+    const assistantRuntime = runtimeStatus?.assistantRuntime || null;
+    if (!runtimeStatus?.enabled) {
+      return "Assistant is disabled.";
+    }
+    const sourceLabel =
+      assistantRuntime?.sourceName ||
+      assistantRuntime?.sourceType ||
+      assistantRuntime?.provider ||
+      "Ollama endpoint";
+    const parts = [];
+    if (assistantRuntime?.state == "ready") {
+      parts.push(
+        `Assistant uses ${sourceLabel}${
+          assistantRuntime.model ? ` / ${assistantRuntime.model}` : ""
+        }`
+      );
+    } else {
+      parts.push(
+        "Assistant is disabled until an Ollama endpoint and model are configured"
+      );
+    }
+    if (assistantRuntime?.lastProbeAt) {
+      parts.push(
+        `Endpoint last probed at ${new Date(
+          assistantRuntime.lastProbeAt
+        ).toLocaleString()}${
+          assistantRuntime.lastProbeLatencyMs
+            ? ` (${assistantRuntime.lastProbeLatencyMs} ms)`
+            : ""
+        }${
+          assistantRuntime.userFacingLastProbeError ||
+          assistantRuntime.lastProbeError
+            ? `: ${
+                assistantRuntime.userFacingLastProbeError ||
+                assistantRuntime.lastProbeError
+              }`
+            : ""
+        }`
+      );
+    }
+    if (assistantRuntime?.fallbackReason) {
+      parts.push(assistantRuntime.fallbackReason);
+    }
+    return `${parts.filter(Boolean).join(". ")}.`;
+  },
