+function installMockEndpoint({ stream = false, handler, toolHandler = null }) {
+  const originalCanUse = AIEndpoint.canUseEndpoint;
+  const originalGetConfig = AIEndpoint.getConfig;
+  const originalChatWithDebug = AIEndpoint.chatWithDebug;
+  const originalChatStreamWithDebug = AIEndpoint.chatStreamWithDebug;
+  const originalChatTurnWithDebug = AIEndpoint.chatTurnWithDebug;
+  const config = {
+    provider: "source",
+    sourceId: "source-1",
+    sourceName: "LocalAI",
+    sourceType: "ollama",
+    endpointURL: "http://127.0.0.1:11434/v1/chat/completions",
+    model: "llama3",
+  };
+  AIEndpoint.canUseEndpoint = () => true;
+  AIEndpoint.getConfig = () => config;
+  const endpointHandler = (...args) => handler(...args);
+  if (stream) {
+    AIEndpoint.chatStreamWithDebug = endpointHandler;
+  } else {
+    AIEndpoint.chatWithDebug = endpointHandler;
+  }
+  AIEndpoint.chatWithDebug = endpointHandler;
+  AIEndpoint.chatTurnWithDebug =
+    toolHandler ||
+    (async (...args) => {
