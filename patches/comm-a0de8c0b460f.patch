+        role == "deterministic" || DETERMINISTIC_RUNTIME_ROLE_IDS.includes(role)
+      );
+    case "MiningWorker":
+      return (
+        role == "mining" ||
+        action == "restart-analysis" ||
+        action == "clear-analysis-queue"
+      );
+    default:
+      return false;
+  }
+}
+
+function runtimeLaneMatchesRecentAction(lane = {}, entry = {}) {
+  if (lane.id != "MiningWorker") {
+    return false;
+  }
+  return MINING_RUNTIME_ACTION_IDS.has(String(entry.action || "").trim());
+}
+
+function runtimeLaneTimeline(
+  lane = {},
+  { runtimeLogs = [], recentActions = [] } = {}
+) {
+  const events = [];
+  for (const entry of runtimeLogs || []) {
+    if (!runtimeLaneMatchesRuntimeLog(lane, entry)) {
+      continue;
+    }
+    events.push(runtimeLaneTimelineEventFromRuntimeLog(lane, entry));
+  }
+  for (const entry of recentActions || []) {
+    if (!runtimeLaneMatchesRecentAction(lane, entry)) {
+      continue;
+    }
+    events.push(runtimeLaneTimelineEventFromRecentAction(lane, entry));
+  }
+  const seen = new Set();
+  return events
+    .sort((a, b) => {
+      const left = Date.parse(a.at) || 0;
+      const right = Date.parse(b.at) || 0;
+      return right - left;
+    })
+    .filter(event => {
+      const key = [
+        event.id,
+        event.at,
+        event.action,
+        event.requestId,
+        event.backend,
+        event.modelId,
+      ].join("|");
+      if (seen.has(key)) {
+        return false;
+      }
+      seen.add(key);
+      return true;
+    })
+    .slice(0, MAX_RUNTIME_LANE_TIMELINE_EVENTS);
+}
+
+function runtimeLaneRepairReportSnapshot(lane = {}) {
+  const budgetSummary = uniqueStringValues(
