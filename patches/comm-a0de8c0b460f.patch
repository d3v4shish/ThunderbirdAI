+  for (const match of text.matchAll(
+    /\b(?:[A-Z][\p{L}\d-]*)(?:\s+[A-Z][\p{L}\d-]*)+\b/gu
+  )) {
+    const topic = compactString(match[0], 120).toLocaleLowerCase();
+    if (topic) {
+      topics.push(topic);
+    }
+  }
+  return uniqueValues(topics);
