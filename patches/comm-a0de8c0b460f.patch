+  async getEmailDomainData(msgHdr) {
+    await AIStorage.init();
+    if (!msgHdr?.folder) {
+      return null;
+    }
+
+    const messageId = messageIdFor(msgHdr);
+    const accountKey = accountKeyFor(msgHdr) || "global";
+    const currentRecord = AIStorage.getMessage(messageId) || {
+      messageId,
+      accountKey,
+      folderURI: msgHdr.folder.URI,
+      messageKey: msgHdr.messageKey,
+      subject: msgHdr.mime2DecodedSubject || "(no subject)",
+      author: msgHdr.mime2DecodedAuthor || "",
+      date: messageDateFor(msgHdr),
+    };
+    const accountRecords = AIStorage.getMessages({ accountKey }).map(record =>
+      storageIdForAIRecord(record) == messageId ? currentRecord : record
+    );
+    if (
+      messageId &&
+      !accountRecords.some(record => storageIdForAIRecord(record) == messageId)
+    ) {
+      accountRecords.push(currentRecord);
+    }
+    const conversationKey = conversationKeyForRecord(
+      currentRecord,
+      msgHdr.mime2DecodedSubject || ""
+    );
+    const conversationRecords = accountRecords.filter(record => {
+      return (
+        conversationKeyForRecord(record, currentRecord.subject) ==
+        conversationKey
+      );
+    });
+    if (
+      !conversationRecords.some(
+        record => storageIdForAIRecord(record) == messageId
+      )
+    ) {
+      conversationRecords.push(currentRecord);
+    }
+    const relatedTraces = AIStorage.getRecentTraces(20, { accountKey }).filter(
+      trace => {
+        const request = parseTraceJSON(trace.request) || {};
+        const retrieval = request.retrievalSummary || {};
+        if (
+          trace.citations?.some(citation => citation.messageId == messageId)
+        ) {
+          return true;
+        }
+        return [
+          ...(retrieval.evidenceCards || []),
+          ...(retrieval.selectedRecords || []),
+        ].some(record => record.messageId == messageId);
+      }
+    );
+
+    return {
+      message: recordReference(currentRecord),
+      conversationTimeline: conversationTimelineForRecords(
+        conversationRecords,
+        currentRecord
+      ),
+      replyNeeded: replyNeededSummaryForRecord(currentRecord),
+      followUpQueue: followUpQueueForRecords(accountRecords),
+      templateFamilies: templateFamiliesForRecords(accountRecords),
+      automationReviewQueue: automationReviewQueueForRecords([
+        currentRecord,
+        ...accountRecords.filter(
+          record => storageIdForAIRecord(record) != messageId
+        ),
+      ]),
+      ragSourceInspector: ragSourcesForTraces(relatedTraces, messageId),
+      savedSearches: await this.listSavedNaturalLanguageSearches(),
+    };
+  }
