+  async runAIRepairAction(actionId = "", options = {}) {
+    await AIStorage.init();
+    const id = String(actionId || "").trim();
+    const startedAt = Date.now();
+    const result = {
+      actionId: id,
+      status: "complete",
+      startedAt: new Date(startedAt).toISOString(),
+      finishedAt: "",
+      durationMs: 0,
+      detail: "",
+    };
+    const execute = async () => {
+      switch (id) {
+        case "test-endpoint": {
+          const test = await this.testEndpointDetailed(
+            options.accountKey || "global",
+            {
+              sourceId: options.sourceId || "",
+              role: options.role || "assistant-fallback",
+            }
+          );
+          result.detail = `Endpoint test passed for ${
+            test.config?.sourceName ||
+            test.config?.provider ||
+            "configured source"
+          }.`;
+          break;
+        }
+        case "retry-download":
+        case "install-model":
+          throw new Error(
+            "Legacy local model downloads are retired. Configure an Assistant endpoint instead."
+          );
+        case "deep-reset-runtime": {
+          const reset = await this.resetAssistantRuntime({
+            clearModelFiles: false,
+          });
+          result.detail = reset.summary;
+          result.reset = reset;
+          break;
+        }
+        case "deep-reset-runtime-with-model-files": {
+          const reset = await this.resetAssistantRuntime({
+            clearModelFiles: true,
+          });
+          result.detail = reset.summary;
+          result.reset = reset;
+          break;
+        }
+        case "increase-timeout": {
+          const timeout = this.setEndpointTimeoutMs(
+            Number(options.timeoutMs) || AIEndpoint.getTimeoutMs() + 15000
+          );
+          result.detail = `Endpoint timeout is now ${timeout.timeoutMs} ms.`;
+          break;
+        }
+        case "open-logs": {
+          const events = AIRuntimeLogging.getLogs({ limit: 20 });
+          result.detail = `Loaded ${events.length} runtime log event(s).`;
+          result.events = events;
+          break;
+        }
+        case "disable-feature":
+          Services.prefs.setBoolPref("mail.ai.enabled", false);
+          result.detail = "AI Mail Assistant disabled.";
+          break;
+        case "clear-queue":
+          this.#queue.length = 0;
+          this.#queuedIds.clear();
+          this.#forcedIds.clear();
+          this.#notifyRuntimeChanged();
+          result.detail = "Cleared analysis queue.";
+          break;
+        default:
+          throw new Error("Unknown AI repair action.");
+      }
+    };
+    try {
+      if (
+        ["deep-reset-runtime", "deep-reset-runtime-with-model-files"].includes(
+          id
+        )
+      ) {
+        await this.#runAssistantEndpointTransition(
+          {
+            owner: "repair",
+            kind: "repair-action",
+            label: "Assistant runtime repair",
+            actionId: id,
+            accountKey: options.accountKey || "global",
+            role: options.role || "",
+            coalesceKey: `repair:${options.accountKey || "global"}:${id}`,
+            activeSupersedesOwners: ["background"],
+            queuedSupersedesOwners: ["background", "repair"],
+            cancellable: false,
+          },
+          async () => execute()
+        );
+      } else {
+        await execute();
+      }
+    } catch (error) {
+      result.status = "failed";
+      result.detail = error.message;
+      result.error = error.message;
+    }
+    result.finishedAt = new Date().toISOString();
+    result.durationMs = Math.max(0, Date.now() - startedAt);
+    AIStorage.recordAction("ai-repair-action", result);
+    if (result.status == "failed") {
+      throw new Error(result.detail);
+    }
+    return result;
+  }
