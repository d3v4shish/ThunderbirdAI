+const MAX_TEXT = 4000;
+const MAX_TEMPLATE_ITEMS = 16;
+
+const MATCH_MODES = new Set(["contains", "regex"]);
+const SUMMARY_MODES = new Set(["template", "extractive", "normal-ai"]);
+const CATEGORY_MODES = new Set(["prior", "override"]);
+const CREATED_FROM = new Set(["manual", "suggested"]);
+const SLOT_TYPES = new Set([
+  "amount",
+  "date",
+  "email",
+  "int",
+  "order_id",
+  "tracking_id",
+  "url",
+]);
+
+const SLOT_PATTERNS = new Map([
+  [
+    "amount",
+    /(?:[$€£₹]\s?\d[\d,]*(?:\.\d+)?|\b\d[\d,]*(?:\.\d+)?\s?(?:inr|rs\.?|usd|eur|gbp)\b)/gi,
+  ],
+  [
+    "date",
+    /\b(?:\d{1,2}[/-]\d{1,2}[/-]\d{2,4}|today|tomorrow|yesterday|monday|tuesday|wednesday|thursday|friday|saturday|sunday|jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)[\w\s,.-]{0,24}\b/gi,
+  ],
+  ["email", /\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi],
+  ["int", /\b\d{2,}\b/g],
+  [
+    "order_id",
+    /\b(?:order|invoice|reference|txn|transaction)(?:\s*(?:id|no|number|#))?\s*[:#-]?\s*[A-Z0-9-]{4,}\b/gi,
+  ],
+  [
+    "tracking_id",
+    /\b(?:tracking|awb|shipment)(?:\s*(?:id|no|number|#))?\s*[:#-]?\s*[A-Z0-9-]{4,}\b/gi,
+  ],
+  ["url", /\bhttps?:\/\/[^\s<>()]+/gi],
+]);
+
+function plainObject(value) {
+  return value && typeof value == "object" && !Array.isArray(value)
+    ? value
+    : {};
+}
+
+function limitedString(value, limit = MAX_TEXT) {
+  return String(value ?? "")
+    .trim()
+    .slice(0, limit);
+}
+
+function makeId() {
+  return `template-${Date.now().toString(36)}-${Math.random()
+    .toString(36)
+    .slice(2, 8)}`;
+}
+
+function normalizeList(value, limit = MAX_TEMPLATE_ITEMS) {
+  const source = Array.isArray(value)
+    ? value
+    : String(value ?? "").split(/[\n,]+/u);
+  return Array.from(
+    new Set(
+      source
+        .map(item => limitedString(item, 120))
+        .filter(Boolean)
+        .slice(0, limit)
+    )
+  );
+}
+
+function normalizeCondition(condition = {}) {
+  return {
+    mode: MATCH_MODES.has(condition.mode) ? condition.mode : "contains",
+    value: limitedString(condition.value, MAX_TEXT),
+  };
+}
+
+function normalizeExample(example = {}) {
+  return {
+    messageId: limitedString(example.messageId, 200),
+    subject: limitedString(example.subject, 200),
+    author: limitedString(example.author, 200),
+  };
+}
+
+function normalizeTemplate(template = {}) {
+  return {
+    id: limitedString(template.id, 80) || makeId(),
+    name: limitedString(template.name, 120) || "Mail template",
+    enabled: template.enabled !== false,
+    createdFrom: CREATED_FROM.has(template.createdFrom)
+      ? template.createdFrom
+      : "manual",
+    match: {
+      from: normalizeCondition(template.match?.from),
+      subject: normalizeCondition(template.match?.subject),
+      body: normalizeCondition(template.match?.body),
+      typedSlots: normalizeList(template.match?.typedSlots, 8).filter(type =>
+        SLOT_TYPES.has(type)
+      ),
+    },
+    summaryMode: SUMMARY_MODES.has(template.summaryMode)
+      ? template.summaryMode
+      : "template",
+    summaryTemplate: limitedString(template.summaryTemplate, 600),
+    categoryMode: CATEGORY_MODES.has(template.categoryMode)
+      ? template.categoryMode
+      : "prior",
+    categoryValue: limitedString(template.categoryValue, 80),
+    extractionFields: normalizeList(template.extractionFields, 12),
+    suppressions: normalizeList(template.suppressions, 16),
+    piiFields: normalizeList(template.piiFields, 12),
+    examples: Array.isArray(template.examples)
+      ? template.examples.slice(0, 12).map(normalizeExample)
+      : [],
+  };
+}
+
+function normalizedAccountData(data = {}) {
+  return {
+    templates: Array.isArray(data.templates)
+      ? data.templates.map(normalizeTemplate)
+      : [],
+  };
+}
+
+function normalizeText(text) {
+  return String(text ?? "")
+    .replace(/\s+/g, " ")
+    .trim()
+    .toLocaleLowerCase();
