+
+  async #flushMailboxDigestPack(context) {
+    if (!context.pack.length) {
+      return;
+    }
+    this.#assertMailboxDigestActive(context.controller.signal);
+    this.#mailboxDigestProgress(
+      context,
+      "mapping",
+      `Ollama is processing ${context.pack.length} bounded email chunk(s).`
+    );
+    const startedAt = Date.now();
+    context.job.endpointInFlight++;
+    let result;
+    try {
+      result = await this.#mapMailboxDigestPack(
+        context.pack,
+        context.accountKey,
+        context.config,
+        context.controller.signal
+      );
+    } finally {
+      context.job.endpointInFlight--;
+    }
+    this.#recordMailboxDigestEndpointTiming(
+      context,
+      Date.now() - startedAt,
+      result.calls
+    );
+    context.job.mapCalls += result.calls;
+    context.job.endpointRetries += Math.max(0, result.calls - 1);
+    for (const entry of context.pack) {
+      const state = context.messageStates.get(entry.messageId);
+      const node = result.nodes.get(entry.id);
+      if (state && node) {
+        state.nodes[entry.chunkIndex] = node;
+        context.job.completedChunks++;
+      } else if (state) {
+        state.failed = true;
+        context.job.endpointFailures++;
+      }
+    }
+    context.pack = [];
+    context.packChars = 0;
+    await this.#finalizeMailboxDigestMessages(context);
+  }
+
+  async #readMailboxDigestBodies(context) {
+    const redactionRequired =
+      getStringPref("mail.ai.external.redaction", "optional") == "required";
+    if (redactionRequired) {
+      await AIPIIRules.init();
