+  async bootstrapAssistantRuntime(options = {}) {
+    await AILocalModels.init();
+    await AISources.init();
+
+    const startedAt = Date.now();
+    const accountKey = options.accountKey || "global";
+    const effectiveAccountKey = accountKey == "global" ? null : accountKey;
+    const result = {
+      status: "ready",
+      startedAt: new Date(startedAt).toISOString(),
+      finishedAt: "",
+      durationMs: 0,
+      summary: "",
+      failedStepId: "",
+      steps: [],
+      runtimeStatus: null,
+    };
+    let currentStep = null;
+    const pushStep = (id, label, status, detail = "") => {
+      result.steps.push({
+        id,
+        label,
+        status,
+        detail: limitedString(detail, 4000),
+      });
+    };
+
+    try {
+      let runtimeStatus = await this.getRuntimeSnapshot(effectiveAccountKey);
+      result.runtimeStatus = runtimeStatus;
+      if (!runtimeStatus.enabled) {
+        throw new Error("AI Mail Assistant is disabled.");
+      }
+      if (
+        !AIEndpoint.canUseEndpoint(effectiveAccountKey, { role: "assistant" })
+      ) {
+        throw new Error(
+          "Assistant is disabled until an Ollama endpoint and model are configured."
+        );
+      }
+      currentStep = {
+        id: "assistant-endpoint",
+        label: "Assistant Ollama endpoint",
+      };
+      const endpointProbe = await this.testEndpointDetailed(accountKey, {
+        role: "assistant",
+      });
+      const firstAttempt =
+        endpointProbe.attempts?.find(attempt => attempt.state == "ok") ||
+        endpointProbe.attempts?.[0] ||
+        null;
+      const sourceLabel =
+        endpointProbe.config?.sourceName ||
+        endpointProbe.config?.sourceType ||
+        endpointProbe.config?.provider ||
+        "Assistant Ollama endpoint";
+      pushStep(
+        currentStep.id,
+        currentStep.label,
+        "complete",
+        uniqueStringValues(
+          `${sourceLabel} answered the Assistant probe.`,
+          firstAttempt?.durationMs
+            ? `Latency ${firstAttempt.durationMs} ms.`
+            : "",
+          endpointProbe.answer ? `Reply: ${endpointProbe.answer}` : ""
+        ).join(" ")
+      );
+      currentStep = null;
+
+      runtimeStatus = await this.getRuntimeSnapshot(effectiveAccountKey);
+      result.runtimeStatus = runtimeStatus;
+      result.summary = `${sourceLabel} answered the Assistant probe.`;
+      return result;
+    } catch (error) {
+      result.status = "failed";
+      result.failedStepId = currentStep?.id || result.steps.at(-1)?.id || "";
+      if (currentStep) {
+        pushStep(currentStep.id, currentStep.label, "failed", error.message);
+      } else if (result.failedStepId) {
+        result.steps[result.steps.length - 1] = {
+          ...result.steps.at(-1),
+          status: "failed",
+          detail: error.message,
+        };
+      } else {
+        pushStep(
+          "assistant-bootstrap",
+          "Assistant bootstrap",
+          "failed",
+          error.message
+        );
+        result.failedStepId = "assistant-bootstrap";
+      }
+      result.summary = result.failedStepId
+        ? `${result.steps.at(-1)?.label || "Assistant bootstrap"} failed: ${error.message}`
+        : error.message;
+      result.runtimeStatus = await this.getRuntimeSnapshot(
+        effectiveAccountKey
+      ).catch(() => null);
+      return result;
+    } finally {
+      result.finishedAt = new Date().toISOString();
+      result.durationMs = Math.max(0, Date.now() - startedAt);
+    }
+  }
