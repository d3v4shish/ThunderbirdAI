+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const { MessageGenerator } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/MessageGenerator.sys.mjs"
+);
+const { AttachmentScanCache } = ChromeUtils.importESModule(
+  "resource:///modules/AttachmentScanCache.sys.mjs"
+);
+const { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+const { AIStorage } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+);
+
+const tabmail = document.getElementById("tabmail");
+const about3Pane = tabmail.currentAbout3Pane;
+const generator = new MessageGenerator();
+
+let account;
+let baseFolder;
+
+function messageIdForHeader(msgHdr) {
+  return `${msgHdr.folder.URI}#${msgHdr.messageKey}`;
+}
+
+function setThreadMarkerState(
+  msgHdr,
+  { ai = "", security = "", av = "not-scanned" } = {}
+) {
+  msgHdr.setStringProperty("aiScanState", ai);
+  msgHdr.setStringProperty("aiSecurityVerdict", security);
+  AttachmentScanCache.setSummary(msgHdr, av);
+}
+
+function makeRuntimeStatus(progress) {
+  return {
+    enabled: true,
+    activeWorkers: 0,
+    workerCount: 4,
+    queueLength: 0,
+    queuedMessageCount: 0,
+    processing: false,
+    backfilling: false,
+    providerStatus: { state: "available" },
+    endpoint: {
+      provider: "ollama",
+      sourceName: "LocalAI",
+      sourceType: "ollama",
+    },
+    currentRun: {
+      scopeLabel: progress.scopeLabel,
+      analyzedMessages: progress.analyzedMessages,
+      totalMessages: progress.totalMessages,
+      missingAnalysis: progress.missingAnalysis,
+    },
+    localModels: [],
+    roleAssignments: {},
+    activeSourceByFeature: {},
+    subsystems: {},
+  };
+}
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  Services.prefs.setBoolPref("mail.ai.backfill.enabled", false);
+  await AIStorage.clearGeneratedData();
+  await AIStorage.init();
+  await AIService.init();
+
+  account = MailServices.accounts.createLocalMailAccount();
+  account.addIdentity(MailServices.accounts.createIdentity());
+  const rootFolder = account.incomingServer.rootFolder.QueryInterface(
+    Ci.nsIMsgLocalMailFolder
+  );
+  baseFolder = rootFolder
+    .createLocalSubfolder("aiAnalysisCoverageBase")
+    .QueryInterface(Ci.nsIMsgLocalMailFolder);
+  baseFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+
+  registerCleanupFunction(async () => {
+    if (account) {
+      MailServices.accounts.removeAccount(account, false);
+      account = null;
+      baseFolder = null;
+    }
+    await AIStorage.clearGeneratedData();
+    await AIService.uninit();
+    Services.prefs.clearUserPref("mail.ai.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.enabled");
+  });
+});
+
+add_task(async function testAnalysisCoverageExplainsScopeAndPartialCounts() {
+  const doc = about3Pane.document;
+  const popupBody = document.getElementById("aiStatusPopupBody");
+  const footerSummary = doc.getElementById("aiTriageRuntimeSummary");
+  const footerDetails = doc.getElementById("aiTriageRuntimeDetails");
+  const coverageText = doc.getElementById("aiSemanticCoverageText");
+  const rootFolder = account.incomingServer.rootFolder.QueryInterface(
+    Ci.nsIMsgLocalMailFolder
+  );
+  const coverageFolder = rootFolder
+    .createLocalSubfolder("aiAnalysisCoverageData")
+    .QueryInterface(Ci.nsIMsgLocalMailFolder);
+  coverageFolder.setFlag(Ci.nsMsgFolderFlags.Mail);
+
+  const recordIds = [];
+  const setRecord = (msgHdr, overrides = {}) => {
+    const recordId = messageIdForHeader(msgHdr);
+    recordIds.push(recordId);
+    AIStorage.setMessage(recordId, {
+      accountKey: account.incomingServer.key,
+      folderURI: coverageFolder.URI,
+      messageKey: msgHdr.messageKey,
+      subject: msgHdr.mime2DecodedSubject,
+      author: msgHdr.mime2DecodedAuthor,
+      date: msgHdr.dateInSeconds,
+      timelineStages: [],
+      ...overrides,
+    });
+  };
+  const stage = (id, status = "complete") => ({ id, status });
+
+  for (const subject of [
+    "Coverage complete",
+    "Coverage partial",
+    "Coverage failed",
+    "Coverage missing",
+  ]) {
+    coverageFolder.addMessage(
+      generator
+        .makeMessage({
+          from: "Coverage <coverage@example.com>",
+          subject,
+          read: true,
+        })
+        .toMessageString()
+    );
+  }
+
+  const headersBySubject = new Map(
+    [...coverageFolder.messages].map(msgHdr => [
+      msgHdr.mime2DecodedSubject,
+      msgHdr,
+    ])
+  );
+  const completeHdr = headersBySubject.get("Coverage complete");
+  const partialHdr = headersBySubject.get("Coverage partial");
+  const failedHdr = headersBySubject.get("Coverage failed");
+  const missingHdr = headersBySubject.get("Coverage missing");
+
+  setThreadMarkerState(completeHdr, { ai: "complete", av: "clean" });
+  setRecord(completeHdr, {
+    summary: "Complete message",
+    embedding: [1, 0],
+    timelineStages: [
+      stage("parser"),
+      stage("security"),
+      stage("template"),
+      stage("embedding"),
+      stage("summary"),
+    ],
+  });
+
+  setThreadMarkerState(partialHdr, { ai: "complete", av: "queued" });
+  setRecord(partialHdr, {
+    timelineStages: [
+      stage("parser"),
+      stage("security", "fallback"),
+      stage("template"),
+      stage("embedding", "pending"),
+    ],
+  });
+
+  setThreadMarkerState(failedHdr, { ai: "failed", av: "failed" });
+  setRecord(failedHdr, {
+    timelineStages: [
+      stage("parser"),
+      stage("security", "pending"),
+      stage("template", "pending"),
+      stage("embedding"),
+    ],
+  });
+
+  setThreadMarkerState(missingHdr, { ai: "queued", av: "queued" });
+
+  try {
+    about3Pane.restoreState({ folderURI: coverageFolder.URI });
+    await BrowserTestUtils.waitForCondition(
+      () => about3Pane.gFolder?.URI == coverageFolder.URI,
+      "The coverage folder should be visible"
+    );
+
+    const progress = await AIService.getAnalysisProgress({
+      accountKey: account.incomingServer.key,
+      folderURI: coverageFolder.URI,
+    });
+    const runtimeStatus = makeRuntimeStatus(progress);
+    const countedLine = `Counted states: parsed ${
+      progress.countedStates.parsedMessages || 0
+    }, security ${progress.countedStates.securityCompleteMessages || 0}, AV ${
+      progress.countedStates.avCompleteMessages || 0
+    }, templates ${progress.countedStates.templateCompleteMessages || 0}, semantic ${
+      progress.countedStates.embeddedMessages || 0
+    }, summaries ${progress.countedStates.summarizedMessages || 0}, failed ${
+      progress.countedStates.failedMessages || 0
+    }`;
+    const partialLine = progress.countedStates.partiallyAnalyzedMessages
+      ? `${progress.countedStates.partiallyAnalyzedMessages} message(s) still have pending summary, embedding, or attachment-scan work.`
+      : "No partially analyzed messages remain in this scope.";
+    const coverageLine = `${progress.analyzedMessages} of ${
+      progress.totalMessages
+    } messages with AI records. Parsed ${
+      progress.countedStates.parsedMessages || 0
+    }, security ${progress.countedStates.securityCompleteMessages || 0}, AV ${
+      progress.countedStates.avCompleteMessages || 0
+    }, templates ${progress.countedStates.templateCompleteMessages || 0}, semantic ${
+      progress.countedStates.embeddedMessages || 0
+    }, summaries ${progress.countedStates.summarizedMessages || 0}, failed ${
+      progress.countedStates.failedMessages || 0
+    }.`;
+
+    about3Pane.aiTriageCenter.renderRuntimeFooter(runtimeStatus, progress);
+    about3Pane.aiTriageCenter.renderAnalysisProgress(progress);
+    window.MsgStatusFeedback._renderAIPopup(runtimeStatus, progress);
+
+    Assert.equal(progress.countedStates.parsedMessages, 3);
+    Assert.equal(progress.countedStates.securityCompleteMessages, 2);
+    Assert.equal(progress.countedStates.failedMessages, 1);
+    Assert.stringContains(
+      footerSummary.textContent,
+      "3 of 4 with AI records",
+      "The triage footer should expose folder coverage in AI-record terms"
+    );
+    Assert.stringContains(
+      footerDetails.textContent,
+      progress.scopeDescription,
+      "The triage footer should explain the folder scope"
+    );
+    Assert.stringContains(
+      footerDetails.textContent,
+      progress.analyzedDefinition,
+      "The triage footer should explain what analyzed counts include"
+    );
+    Assert.stringContains(
+      footerDetails.textContent,
+      countedLine,
+      "The triage footer should expose exact counted states"
+    );
+    Assert.stringContains(
+      footerDetails.textContent,
+      partialLine,
+      "The triage footer should call out partial analysis explicitly"
+    );
+    Assert.stringContains(
+      coverageText.textContent,
+      coverageLine,
+      "Semantic coverage text should mirror the explicit counted-state breakdown"
+    );
+
+    const popupText = [...popupBody.querySelectorAll("label, description")]
+      .map(element => element.value || element.textContent || "")
+      .join("\n");
+    Assert.stringContains(
+      popupText,
+      progress.scopeDescription,
+      "The detailed popup should include the scope explanation"
+    );
+    Assert.stringContains(
+      popupText,
+      progress.analyzedDefinition,
+      "The detailed popup should explain the analyzed-count contract"
+    );
+    Assert.stringContains(
+      popupText,
+      countedLine,
+      "The detailed popup should include the counted-stage totals"
+    );
+  } finally {
+    about3Pane.restoreState({ folderURI: baseFolder.URI });
+    await BrowserTestUtils.waitForCondition(
+      () => about3Pane.gFolder?.URI == baseFolder.URI,
+      "The base folder should be restored before cleanup"
+    );
+    for (const recordId of recordIds) {
+      AIStorage.removeMessage(recordId);
+    }
+    coverageFolder.deleteSelf(null);
+  }
+});
