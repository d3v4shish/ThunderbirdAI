+    `${authResults}\r\n` +
+    `From: Alice <alice@${fromDomain}>\r\n` +
+    "Subject: SPF test\r\n" +
+    "\r\n" +
+    "Hello\r\n";
+  const dns = new Map([
+    [`_dmarc.${fromDomain}`, [dmarcRecord]],
+    [
+      envelopeFrom.slice(envelopeFrom.lastIndexOf("@") + 1),
+      ["v=spf1 mx -all"],
+    ],
+    ...(helo && helo.includes(".") ? [[helo, ["v=spf1 a -all"]]] : []),
+  ]);
+  return {
+    message,
+    dnsTxtLookup: async name => dns.get(name) || [],
