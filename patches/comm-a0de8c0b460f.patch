+  async runRuntimeAction(action = "") {
+    if (this._runtimeActionBusy) {
+      return;
+    }
+    if (["clear-analysis-artifact", "reset-analysis"].includes(action)) {
+      const artifact = this.analysisArtifactSelect?.value || "all";
+      const confirmed = Services.prompt.confirm(
+        window,
+        "Clear AI analysis?",
+        `This removes ${this.analysisArtifactLabel(artifact)} from ${this.scopeLabel().toLocaleLowerCase()}. The data can be rebuilt by reanalysis.`
+      );
+      if (!confirmed) {
+        return;
+      }
+    }
+    this._runtimeActionBusy = true;
+    this.updateRuntimeActionButtons();
+    this.setRuntimeActionStatus("Working...", "info");
+    try {
+      let message = "Assistant runtime action completed.";
+      if (action == "self-test") {
+        const result = await AIService.runAssistantSelfTest({
+          accountKey: this.mailContext.accountKey || "global",
+        });
+        if (result.status != "ok") {
+          throw new Error(result.summary || "Assistant self-test failed.");
+        }
+        message = result.summary || "Assistant self-test passed.";
+      } else if (action == "clear-analysis-artifact") {
+        message = await this.clearCurrentScopeAnalysis(
+          this.analysisArtifactSelect?.value || "all"
+        );
+      } else if (action == "reanalyze-scope") {
+        message = await this.reanalyzeCurrentScope();
+      } else if (action == "upgrade-with-ollama") {
+        message = await this.upgradeCurrentScopeWithOllama();
+      } else if (action == "cancel-reanalysis") {
+        const result = AIService.cancelReanalysisJob();
+        message = result.cancelled
+          ? "Cancelled the current reanalysis job."
+          : "There is no active reanalysis job to cancel.";
+      } else if (action == "cancel-analysis-queue") {
+        const result = AIService.clearPendingAnalysisQueue();
+        message = result.activeAnalysisCount
+          ? `${result.summary} Work already in progress is allowed to finish safely.`
+          : result.summary;
+      } else if (action == "fix-attachment-security") {
+        const result = await AIService.enableAttachmentSecurityUpdates();
+        message = result.summary;
+      } else if (action == "reset-analysis") {
+        message = await this.clearCurrentScopeAnalysis("all");
+      } else if (action == "reset-analysis-reanalyze") {
+        message = await this.reanalyzeCurrentScope();
+      } else {
+        message = "Assistant runtime action is unavailable.";
+      }
+      this.setRuntimeActionStatus(message, "pass");
+    } catch (error) {
+      this.setRuntimeActionStatus(error.message, "fail");
+    } finally {
+      await this.refreshRuntimeSummary();
+      this._runtimeActionBusy = false;
+      this.updateRuntimeActionButtons();
+    }
+  },
