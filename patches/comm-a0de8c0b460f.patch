+        bodiesRead: context.job.readMessages,
+        summarizedMessages: context.job.mappedMessages,
+        cacheHits: context.job.cacheHits,
+        unavailableMessages: context.job.unavailableMessages,
+        truncatedMessages: context.job.truncatedMessages,
+        failedMessages: context.job.failedMessages,
+        threadCount: facets.threadCount,
+        chunkCount: context.job.chunks,
+        complete,
+      },
+      facets: {
+        dateRange: facets.dateRange,
+        categories: facets.categories,
+        months: facets.months,
+        topSenders: facets.topSenders,
