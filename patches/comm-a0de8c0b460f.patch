+      schemaVersion: MAILBOX_DIGEST_SCHEMA_VERSION,
+      scopeKey,
+      scopeFingerprint,
+      scopeMode,
+      scope: normalizedScope,
+      prompt,
+      state: "running",
+      phase: "reading",
+      scopeLabel,
+      message: "Preparing the exhaustive mailbox digest.",
+      totalMessages: headers.length,
+      readMessages: 0,
+      mappedMessages: 0,
+      cacheHits: 0,
+      unavailableMessages: 0,
+      truncatedMessages: 0,
+      failedMessages: 0,
+      skippedMessages: 0,
+      chunks: 0,
+      completedChunks: 0,
+      totalThreads: 0,
+      completedThreads: 0,
+      mapCalls: 0,
+      reductionCalls: 0,
+      reductionRounds: 0,
+      endpointInFlight: 0,
