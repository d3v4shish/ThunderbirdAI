+  // eslint-disable-next-line complexity
+  updateRuntimeActionButtons(runtimeStatus = this._latestRuntimeStatus) {
+    const selectionRequired = this.selectedScopeRequiresSelection();
+    const activeJob = ["preparing", "queued", "running"].includes(
+      runtimeStatus?.analysisJob?.state
+    );
+    const scopeQueue = runtimeStatus?.scopeSummary?.queueSummary || {};
+    const hasQueuedAnalysis =
+      !!runtimeStatus?.processing ||
