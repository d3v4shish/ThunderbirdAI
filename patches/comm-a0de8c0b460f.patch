+add_task(async function test_chat_honors_caller_cancellation() {
+  const endpointGlobal = Cu.getGlobalForObject(AIEndpoint);
+  const originalFetch = endpointGlobal.fetch;
+  endpointGlobal.fetch = (_url, { signal } = {}) =>
+    new Promise((_resolve, reject) => {
+      const rejectOnAbort = () =>
+        reject(new DOMException("Aborted", "AbortError"));
+      if (signal?.aborted) {
+        rejectOnAbort();
+        return;
+      }
+      signal?.addEventListener("abort", rejectOnAbort, { once: true });
+    });
+
+  Services.prefs.setStringPref("mail.ai.provider", "custom");
+  Services.prefs.setStringPref(
+    "mail.ai.endpoint.url",
+    "http://localhost:11434/v1/chat/completions"
+  );
+  Services.prefs.setStringPref("mail.ai.endpoint.model", "test-model");
+
+  const controller = new AbortController();
+  const request = AIEndpoint.chat("Summarize this message.", null, {
+    signal: controller.signal,
+  });
+  controller.abort();
+  try {
+    await Assert.rejects(request, /AI endpoint cancelled/);
+  } finally {
+    endpointGlobal.fetch = originalFetch;
+  }
+});
