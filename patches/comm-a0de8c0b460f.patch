+      embeddingModeMenu.value = Services.prefs.getStringPref(
+        "mail.ai.embeddings.mode",
+        "endpoint-first"
+      );
+    }
+    this.renderAILocalModelsOverview(state);
+    this.renderAILocalModelsRuntimeStatus(state);
+    this.renderAILocalModelCards(state);
+    if (this._aiLocalModelsActionLogState) {
+      this.renderAITestLog(
