+    return "ml-runtime";
+  }
+  if (
+    /no space left|not enough space|disk full|insufficient space/.test(text)
+  ) {
+    return "disk-space";
+  }
+  if (
+    /pull model manifest: file does not exist|manifest.*file does not exist|model manifest.*missing|model.*not found/.test(
+      text
