+    await AIPIIRules.clearGeneratedData();
+    await AIStorage.clearGeneratedData();
+  });
+});
+
+add_task(async function test_raw_chat_redacts_explicit_context_at_runtime() {
+  await AIStorage.clearGeneratedData();
+  Services.prefs.setStringPref("mail.ai.external.redaction", "required");
+
+  const stub = stubAssistantEndpoint();
+  try {
+    const result = await AIChat.askRaw({
+      prompt: "Summarize this attached context.",
+      attachedContextLabel: "Selected emails",
+      attachedContextText:
+        "Contact alice@example.com and charge 4111111111111111 for follow-up.",
+    });
+
+    Assert.equal(result.status, "ok");
+    const attachedContextText = extractAttachedContextText(stub.seen[0]);
+    Assert.ok(
+      attachedContextText.includes("<EMAIL>"),
+      "raw Assistant send should redact email addresses before emission"
+    );
+    Assert.ok(
+      attachedContextText.includes("<CARD>"),
+      "raw Assistant send should redact card-like numbers before emission"
+    );
+    Assert.ok(
+      !attachedContextText.includes("alice@example.com"),
+      "raw Assistant send should not emit the original email address"
+    );
+    Assert.ok(
+      !attachedContextText.includes("4111111111111111"),
+      "raw Assistant send should not emit the original card-like number"
+    );
+  } finally {
+    stub.restore();
+    Services.prefs.clearUserPref("mail.ai.external.redaction");
+  }
+});
+
+add_task(
+  async function test_raw_chat_redacts_current_message_body_at_runtime() {
+    await AIStorage.clearGeneratedData();
+    Services.prefs.setStringPref("mail.ai.external.redaction", "required");
+    AIStorage.setMessage("folder://inbox#1", {
+      accountKey: "server2",
+      folderURI: "folder://inbox",
+      messageKey: 1,
+      subject: "Payment confirmation",
+      author: "Alice <alice@example.com>",
+      summary: "Follow up with the customer.",
+      body: "Send the receipt to alice@example.com and bill 4111111111111111.",
+      canonicalBodyInfo: {
+        source: "canonical-body",
+        truncated: false,
+        charCount: 64,
+      },
+    });
+
+    const stub = stubAssistantEndpoint();
+    try {
+      const result = await AIChat.askRaw({
+        prompt: "Summarize the attached message.",
+        accountKey: "server2",
+        folderURI: "folder://inbox",
+        messageIds: ["folder://inbox#1"],
+        attachmentMode: "current",
+      });
+
+      Assert.equal(result.status, "ok");
+      const currentPayload = JSON.parse(
+        extractAttachedContextText(stub.seen[0])
+      );
+      Assert.ok(
+        !Object.prototype.hasOwnProperty.call(
+          currentPayload.records[0],
+          "canonicalBodyText"
+        ),
+        "current-message raw chat should omit the canonical body field when redaction is required"
+      );
+      Assert.equal(
+        currentPayload.records[0].redactedBodyText,
+        "Send the receipt to <EMAIL> and bill <CARD>.",
+        "current-message raw chat should emit the redacted body instead"
+      );
+      Assert.ok(
+        !JSON.stringify(currentPayload).includes("alice@example.com"),
+        "raw Assistant payload should not include the original email address"
+      );
+      Assert.ok(
+        !JSON.stringify(currentPayload).includes("4111111111111111"),
+        "raw Assistant payload should not include the original card-like number"
+      );
+    } finally {
+      stub.restore();
+      Services.prefs.clearUserPref("mail.ai.external.redaction");
+    }
+  }
+);
+
+add_task(async function test_summary_endpoint_redacts_payload_at_runtime() {
+  await AIStorage.clearGeneratedData();
+  Services.prefs.setStringPref("mail.ai.external.redaction", "required");
+
+  const stub = stubAssistantEndpoint();
+  try {
+    const result = await AIEndpoint.summarizeMessage({
+      author: "Alice <alice@example.com>",
+      recipients: "Bob <bob@example.com>",
+      subject: "Invoice 4111111111111111",
+      body: "Call +1 415-555-0100 or write alice@example.com for the update.",
+    });
+
+    Assert.equal(result.summary, "Redacted summary");
+    const emailJSON = extractEmailJSON(stub.seen[0]);
+    Assert.equal(emailJSON.from, "Alice <<EMAIL>>");
+    Assert.equal(emailJSON.to, "Bob <<EMAIL>>");
+    Assert.equal(emailJSON.subject, "Invoice <CARD>");
+    Assert.equal(
