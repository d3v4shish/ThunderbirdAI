+      current.enabled !== false;
+    document.getElementById("aiTemplateSummaryMode").value =
+      current.summaryMode || "template";
+    document.getElementById("aiTemplateSummaryTemplate").value =
+      current.summaryTemplate || "";
+    document.getElementById("aiTemplateCategoryMode").value =
+      current.categoryMode || "prior";
+    document.getElementById("aiTemplateCategoryValue").value =
+      current.categoryValue || "";
+    document.getElementById("aiTemplateFromMode").value =
+      current.match?.from?.mode || "contains";
+    document.getElementById("aiTemplateFromValue").value =
+      current.match?.from?.value || "";
+    document.getElementById("aiTemplateSubjectMode").value =
+      current.match?.subject?.mode || "contains";
+    document.getElementById("aiTemplateSubjectValue").value =
+      current.match?.subject?.value || "";
+    document.getElementById("aiTemplateBodyMode").value =
+      current.match?.body?.mode || "contains";
+    document.getElementById("aiTemplateBodyValue").value =
+      current.match?.body?.value || "";
+    document.getElementById("aiTemplateTypedSlots").value = (
+      current.match?.typedSlots || []
+    ).join(", ");
+    document.getElementById("aiTemplateExtractionFields").value = (
+      current.extractionFields || []
+    ).join(", ");
+    document.getElementById("aiTemplateSuppressions").value = (
+      current.suppressions || []
+    ).join(", ");
+    document.getElementById("aiTemplatePIIFields").value = (
+      current.piiFields || []
+    ).join(", ");
+    if (list) {
+      list.value = current.id || "";
+    }
+    this.updateAITemplatePreview();
