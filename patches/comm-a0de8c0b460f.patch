+      },
+    };
+    for (const prefName of prefNames) {
+      Services.prefs.addObserver(prefName, prefObserver);
+    }
+
+    const originalBroadcast = AIService.broadcastRuntimeChanged;
+    let broadcastCalls = 0;
+    AIService.broadcastRuntimeChanged = function (...args) {
+      broadcastCalls++;
+      return originalBroadcast.apply(this, args);
+    };
+
+    try {
