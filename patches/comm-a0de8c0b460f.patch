+    return {
+      ok: status == "ok",
+      feature: normalizedFeature,
+      role,
+      traceId: trace.id,
+      sourceName: config.sourceName || config.sourceId || config.provider || "",
+      sourceId: config.sourceId || sourceId,
+      model: config.model || "",
+      endpointURL: config.endpointURL || "",
+      requestPreview: JSON.stringify(redactedSecurityValue(messages), null, 2),
+      responsePreview: answer || errorMessage,
+      attempts: (debug.attempts || []).length,
