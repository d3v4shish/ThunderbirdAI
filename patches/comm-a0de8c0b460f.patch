+  async testPromptSandbox({
+    feature = "assistant",
+    sourceId = "",
+    featureInstruction = "",
+    rawOverride = "",
+    debugEnabled = false,
+  } = {}) {
+    await AIPromptConfig.init();
+    await AIStorage.init();
+    const normalizedFeature = feature == "summary" ? "summary" : "assistant";
+    const role = this.promptSandboxRole(normalizedFeature);
+    const accountKey = "global";
+    const systemPrompt = this.promptSandboxPrompt(normalizedFeature, {
+      sourceId,
+      featureInstruction,
+      rawOverride,
+      debugEnabled,
+    });
+    const messages = this.promptSandboxMessages(
+      normalizedFeature,
+      systemPrompt
+    );
+    let debug = null;
+    let answer = "";
+    let status = "ok";
+    let errorMessage = "";
+    if (AIStorage.isProviderPaused(accountKey)) {
+      status = "failed";
+      errorMessage = endpointPauseMessage(
+        normalizedFeature == "summary"
+          ? "Summary endpoint"
+          : "Assistant endpoint"
+      );
+      debug = {
+        config: AIEndpoint.getConfig(null, { sourceId, role }),
+        attempts: [],
+      };
+    } else {
+      try {
+        debug = await AIEndpoint.chatWithDebug(messages, null, {
+          sourceId,
+          role,
+        });
+        answer = debug.answer;
+      } catch (error) {
+        status = "failed";
+        errorMessage = error.message;
+        debug = error.aiEndpointDebug || {
+          config: AIEndpoint.getConfig(null, { sourceId, role }),
+          attempts: [],
+        };
+      }
+    }
+    const config =
+      debug.config || AIEndpoint.getConfig(null, { sourceId, role });
+    const trace = AIStorage.recordTrace({
+      explicitRequest: true,
+      type: "prompt-sandbox",
+      route: normalizedFeature,
+      status,
+      answerMode: "prompt-dry-run",
+      accountKey,
+      sourceId: config.sourceId || sourceId,
+      sourceName: config.sourceName || config.sourceId || config.provider || "",
+      sourceType: config.sourceType || config.provider || "",
+      endpointURL: config.endpointURL || "",
+      model: config.model || "",
+      prompt: messages[1].content,
+      request: {
+        feature: normalizedFeature,
+        role,
+        sourceId: config.sourceId || sourceId,
+        model: config.model || "",
+        messages: redactedSecurityValue(messages),
+      },
+      response: answer || errorMessage,
+      attempts: redactedSecurityValue(debug.attempts || []),
+      decisionReason: errorMessage || "Prompt sandbox dry-run completed.",
+    });
