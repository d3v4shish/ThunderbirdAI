+    await this.#flushMailboxDigestPack(context);
+  }
+
+  async #reduceMailboxDigestMessages(context) {
+    this.#mailboxDigestProgress(
+      context,
+      "threads",
+      "Finishing per-message summaries before thread reduction.",
+      { force: true, checkpoint: true }
+    );
+    await this.#finalizeMailboxDigestMessages(context, true);
+  }
+
+  async #reduceMailboxDigestScope(context) {
+    if (!context.messageNodes.size && context.headers.length) {
+      throw new Error("No message body could be summarized by Ollama.");
+    }
+    this.#mailboxDigestProgress(
+      context,
+      "threads",
+      `Reducing ${context.messageNodes.size} email summaries into threads.`,
+      { force: true, checkpoint: true }
+    );
+    const threadBaseCalls = context.job.reductionCalls;
+    const threadBaseRounds = context.job.reductionRounds;
+    const threadReduction = await this.#mailboxDigestThreadNodes(
+      context.metadata,
+      context.messageNodes,
+      context.accountKey,
+      context.config,
+      context.controller.signal,
+      thread => {
+        context.job.reductionCalls = threadBaseCalls + thread.calls;
+        context.job.reductionRounds = Math.max(threadBaseRounds, thread.rounds);
+        context.job.completedThreads = thread.completed;
+        context.job.totalThreads = thread.total;
+        this.#mailboxDigestProgress(
+          context,
+          "threads",
+          `Reduced ${thread.completed}/${thread.total} thread(s).`
+        );
+      }
+    );
+    context.job.reductionCalls = threadBaseCalls + threadReduction.calls;
+    context.job.reductionRounds = Math.max(
+      threadBaseRounds,
+      threadReduction.rounds
+    );
+    this.#mailboxDigestProgress(
+      context,
+      "batches",
+      `Combining ${threadReduction.nodes.length} thread summaries into the final digest.`,
+      { force: true, checkpoint: true }
+    );
+    const scopeBaseCalls = context.job.reductionCalls;
+    const scopeBaseRounds = context.job.reductionRounds;
+    const reduced = await this.#reduceMailboxDigestNodes(
+      threadReduction.nodes,
+      context.accountKey,
+      context.config,
+      context.controller.signal,
+      round => {
+        context.job.reductionCalls = scopeBaseCalls + round.calls;
+        context.job.reductionRounds = Math.max(scopeBaseRounds, round.rounds);
+        this.#mailboxDigestProgress(
+          context,
+          "batches",
+          `Reduction round ${round.rounds}: ${round.remainingNodes} summary node(s) remain.`
