+      ...enrichedData,
+      phishingEvidence: phishingEvidenceGroups(enrichedData),
+      linkInvestigations: this.#linksWithReputation(
+        linkRows,
+        urlReputationRows
+      ),
+      authProvenance: authProvenanceEntries(data.authResult),
+      rawAuthEvidence: this.#rawAuthEvidence(data.authResult),
+      cryptoStatus: cryptoStatusForMessage(msgHdr, data),
+      attachmentDeepInspection: attachmentDetails,
+      piiRedactionPreview: piiPreview,
+      piiPolicyEffects: piiPolicyEffects(analysis),
+      urlReputationProviders: urlReputationProviderRows(enrichedData),
+      senderReputationHistory: senderReputationHistory(enrichedData),
+      authExplanations: authPlainLanguageExplanations(data.authResult),
+      impersonationEvidence: impersonationEvidence(enrichedData),
+      qrCodeFindings: qrCodeFindings(enrichedData),
+      oauthAppLinkRisks: oauthAndAppLinkRisks(enrichedData),
+      becSignals: becSignalRows(detectionData),
