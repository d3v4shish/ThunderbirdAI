+
+  #miningCandidates(accountKey = "global", type = "", state = "") {
+    const allAccounts = accountKey == MINING_ALL_ACCOUNTS_KEY;
+    const normalizedAccountKey = allAccounts
+      ? ""
+      : this.#normalizedMiningAccountKey(accountKey);
+    return Object.values(this.#miningData().candidates || {})
+      .filter(candidate => {
+        if (
+          !allAccounts &&
+          normalizedAccountKey &&
+          candidate.accountKey != normalizedAccountKey
+        ) {
+          return false;
+        }
+        if (type && candidate.type != type) {
+          return false;
+        }
+        if (state && candidate.state != state) {
+          return false;
+        }
+        return true;
+      })
+      .sort((left, right) => {
+        const countDelta =
+          (Number(right.observedCount) || 0) -
+          (Number(left.observedCount) || 0);
+        if (countDelta) {
+          return countDelta;
+        }
+        return String(left.label || left.id || "").localeCompare(
+          String(right.label || right.id || "")
+        );
+      });
+  }
