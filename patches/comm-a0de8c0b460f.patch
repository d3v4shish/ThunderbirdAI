+  high: 3,
+  critical: 4,
+};
+
+function plainObject(value) {
+  return value && typeof value == "object" && !Array.isArray(value)
+    ? value
+    : {};
+}
+
+function limitedString(value, limit = 4000) {
+  return String(value ?? "")
+    .trim()
+    .slice(0, limit);
+}
+
+function normalizeRule(rule = {}) {
+  return {
+    id:
+      limitedString(rule.id, 80) ||
+      `pii-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,
+    name: limitedString(rule.name, 120) || "Custom PII rule",
+    enabled: rule.enabled !== false,
+    type: limitedString(rule.type, 40) || "custom",
+    severity:
+      limitedString(rule.severity, 20).toLocaleLowerCase() in SEVERITY_ORDER
+        ? limitedString(rule.severity, 20).toLocaleLowerCase()
+        : "medium",
+    pattern: limitedString(rule.pattern, 400),
+    scopes: Array.isArray(rule.scopes)
+      ? rule.scopes.slice(0, 8)
+      : ["incoming", "outgoing", "external"],
+  };
+}
+
+function defaultPolicies() {
+  return {
+    incoming: {
+      localAnalysis: "allow",
+      externalAI: "redact",
+      externalThreshold: "medium",
+    },
+    outgoing: {
+      action: "warn",
+      threshold: "high",
+      blockThreshold: "critical",
+    },
+  };
+}
+
+function severityMax(left = "low", right = "low") {
+  return SEVERITY_ORDER[left] >= SEVERITY_ORDER[right] ? left : right;
+}
+
+function matchesForPattern(text, pattern) {
+  const regex = new RegExp(pattern.source, pattern.flags);
+  const matches = [];
+  for (const match of String(text ?? "").matchAll(regex)) {
+    const value = limitedString(match[0], 200);
+    if (value) {
+      matches.push(value);
+    }
+  }
+  return matches;
+}
+
+function isLuhnValid(value = "") {
+  const digits = String(value).replace(/\D/g, "");
+  if (digits.length < 13 || digits.length > 19) {
+    return false;
+  }
+  let sum = 0;
+  let shouldDouble = false;
+  for (let index = digits.length - 1; index >= 0; index--) {
+    let digit = Number(digits[index]);
+    if (shouldDouble) {
+      digit *= 2;
+      if (digit > 9) {
+        digit -= 9;
+      }
+    }
+    sum += digit;
+    shouldDouble = !shouldDouble;
+  }
+  return sum % 10 == 0;
+}
+
+function availableCustomRules(owner) {
+  return owner._jsonFile?.dataReady ? owner.getRules() : [];
+}
+
+function availablePolicies(owner) {
+  return owner._jsonFile?.dataReady ? owner.getPolicies() : defaultPolicies();
+}
+
+export const AIPIIRules = {
+  _jsonFile: null,
+  _initPromise: null,
+
+  async init() {
+    if (this._jsonFile?.dataReady) {
+      return;
+    }
+    if (this._initPromise) {
+      await this._initPromise;
+      return;
+    }
+    this._initPromise = (async () => {
+      await IOUtils.makeDirectory(AIRuntimePaths.profileConfigRootDir(), {
+        createAncestors: true,
+        ignoreExisting: true,
+      });
+      const { jsonFile } = await initRecoverableJSONStore({
+        storeId: "ai-pii-rules",
+        owner: "AI PII rules",
+        path: AIRuntimePaths.piiRulesFilePath(),
+        dataPostProcessor(data = {}) {
+          return {
+            version: 1,
+            rules: Array.isArray(data.rules)
+              ? data.rules.map(normalizeRule)
+              : [],
+            policies: {
+              ...defaultPolicies(),
+              ...plainObject(data.policies),
+            },
+          };
+        },
+      });
+      this._jsonFile = jsonFile;
+    })();
+    try {
+      await this._initPromise;
+    } finally {
+      this._initPromise = null;
+    }
+  },
+
+  get data() {
+    if (!this._jsonFile?.dataReady) {
+      throw new Error("AI PII rules storage is not ready");
+    }
+    return this._jsonFile.data;
+  },
+
+  saveSoon() {
+    this._jsonFile?.saveSoon();
+  },
+
+  getRules() {
+    return this.data.rules.map(normalizeRule);
+  },
+
+  setRules(rules = []) {
+    this.data.rules = Array.isArray(rules) ? rules.map(normalizeRule) : [];
+    this.saveSoon();
+  },
+
+  getPolicies() {
+    return {
+      ...defaultPolicies(),
+      ...plainObject(this.data.policies),
+    };
+  },
+
+  setPolicies(policies = {}) {
+    this.data.policies = {
+      ...this.getPolicies(),
+      ...plainObject(policies),
+    };
+    this.saveSoon();
+  },
+
+  evaluateText(text = "", options = {}) {
+    const scope = options.scope || "incoming";
+    const matches = [];
+    let highestSeverity = "low";
+    for (const [type, severity, pattern] of BUILTIN_RULES) {
+      for (const value of matchesForPattern(text, pattern)) {
+        if (type == "card" && !isLuhnValid(value)) {
+          continue;
+        }
+        matches.push({ id: `builtin-${type}`, type, severity, value });
+        highestSeverity = severityMax(highestSeverity, severity);
+      }
+    }
+    // Built-in detection must remain available during early startup. Optional
+    // custom rules are loaded once the profile-backed store is ready, but an
+    // external-AI caller must never fall back to sending unredacted text just
+    // because that store has not finished initializing.
+    const customRules = availableCustomRules(this);
+    for (const rule of customRules) {
+      if (!rule.enabled || !rule.pattern || !rule.scopes.includes(scope)) {
+        continue;
+      }
+      try {
+        const regex = new RegExp(rule.pattern, "gi");
+        for (const value of matchesForPattern(text, regex)) {
+          matches.push({
+            id: rule.id,
+            type: rule.type,
+            severity: rule.severity,
+            value,
+          });
+          highestSeverity = severityMax(highestSeverity, rule.severity);
+        }
+      } catch {}
+    }
+    for (const field of options.templateFields || []) {
+      matches.push({
+        id: `template-${field}`,
+        type: field,
+        severity: "high",
+        value: field,
+      });
+      highestSeverity = severityMax(highestSeverity, "high");
+    }
+    const deduped = [];
+    const seen = new Set();
+    for (const match of matches) {
+      const key = `${match.type}\n${match.value}`;
+      if (seen.has(key)) {
+        continue;
+      }
+      seen.add(key);
+      deduped.push(match);
+    }
+    let redactedText = String(text ?? "");
+    for (const match of deduped) {
+      if (!match.value) {
+        continue;
+      }
+      redactedText = redactedText
+        .split(match.value)
+        .join(`<${match.type.toUpperCase()}>`);
+    }
+    const policies = availablePolicies(this);
+    let decision = "allow";
+    if (scope == "external") {
+      const threshold = policies.incoming.externalThreshold || "medium";
+      if (SEVERITY_ORDER[highestSeverity] >= SEVERITY_ORDER[threshold]) {
+        decision = policies.incoming.externalAI || "redact";
+      }
+    } else if (scope == "outgoing") {
+      if (
+        SEVERITY_ORDER[highestSeverity] >=
+        SEVERITY_ORDER[policies.outgoing.blockThreshold || "critical"]
+      ) {
+        decision = "block";
+      } else if (
+        SEVERITY_ORDER[highestSeverity] >=
+        SEVERITY_ORDER[policies.outgoing.threshold || "high"]
+      ) {
+        decision = policies.outgoing.action || "warn";
+      }
+    }
+    return {
+      matches: deduped,
+      highestSeverity,
+      redactedText,
+      decision,
+    };
+  },
+
+  exportJSON() {
+    return JSON.stringify(
+      {
+        rules: this.getRules(),
+        policies: this.getPolicies(),
+      },
+      null,
+      2
+    );
+  },
+
+  importJSON(data = {}, replace = false) {
+    if (replace) {
+      this.setRules(data.rules || []);
+      this.setPolicies(data.policies || {});
+      return;
+    }
+    this.setRules(this.getRules().concat(data.rules || []));
+    this.setPolicies({
+      ...this.getPolicies(),
+      ...plainObject(data.policies),
+    });
+  },
+
+  async clearGeneratedData() {
+    await IOUtils.remove(AIRuntimePaths.piiRulesFilePath(), {
+      ignoreAbsent: true,
+    });
+    await clearJSONStoreRecoveryArchives("ai-pii-rules");
+    this._jsonFile = null;
+    this._initPromise = null;
+    await this.init();
+  },
+};
diff --git a/mail/components/ai/modules/AIPromptConfig.sys.mjs b/mail/components/ai/modules/AIPromptConfig.sys.mjs
