--- /dev/null
+++ b/mail/components/ai/test/unit/test_ai_mining_shadow_rematch.js
@@ -0,0 +1,384 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+do_get_profile();
+
+const { AIService } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIService.sys.mjs"
+);
+const { AIStorage } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIStorage.sys.mjs"
+);
+const { AIExtractionRules } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AIExtractionRules.sys.mjs"
+);
+const { AITemplates } = ChromeUtils.importESModule(
+  "moz-src:///comm/mail/components/ai/modules/AITemplates.sys.mjs"
+);
+const { MessageGenerator, SyntheticMessageSet } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/MessageGenerator.sys.mjs"
+);
+const { MessageInjection } = ChromeUtils.importESModule(
+  "resource://testing-common/mailnews/MessageInjection.sys.mjs"
+);
+const { TestUtils } = ChromeUtils.importESModule(
+  "resource://testing-common/TestUtils.sys.mjs"
+);
+
+let gTimelineGenerator = null;
+let gTimelineInjection = null;
+
+add_setup(async function () {
+  Services.prefs.setBoolPref("mail.ai.enabled", true);
+  Services.prefs.setBoolPref("mail.ai.backfill.enabled", false);
+  await AIStorage.clearGeneratedData();
+  await AIExtractionRules.clearGeneratedData();
+  await AITemplates.clearGeneratedData();
+  await AIService.init();
+
+  registerCleanupFunction(async () => {
+    await AIService.uninit();
+    Services.prefs.clearUserPref("mail.ai.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.enabled");
+    Services.prefs.clearUserPref("mail.ai.backfill.paused");
+    gTimelineInjection?.teardownMessageInjection();
+    gTimelineInjection = null;
+    gTimelineGenerator = null;
+    await AIStorage.clearGeneratedData();
+    await AIExtractionRules.clearGeneratedData();
+    await AITemplates.clearGeneratedData();
+  });
+});
+
+async function createTimelineTestMessage({
+  from = "Billing Ops <billing@example.com>",
+  subject = "Invoice 4107 review",
+  body = "Invoice 4107 amount 225 INR is ready for review.",
+  date = new Date(),
+} = {}) {
+  if (!gTimelineInjection) {
+    gTimelineGenerator = new MessageGenerator();
+    gTimelineInjection = new MessageInjection(
+      { mode: "local" },
+      gTimelineGenerator
+    );
+  }
+  const folder = gTimelineInjection.getInboxFolder();
+  const existingKeys = new Set(
+    [...folder.messages].map(msgHdr => msgHdr.messageKey)
+  );
+  const message = gTimelineGenerator.makeMessage({
+    from,
+    subject,
+    date,
+    body: { body },
+  });
+  await gTimelineInjection.addSetsToFolders(
+    [folder],
+    [new SyntheticMessageSet([message])]
+  );
+  return {
+    injection: {
+      teardownMessageInjection() {},
+    },
+    folder,
+    msgHdr: [...folder.messages].find(
+      msgHdr => !existingKeys.has(msgHdr.messageKey)
+    ),
+  };
+}
+
+function invoiceMessageDetails(index) {
+  const invoiceId = 4106 + index;
+  const amount = 200 + index * 25;
+  return {
+    from: "Billing Ops <billing@example.com>",
+    subject: `Invoice ${invoiceId} review`,
+    date: new Date(Date.UTC(2026, 6, index, 12, 0, 0)),
+    body:
+      `Invoice ${invoiceId} amount ${amount} INR is ready for review.\n` +
+      `Please verify invoice ${invoiceId}.`,
+  };
+}
+
+async function waitForAnalysis(messageId, expectedTemplateId, expectedRuleId) {
+  await TestUtils.waitForCondition(() => {
+    const record = AIStorage.getMessage(messageId);
+    return (
+      record?.matchedTemplateId == expectedTemplateId &&
+      record?.extractions?.[0]?.ruleId == expectedRuleId
+    );
+  }, `waiting for analysis of ${messageId}`);
+}
+
+add_task(
+  async function test_mining_candidates_stay_shadow_until_threshold_and_rematch_resumes_from_checkpoint() {
+    await AIStorage.clearGeneratedData();
+    await AIExtractionRules.clearGeneratedData();
+    await AITemplates.clearGeneratedData();
+
+    const created = [];
+    for (let index = 1; index <= 2; index++) {
+      created.push(
+        await createTimelineTestMessage(invoiceMessageDetails(index))
+      );
+    }
+    const { injection, folder } = created[0];
+    folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    const msgHdrs = created.map(item => item.msgHdr);
+    for (const msgHdr of msgHdrs) {
+      msgHdr.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+    }
+
+    const accountKey = msgHdrs[0].folder.server.key;
+    const messageIds = msgHdrs.map(
+      msgHdr => `${folder.URI}#${msgHdr.messageKey}`
+    );
+
+    AITemplates.setTemplates(accountKey, [
+      {
+        id: "manual-invoice-template",
+        name: "Manual invoice template",
+        enabled: true,
+        match: {
+          from: { mode: "contains", value: "billing@example.com" },
+          subject: { mode: "regex", value: "Invoice\\s+\\d+\\s+review" },
+          body: { mode: "contains", value: "review" },
+          typedSlots: ["int"],
+        },
+        summaryMode: "template",
+        summaryTemplate: "Manual invoice review for {{int}}.",
+        categoryMode: "override",
+        categoryValue: "finance",
+        extractionFields: ["int"],
+        suppressions: [],
+        piiFields: [],
+      },
+    ]);
+    AIExtractionRules.setRules(accountKey, [
+      {
+        id: "manual-invoice-rule",
+        name: "Manual invoice rule",
+        enabled: true,
+        extractionMode: "regex",
+        conditions: {
+          from: { mode: "contains", value: "billing@example.com" },
+          subject: { mode: "contains", value: "Invoice" },
+          body: { mode: "contains", value: "INR" },
+        },
+      },
+    ]);
+
+    try {
+      for (let index = 0; index < 2; index++) {
+        AIService.requestAnalysis(msgHdrs[index]);
+        await waitForAnalysis(
+          messageIds[index],
+          "manual-invoice-template",
+          "manual-invoice-rule"
+        );
+      }
+
+      let miningStatus = await AIService.getMiningStatus(accountKey);
+      Assert.equal(miningStatus.candidates.length, 2);
+      Assert.equal(miningStatus.shadowCandidateCount, 2);
+      Assert.equal(miningStatus.suggestedCandidateCount, 0);
+      Assert.ok(
+        miningStatus.candidates.every(candidate => candidate.state == "shadow"),
+        "mined template and extraction candidates should stay shadow before the threshold"
+      );
+      Assert.ok(
+        miningStatus.candidates.every(
+          candidate => candidate.observedCount == 2
+        ),
+        "shadow candidates should only reflect the first two observations"
+      );
+      Assert.equal(
+        (await AIService.getSuggestedTemplates(accountKey)).length,
+        0
+      );
+      Assert.equal(
+        (await AIService.getSuggestedExtractionRules(accountKey)).length,
+        0
+      );
+
+      const manualRecord = AIStorage.getMessage(messageIds[1]);
+      Assert.equal(manualRecord.matchedTemplateName, "Manual invoice template");
+      Assert.equal(manualRecord.extractions[0].ruleId, "manual-invoice-rule");
+
+      const templateCandidateId = `template:${accountKey}:example.com|invoice # review`;
+      const pauseAfterFirstCheckpoint = new Promise(resolve => {
+        const observer = {
+          observe(subject, topic, data) {
+            const checkpoint = subject?.wrappedJSObject;
+            if (
+              topic != "mail-ai-mining-checkpoint" ||
+              data != templateCandidateId ||
+              checkpoint?.processedCount != 2 ||
+              checkpoint?.totalCount != 3
+            ) {
+              return;
+            }
+            AIService.pauseAnalysis();
+            Services.obs.removeObserver(observer, "mail-ai-mining-checkpoint");
+            resolve(checkpoint);
+          },
+        };
+        Services.obs.addObserver(observer, "mail-ai-mining-checkpoint");
+      });
+
+      const thirdCreated = await createTimelineTestMessage(
+        invoiceMessageDetails(3)
+      );
+      const thirdMsgHdr = thirdCreated.msgHdr;
+      thirdMsgHdr.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+      const thirdMessageId = `${folder.URI}#${thirdMsgHdr.messageKey}`;
+      msgHdrs.push(thirdMsgHdr);
+      messageIds.push(thirdMessageId);
+
+      AIService.requestAnalysis(thirdMsgHdr);
+      await waitForAnalysis(
+        thirdMessageId,
+        "manual-invoice-template",
+        "manual-invoice-rule"
+      );
+
+      const activeCheckpoint = await pauseAfterFirstCheckpoint;
+      Assert.equal(
+        activeCheckpoint.progressDetail,
+        "2/3 recent-first rematch records processed"
+      );
+
+      miningStatus = await AIService.getMiningStatus(accountKey);
+      Assert.equal(miningStatus.suggestedCandidateCount, 2);
+      Assert.equal(
+        (await AIService.getSuggestedTemplates(accountKey)).length,
+        1
+      );
+      Assert.equal(
+        (await AIService.getSuggestedExtractionRules(accountKey)).length,
+        1
+      );
+      const [suggestedExtractionRule] =
+        await AIService.getSuggestedExtractionRules(accountKey);
+      for (let index = 1; index <= 3; index++) {
+        const sourceExample = invoiceMessageDetails(index);
+        Assert.ok(
+          AIExtractionRules.matchesRule(
+            {
+              author: sourceExample.from,
+              subject: sourceExample.subject,
+              body: sourceExample.body,
+            },
+            suggestedExtractionRule
+          ),
+          `the mined extraction suggestion should match source example ${index}`
+        );
+      }
+
+      const pausedTemplateJob = miningStatus.rematchJobs.find(
+        job => job.candidateId == templateCandidateId
+      );
+      Assert.equal(pausedTemplateJob.state, "paused");
+      Assert.equal(pausedTemplateJob.processedCount, 2);
+      Assert.equal(pausedTemplateJob.totalCount, 3);
+      Assert.deepEqual(
+        pausedTemplateJob.matchedMessageIds,
+        [messageIds[2], messageIds[1]],
+        "rematch should checkpoint the newest messages first"
+      );
+
+      const promotedRecord = AIStorage.getMessage(messageIds[2]);
+      Assert.equal(
+        promotedRecord.matchedTemplateName,
+        "Manual invoice template",
+        "promoted mined templates should stay non-authoritative by default"
+      );
+      Assert.equal(
+        promotedRecord.extractions[0].ruleId,
+        "manual-invoice-rule",
+        "promoted mined extraction candidates should not replace user-authored rules"
+      );
+
+      AIService.resumeAnalysis();
+      await TestUtils.waitForCondition(async () => {
+        const status = await AIService.getMiningStatus(accountKey);
+        return status.rematchJobs.some(
+          job =>
+            job.candidateId == templateCandidateId && job.state == "complete"
+        );
+      }, "waiting for template rematch to resume from the saved checkpoint");
+
+      miningStatus = await AIService.getMiningStatus(accountKey);
+      const completedTemplateJob = miningStatus.rematchJobs.find(
+        job => job.candidateId == templateCandidateId
+      );
+      Assert.equal(completedTemplateJob.state, "complete");
+      Assert.equal(completedTemplateJob.processedCount, 3);
+      Assert.equal(completedTemplateJob.matchedCount, 3);
+      Assert.deepEqual(
+        completedTemplateJob.matchedMessageIds.slice(0, 2),
+        [messageIds[2], messageIds[1]],
+        "completed rematch should preserve the checkpointed recent-first prefix"
+      );
+      Assert.ok(
+        completedTemplateJob.matchedMessageIds.includes(messageIds[0]),
+        "resume should finish the remaining historical message instead of restarting from zero"
+      );
+    } finally {
+      injection.teardownMessageInjection();
+      await AIStorage.clearGeneratedData();
+      await AIExtractionRules.clearGeneratedData();
+      await AITemplates.clearGeneratedData();
+      Services.prefs.clearUserPref("mail.ai.backfill.paused");
+    }
+  }
+);
+
+add_task(async function test_automatic_mining_learns_variable_word_slots() {
+  await AIStorage.clearGeneratedData();
+  await AIExtractionRules.clearGeneratedData();
+  await AITemplates.clearGeneratedData();
+
+  const names = ["Northwind", "Contoso", "Fabrikam"];
+  const created = [];
+  try {
+    for (let index = 0; index < names.length; index++) {
+      const name = names[index];
+      const item = await createTimelineTestMessage({
+        from: "Billing Ops <billing@example.com>",
+        subject: `Invoice ${name} review`,
+        body: `Invoice ${name} amount 225 INR is ready for review.`,
+        date: new Date(Date.UTC(2026, 8, index + 1, 12, 0, 0)),
+      });
+      item.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+      item.msgHdr.folder.setFlag(Ci.nsMsgFolderFlags.Mail);
+      created.push(item);
+      const messageId = `${item.folder.URI}#${item.msgHdr.messageKey}`;
+      AIService.requestAnalysis(item.msgHdr);
+      await TestUtils.waitForCondition(
+        () => !!AIStorage.getMessage(messageId),
+        `waiting for automatic mining input ${name}`
+      );
+    }
+
+    const accountKey = created[0].msgHdr.folder.server.key;
+    await TestUtils.waitForCondition(async () => {
+      const status = await AIService.getMiningStatus(accountKey);
+      return status.suggestedTemplates.some(
+        candidate => candidate.observedCount == 3
+      );
+    }, "waiting for a variable-word Drain template promotion");
+    const suggestions = await AIService.getSuggestedTemplates(accountKey);
+    Assert.equal(suggestions.length, 1);
+    Assert.equal(suggestions[0].observedCount, 3);
+    Assert.ok(
+      suggestions[0].match.subject.value.includes("(?:\\S+"),
+      "the learned subject should contain a bounded Drain wildcard"
+    );
+  } finally {
+    await AIStorage.clearGeneratedData();
+    await AIExtractionRules.clearGeneratedData();
+    await AITemplates.clearGeneratedData();
+  }
+});
