+    await OPFS.remove(runtimeRoot, { recursive: true });
+
+    await Assert.rejects(
+      MLEngineParent.getWasmArrayBuffer(backend),
+      /Remote Settings/,
+      "Without a Remote Settings record or cached runtime, the original error should still surface."
+    );
+  } finally {
+    try {
+      await OPFS.remove(runtimeRoot, { recursive: true });
+    } catch {}
