+add_task(async function test_ml_engine_uses_cached_runtime_when_rs_is_empty() {
+  const { cleanup, remoteClients } = await setup();
+  const backend = MLEngineParent.DEFAULT_BACKEND;
+  const runtimeRoot = `mlRuntimeFiles/${backend}`;
+  const cachedPath = `${runtimeRoot}/${MLEngineParent.WASM_MAJOR_VERSION[
