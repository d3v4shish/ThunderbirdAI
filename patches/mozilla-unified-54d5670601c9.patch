@@ -810,6 +810,66 @@
   }
 
   /**
+   * Returns the newest cached runtime attachment from OPFS for the given backend.
+   *
+   * This keeps already-downloaded Gecko ML runtime files usable when
+   * Remote Settings metadata is temporarily unavailable.
+   *
+   * @param {string} backend
+   * @returns {Promise<ArrayBuffer | null>}
+   */
+  static async #getCachedWasmArrayBuffer(backend) {
+    const runtimeRoot = `${RUNTIME_ROOT_IN_OPFS}/${backend}`;
+    const expectedFileName =
+      MLEngineParent.WASM_FILENAME[backend || MLEngineParent.DEFAULT_BACKEND];
+    let runtimeDirectory;
+    try {
+      runtimeDirectory = await lazy.OPFS.getDirectoryHandle(runtimeRoot, {
+        create: false,
+      });
+    } catch (error) {
+      if (error?.name == "NotFoundError") {
+        return null;
+      }
+      throw error;
+    }
+
+    let newestFile = null;
+    for await (const [_version, handle] of runtimeDirectory.entries()) {
+      if (handle.kind != "directory") {
+        continue;
+      }
+      let fileHandle;
+      try {
+        fileHandle = await handle.getFileHandle(expectedFileName, {
+          create: false,
+        });
+      } catch (error) {
+        if (error?.name == "NotFoundError") {
+          continue;
+        }
+        throw error;
+      }
+      const file = await fileHandle.getFile();
+      if (
+        !newestFile ||
+        Number(file.lastModified) > Number(newestFile.lastModified)
+      ) {
+        newestFile = file;
+      }
+    }
+
+    if (!newestFile) {
+      return null;
+    }
+
+    lazy.console.debug(
+      `Using cached Gecko ML runtime attachment ${newestFile.name} for backend ${backend}.`
+    );
+    return new Response(newestFile.stream()).arrayBuffer();
+  }
+
+  /**
    * Download the wasm for the ML inference engine.
    *
    * @param {string} backend - The ML engine for which the WASM buffer is requested.
@@ -831,12 +891,23 @@
