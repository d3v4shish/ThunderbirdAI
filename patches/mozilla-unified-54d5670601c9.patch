diff --git a/toolkit/components/ml/tests/xpcshell/test_engine_process_pipeline_options.js b/toolkit/components/ml/tests/xpcshell/test_engine_process_pipeline_options.js
new file mode 100644
--- /dev/null
+++ b/toolkit/components/ml/tests/xpcshell/test_engine_process_pipeline_options.js
@@ -0,0 +1,56 @@
+/* Any copyright is dedicated to the Public Domain.
+   http://creativecommons.org/publicdomain/zero/1.0/ */
+
+"use strict";
+
+const {
+  InferenceDevice,
+  PipelineOptions,
+} = ChromeUtils.importESModule(
+  "chrome://global/content/ml/EngineProcess.sys.mjs"
+);
+
+add_task(function test_pipeline_options_accept_llama_gpu_offload_controls() {
+  const options = new PipelineOptions({
+    taskName: "test-echo",
+    modelId: "test-echo",
+    modelRevision: "main",
+    device: InferenceDevice.GPU,
+    numGpuLayers: 24,
+    offloadKqv: true,
+  });
+
+  Assert.equal(options.numGpuLayers, 24);
+  Assert.equal(options.offloadKqv, true);
+
+  const config = {};
+  options.applyToConfig(config);
+  Assert.equal(config.numGpuLayers, 24);
+  Assert.equal(config.offloadKqv, true);
+});
+
+add_task(function test_pipeline_options_reject_invalid_llama_gpu_offload_controls() {
+  Assert.throws(
+    () =>
+      new PipelineOptions({
+        taskName: "test-echo",
+        modelId: "test-echo",
+        modelRevision: "main",
+        numGpuLayers: -1,
+      }),
+    /Invalid value/,
+    "Negative GPU layer counts should be rejected"
+  );
+
+  Assert.throws(
+    () =>
+      new PipelineOptions({
+        taskName: "test-echo",
+        modelId: "test-echo",
+        modelRevision: "main",
+        offloadKqv: "yes",
+      }),
+    /Invalid value/,
+    "Non-boolean offloadKqv values should be rejected"
+  );
+});
